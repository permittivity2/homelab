#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_install:
	dh_install
	install -D -m 644 config/postfix-block-link.example.yml \
		debian/homelab-postfix-block-link/usr/share/homelab-postfix-block-link/config/postfix-block-link.example.yml
	install -D -m 644 services/postfix-block-link.yml \
		debian/homelab-postfix-block-link/usr/share/homelab-postfix-block-link/services/postfix-block-link.yml
