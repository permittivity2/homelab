#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR=/etc/homelab/postfix-block-link
CONFIG_FILE="$CONFIG_DIR/config.yml"
SHARE_DIR=/usr/share/homelab-postfix-block-link

case "$1" in
    configure)
        echo "homelab-postfix-block-link post-installation setup..."

        if ! command -v postconf >/dev/null 2>&1; then
            echo "ERROR: postconf not found -- is homelab-postfix actually installed on this host?"
            db_stop
            exit 1
        fi

        # The milter service runs as User=homelab, but a postfix host does not
        # otherwise have that user -- create it (same system-user recipe every
        # other homelab-* app postinst uses). Without this the unit dies
        # 217/USER in a restart loop.
        adduser --system --group --home /var/lib/homelab --no-create-home \
            --shell /usr/sbin/nologin homelab 2>/dev/null || true
        mkdir -p /var/lib/homelab
        chown homelab:homelab /var/lib/homelab 2>/dev/null || true

        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services
        cp "$SHARE_DIR/services/postfix-block-link.yml" /etc/homelab/services/postfix-block-link.yml

        mkdir -p "$CONFIG_DIR"

        if [ ! -f "$CONFIG_FILE" ]; then
            db_get homelab-postfix-block-link/db_host || true;         DB_HOST="${RET:-localhost}"
            db_get homelab-postfix-block-link/pgbouncer_host || true;  PGBOUNCER_HOST="${RET:-localhost}"
            db_get homelab-postfix-block-link/instance_id || true;     INSTANCE_ID="$RET"
            db_get homelab-postfix-block-link/milter_listen || true;   MILTER_LISTEN="${RET:-inet:8892@127.0.0.1}"
            db_get homelab-postfix-block-link/public_base_url || true; PUBLIC_BASE_URL="${RET:-https://blockemail.test.mailmasker.org}"
            db_get homelab-postfix-block-link/link_ttl_days || true;   LINK_TTL_DAYS="${RET:-90}"

            ROLE_SUFFIX_ARGS=""
            [ -n "$INSTANCE_ID" ] && ROLE_SUFFIX_ARGS="--role-suffix $INSTANCE_ID"

            echo "  bootstrapping 'homelab_postfix_block_link_runtime${INSTANCE_ID:+_$INSTANCE_ID}' on $DB_HOST..."
            echo "  (needs homelab-api, homelab-domain-admin, and homelab-block-link already"
            echo "   installed/migrated there -- see README.md's \"Install order\" section)"
            # Makefile.PL's EXE_FILES installs this straight to /usr/bin
            # (standard perl_makemaker layout), NOT under
            # $SHARE_DIR/script -- unlike homelab-postfix's own bootstrap
            # script, which its debian/rules copies into $SHARE_DIR
            # explicitly. Confirmed via `dpkg -c` on the built .deb
            # before fixing this (real bug hit on first live install,
            # not caught by syntax-checking alone).
            BOOTSTRAP_OUT="$(homelab-postfix-block-link-bootstrap-role --db-host "$DB_HOST" $ROLE_SUFFIX_ARGS </dev/null || true)"

            ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^ROLE=//p')"
            PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^PASSWORD=//p')"
            SCRAM_SECRET="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^SCRAM_SECRET=//p')"
            MANUAL="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MANUAL=//p')"

            if [ -z "$ROLE" ]; then
                echo "ERROR: homelab-postfix-block-link-bootstrap-role did not report success -- see output above."
                echo "       Not writing $CONFIG_FILE or wiring the milter into Postfix;"
                echo "       re-run 'dpkg-reconfigure homelab-postfix-block-link' once fixed."
                db_stop
                exit 0
            fi

            if [ "$MANUAL" = "1" ]; then
                echo "  manual bootstrap: wrote pending SQL; skipping pgbouncer-register for '$ROLE'"
                echo "    -> apply the SQL on the DB primary + register '$ROLE' in pgbouncer, then: dpkg-reconfigure homelab-postfix-block-link"
            else
                echo "  registering '$ROLE' with pgbouncer on $PGBOUNCER_HOST..."
                homelab-bootstrap-pgbouncer-entry --role "$ROLE" \
                    --scram-secret "$SCRAM_SECRET" --pgbouncer-host "$PGBOUNCER_HOST" \
                    || echo "  WARNING: pgbouncer registration failed -- see output above; register '$ROLE' by hand."
            fi

            sed \
                -e "s#YOUR_PGBOUNCER_HOST#$PGBOUNCER_HOST#g" \
                -e "s#YOUR_RUNTIME_PASSWORD_HERE#$PASSWORD#g" \
                -e "s#homelab_postfix_block_link_runtime#$ROLE#g" \
                -e "s#https://blockemail\.test\.mailmasker\.org#$PUBLIC_BASE_URL#g" \
                -e "s#link_ttl_days: 90#link_ttl_days: $LINK_TTL_DAYS#g" \
                -e "s#\"inet:8892@127\.0\.0\.1\"#\"$MILTER_LISTEN\"#g" \
                "$SHARE_DIR/config/postfix-block-link.example.yml" > "$CONFIG_FILE"
            chown root:homelab "$CONFIG_FILE" 2>/dev/null || true
            chmod 640 "$CONFIG_FILE"
            echo "  wrote $CONFIG_FILE"
        else
            echo "  $CONFIG_FILE already exists -- leaving it untouched"
            echo "  (dpkg-reconfigure homelab-postfix-block-link to redo the prompts, e.g. after a password rotation)"
            MILTER_LISTEN="$(sed -n 's/^  listen: "\(.*\)"/\1/p' "$CONFIG_FILE" | head -1)"
            MILTER_LISTEN="${MILTER_LISTEN:-inet:8892@127.0.0.1}"
        fi

        # --- Grants, re-applied on EVERY configure. The bootstrap above runs
        # only when config.yml is first written, so a GRANT added by a later
        # release (0.2.0: the #67 reply-identity tables) would never reach an
        # already-installed host. On the DB host itself this applies them
        # directly; anywhere else it writes the SQL to the pending directory
        # and install-orchestrators/mail-reply-alias-orchestrate.sh applies
        # the same text (--print-grants) on the DB primary from the
        # workstation. No SSH from here: fleet guests hold no trust to the
        # database hosts.
        ROLE_IN_CONFIG="$(sed -n 's/^  user: \(.*\)$/\1/p' "$CONFIG_FILE" | head -1)"
        db_get homelab-postfix-block-link/db_host || true; GRANT_DB_HOST="${RET:-localhost}"
        if [ -n "$ROLE_IN_CONFIG" ]; then
            homelab-postfix-block-link-bootstrap-role --grants-only --role "$ROLE_IN_CONFIG" --db-host "$GRANT_DB_HOST" </dev/null \
                || echo "  WARNING: grants step failed -- see output above. Apply 'homelab-postfix-block-link-bootstrap-role --print-grants --role $ROLE_IN_CONFIG' on the DB primary by hand."
        else
            echo "  WARNING: could not read database.user from $CONFIG_FILE -- grants not re-applied"
        fi

        # --- Wire into Postfix's milter chains. The ORDER relative to
        # OpenDKIM (inet:*:8891) matters and differs per listener, so this
        # no longer appends-if-missing (which left the order to whichever
        # postinst ran last -- prod had this milter BEFORE OpenDKIM on 25,
        # so OpenDKIM verified inbound mail that already carried our footer):
        #
        #   smtpd_milters (25 and anything else using main.cf's list):
        #       OpenDKIM first (verification sees the untouched original),
        #       this milter LAST.
        #   non_smtpd_milters (pickup/sendmail, local mail):
        #       this milter FIRST, the signer last.
        #   submission/inet (587) and smtps/inet (465, #70) -- per-service
        #   overrides via postconf -P:
        #       this milter FIRST so the #67 From/envelope rewrite happens
        #       before OpenDKIM signs (the signature then covers the
        #       rewritten From and uses the alias domain's key), OpenDKIM
        #       LAST. And milter_default_action=tempfail there: if this
        #       milter is unreachable, a reply is deferred (phones retry)
        #       rather than sent from the user's real address. Gardner's
        #       decision, 2026-11-10 (#67). Inbound (25) keeps 'accept'.
        #
        # homelab-postfix's own postinst applies the same rules for the
        # OpenDKIM entry, so the two converge whatever the run order.
        #
        # Postfix's own smtpd_milters/non_smtpd_milters connect syntax
        # is "inet:HOST:PORT" -- the REVERSE of Sendmail::PMilter's own
        # setconn()/milter.listen syntax "inet:PORT@HOST" used above.
        # Converted here, not stored twice, so config.yml stays the one
        # source of truth for what this milter actually binds to.
        MILTER_PORT="$(echo "$MILTER_LISTEN" | sed -n 's/^inet:\([0-9]*\)@.*/\1/p')"
        MILTER_HOST="$(echo "$MILTER_LISTEN" | sed -n 's/^inet:[0-9]*@\(.*\)/\1/p')"
        if [ -n "$MILTER_PORT" ] && [ -n "$MILTER_HOST" ]; then
            MILTER_CONNECT="inet:$MILTER_HOST:$MILTER_PORT"
            SELF_GLOB="inet:*:$MILTER_PORT"

            # $1 = comma-separated milter list, $2 = glob; echoes the list
            # without the entries matching the glob, trimmed, ", "-joined.
            _list_without() {
                _out=""
                _oldifs="$IFS"; IFS=','
                for _m in $1; do
                    _m="$(printf '%s' "$_m" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                    [ -z "$_m" ] && continue
                    case "$_m" in $2) continue ;; esac
                    if [ -z "$_out" ]; then _out="$_m"; else _out="$_out, $_m"; fi
                done
                IFS="$_oldifs"
                printf '%s' "$_out"
            }

            REST="$(_list_without "$(postconf -h smtpd_milters 2>/dev/null || true)" "$SELF_GLOB")"
            postconf -e "smtpd_milters = ${REST:+$REST, }$MILTER_CONNECT"

            REST="$(_list_without "$(postconf -h non_smtpd_milters 2>/dev/null || true)" "$SELF_GLOB")"
            postconf -e "non_smtpd_milters = $MILTER_CONNECT${REST:+, $REST}"

            # NB: postconf -P refuses whitespace in a master.cf -o value
            # ("-Pe does not accept whitespace in parameter value"), so the
            # per-service lists are comma-separated WITHOUT the spaces
            # main.cf uses. Both authenticated listeners get the same order
            # and the same tempfail: 587 (STARTTLS) and 465 (implicit TLS, #70).
            for svc in submission/inet smtps/inet; do
                if postconf -Mf "$svc" >/dev/null 2>&1; then
                    CUR_SUB="$(postconf -Ph "$svc/smtpd_milters" 2>/dev/null || true)"
                    [ -n "$CUR_SUB" ] || CUR_SUB="$(postconf -h smtpd_milters 2>/dev/null || true)"
                    REST="$(_list_without "$CUR_SUB" "$SELF_GLOB")"
                    postconf -P "$svc/smtpd_milters=$(printf '%s' "$MILTER_CONNECT${REST:+,$REST}" | tr -d ' ')"
                    postconf -P "$svc/milter_default_action=tempfail"
                else
                    echo "  NOTE: no ${svc%/inet} service in master.cf yet -- its milter order is set when homelab-postfix adds it"
                fi
            done

            postconf -e 'milter_default_action = accept' 'milter_protocol = 6'
            echo "  milter chains: 25 -> $(postconf -h smtpd_milters)"
            echo "                 587 -> $(postconf -Ph submission/inet/smtpd_milters 2>/dev/null || echo '(no submission service)')"
            echo "                 465 -> $(postconf -Ph smtps/inet/smtpd_milters 2>/dev/null || echo '(no smtps service)')"
            echo "                 local -> $(postconf -h non_smtpd_milters)"
        else
            echo "  WARNING: could not parse milter.listen ('$MILTER_LISTEN') as inet:PORT@HOST --"
            echo "           NOT wiring into Postfix's milter chain. Fix milter.listen in $CONFIG_FILE"
            echo "           and re-run 'dpkg-reconfigure homelab-postfix-block-link', or wire it by hand:"
            echo "           postconf -e 'smtpd_milters = \$smtpd_milters, inet:127.0.0.1:8892'"
        fi

        if postfix check >/dev/null 2>&1; then
            systemctl reload-or-restart postfix \
                || echo "  WARNING: postfix reload/restart failed -- check 'systemctl status postfix' by hand."
        else
            echo "  WARNING: 'postfix check' reports a config error -- NOT reloading postfix."
            echo "           Run 'postfix check' by hand to see it; the previous running config is untouched."
        fi

        systemctl enable homelab-postfix-block-link >/dev/null 2>&1 || true
        if systemctl is-active --quiet homelab-postfix-block-link; then
            systemctl restart homelab-postfix-block-link \
                || echo "  WARNING: homelab-postfix-block-link restart failed -- check 'systemctl status homelab-postfix-block-link' by hand."
        else
            systemctl start homelab-postfix-block-link \
                || echo "  WARNING: homelab-postfix-block-link failed to start -- check 'systemctl status homelab-postfix-block-link' / 'journalctl -xeu homelab-postfix-block-link' by hand."
        fi

        db_stop

        echo ""
        echo "homelab-postfix-block-link configured."
        echo "config:        $CONFIG_FILE"
        echo "milter socket: $MILTER_LISTEN"
        echo "Next steps:"
        echo "  homelab-cli admin block-link domain set <domain> --enabled --mode header"
        echo "  homelab-cli mail reply-from-alias enable      (per user; replies go out from the alias they were sent to)"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
