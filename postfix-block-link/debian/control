Package: homelab-postfix-block-link
Architecture: all
Depends: perl (>= 5.36),
         homelab-common (>= 0.1.23),
         homelab-postfix,
         libmojolicious-perl,
         libyaml-libyaml-perl,
         libmojo-pg-perl,
         libsendmail-pmilter-perl,
         libemail-mime-perl,
         libemail-address-xs-perl,
         adduser,
