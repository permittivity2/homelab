#!/usr/bin/perl
# Bespoke, one-off cross-schema grant, modeled almost exactly on
# ../../postfix/script/homelab-postfix-bootstrap-role (that file's own
# header explains why this can't be the generic homelab-bootstrap-
# app-role: that script only ever mints a role scoped to a schema IT
# creates for one feature; this one deliberately reaches into role
# schemas it doesn't own -- domainadmin's for alias/domain resolution,
# api's for recipient validation, AND block_link's own
# pending_links table, owned by the SEPARATE homelab-block-link
# package/service, not this one).
#
# Same three-tier local/SSH/manual fallback, same list-form-exec/
# stdin-piped SQL discipline (never SQL-as-argv, see that file's own
# comment on the exact remote-shell-mangling bug this avoids), same
# ROLE_SUFFIX per-HA-instance support (a postfix host running block-
# link in an HA trio needs its own role, same "shared role, last-
# install-wins password" risk already found and fixed for
# homelab-postfix/homelab-dovecot/homelab-roundcube's own runtime
# roles).
#
# On success, prints (to stdout only):
#   ROLE=homelab_postfix_block_link_runtime
#   PASSWORD=<password>
#   SCRAM_SECRET=<secret>
#
# Usage: homelab-postfix-block-link-bootstrap-role --db-host HOST [--db homelab] [--role-suffix SUFFIX]
#
# Two more modes, added for post-cutover #67 because the full bootstrap
# runs ONLY ONCE per host (the postinst calls it when config.yml is first
# written), so a GRANT added in a later release never reached existing
# hosts on upgrade (same trap homelab-postfix hit once, see its README):
#
#   --print-grants [--role-suffix S | --role R]
#       Print the idempotent GRANT statements for the role to stdout and
#       exit. No database access. This is what the workstation orchestrator
#       (install-orchestrators/mail-reply-alias-orchestrate.sh) pipes into
#       `sudo -u postgres psql` on the Patroni leader, so the GRANT text has
#       one source of truth. Prints no CREATE/ALTER ROLE and no password.
#   --grants-only --db-host HOST [--role-suffix S | --role R]
#       Re-apply the grants: directly when HOST is this machine, otherwise
#       written to $PENDING_DIR for the orchestrator/operator to apply on the
#       DB primary. Deliberately NO SSH tier -- fleet guests must never hold
#       SSH trust to the database hosts. The postinst runs this on EVERY
#       configure. Prints GRANTS=applied or GRANTS=pending.

use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Path qw(make_path);
use IPC::Open2 qw(open2);

my $DB      = 'homelab';
my $DB_HOST = '';
my $ROLE_SUFFIX = '';
my $ROLE_NAME   = '';
my $ROLE_BASE   = 'homelab_postfix_block_link_runtime';
my ($PRINT_GRANTS, $GRANTS_ONLY) = (0, 0);
our $ROLE;

GetOptions(
    'db-host=s'     => \$DB_HOST,
    'db=s'          => \$DB,
    'role-suffix=s' => \$ROLE_SUFFIX,
    'role=s'        => \$ROLE_NAME,
    'print-grants'  => \$PRINT_GRANTS,
    'grants-only'   => \$GRANTS_ONLY,
) or die usage();

die usage() unless $DB_HOST || $PRINT_GRANTS;

$ROLE = length($ROLE_NAME)   ? $ROLE_NAME
      : length($ROLE_SUFFIX) ? "${ROLE_BASE}_${ROLE_SUFFIX}"
      :                        $ROLE_BASE;
die_msg("refusing role name '$ROLE' (letters, digits and underscores only)") unless $ROLE =~ /\A[a-z_][a-z0-9_]*\z/;

my @SSH_OPTS    = ('-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', '-o', 'StrictHostKeyChecking=accept-new');
my $PENDING_DIR = '/var/lib/homelab-database/pending';

sub usage {
    return "Usage: $0 --db-host HOST [--db homelab] [--role-suffix SUFFIX]\n"
         . "       $0 --print-grants [--role-suffix SUFFIX | --role ROLE]\n"
         . "       $0 --grants-only --db-host HOST [--role-suffix SUFFIX | --role ROLE]\n";
}

sub log_msg  { print STDERR "[postfix-block-link-bootstrap-role] @_\n" }
sub warn_msg { print STDERR "[postfix-block-link-bootstrap-role] WARNING: @_\n" }
sub die_msg  { print STDERR "[postfix-block-link-bootstrap-role] ERROR: @_\n"; exit 1 }

sub random_password {
    open(my $fh, '<', '/dev/urandom') or die_msg("cannot open /dev/urandom: $!");
    read($fh, my $bytes, 24) == 24 or die_msg('short read from /dev/urandom');
    close($fh);
    require MIME::Base64;
    return MIME::Base64::encode_base64($bytes, '');
}

sub is_local_host {
    my ($host) = @_;
    return 1 if $host eq 'localhost' || $host eq '127.0.0.1' || $host eq '::1';
    chomp(my $hostname = `hostname`);
    return 1 if $host eq $hostname;
    chomp(my $fqdn = `hostname -f 2>/dev/null`);
    return 1 if $fqdn && $host eq $fqdn;
    return 0;
}

sub sql_escape {
    my ($s) = @_;
    $s =~ s/'/''/g;
    return $s;
}

sub build_sql {
    my (%opts) = @_;
    return build_role_sql(%opts) . build_grant_sql();
}

sub build_role_sql {
    my (%opts) = @_;
    my $pw_esc   = sql_escape($opts{password});
    my $role_esc = sql_escape($ROLE);

    return <<SQL;
-- generated by homelab-postfix-block-link's homelab-postfix-block-link-bootstrap-role
DO \$\$
BEGIN
   IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$role_esc') THEN
      CREATE ROLE "$ROLE" WITH LOGIN PASSWORD '$pw_esc';
   ELSE
      ALTER ROLE "$ROLE" WITH LOGIN PASSWORD '$pw_esc';
   END IF;
END
\$\$;

SQL
}

# Idempotent: GRANT on an already-granted privilege is a no-op in Postgres,
# so this block is safe to re-run on every configure (--grants-only) and
# from the orchestrator (--print-grants).
sub build_grant_sql {
    return <<SQL;
-- grants for "$ROLE" (homelab-postfix-block-link-bootstrap-role --print-grants)
-- Recipient validation, same column-scoped shape as homelab-postfix's
-- own grant (never password_hash -- this milter never authenticates
-- anyone, only decides whether to inject a link).
GRANT USAGE ON SCHEMA api TO "$ROLE";
GRANT SELECT (email, active) ON api.users TO "$ROLE";

-- Envelope-address -> destination-account resolution (the SAME
-- mail_aliases exact-then-catch-all lookup Postfix's own
-- pgsql-virtual-alias-maps.cf.template already does) and domain
-- existence/active checks.
GRANT USAGE ON SCHEMA domainadmin TO "$ROLE";
GRANT SELECT (domain_name, mail_enabled, active) ON domainadmin.domains TO "$ROLE";
GRANT SELECT ON domainadmin.mail_aliases TO "$ROLE";

-- Settings this milter reads on every transaction (owned by the
-- SEPARATE homelab-block-link package/service -- see that package's
-- own migrations/001-block-link.sql). Read-only: this milter never
-- writes settings, only pending_links (below).
GRANT USAGE ON SCHEMA block_link TO "$ROLE";
GRANT SELECT ON block_link.domain_settings TO "$ROLE";
GRANT SELECT ON block_link.account_settings TO "$ROLE";

-- The one table this milter writes to -- INSERT only (it never reads
-- pending_links back; homelab-block-link's own web service owns
-- reading/updating these rows). USAGE on the owning sequence is
-- required for a BIGSERIAL PK insert to succeed at all -- found
-- missing once already for a different package's own INSERT-only
-- grant (homelab-audit-grant-queue-insert's own history), not
-- rediscovered the hard way here.
GRANT INSERT ON block_link.pending_links TO "$ROLE";
GRANT USAGE ON block_link.pending_links_id_seq TO "$ROLE";

-- Post-cutover #67, "reply from the alias a message was sent to" (tables
-- owned by homelab-domain-admin, migration 009). The milter READS the
-- per-user setting, WRITES one row per inbound message naming which of
-- the user's own addresses it was sent to, and READS that row back when
-- the user replies on 587. Never UPDATE/DELETE: pruning is domain-admin's.
GRANT SELECT ON domainadmin.mail_reply_identity TO "$ROLE";
GRANT SELECT, INSERT ON domainadmin.mail_received_via TO "$ROLE";
GRANT USAGE ON SEQUENCE domainadmin.mail_received_via_id_seq TO "$ROLE";
SQL
}

sub run_sql_local_or_remote {
    my ($sql, @cmd) = @_;
    open(my $fh, '|-', @cmd) or die_msg("cannot exec @cmd: $!");
    print $fh $sql;
    close($fh);
    return $? == 0;
}

sub run_query_stdin_local_or_remote {
    my ($sql, @cmd) = @_;
    my ($out_fh, $in_fh);
    my $pid = open2($out_fh, $in_fh, @cmd);
    print $in_fh $sql;
    close($in_fh);
    my $out = do { local $/; <$out_fh> };
    close($out_fh);
    waitpid($pid, 0);
    return undef unless $? == 0;
    return $out;
}

sub check_exists {
    my ($regclass, @cmd) = @_;
    my $out = run_query_stdin_local_or_remote(sprintf(q{SELECT to_regclass('%s')}, $regclass), @cmd);
    return 0 unless defined $out;
    # psql -tA prints an EMPTY LINE for a NULL result, so "\n" used to count
    # as "exists" and a missing table only surfaced later, at the GRANT.
    $out =~ s/\s+//g;
    return length $out ? 1 : 0;
}

sub fetch_scram_secret {
    my (@cmd) = @_;
    my $query = sprintf(q{SELECT rolpassword FROM pg_authid WHERE rolname = '%s'}, sql_escape($ROLE));
    return run_query_stdin_local_or_remote($query, @cmd);
}

my @REQUIRED_TABLES = qw(
    api.users domainadmin.domains domainadmin.mail_aliases block_link.pending_links
    domainadmin.mail_reply_identity domainadmin.mail_received_via
);

sub check_all_exist {
    my (@cmd) = @_;
    for my $table (@REQUIRED_TABLES) {
        unless (check_exists($table, @cmd)) {
            die_msg("$table does not exist on $DB_HOST yet -- install/migrate the package that "
                . "owns it there first (homelab-api, homelab-domain-admin, or homelab-block-link -- "
                . "see this package's own README.md's \"Install order\" section)");
        }
    }
}

sub run_local {
    my (%opts) = @_;
    my @psql_prefix = ('sudo', '-u', 'postgres', 'psql');
    check_all_exist(@psql_prefix, '-d', $DB, '-X', '-tA');
    log_msg("bootstrapping '$ROLE' locally (db-host is this host)");
    run_sql_local_or_remote(build_sql(%opts), @psql_prefix, '-q', '-d', $DB, '-X', '-v', 'ON_ERROR_STOP=1')
        or return undef;
    return fetch_scram_secret(@psql_prefix, '-d', $DB, '-X', '-tA');
}

sub ssh_trust_works {
    system('ssh', @SSH_OPTS, $DB_HOST, 'true') == 0;
}

sub run_remote {
    my (%opts) = @_;
    my @remote_prefix = ('ssh', @SSH_OPTS, $DB_HOST);
    check_all_exist(@remote_prefix, "sudo -u postgres psql -d $DB -X -tA");
    log_msg("bootstrapping '$ROLE' on $DB_HOST via SSH");
    run_sql_local_or_remote(
        build_sql(%opts), @remote_prefix,
        "sudo -u postgres psql -q -d $DB -X -v ON_ERROR_STOP=1",
    ) or return undef;
    return fetch_scram_secret(@remote_prefix, "sudo -u postgres psql -d $DB -X -tA");
}

sub run_manual {
    my (%opts) = @_;
    make_path($PENDING_DIR, { mode => 0700 });
    my $pending_file = "$PENDING_DIR/homelab-postfix-block-link-bootstrap.sql";
    open(my $fh, '>', $pending_file) or die_msg("cannot write $pending_file: $!");
    print $fh build_sql(%opts);
    close($fh);
    chmod(0600, $pending_file);

    warn_msg("cannot bootstrap '$ROLE' automatically (not local, and no SSH trust to $DB_HOST)");
    print STDERR <<MSG;

  On $DB_HOST, have an administrator run:
    sudo -u postgres psql -d $DB -v ON_ERROR_STOP=1 -f $pending_file
  (copy $pending_file to $DB_HOST first if it isn't already there)

MSG

    while (1) {
        print STDERR "Press Enter once that's been run to fetch the role's secret (or 's' to skip): ";
        my $reply = <STDIN>;
        unless (defined $reply) {
            # Non-interactive (no tty -- fleet orchestrator's dpkg on a no-SSH-to-DB
            # host). Don't die (aborts the postinst under set -e). Emit the
            # manual-bootstrap contract so the postinst writes config + wires the
            # milter; the operator/orchestrator applies the pending SQL on the DB
            # primary + registers pgbouncer out of band, then dpkg-reconfigure.
            warn_msg('non-interactive: emitting manual-bootstrap markers (apply the SQL above on the DB primary, then register pgbouncer, then dpkg-reconfigure)');
            print "ROLE=$ROLE\n";
            print "PASSWORD=$opts{password}\n";
            print "MANUAL=1\n";
            exit 0;
        }
        chomp $reply;
        return undef if lc($reply) eq 's';

        if (is_local_host($DB_HOST)) {
            my $secret = fetch_scram_secret('sudo', '-u', 'postgres', 'psql', '-d', $DB, '-X', '-tA');
            return $secret if defined $secret && length $secret;
        }
        elsif (ssh_trust_works()) {
            my $secret = fetch_scram_secret('ssh', @SSH_OPTS, $DB_HOST, "sudo -u postgres psql -d $DB -X -tA");
            return $secret if defined $secret && length $secret;
        }
        else {
            warn_msg("still no SSH trust to $DB_HOST; run the command above, then retry from a host that does");
        }
    }
}

# --grants-only: no role creation, no password, no SSH. Local DB host ->
# applied now; anything else -> pending file for the orchestrator/operator.
sub run_grants_only {
    if (is_local_host($DB_HOST)) {
        my @psql_prefix = ('sudo', '-u', 'postgres', 'psql');
        check_all_exist(@psql_prefix, '-d', $DB, '-X', '-tA');
        log_msg("re-applying grants for '$ROLE' locally (db-host is this host)");
        run_sql_local_or_remote(build_grant_sql(), @psql_prefix, '-q', '-d', $DB, '-X', '-v', 'ON_ERROR_STOP=1')
            or die_msg("applying grants for '$ROLE' failed -- see psql output above");
        print "GRANTS=applied\n";
        return;
    }

    make_path($PENDING_DIR, { mode => 0700 });
    my $pending_file = "$PENDING_DIR/homelab-postfix-block-link-grants.sql";
    open(my $fh, '>', $pending_file) or die_msg("cannot write $pending_file: $!");
    print $fh build_grant_sql();
    close($fh);
    chmod(0600, $pending_file);
    log_msg("grants for '$ROLE' written to $pending_file (this host is not the DB host and never SSHes to it);"
          . " apply on the DB primary: sudo -u postgres psql -d $DB -v ON_ERROR_STOP=1 -f $pending_file"
          . " -- install-orchestrators/mail-reply-alias-orchestrate.sh does exactly that from the workstation");
    print "GRANTS=pending\n";
    return;
}

sub main {
    if ($PRINT_GRANTS) {
        print build_grant_sql();
        return;
    }
    return run_grants_only() if $GRANTS_ONLY;

    my %opts = (password => random_password());

    my $secret =
        is_local_host($DB_HOST) ? run_local(%opts)
      : ssh_trust_works()       ? run_remote(%opts)
      :                           run_manual(%opts);

    die_msg('bootstrap failed or was skipped') unless defined $secret && length $secret;

    print "ROLE=$ROLE\n";
    print "PASSWORD=$opts{password}\n";
    print "SCRAM_SECRET=$secret\n";
}

main();
