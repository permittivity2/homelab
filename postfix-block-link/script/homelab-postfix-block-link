#!/usr/bin/env perl
# The milter half of the click-to-block-link mechanism and, since 0.2.0,
# of "reply from the alias a message was sent to" (post-cutover #67). Real
# Sendmail::PMilter API confirmed against the actual installed module
# source (/usr/share/perl5/Sendmail/PMilter{,/Context}.pm) before
# writing this, not assumed -- see block-link's own plan/README for
# the citations.
#
# Fail-open and fail-closed, deliberately split:
#   * INBOUND work (block-link injection; remembering which alias a message
#     came through) fails OPEN: any DB error or unexpected exception logs
#     and lets the message through completely unmodified -- a milter on the
#     hot SMTP delivery path must never become a new way to break mail.
#   * The SUBMISSION rewrite (587, authenticated user replying from the
#     login address) fails CLOSED when the database cannot be consulted:
#     the reply is deferred (451, the phone retries from its outbox) rather
#     than silently sent from the user's real address -- the very thing the
#     feature exists to prevent. Gardner's decision, 2026-11-10;
#     reply_identity.on_db_error in config.yml is the operator's escape
#     hatch. Postfix's own sender-login lookup on 587 is a pgsql map, so a
#     database outage already defers submissions; this adds no new outage.
use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Sendmail::PMilter qw(:all);
use Homelab::Common::Config qw(load_config);
use Homelab::Common::DB qw(runtime_pg);
use Homelab::PostfixBlockLink::Milter qw(
    resolve_recipient effective_setting is_signed_mime
    generate_token build_header_value insert_pending_link
    normalise_message_id last_reference_id parse_header_addresses is_safe_address
    choose_reply_address rewrite_address_header
    reply_from_alias_enabled record_received_via lookup_received_via allowed_to_send_as
);
use Mojo::JSON qw(encode_json);
use Email::MIME;

my $config = load_config('HOMELAB_POSTFIX_BLOCK_LINK_CONFIG', '/etc/homelab/postfix-block-link/config.yml');
my $bl_cfg = $config->{block_link} // die "config: block_link.* is required\n";
my $listen = $config->{milter}{listen} // die "config: milter.listen is required\n";
# Hosts installed before 0.2.0 have no reply_identity section in their
# config.yml (it is written once, at first install) -- these defaults ARE
# the shipped behaviour, the example yml only documents them.
my $ri_cfg      = $config->{reply_identity} // {};
my $ON_DB_ERROR = $ri_cfg->{on_db_error} // 'tempfail';
my $HDR_LIMIT   = $ri_cfg->{header_address_limit} // 50;

sub log_line { print STDERR "[homelab-postfix-block-link] @_\n" }

# Lazy, fork-safe DB handle -- deliberately NOT a single connection
# created once at file scope. prefork_dispatcher (below) forks worker
# processes AFTER this script's top-level code runs, and a Postgres
# connection (like any DBI connection) does not survive fork() safely
# -- multiple children sharing one inherited socket would corrupt the
# wire protocol. Re-creates the connection the first time any callback
# touches it in a given process, and again if $$ (the pid) ever
# changes from when it was created -- covers both prefork's own
# up-front fork and any other dispatcher style that forks later.
my $pg;
my $pg_pid = 0;
sub _pg {
    if (!$pg || $pg_pid != $$) {
        $pg = runtime_pg(%{ $config->{database} });
        $pg_pid = $$;
    }
    return $pg;
}

# Macros are per protocol stage inside PMilter: the CONNECT set
# ({daemon_name}) lives for the whole connection, the MAIL set
# ({auth_authen}) until the next MAIL/ABORT; getsymval searches every
# stage, so reading both at eom is correct. Never die over a macro.
sub _macro {
    my ($ctx, $name) = @_;
    my $v = eval { $ctx->getsymval($name) };
    return defined $v ? $v : '';
}

my %cbs;

# START OF EACH MESSAGE. Without this, per-message state only ever got
# cleared in the `close` callback -- and close fires when the SMTP CONNECTION
# ends, not when a message does.
#
# Any sending MTA may deliver many messages down one connection; that is
# normal, not unusual. Every message after the first then had the PREVIOUS
# messages' bodies accumulated into $priv->{body}, and eom's replacebody
# wrote that back. Observed on a 300-message run over one connection:
# message 143 was delivered with the bodies of messages 1-143 in it, 28 KB
# instead of 180 bytes.
#
# Worse than the size: one connection can carry messages for DIFFERENT
# recipients, so recipient B could receive recipient A's message body. The
# accumulating `candidates` list has the same shape of problem -- an earlier
# message's recipients stayed eligible for later ones.
#
# envfrom is the canonical per-message boundary, so the reset belongs here.
$cbs{envfrom} = sub {
    my ($ctx, $from) = @_;
    (my $clean = $from // '') =~ s/^<//;
    $clean =~ s/>$//;
    # Deliberately a fresh hashref rather than deleting known keys: anything
    # a future callback adds is then reset too, instead of silently becoming
    # the next instance of this bug.
    $ctx->setpriv({ envelope_from => lc $clean, recipients => [], candidates => [], headers => {} });
    return SMFIS_CONTINUE;
};

# A message abandoned mid-stream (client disconnect, reject, DATA abort)
# never reaches eom, so without this its partial body would be inherited by
# whatever is sent next on the same connection.
$cbs{abort} = sub {
    my ($ctx) = @_;
    $ctx->setpriv({});
    return SMFIS_CONTINUE;
};

$cbs{envrcpt} = sub {
    my ($ctx, $addr, @esmtp) = @_;
    my $priv = $ctx->getpriv() // {};
    $priv->{candidates} //= [];
    $priv->{recipients} //= [];

    # Postfix also reports recipients it REJECTED when the milter protocol
    # negotiation asks for them (PMilter echoes Postfix's full offer, so it
    # does); those carry {rcpt_mailer}=error and are nobody's mail.
    if (_macro($ctx, '{rcpt_mailer}') eq 'error') {
        $ctx->setpriv($priv);
        return SMFIS_CONTINUE;
    }

    # Strip SMTP envelope angle brackets ("<user@domain>" -> "user@domain")
    # -- PMilter hands this callback the raw envelope token verbatim.
    (my $clean = $addr) =~ s/^<//;
    $clean =~ s/>$//;

    eval {
        my $account = resolve_recipient(_pg()->db, $clean);
        if ($account) {
            # Every local recipient, in RCPT order (#67 needs them all, with
            # the ORIGINAL address: by LMTP time Postfix has rewritten the
            # envelope to the mailbox and the alias is gone).
            push @{ $priv->{recipients} }, { address => lc $clean, account => $account };

            my $setting = effective_setting(_pg()->db, $account);
            push @{ $priv->{candidates} }, {
                address => $clean, account_email => $account,
                enabled => $setting->{enabled}, mode => $setting->{mode},
            } if $setting->{enabled};
        }
    };
    log_line("envrcpt resolution failed for $clean (failing open, continuing unmodified): $@") if $@;

    $ctx->setpriv($priv);
    return SMFIS_CONTINUE;
};

# Headers #67 needs besides Content-Type/Message-ID. To/Cc may legally
# repeat (RFC 5322 allows one each, real mail does not care) -- joined so
# every address counts; the rest keep their first occurrence.
my %JOIN_HEADERS  = map { $_ => 1 } qw(to cc);
my %FIRST_HEADERS = map { $_ => 1 } qw(from reply-to sender in-reply-to references);

$cbs{header} = sub {
    my ($ctx, $name, $value) = @_;
    my $priv = $ctx->getpriv() // {};
    my $n = lc($name // '');
    if ($n eq 'content-type') {
        $priv->{content_type} = $value;
    }
    elsif ($n eq 'message-id') {
        $priv->{message_id} = $value;
    }
    elsif ($JOIN_HEADERS{$n}) {
        $priv->{headers}{$n} = defined $priv->{headers}{$n} ? "$priv->{headers}{$n}, $value" : $value;
    }
    elsif ($FIRST_HEADERS{$n}) {
        $priv->{headers}{$n} //= $value;
    }
    $ctx->setpriv($priv);
    return SMFIS_CONTINUE;
};

$cbs{body} = sub {
    my ($ctx, $chunk) = @_;
    my $priv = $ctx->getpriv() // {};
    # Only block-link's footer injection ever needs the body, and only when
    # an enabled recipient is on the message. Not buffering it otherwise
    # keeps every outgoing message on 587 (attachments included) and every
    # inbound message for a non-enabled account out of memory.
    if (@{ $priv->{candidates} // [] }) {
        $priv->{body} = '' unless defined $priv->{body};
        $priv->{body} .= $chunk;
    }
    $ctx->setpriv($priv);
    return SMFIS_CONTINUE;
};

$cbs{eom} = sub {
    my ($ctx) = @_;
    my $priv = $ctx->getpriv() // {};
    _record_received_via($priv);             # (a) #67 inbound half -- fails open
    _inject_block_link($ctx, $priv);         # (b) click-to-block link -- fails open, unchanged behaviour
    return _rewrite_reply($ctx, $priv);      # (c) #67 submission half -- fails closed on DB error
};

$cbs{close} = sub {
    my ($ctx) = @_;
    $ctx->setpriv(undef);
    return SMFIS_CONTINUE;
};

# (a) For every destination account on this message, work out which of the
# account's own addresses the reply should come from (the rule lives in
# Milter.pm's choose_reply_address) and remember it under the Message-ID.
# Recorded for EVERY account, not only those with the setting on, so
# switching the setting on later works for mail already received; the
# setting gates the rewrite only. Nothing is recorded when the winner is the
# account's real address -- there is nothing to rewrite to.
sub _record_received_via {
    my ($priv) = @_;
    my @recipients = @{ $priv->{recipients} // [] };
    return unless @recipients;

    my $mid = normalise_message_id($priv->{message_id});
    unless (defined $mid) {
        log_line('reply-identity: no usable Message-ID, nothing recorded');
        return;
    }

    my %accounts = map { $_->{account} => 1 } @recipients;
    my ($to, $cc);
    for my $account (sort keys %accounts) {
        eval {
            my $db = _pg()->db;
            $to //= parse_header_addresses($priv->{headers}{to}, $HDR_LIMIT);
            $cc //= parse_header_addresses($priv->{headers}{cc}, $HDR_LIMIT);
            my $d = choose_reply_address(
                account => $account, to => $to, cc => $cc, envelope => \@recipients,
                resolve => sub { resolve_recipient($db, $_[0]) },
            );
            return unless $d && $d->{chosen} ne $account;
            my $n = record_received_via(
                $db, account => $account, message_id => $mid, chosen => $d->{chosen},
                via => $d->{via}, candidates_json => encode_json($d->{candidates}),
            );
            log_line("reply-identity: recorded account=$account msgid=<$mid> chosen=$d->{chosen} via=$d->{via}") if $n;
        };
        log_line("reply-identity: recording for $account failed (failing open): $@") if $@;
    }
    return;
}

# (b) Exactly the pre-0.2.0 end-of-message behaviour.
sub _inject_block_link {
    my ($ctx, $priv) = @_;
    my @enabled = grep { $_->{enabled} } @{ $priv->{candidates} // [] };
    return unless @enabled;

    eval {
        my $token = generate_token();
        my $candidates_json = encode_json([
            map { { account_email => $_->{account_email}, address => $_->{address} } } @enabled
        ]);
        insert_pending_link(
            _pg()->db, token => $token, candidates_json => $candidates_json,
            message_id => $priv->{message_id}, ttl_days => $bl_cfg->{link_ttl_days},
        );

        my $link = build_header_value($bl_cfg->{public_base_url}, $token);
        $ctx->addheader('List-Unsubscribe', $link);

        # body mode: if ANY enabled recipient's own domain wants body
        # content, include it -- see README.md's "Mixed-mode
        # transactions" note on why this is a deliberate, documented
        # choice (favor coverage) rather than a per-recipient split a
        # milter structurally can't do (one shared body per
        # transaction, not one per recipient).
        my $want_body = grep { $_->{mode} eq 'body' || $_->{mode} eq 'both' } @enabled;
        if ($want_body && !is_signed_mime($priv->{content_type})) {
            my $ct = $priv->{content_type};
            # No Content-Type header at all defaults to text/plain per RFC
            # 2045 -- the simplest, safest case to append to, not one to
            # exclude by treating "undef" as "unknown, skip it".
            my $is_plain = !defined($ct) || lc($ct) =~ m{^\s*text/plain};
            if ($is_plain) {
                my $footer = "\r\n\r\n--\r\nDon't want mail like this? Manage blocked addresses: "
                    . "$bl_cfg->{public_base_url}/l/$token\r\n";
                $ctx->replacebody(($priv->{body} // '') . $footer);
            }
            else {
                # multipart / text/html: inject the footer into every
                # text/plain and text/html LEAF part via Email::MIME (it
                # decode/re-encodes each part's own Content-Transfer-
                # Encoding and PRESERVES the message's existing boundary --
                # verified on real Gmail multipart/alternative, both 7bit
                # and quoted-printable). This is the case that covers
                # essentially all real-world mail (Gmail/Outlook/etc. send
                # multipart/alternative); the old text/plain-only path
                # silently skipped it -- header added, footer missing.
                my $new_body = _inject_mime_footer(
                    $ct, $priv->{body} // '', $bl_cfg->{public_base_url}, $token);
                $ctx->replacebody($new_body) if defined $new_body;
            }
        }
    };
    if ($@) {
        log_line("eom injection failed (failing open, message delivered unmodified): $@");
    }
    return;
}

# (c) An authenticated submission (587 sets milter_macro_daemon_name=
# ORIGINATING) that is a reply (In-Reply-To, else the last References id)
# and whose From: is the login address itself: if the user has the setting
# on and we remember which of their aliases the original was sent to, and
# they are still allowed to send as it, swap the From: (and a Reply-To:/
# Sender: that also names the login) and the envelope sender to the alias.
# OpenDKIM runs after this milter on 587 and signs the rewritten From with
# the alias domain's key. Mail already From an alias (a Roundcube identity,
# `mail send --from`) is untouched: From ne login.
sub _rewrite_reply {
    my ($ctx, $priv) = @_;
    return SMFIS_CONTINUE unless _macro($ctx, '{daemon_name}') eq 'ORIGINATING';
    my $login = lc _macro($ctx, '{auth_authen}');
    return SMFIS_CONTINUE unless length $login;

    my $from_raw = $priv->{headers}{from};
    my $from = parse_header_addresses($from_raw, 2);
    return SMFIS_CONTINUE unless @$from == 1 && $from->[0] eq $login;

    my $parent = normalise_message_id($priv->{headers}{'in-reply-to'})
        // last_reference_id($priv->{headers}{references});
    return SMFIS_CONTINUE unless defined $parent;

    my ($alias, $skip);
    my $decided = eval {
        my $db = _pg()->db;
        if (!reply_from_alias_enabled($db, $login))     { $skip = 'setting off';                               return 1 }
        my $chosen = lookup_received_via($db, $login, $parent);
        if (!defined $chosen)                           { $skip = 'no record of the original';                 return 1 }
        if ($chosen eq $login)                          { $skip = 'original went to the real address';         return 1 }
        if (!is_safe_address($chosen))                  { $skip = "recorded address '$chosen' is not safe";    return 1 }
        if (!allowed_to_send_as($db, $login, $chosen))  { $skip = "$login may not send as $chosen any more";   return 1 }
        $alias = $chosen;
        1;
    };
    if (!$decided) {
        log_line("reply-identity: cannot decide for $login (in-reply-to <$parent>): $@");
        return _fail_closed($ctx);
    }
    if (!defined $alias) {
        log_line("reply-identity: $login reply to <$parent> left alone ($skip)");
        return SMFIS_CONTINUE;
    }

    my $done = eval {
        my $new_from = rewrite_address_header($from_raw, $login, $alias)
            // die "From header could not be rewritten\n";
        $ctx->chgheader('From', 1, $new_from);
        for my $h (qw(reply-to sender)) {
            my $raw = $priv->{headers}{$h};
            next unless defined $raw;
            my $p = parse_header_addresses($raw, 2);
            next unless @$p == 1 && $p->[0] eq $login;
            my $v = rewrite_address_header($raw, $login, $alias);
            next unless defined $v;
            $ctx->chgheader($h eq 'reply-to' ? 'Reply-To' : 'Sender', 1, $v);
        }
        $ctx->chgfrom("<$alias>");
        1;
    };
    if (!$done) {
        # A half-applied rewrite must not leave: TEMPFAIL makes Postfix drop
        # every edit of this message along with the message itself.
        log_line("reply-identity: rewrite for $login failed midway: $@");
        return _fail_closed($ctx);
    }
    log_line("reply-identity: rewrote login=$login to=$alias in-reply-to=<$parent>");
    return SMFIS_CONTINUE;
}

sub _fail_closed {
    my ($ctx) = @_;
    if ($ON_DB_ERROR eq 'accept') {
        log_line('reply-identity: on_db_error=accept -- letting the message through unchanged');
        return SMFIS_CONTINUE;
    }
    eval { $ctx->setreply('451', '4.7.1', 'Reply identity check temporarily unavailable, try again later') };
    return SMFIS_TEMPFAIL;
}

# Inject the block-link footer into a multipart / text/html message.
# Returns the new BODY (for replacebody) or undef if nothing was touched
# (e.g. an attachment-only multipart with no text part). Uses Email::MIME's
# per-part body()/body_set(), which decode + re-encode each part's own
# Content-Transfer-Encoding (quoted-printable / base64 / 7bit) and preserve
# the message's existing MIME boundary. Called only from inside the eom
# eval, so any parse failure fails open (message delivered unmodified).
sub _inject_mime_footer {
    my ($content_type, $body, $base_url, $token) = @_;
    my $link = "$base_url/l/$token";
    my $plain_footer = "\n\n--\nDon't want mail like this? Manage blocked addresses: $link\n";
    my $html_footer = qq{<div style="margin-top:1em;padding-top:0.6em;border-top:1px solid #ccc;font-size:12px;color:#777;font-family:sans-serif">Don't want mail like this? <a href="$link">Manage blocked addresses</a></div>};

    my $msg = Email::MIME->new("Content-Type: $content_type\n\n$body");
    my $touched = 0;
    $msg->walk_parts(sub {
        my ($part) = @_;
        return if $part->subparts;   # a container, not a leaf
        my $pct = lc($part->content_type // 'text/plain');
        if ($pct =~ m{^\s*text/plain}) {
            $part->body_set($part->body . $plain_footer);
            $touched = 1;
        }
        elsif ($pct =~ m{^\s*text/html}) {
            my $b = $part->body;
            # Prefer injecting just before </body>; else append at the end.
            $b =~ s{</body\s*>}{$html_footer$&}i or $b .= $html_footer;
            $part->body_set($b);
            $touched = 1;
        }
    });
    return undef unless $touched;

    # as_string re-emits the reconstructed top Content-Type header + the
    # (now-modified) body; strip that header block back off so ONLY the
    # body reaches replacebody -- the real message keeps its own top
    # headers, including the identical boundary preserved above.
    my $out = $msg->as_string;
    $out =~ s/\A.*?\r?\n\r?\n//s;
    # CRITICAL: Email::MIME->as_string emits bare-LF line endings, but mail
    # (and everything reading the maildir afterwards -- dovecot's IMAP
    # BODYSTRUCTURE, Roundcube) requires CRLF. Handing replacebody an all-LF
    # body silently corrupts the stored message: the MIME structure no
    # longer parses and clients report "Could not load message from server".
    # Normalize every line ending to CRLF (idempotent on already-CRLF input).
    $out =~ s/\r?\n/\r\n/g;
    return $out;
}

my $milter = Sendmail::PMilter->new();
$milter->setconn($listen) or die "cannot bind to $listen: $!\n";
# CHGHDRS + CHGFROM are what #67's From/envelope rewrite needs; PMilter
# refuses (dies -> TEMPFAIL) any action whose flag was not registered.
$milter->register('homelab-postfix-block-link', \%cbs,
    SMFIF_ADDHDRS | SMFIF_CHGBODY | SMFIF_CHGHDRS | SMFIF_CHGFROM);

my $dispatcher = Sendmail::PMilter::prefork_dispatcher(
    max_children => 10,
    max_requests_per_child => 200,
);
$milter->set_dispatcher($dispatcher);

log_line("listening on $listen (reply-identity on_db_error=$ON_DB_ERROR)");
$milter->main();
