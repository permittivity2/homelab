# Managed by homelab-postfix -- do not hand-edit, edit debconf answers
# instead (dpkg-reconfigure homelab-postfix). Backs Postfix's own
# check_recipient_access restriction against a live lookup in
# homelab-domain-admin's domainadmin.recipient_access table, so
# `homelab-cli dns recipient-access block/allow/remove` (admin) and
# `homelab-cli mail block/unblock` (self-service, one of the caller's
# own addresses only) both take effect on this host without ever
# touching Postfix config directly. See ../../domain-admin/README.md
# and this package's own README.md "Recipient allow/block" section.
#
# `reason` is appended to `action` (when present) so a rejected sender
# actually sees why, e.g. "REJECT no longer accepting mail here" -- the
# column was always stored but never reached Postfix until now.
hosts = __DB_HOST__:__DB_PORT__
user = __DB_USER__
password = __DB_PASS__
dbname = __DB_NAME__
query = SELECT action || CASE WHEN reason IS NOT NULL AND reason <> '' THEN ' ' || reason ELSE '' END FROM domainadmin.recipient_access WHERE recipient='%s'
