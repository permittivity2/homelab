#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/postfix/pgsql-virtual-mailbox.cf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or
# re-bootstrap a role that's already live and in use.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-postfix/hostname || true
db_input high homelab-postfix/mail_domain || true
db_input high homelab-postfix/db_host || true
db_input high homelab-postfix/pgbouncer_host || true
db_go

exit 0
