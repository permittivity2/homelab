#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/postfix/pgsql-virtual-mailbox.cf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or
# re-bootstrap a role that's already live and in use.
if [ -f "$MARKER" ]; then
    # Still offer the DKIM opt-in on every configure, INCLUDING a
    # routine upgrade -- at medium priority (below the usual "high"
    # threshold) so it never interrupts an unattended/scripted install
    # and defaults to false there, but IS shown on an explicit
    # `dpkg-reconfigure homelab-postfix` regardless of threshold. This
    # is deliberately separate from the bootstrap questions above: an
    # already-working host must see zero milter-config change on a
    # routine upgrade unless an administrator explicitly asks for it.
    db_input medium homelab-postfix/enable_dkim || true
    db_go
    exit 0
fi

db_input high homelab-postfix/hostname || true
db_input high homelab-postfix/mail_domain || true
db_input high homelab-postfix/db_host || true
db_input high homelab-postfix/pgbouncer_host || true
db_input medium homelab-postfix/enable_dkim || true
db_go

exit 0
