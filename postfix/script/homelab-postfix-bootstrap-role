#!/usr/bin/perl
# Bespoke, one-off cross-schema grant: creates homelab_postfix_runtime and
# gives it a narrow, COLUMN-scoped SELECT on api.users -- never
# generalized into homelab-bootstrap-app-role because that script only
# ever mints a role pair scoped to a schema IT creates for ONE feature.
# This one deliberately reaches into ANOTHER feature's existing table
# instead (api.users, owned by homelab-api's own migrate role), which is
# exactly the kind of grant CLAUDE.md calls out as a rare, deliberate,
# one-time admin action -- same precedent as homelab-dovecot's own
# bootstrap script (see dovecot/script/homelab-dovecot-bootstrap-role),
# which this is modeled on almost exactly.
#
# Narrower than dovecot's grant: postfix only needs to know whether an
# address is a valid, active recipient (see config/pgsql-virtual-mailbox.cf.template's
# `SELECT 1 FROM api.users WHERE email='%s' AND active = true`) -- it
# never needs password_hash at all, since SASL auth is delegated
# entirely to Dovecot's own passdb over a unix socket (smtpd_sasl_type =
# dovecot), not queried directly by Postfix. One password, one grant
# each, two completely separate least-privilege credentials.
#
# No migrate role here, unlike the generic script -- homelab-postfix
# owns no schema/tables of its own (recipient validation is a read-only
# view into homelab-api's table; mail queueing/spool state lives in
# Postfix's own on-disk queue, not Postgres), so there is nothing for a
# migrate role to hold DDL rights over.
#
# Never uses a stored/network admin Postgres credential -- always
# OS-level peer auth (`sudo -u postgres`), local or over SSH, same
# three-tier fallback as homelab-bootstrap-app-role / homelab-dovecot's
# own bootstrap script:
#
#   1. Local (--db-host is this host): `sudo -u postgres psql` directly.
#   2. Remote + SSH trust works: identical bootstrap, piped through
#      `ssh <db-host> sudo -u postgres psql ...` instead of a local shell.
#   3. Neither works: the SQL is written to a file and printed for a
#      human to run by hand on the DB host; this script then polls for
#      the resulting role's secret once told to.
#
# Before granting anything, confirms api.users actually exists yet (via
# the same working psql channel used for everything else) and dies with
# a clear message if not -- a real ordering dependency between two
# otherwise-independent packages (homelab-api must be installed/migrated
# on the DB host first) that must fail loudly, not silently grant onto a
# table that doesn't exist yet.
#
# On success, prints (to stdout only -- all logging goes to stderr,
# since callers capture stdout to parse these lines):
#   ROLE=homelab_postfix_runtime
#   PASSWORD=<password>
#   SCRAM_SECRET=<secret>
# The SCRAM secret comes straight from pg_authid.rolpassword (already in
# ready-to-use scram-secret format) -- callers registering this role
# with homelab-pgbouncer's userlist.txt use it directly, no separate
# hashing step.
#
# Usage: homelab-postfix-bootstrap-role --db-host HOST [--db homelab]

use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Path qw(make_path);
use IPC::Open2 qw(open2);

my $DB      = 'homelab';
my $DB_HOST = '';
my $ROLE    = 'homelab_postfix_runtime';

GetOptions(
    'db-host=s' => \$DB_HOST,
    'db=s'      => \$DB,
) or die usage();

die usage() unless $DB_HOST;

my @SSH_OPTS    = ('-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', '-o', 'StrictHostKeyChecking=accept-new');
my $PENDING_DIR = '/var/lib/homelab-database/pending';

sub usage {
    return "Usage: $0 --db-host HOST [--db homelab]\n";
}

sub log_msg  { print STDERR "[postfix-bootstrap-role] @_\n" }
sub warn_msg { print STDERR "[postfix-bootstrap-role] WARNING: @_\n" }
sub die_msg  { print STDERR "[postfix-bootstrap-role] ERROR: @_\n"; exit 1 }

sub random_password {
    # 24 bytes of real entropy, base64-encoded -- matches
    # homelab-bootstrap-app-role's own convention.
    open(my $fh, '<', '/dev/urandom') or die_msg("cannot open /dev/urandom: $!");
    read($fh, my $bytes, 24) == 24 or die_msg('short read from /dev/urandom');
    close($fh);
    require MIME::Base64;
    return MIME::Base64::encode_base64($bytes, '');
}

sub is_local_host {
    my ($host) = @_;
    return 1 if $host eq 'localhost' || $host eq '127.0.0.1' || $host eq '::1';
    chomp(my $hostname = `hostname`);
    return 1 if $host eq $hostname;
    chomp(my $fqdn = `hostname -f 2>/dev/null`);
    return 1 if $fqdn && $host eq $fqdn;
    return 0;
}

sub sql_escape {
    my ($s) = @_;
    $s =~ s/'/''/g;
    return $s;
}

sub build_sql {
    my (%opts) = @_;
    my $pw_esc   = sql_escape($opts{password});
    my $role_esc = sql_escape($ROLE);

    return <<SQL;
-- generated by homelab-postfix's homelab-postfix-bootstrap-role
DO \$\$
BEGIN
   IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$role_esc') THEN
      CREATE ROLE "$ROLE" WITH LOGIN PASSWORD '$pw_esc';
   ELSE
      ALTER ROLE "$ROLE" WITH LOGIN PASSWORD '$pw_esc';
   END IF;
END
\$\$;

-- Deliberately column-scoped and even narrower than homelab-dovecot's
-- grant: postfix never needs password_hash, only enough to answer
-- "is this a valid, active recipient" at RCPT TO time.
GRANT USAGE ON SCHEMA api TO "$ROLE";
GRANT SELECT (email, active) ON api.users TO "$ROLE";

-- Second cross-schema grant, same discipline: column-scoped, read-only,
-- reaching into homelab-domain-admin's schema instead of homelab-api's.
-- Backs the live virtual_mailbox_domains lookup (see
-- config/pgsql-virtual-domains.cf.template) -- postfix only needs to
-- know whether a domain is currently a valid, active mail domain, never
-- anything about DNS/DKIM state.
GRANT USAGE ON SCHEMA domainadmin TO "$ROLE";
GRANT SELECT (domain_name, mail_enabled, active) ON domainadmin.domains TO "$ROLE";
GRANT SELECT ON domainadmin.recipient_access TO "$ROLE";
SQL
}

# Runs $sql with @cmd's STDIN piped, discarding stdout (psql's own
# command-tag output) -- used for the DDL step. Returns true on success.
# List-form exec throughout: no shell ever interprets $sql or the
# password/secret it contains, only the fixed argv the caller controls.
sub run_sql_local_or_remote {
    my ($sql, @cmd) = @_;
    open(my $fh, '|-', @cmd) or die_msg("cannot exec @cmd: $!");
    print $fh $sql;
    close($fh);
    return $? == 0;
}

# Runs $sql on @cmd's STDIN (psql with no -c/-f, so it executes stdin as
# a script) and returns its stdout -- deliberately NOT passing SQL as a
# -c/-tAc command-line ARGUMENT. When @cmd starts with 'ssh', OpenSSH
# concatenates ALL of its own trailing arguments with plain spaces and
# hands the joined string to the REMOTE shell for parsing (see ssh(1))
# -- any quote characters in a SQL string passed as a separate argv
# element get reinterpreted (and mangled) by that remote shell before
# psql ever sees them. Piping via stdin sidesteps the remote shell's
# argument parsing entirely -- same fix already applied to
# homelab-dovecot-bootstrap-role and backported into
# homelab-bootstrap-app-role after being caught empirically there.
sub run_query_stdin_local_or_remote {
    my ($sql, @cmd) = @_;
    my ($out_fh, $in_fh);
    my $pid = open2($out_fh, $in_fh, @cmd);
    print $in_fh $sql;
    close($in_fh);
    my $out = do { local $/; <$out_fh> };
    close($out_fh);
    waitpid($pid, 0);
    return undef unless $? == 0;
    return $out;
}

# NULL (empty string) means the table doesn't exist yet. @cmd is the
# full psql invocation through -tA (no -c) -- local argv or an
# ssh-prefixed one; see run_query_stdin_local_or_remote for why the
# query itself is never part of that argv.
sub check_api_users_exists {
    my (@cmd) = @_;
    my $out = run_query_stdin_local_or_remote(q{SELECT to_regclass('api.users')}, @cmd);
    return defined $out && length $out;
}

# Same ordering-dependency check as check_api_users_exists, for the
# second cross-schema grant added above -- homelab-domain-admin must be
# installed/migrated (and its own schema created) before this script's
# grant onto domainadmin.domains can succeed.
sub check_domainadmin_domains_exists {
    my (@cmd) = @_;
    my $out = run_query_stdin_local_or_remote(q{SELECT to_regclass('domainadmin.domains')}, @cmd);
    return defined $out && length $out;
}

sub fetch_scram_secret {
    my (@cmd) = @_;
    my $query = sprintf(q{SELECT rolpassword FROM pg_authid WHERE rolname = '%s'}, sql_escape($ROLE));
    return run_query_stdin_local_or_remote($query, @cmd);
}

sub run_local {
    my (%opts) = @_;
    my @psql_prefix = ('sudo', '-u', 'postgres', 'psql');
    unless (check_api_users_exists(@psql_prefix, '-d', $DB, '-X', '-tA')) {
        die_msg("api.users does not exist on $DB_HOST yet -- install/migrate homelab-api there first");
    }
    unless (check_domainadmin_domains_exists(@psql_prefix, '-d', $DB, '-X', '-tA')) {
        die_msg("domainadmin.domains does not exist on $DB_HOST yet -- install/migrate homelab-domain-admin there first");
    }
    log_msg("bootstrapping '$ROLE' locally (db-host is this host)");
    run_sql_local_or_remote(build_sql(%opts), @psql_prefix, '-q', '-d', $DB, '-X', '-v', 'ON_ERROR_STOP=1')
        or return undef;
    return fetch_scram_secret(@psql_prefix, '-d', $DB, '-X', '-tA');
}

sub ssh_trust_works {
    system('ssh', @SSH_OPTS, $DB_HOST, 'true') == 0;
}

sub run_remote {
    my (%opts) = @_;
    my @remote_prefix = ('ssh', @SSH_OPTS, $DB_HOST);
    unless (check_api_users_exists(@remote_prefix, "sudo -u postgres psql -d $DB -X -tA")) {
        die_msg("api.users does not exist on $DB_HOST yet -- install/migrate homelab-api there first");
    }
    unless (check_domainadmin_domains_exists(@remote_prefix, "sudo -u postgres psql -d $DB -X -tA")) {
        die_msg("domainadmin.domains does not exist on $DB_HOST yet -- install/migrate homelab-domain-admin there first");
    }
    log_msg("bootstrapping '$ROLE' on $DB_HOST via SSH");
    run_sql_local_or_remote(
        build_sql(%opts), @remote_prefix,
        "sudo -u postgres psql -q -d $DB -X -v ON_ERROR_STOP=1",
    ) or return undef;
    return fetch_scram_secret(@remote_prefix, "sudo -u postgres psql -d $DB -X -tA");
}

sub run_manual {
    my (%opts) = @_;
    make_path($PENDING_DIR, { mode => 0700 });
    my $pending_file = "$PENDING_DIR/homelab-postfix-bootstrap.sql";
    open(my $fh, '>', $pending_file) or die_msg("cannot write $pending_file: $!");
    print $fh build_sql(%opts);
    close($fh);
    chmod(0600, $pending_file);

    warn_msg("cannot bootstrap '$ROLE' automatically (not local, and no SSH trust to $DB_HOST)");
    print STDERR <<MSG;

  On $DB_HOST, have an administrator run:
    sudo -u postgres psql -d $DB -v ON_ERROR_STOP=1 -f $pending_file
  (copy $pending_file to $DB_HOST first if it isn't already there)

  Note: if api.users or domainadmin.domains doesn't exist there yet
  (homelab-api or homelab-domain-admin not installed/migrated on that
  host), the GRANT statements in this file will fail with a clear
  Postgres error -- install/migrate both first, then re-run this script.

MSG

    while (1) {
        print STDERR "Press Enter once that's been run to fetch the role's secret (or 's' to skip): ";
        my $reply = <STDIN>;
        unless (defined $reply) {
            warn_msg('no input available; skipping');
            return undef;
        }
        chomp $reply;
        return undef if lc($reply) eq 's';

        if (is_local_host($DB_HOST)) {
            my $secret = fetch_scram_secret('sudo', '-u', 'postgres', 'psql', '-d', $DB, '-X', '-tA');
            return $secret if defined $secret && length $secret;
        }
        elsif (ssh_trust_works()) {
            my $secret = fetch_scram_secret('ssh', @SSH_OPTS, $DB_HOST, "sudo -u postgres psql -d $DB -X -tA");
            return $secret if defined $secret && length $secret;
        }
        else {
            warn_msg("still no SSH trust to $DB_HOST; run the command above, then retry from a host that does");
        }
    }
}

sub main {
    my %opts = (password => random_password());

    my $secret =
        is_local_host($DB_HOST) ? run_local(%opts)
      : ssh_trust_works()       ? run_remote(%opts)
      :                           run_manual(%opts);

    die_msg('bootstrap failed or was skipped') unless defined $secret && length $secret;

    print "ROLE=$ROLE\n";
    print "PASSWORD=$opts{password}\n";
    print "SCRAM_SECRET=$secret\n";
}

main();
