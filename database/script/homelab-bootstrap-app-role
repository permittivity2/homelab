#!/usr/bin/perl
# Creates a narrow, least-privilege PAIR of Postgres roles + a schema for
# one homelab-* feature, inside the shared `homelab` database
# homelab-database itself creates. See CLAUDE.md's split-role design:
#
#   <feature>_runtime — CRUD only (SELECT/INSERT/UPDATE/DELETE), no DDL.
#                        This is the only credential the long-running,
#                        network-facing service process ever holds.
#   <feature>_migrate — CRUD + DDL (CREATE/ALTER/DROP), same schema only.
#                        Used only transiently by postinst/upgrade via
#                        Homelab::Common::Migrate — never held by the
#                        running daemon.
#
# Never uses a stored/network admin Postgres credential — always OS-level
# peer auth (`sudo -u postgres`), local or over SSH:
#
#   1. Local (--db-host is this host): `sudo -u postgres psql` directly.
#   2. Remote + SSH trust works: identical bootstrap, piped through
#      `ssh <db-host> sudo -u postgres psql ...` instead of a local shell.
#   3. Neither works: the SQL is written to a file and printed for a
#      human to run by hand on the DB host; this script then polls for
#      the resulting roles' secrets once told to.
#
# On success, prints (to stdout only — all logging goes to stderr, since
# callers capture stdout to parse these lines):
#   RUNTIME_ROLE=<role>
#   RUNTIME_PASSWORD=<password>
#   RUNTIME_SCRAM_SECRET=<secret>
#   MIGRATE_ROLE=<role>
#   MIGRATE_PASSWORD=<password>
#   MIGRATE_SCRAM_SECRET=<secret>
# SCRAM secrets come straight from pg_authid.rolpassword (already in
# ready-to-use scram-secret format) — callers registering the runtime
# role with homelab-pgbouncer's userlist.txt use it directly, no
# separate hashing step. The migrate role is deliberately never
# registered with pgbouncer — see CLAUDE.md.
#
# Usage: homelab-bootstrap-app-role --feature NAME --schema NAME \
#            --db-host HOST [--db homelab]
#
# Unlike the single-role predecessor this replaces, this script does NOT
# take a --schema-sql file — it only ensures the schema exists and grants
# both roles on it. Table/column DDL is the feature's own job afterward,
# via Homelab::Common::Migrate using the migrate role returned here.

use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Path qw(make_path);

my $DB      = 'homelab';
my $FEATURE = '';
my $SCHEMA  = '';
my $DB_HOST = '';

GetOptions(
    'feature=s' => \$FEATURE,
    'schema=s'  => \$SCHEMA,
    'db-host=s' => \$DB_HOST,
    'db=s'      => \$DB,
) or die usage();

die usage() unless $FEATURE && $SCHEMA && $DB_HOST;

my $RUNTIME_ROLE = "${FEATURE}_runtime";
my $MIGRATE_ROLE = "${FEATURE}_migrate";
my @SSH_OPTS      = ('-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', '-o', 'StrictHostKeyChecking=accept-new');
my $PENDING_DIR   = '/var/lib/homelab-database/pending';

sub usage {
    return "Usage: $0 --feature NAME --schema NAME --db-host HOST [--db homelab]\n";
}

sub log_msg  { print STDERR "[bootstrap-app-role] @_\n" }
sub warn_msg { print STDERR "[bootstrap-app-role] WARNING: @_\n" }
sub die_msg  { print STDERR "[bootstrap-app-role] ERROR: @_\n"; exit 1 }

sub random_password {
    # 24 bytes of real entropy, base64-encoded — matches the old script's
    # `openssl rand -base64 24`, just without shelling out for it.
    open(my $fh, '<', '/dev/urandom') or die_msg("cannot open /dev/urandom: $!");
    read($fh, my $bytes, 24) == 24 or die_msg('short read from /dev/urandom');
    close($fh);
    require MIME::Base64;
    return MIME::Base64::encode_base64($bytes, '');
}

sub is_local_host {
    my ($host) = @_;
    return 1 if $host eq 'localhost' || $host eq '127.0.0.1' || $host eq '::1';
    chomp(my $hostname = `hostname`);
    return 1 if $host eq $hostname;
    chomp(my $fqdn = `hostname -f 2>/dev/null`);
    return 1 if $fqdn && $host eq $fqdn;
    return 0;
}

sub sql_escape {
    my ($s) = @_;
    $s =~ s/'/''/g;
    return $s;
}

# Builds the full bootstrap SQL for BOTH roles. Schema creation is
# idempotent (IF NOT EXISTS) — this script owns creating the schema
# itself now (unlike its single-role predecessor), since it no longer
# takes caller-supplied schema SQL; table/column DDL is the feature's
# own job afterward via Homelab::Common::Migrate.
sub build_sql {
    my (%opts) = @_;
    my $runtime_pw_esc = sql_escape($opts{runtime_password});
    my $migrate_pw_esc = sql_escape($opts{migrate_password});
    my $runtime_esc    = sql_escape($RUNTIME_ROLE);
    my $migrate_esc    = sql_escape($MIGRATE_ROLE);

    return <<SQL;
-- generated by homelab-database's homelab-bootstrap-app-role for
-- feature: $FEATURE (schema: $SCHEMA)
CREATE SCHEMA IF NOT EXISTS "$SCHEMA";

DO \$\$
BEGIN
   IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$runtime_esc') THEN
      CREATE ROLE "$RUNTIME_ROLE" WITH LOGIN PASSWORD '$runtime_pw_esc';
   ELSE
      ALTER ROLE "$RUNTIME_ROLE" WITH LOGIN PASSWORD '$runtime_pw_esc';
   END IF;
END
\$\$;

DO \$\$
BEGIN
   IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '$migrate_esc') THEN
      CREATE ROLE "$MIGRATE_ROLE" WITH LOGIN PASSWORD '$migrate_pw_esc';
   ELSE
      ALTER ROLE "$MIGRATE_ROLE" WITH LOGIN PASSWORD '$migrate_pw_esc';
   END IF;
END
\$\$;

-- Migrate role: CRUD + DDL, same schema only. Used transiently by
-- postinst/upgrade, never held by the running daemon. Granted first
-- since it's the role that will actually create every table/sequence
-- in this schema going forward (via Homelab::Common::Migrate) — the
-- runtime role's default-privileges clause below depends on that.
GRANT USAGE, CREATE ON SCHEMA "$SCHEMA" TO "$MIGRATE_ROLE";
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA "$SCHEMA" TO "$MIGRATE_ROLE";
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA "$SCHEMA" TO "$MIGRATE_ROLE";

-- Runtime role: CRUD only, no DDL. This is the only credential the
-- long-running service process ever holds.
--
-- Critical detail: `ALTER DEFAULT PRIVILEGES` with no `FOR ROLE` only
-- covers objects created later BY THE ROLE RUNNING THIS STATEMENT
-- (postgres, here) — NOT objects created by any other role. Since every
-- table/sequence in this schema is actually created by
-- "$MIGRATE_ROLE" (via migrations), the clause MUST say `FOR ROLE
-- "$MIGRATE_ROLE"` explicitly, or the runtime role silently gets no
-- access to anything created after bootstrap. Caught by testing this
-- against a real Postgres, not by inspection — see t/bootstrap-role.t.
GRANT USAGE ON SCHEMA "$SCHEMA" TO "$RUNTIME_ROLE";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA "$SCHEMA" TO "$RUNTIME_ROLE";
GRANT USAGE ON ALL SEQUENCES IN SCHEMA "$SCHEMA" TO "$RUNTIME_ROLE";
ALTER DEFAULT PRIVILEGES FOR ROLE "$MIGRATE_ROLE" IN SCHEMA "$SCHEMA" GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO "$RUNTIME_ROLE";
ALTER DEFAULT PRIVILEGES FOR ROLE "$MIGRATE_ROLE" IN SCHEMA "$SCHEMA" GRANT USAGE ON SEQUENCES TO "$RUNTIME_ROLE";
SQL
}

# Runs @cmd with $sql fed on stdin, discarding stdout (psql's own
# command-tag output) — used for the DDL step. Returns true on success.
# List-form exec throughout: no shell ever interprets $sql or the SQL
# content, only the fixed argv the caller controls.
sub run_sql_local_or_remote {
    my ($sql, @cmd) = @_;
    open(my $fh, '|-', @cmd) or die_msg("cannot exec @cmd: $!");
    print $fh $sql;
    close($fh);
    return $? == 0;
}

# Runs a -tAc query via @cmd, returns its single-line stdout (chomped).
sub run_query_local_or_remote {
    my (@cmd) = @_;
    open(my $fh, '-|', @cmd) or die_msg("cannot exec @cmd: $!");
    my $out = do { local $/; <$fh> };
    close($fh);
    return undef unless $? == 0;
    chomp($out) if defined $out;
    return $out;
}

# Fetches both roles' SCRAM secrets in one query, keyed by role name —
# one round-trip instead of two, and avoids any ambiguity about which
# secret belongs to which role.
sub fetch_scram_secrets {
    my (@psql_prefix) = @_;
    my $query = sprintf(
        q{SELECT rolname || '|' || rolpassword FROM pg_authid WHERE rolname IN ('%s', '%s')},
        sql_escape($RUNTIME_ROLE), sql_escape($MIGRATE_ROLE),
    );
    open(my $fh, '-|', @psql_prefix, '-d', $DB, '-X', '-tAc', $query)
        or die_msg("cannot exec @psql_prefix: $!");
    my %secrets;
    while (my $line = <$fh>) {
        chomp $line;
        next unless $line;
        my ($role, $secret) = split /\|/, $line, 2;
        $secrets{$role} = $secret;
    }
    close($fh);
    return %secrets;
}

sub run_local {
    my (%opts) = @_;
    log_msg("bootstrapping '$RUNTIME_ROLE'/'$MIGRATE_ROLE' locally (db-host is this host)");
    my @psql_prefix = ('sudo', '-u', 'postgres', 'psql');
    run_sql_local_or_remote(build_sql(%opts), @psql_prefix, '-q', '-d', $DB, '-X', '-v', 'ON_ERROR_STOP=1')
        or return ();
    return fetch_scram_secrets(@psql_prefix);
}

sub ssh_trust_works {
    system('ssh', @SSH_OPTS, $DB_HOST, 'true') == 0;
}

sub run_remote {
    my (%opts) = @_;
    log_msg("bootstrapping '$RUNTIME_ROLE'/'$MIGRATE_ROLE' on $DB_HOST via SSH");
    my @remote_prefix = ('ssh', @SSH_OPTS, $DB_HOST);
    run_sql_local_or_remote(
        build_sql(%opts), @remote_prefix,
        "sudo -u postgres psql -q -d $DB -X -v ON_ERROR_STOP=1",
    ) or return ();
    return fetch_scram_secrets(@remote_prefix, 'sudo -u postgres psql');
}

sub run_manual {
    my (%opts) = @_;
    make_path($PENDING_DIR, { mode => 0700 });
    my $pending_file = "$PENDING_DIR/${FEATURE}-bootstrap.sql";
    open(my $fh, '>', $pending_file) or die_msg("cannot write $pending_file: $!");
    print $fh build_sql(%opts);
    close($fh);
    chmod(0600, $pending_file);

    warn_msg("cannot bootstrap '$FEATURE' automatically (not local, and no SSH trust to $DB_HOST)");
    print STDERR <<MSG;

  On $DB_HOST, have an administrator run:
    sudo -u postgres psql -d $DB -v ON_ERROR_STOP=1 -f $pending_file
  (copy $pending_file to $DB_HOST first if it isn't already there)

MSG

    while (1) {
        print STDERR "Press Enter once that's been run to fetch both roles' secrets (or 's' to skip): ";
        my $reply = <STDIN>;
        unless (defined $reply) {
            warn_msg('no input available; skipping');
            return ();
        }
        chomp $reply;
        return () if lc($reply) eq 's';

        if (is_local_host($DB_HOST)) {
            my %secrets = fetch_scram_secrets('sudo', '-u', 'postgres', 'psql');
            return %secrets if %secrets;
        }
        elsif (ssh_trust_works()) {
            my %secrets = fetch_scram_secrets('ssh', @SSH_OPTS, $DB_HOST, 'sudo -u postgres psql');
            return %secrets if %secrets;
        }
        else {
            warn_msg("still no SSH trust to $DB_HOST; run the command above, then retry from a host that does");
        }
    }
}

sub main {
    my %opts = (
        runtime_password => random_password(),
        migrate_password => random_password(),
    );

    my %secrets =
        is_local_host($DB_HOST) ? run_local(%opts)
      : ssh_trust_works()       ? run_remote(%opts)
      :                           run_manual(%opts);

    die_msg('bootstrap failed or was skipped') unless %secrets;
    die_msg('bootstrap reported success but no SCRAM secret was returned for the runtime role')
        unless $secrets{$RUNTIME_ROLE};
    die_msg('bootstrap reported success but no SCRAM secret was returned for the migrate role')
        unless $secrets{$MIGRATE_ROLE};

    print "RUNTIME_ROLE=$RUNTIME_ROLE\n";
    print "RUNTIME_PASSWORD=$opts{runtime_password}\n";
    print "RUNTIME_SCRAM_SECRET=$secrets{$RUNTIME_ROLE}\n";
    print "MIGRATE_ROLE=$MIGRATE_ROLE\n";
    print "MIGRATE_PASSWORD=$opts{migrate_password}\n";
    print "MIGRATE_SCRAM_SECRET=$secrets{$MIGRATE_ROLE}\n";
}

main();
