#!/bin/sh
set -e

. /usr/share/debconf/confmodule

PGVER="$(pg_lsclusters -h 2>/dev/null | awk '{print $1}' | sort -V | tail -1)"
MARKER="/etc/postgresql/$PGVER/main/conf.d/90-homelab-database.conf"

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -n "$PGVER" ] && [ -f "$MARKER" ]; then
    exit 0
fi

# Pre-seed adopt_existing based on whether a cluster with real data already
# exists (postgresql's own postinst creates one on first install of that
# package, so "existing" here specifically means "not created by us").
if [ -n "$PGVER" ] && systemctl is-active --quiet "postgresql@$PGVER-main" 2>/dev/null; then
    db_set homelab-database/adopt_existing true || true
fi

db_input high homelab-database/listen_addresses || true
db_input high homelab-database/allowed_networks || true
db_input high homelab-database/adopt_existing || true
db_input medium homelab-database/enable_backups || true
db_go

exit 0
