#!/bin/sh
set -e

. /usr/share/debconf/confmodule

H="$(hostname -s)"

# Preseed this-node + a single-node member default (this host) so an unattended
# install still produces a valid one-member cluster.
db_get homelab-database-ha/this_node 2>/dev/null || true
[ -n "$RET" ] || db_set homelab-database-ha/this_node "$H" || true

db_get homelab-database-ha/members 2>/dev/null || true
if [ -z "$RET" ]; then
    IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
    [ -n "$IP" ] && db_set homelab-database-ha/members "$H:$IP" || true
fi

db_input high homelab-database-ha/members || true
db_input high homelab-database-ha/this_node || true
db_input high homelab-database-ha/vip || true
db_input high homelab-database-ha/app_network || true
db_input high homelab-database-ha/replication_password || true
db_input medium homelab-database-ha/wipe_existing || true
db_go

exit 0
