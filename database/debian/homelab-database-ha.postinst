#!/bin/sh
set -e

. /usr/share/debconf/confmodule

case "$1" in
    configure)
        # Capture $2 (the previously-configured version) NOW: the `set --`
        # further down replaces the positional parameters with the bootstrap's
        # own argv, after which "$2" is --members' VALUE, not the old version.
        # Reading it late made the upgrade check always true, which skipped the
        # bootstrap even on a first install -- caught on a real upgrade, where
        # the skip message printed the members string where a version belonged.
        OLDVER="$2"

        db_get homelab-database-ha/members || true;              MEMBERS="$RET"
        db_get homelab-database-ha/this_node || true;            THIS="${RET:-$(hostname -s)}"
        db_get homelab-database-ha/vip || true;                  VIP="$RET"
        db_get homelab-database-ha/app_network || true;          APPNET="${RET:-10.50.0.0/22}"
        db_get homelab-database-ha/replication_password || true; REPLPW="$RET"
        db_get homelab-database-ha/wipe_existing || true;        WIPE="${RET:-false}"
        db_stop

        if [ -z "$MEMBERS" ]; then
            IP="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)"
            MEMBERS="$THIS:$IP"
        fi

        # Replication password must be identical on every member. Auto-generate
        # only for a genuine single-node cluster; for multi-node, require it
        # (an auto-generated per-node value would never match).
        NMEM=$(printf '%s' "$MEMBERS" | tr ',' '\n' | grep -c .)
        if [ -z "$REPLPW" ]; then
            if [ "$NMEM" -le 1 ]; then
                REPLPW="$(openssl rand -hex 16)"
                echo "  generated a replication password (single-node cluster)."
            else
                echo "  WARNING: no replication password set for a $NMEM-node cluster."
                echo "           Set the SAME value on every member and re-run:"
                echo "           sudo dpkg-reconfigure homelab-database-ha"
                exit 0
            fi
        fi

        set -- --members "$MEMBERS" --this-node "$THIS" \
               --replication-password "$REPLPW" --app-network "$APPNET" --yes
        [ -n "$VIP" ] && set -- "$@" --vip "$VIP"
        [ "$WIPE" = "true" ] && set -- "$@" --wipe-existing-cluster

        # $2 is the previously-configured version: non-empty means this is an
        # UPGRADE, not a first install, so the member is already bootstrapped
        # and re-running the bootstrap can only do harm -- it wipes etcd's DCS
        # state, and with wipe_existing=true drops the live data directory.
        # Found 2026-10-28: all three production database nodes still had
        # wipe_existing=true left over from their greenfield install, so a
        # routine `apt upgrade` here would have destroyed the cluster.
        if [ -n "$OLDVER" ]; then
            echo "homelab-database-ha: upgrade from $OLDVER -- not re-running the HA bootstrap."
            echo "  (an already-bootstrapped member needs none; run"
            echo "   'dpkg-reconfigure homelab-database-ha' deliberately if you must)"
            db_stop 2>/dev/null || true
            exit 0
        fi

        echo "homelab-database-ha: bootstrapping HA member '$THIS' ($NMEM-node cluster)..."
        if homelab-database-ha-bootstrap "$@"; then
            echo "homelab-database-ha configured."
            echo "  check the cluster: patronictl -c /etc/patroni/config.yml list"
            [ "$NMEM" -gt 1 ] && echo "  run this package's install on the OTHER members too (same --members)."
        else
            echo "  WARNING: HA bootstrap failed -- see output above, then"
            echo "           'sudo dpkg-reconfigure homelab-database-ha' to retry."
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
