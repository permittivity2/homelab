#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Nothing to compile

override_dh_auto_test:
	# No package-build-time tests

override_dh_install:
	dh_install
	install -D -m 644 conf.d/90-homelab-database.conf.template \
		debian/homelab-database/usr/share/homelab-database/conf.d/90-homelab-database.conf.template
	install -D -m 755 scripts/backup.sh \
		debian/homelab-database/usr/share/homelab-database/scripts/backup.sh
	install -D -m 644 backup-paths.txt \
		debian/homelab-database/usr/share/homelab-database/backup-paths.txt
	install -D -m 755 backup-hook.sh \
		debian/homelab-database/usr/share/homelab-database/backup-hook.sh
	install -D -m 644 services/postgresql.yml \
		debian/homelab-database/usr/share/homelab-database/services/postgresql.yml
	# HA (Patroni + etcd + keepalived VIP) templates + bootstrap tool
	install -D -m 644 ha/etcd.env.tmpl \
		debian/homelab-database/usr/share/homelab-database/ha/etcd.env.tmpl
	install -D -m 644 ha/patroni.yml.tmpl \
		debian/homelab-database/usr/share/homelab-database/ha/patroni.yml.tmpl
	install -D -m 644 ha/keepalived.conf.tmpl \
		debian/homelab-database/usr/share/homelab-database/ha/keepalived.conf.tmpl
	install -D -m 755 scripts/ha-bootstrap.sh \
		debian/homelab-database/usr/sbin/homelab-database-ha-bootstrap
