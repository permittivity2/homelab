[Unit]
Description=Homelab Account Management
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_ACCOUNTMANAGE_CONFIG=/etc/homelab/accountmanage/config.yml"
Environment="HOMELAB_ACCOUNTMANAGE_HOME=/usr/share/homelab-accountmanage"
# Browser traffic arrives via homelab-webproxy (myaccount.<domain>), so
# trust X-Forwarded-* to build correct absolute OAuth redirect URLs.
Environment="MOJO_REVERSE_PROXY=1"
# Post-cutover #41 J: the hypnotoad pid file lives in /run, emptied at every
# boot (homelab-common >= 0.1.38 points pid_file at RUNTIME_DIRECTORY), so a
# pid left on disk by a power cut can never make hypnotoad signal a stranger.
# The ExecStartPre clears the old on-disk pid for one release.
RuntimeDirectory=homelab-accountmanage
RuntimeDirectoryMode=0750
ExecStartPre=-/bin/rm -f /var/lib/homelab/accountmanage-hypnotoad.pid
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-accountmanage
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-accountmanage
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-accountmanage

[Install]
WantedBy=multi-user.target
