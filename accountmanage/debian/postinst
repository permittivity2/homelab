#!/bin/sh
set -e

CONFIG_DIR=/etc/homelab/accountmanage
CONFIG_FILE="$CONFIG_DIR/config.yml"
SHARE_DIR=/usr/share/homelab-accountmanage

case "$1" in
    configure)
        echo "homelab-accountmanage post-installation setup..."

        adduser --system --group --home /var/lib/homelab --no-create-home \
            --shell /usr/sbin/nologin homelab 2>/dev/null || true
        mkdir -p /var/lib/homelab "$CONFIG_DIR"
        chown homelab:homelab /var/lib/homelab

        # Static service manifest for homelab-agent to report (always refresh).
        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services
        cp "$SHARE_DIR/services/accountmanage.yml" "/etc/homelab/services/accountmanage.yml"

        # First install: seed config from the example for in-place editing
        # (this app has no debconf prompts, and owns no database). It will
        # not start cleanly until session.secret + sso.client_secret are set.
        if [ ! -f "$CONFIG_FILE" ]; then
            cp "$SHARE_DIR/config/accountmanage.example.yml" "$CONFIG_FILE"
            echo "  wrote $CONFIG_FILE from the example -- EDIT IT before the service will run:"
            echo "  set session.secret, sso.client_secret (from homelab-sso), homelab_api.base_url,"
            echo "  the sso.* URLs, and registry.host."
        fi
        chown root:homelab "$CONFIG_FILE" 2>/dev/null || true
        chmod 640 "$CONFIG_FILE" 2>/dev/null || true

        # --- device setup (the "Mail setup" panel + its QR code).
        #
        # Runs on EVERY configure, because the branch above only seeds a
        # config on a FIRST install -- an upgrade from a version
        # predating this feature would otherwise have no device_setup
        # block and the QR code would silently never appear.
        #
        # NOTE no secret is generated here. This app runs as a three-node
        # pool and a per-host key would verify on about one request in
        # three; blank means "use session.secret", which is already
        # identical across the pool because signed cookies require it.
        if ! grep -q '^device_setup:' "$CONFIG_FILE"; then
            echo "  adding device_setup block to $CONFIG_FILE (upgrade from a pre-device-setup version)"
            cat >> "$CONFIG_FILE" <<'EOF'

# Device setup -- added automatically on upgrade. imap_host/smtp_host are
# left blank to derive mail.<domain> / smtp.<domain> from each signed-in
# user's own address; set them only if those are not the names the edge
# certificate carries. token_secret blank = use session.secret (see the
# shipped example config for why that is the pool-safe default).
device_setup:
  imap_host:
  imap_port: 993
  smtp_host:
  smtp_port: 587
  service_label: MailMasker
  organization: Silver Linings, LLC
  webmail_url: https://mail.mailmasker.org/
  qr_ttl_minutes: 15
  token_secret:
EOF
        fi

        # --- Apple configuration-profile signing.
        #
        # Appended on every configure for the same reason as the block
        # above: the seed branch never rewrites an existing config, so an
        # upgrade would otherwise carry no profile_signing block at all
        # and profiles would stay unsigned forever with nothing to
        # explain why.
        #
        # Pointed at the fleet's certificate issuer, because signing
        # locally would mean a publicly-trusted private key on THIS host
        # -- and the ready-made way to get one also brings the fleet-wide
        # key-encryption key. Unreachable issuer = unsigned profile, which
        # is exactly what this fleet served before signing existed.
        if ! grep -q '^profile_signing:' "$CONFIG_FILE"; then
            echo "  adding profile_signing block to $CONFIG_FILE"
            cat >> "$CONFIG_FILE" <<'EOF'

# Apple configuration-profile signing -- added automatically. The issuer
# (homelab-cert-server's homelab-cert-sign unit, :2516) signs; no private
# key is held here. Blank url = serve profiles unsigned, which installs
# fine and just shows red "Unverified" on the iOS install screen.
profile_signing:
  url: http://10.50.2.190:2516
  lineage: myaccount.mailmasker.org
  timeout_seconds: 5
  cache_seconds: 900
  retry_seconds: 60
EOF
        fi

        # --- mailer identity for the site_admin "resend the welcome
        # email" action. A commented stub only: it needs the password of
        # a real service mailbox, which a maintainer script has no way to
        # know and no business inventing. Until it is filled in, that one
        # admin action reports itself unavailable and nothing else is
        # affected -- this app sends no other mail.
        if ! grep -q '^#\{0,1\}mailer:' "$CONFIG_FILE"; then
            echo "  adding a commented mailer: stub to $CONFIG_FILE"
            echo "  -> fill it in to enable Administration > Users > Resend the welcome email"
            cat >> "$CONFIG_FILE" <<'EOF'

# Mailer identity -- UNCOMMENT AND FILL IN to enable the site_admin
# "resend the welcome email" action. Reuse the same service mailbox
# homelab-invite sends as (its password is in that package's config on
# the invite nodes); the resent message is the same message, so it should
# come from the same place.
#
# smtp_host MUST be a submission endpoint that accepts a PLAIN
# connection -- the edge HAProxy submission frontend, NOT a postfix
# backend and NOT loopback. The backends require a PROXY-protocol header
# a direct client cannot send, and pointing at one fails every send with
# "421 4.3.0 Server local error" while the UI shows nothing at all.
#mailer:
#  email: invites@mailmasker.org
#  smtp_host: 10.50.2.140
#  smtp_port: 587
#  smtp_password: PUT_THE_REAL_PASSWORD_HERE
EOF
        fi

        # Metrics tab egress: open this host -> the fleet Prometheus
        # (prometheus.base_url in the config) so the metrics.view-gated
        # Metrics tab can query it. The base output chain has a drop policy.
        # Applied live via an incremental add rule (idempotent by comment)
        # that never flushes the ruleset -- bad-ips' runtime set survives.
        NFT_METRICS=/etc/nftables.d/10-homelab-accountmanage-metrics.nft
        : > "$NFT_METRICS.tmp"
        for section in prometheus grafana; do
            URL="$(grep -A3 "^$section:" "$CONFIG_FILE" 2>/dev/null | sed -n 's/.*base_url:[[:space:]]*//p' | sed 's/#.*//; s/[[:space:]]//g' | head -1)"
            HP="$(printf '%s' "$URL" | sed 's#^https\{0,1\}://##; s#/.*##')"
            HOST="${HP%%:*}"; PORT="${HP##*:}"
            [ -n "$HOST" ] && [ -n "$PORT" ] && [ "$HOST" != "$PORT" ] || continue
            printf 'add rule inet filter output ip daddr %s tcp dport %s accept comment "homelab-accountmanage-metrics"\n' \
                "$HOST" "$PORT" >> "$NFT_METRICS.tmp"
        done
        if [ -s "$NFT_METRICS.tmp" ] && [ -d /etc/nftables.d ]; then
            sort -u "$NFT_METRICS.tmp" > "$NFT_METRICS"; rm -f "$NFT_METRICS.tmp"
            # Apply live (delete-by-comment, no ruleset flush -- bad-ips-safe).
            if nft list chain inet filter output >/dev/null 2>&1; then
                for hh in $(nft -a list chain inet filter output 2>/dev/null \
                        | awk '/homelab-accountmanage-metrics/ {print $NF}'); do
                    nft delete rule inet filter output handle "$hh" 2>/dev/null || true
                done
                nft -f "$NFT_METRICS" 2>/dev/null \
                    || echo "  WARNING: could not apply $NFT_METRICS live -- effective on next nftables reload/boot."
            fi
            echo "  metrics egress opened (Prometheus + Grafana):"; sed 's/^/    /' "$NFT_METRICS"
        else
            rm -f "$NFT_METRICS" "$NFT_METRICS.tmp" 2>/dev/null || true
        fi

        systemctl daemon-reload 2>/dev/null || true
        systemctl enable homelab-accountmanage 2>/dev/null || true
        systemctl restart homelab-accountmanage 2>/dev/null || true
        ;;
esac

#DEBHELPER#
exit 0
