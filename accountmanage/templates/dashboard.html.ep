% layout 'default';
% title 'My Account';

<% my $fmt_bytes = sub {
     my $n = shift;
     return '0 B' unless $n;
     my @u = ('B', 'KB', 'MB', 'GB', 'TB');
     my $i = 0;
     while ($n >= 1024 && $i < $#u) { $n /= 1024; $i++; }
     return sprintf('%.1f %s', $n, $u[$i]);
}; %>

<h1 class="page">Account</h1>

<div class="layout">
  <nav class="sidenav">
    <button type="button" data-section="profile"><span class="ico">👤</span><span class="label">Profile</span></button>
    <button type="button" data-section="storage"><span class="ico">💾</span><span class="label">Storage</span></button>
    <button type="button" data-section="security"><span class="ico">🔑</span><span class="label">Security</span></button>
    <button type="button" data-section="sessions"><span class="ico">🖥️</span><span class="label">Sessions</span></button>
    <button type="button" data-section="mailself"><span class="ico">📨</span><span class="label">Mail</span></button>
% if ($is_admin) {
    <button type="button" data-section="admin"><span class="ico">🛠️</span><span class="label">Administration</span></button>
% }
  </nav>

  <div class="main-pane">

    <section class="section" id="profile">
      <div class="card">
        <h2>Profile</h2>
        <dl class="kv">
          <dt>Email</dt><dd><%= $email %></dd>
          <dt>Account created</dt><dd><%= $summary->{created_at} // '—' %></dd>
          <dt>Recovery email</dt><dd><%= $summary->{recovery_email} // '(none set)' %></dd>
          <dt>Status</dt><dd><%= $summary->{active} ? 'Active' : 'Suspended' %></dd>
          <dt>Access</dt>
          <dd>
% if (@$roles) {
%   for my $r (@$roles) {
            <span class="badge <%= $r eq 'site_admin' ? 'admin' : '' %>"><%= $r %></span>
%   }
% } else {
            <span class="muted">user</span>
% }
          </dd>
        </dl>
      </div>
    </section>

    <section class="section" id="storage">
      <div class="card">
        <h2>Storage usage</h2>
% if (defined $drive_usage && defined $drive_usage->{used_bytes}) {
%   my $used = $drive_usage->{used_bytes};
%   my $lim  = $drive_usage->{limit_bytes} // 0;
%   my $pct  = ($lim > 0) ? int($used / $lim * 100) : 0;
%   $pct = 100 if $pct > 100;
%   my $cls = $pct >= 100 ? 'full' : ($pct >= 90 ? 'warn' : '');
        <div class="usage-line"><span>Drive</span><span class="amt"><%= $fmt_bytes->($used) %> of <%= $fmt_bytes->($lim) %> (<%= $pct %>%)</span></div>
        <div class="quota-bar"><span class="<%= $cls %>" style="width: <%= $pct %>%"></span></div>
% } else {
        <div class="usage-line"><span>Drive</span><span class="amt muted">unavailable</span></div>
% }
% if (defined $mail_usage && defined $mail_usage->{used_bytes}) {
%   my $used = $mail_usage->{used_bytes};
%   my $lim  = $mail_usage->{limit_bytes} // 0;
%   my $pct  = ($lim > 0) ? int($used / $lim * 100) : 0;
%   $pct = 100 if $pct > 100;
%   my $cls = $pct >= 100 ? 'full' : ($pct >= 90 ? 'warn' : '');
        <div class="usage-line" style="margin-top:0.9rem;"><span>Mail</span><span class="amt"><%= $fmt_bytes->($used) %> of <%= $fmt_bytes->($lim) %> (<%= $pct %>%)</span></div>
        <div class="quota-bar"><span class="<%= $cls %>" style="width: <%= $pct %>%"></span></div>
% } else {
        <div class="usage-line" style="margin-top:0.9rem;"><span>Mail</span><span class="amt muted">unavailable</span></div>
% }
        <p class="muted" style="font-size:0.82rem;margin:0.6rem 0 0;">Every account starts with a 1&nbsp;TB drive limit and a 1&nbsp;TB mail limit.</p>
      </div>
    </section>

    <section class="section" id="security">
      <div class="card">
        <h2>Change password</h2>
% if (my $ok = flash 'pw_ok') {
        <div class="flash ok"><%= $ok %></div>
% }
% if (my $err = flash 'pw_error') {
        <div class="flash err"><%= $err %></div>
% }
        <form method="post" action="/security/password" autocomplete="off">
          <div class="field"><label>Current password</label><input type="password" name="current_password" required></div>
          <div class="field"><label>New password (min 8 characters)</label><input type="password" name="new_password" minlength="8" required></div>
          <div class="field"><label>Confirm new password</label><input type="password" name="confirm_password" minlength="8" required></div>
          <button type="submit" class="btn btn-primary">Change password</button>
        </form>
        <p class="muted" style="font-size:0.82rem;margin:0.9rem 0 0;">Changing your password signs out your other sessions.</p>
      </div>

      <div class="card">
        <h2>Recovery email <span class="hint">used for password reset by email</span></h2>
% if (my $ok = flash 're_ok') {
        <div class="flash ok"><%= $ok %></div>
% }
% if (my $err = flash 're_error') {
        <div class="flash err"><%= $err %></div>
% }
        <form method="post" action="/security/recovery-email">
          <div class="field">
            <label>Recovery email address (leave blank to remove)</label>
            <input type="email" name="recovery_email" value="<%= $summary->{recovery_email} // '' %>" placeholder="you@example.com">
          </div>
          <button type="submit" class="btn btn-primary">Save</button>
        </form>
% if (!$summary->{recovery_email}) {
        <p class="muted" style="font-size:0.82rem;margin:0.9rem 0 0;">Reset-by-email needs a recovery address on file — set one here first, then you can use the link below.</p>
% }
        <div class="btn-row"><a class="btn btn-secondary" href="<%= $sso_forgot_url %>">Reset password by email</a></div>
      </div>
    </section>

    <section class="section" id="sessions">
      <div class="card">
        <h2>Active sessions <span class="hint">devices &amp; tokens signed in to your account</span></h2>
% if (@$sessions) {
        <table class="sessions">
          <thead><tr><th>Device</th><th>IP address</th><th>Signed in</th><th></th></tr></thead>
          <tbody>
% for my $s (@$sessions) {
            <tr>
              <td>
                <%= $s->{user_agent} // 'unknown' %>
% if ($s->{current}) {
                <span class="this-session">· this session</span>
% }
              </td>
              <td><%= $s->{ip_address} // '—' %></td>
              <td><%= $s->{first_seen_at} // '—' %></td>
              <td>
% unless ($s->{current}) {
                <form method="post" action="/sessions/<%= $s->{jti} %>/revoke"><button type="submit" class="btn btn-danger">Revoke</button></form>
% }
              </td>
            </tr>
% }
          </tbody>
        </table>
        <div class="btn-row">
          <form method="post" action="/sessions/revoke-others"><button type="submit" class="btn btn-secondary">Sign out everywhere else</button></form>
        </div>
% } else {
        <p class="muted">No active sessions to show.</p>
% }
      </div>
    </section>

    <section class="section" id="mailself">
      <div class="card">
        <h2>Send-as addresses <span class="hint">what you're allowed to send mail as</span></h2>
        <div id="ms-sendas"><p class="muted">Loading…</p></div>
      </div>
      <div class="card">
        <h2>Click-to-block links <span class="hint">a "block this sender" link added to your inbound mail</span></h2>
        <div id="ms-blocklink"><p class="muted">Loading…</p></div>
      </div>
      <div class="card">
        <h2>Blocked addresses <span class="hint">reject all mail to one of your own addresses</span></h2>
        <div id="ms-blocked"><p class="muted">Loading…</p></div>
        <div class="field" style="margin-top:0.8rem;"><label>Block mail to one of your addresses</label><input type="email" id="ms-block-input" autocomplete="off" placeholder="you@your-domain"></div>
        <button type="button" class="btn btn-danger" id="ms-block-btn">Block address</button>
        <div id="ms-block-status" class="usage-note"></div>
      </div>
    </section>

% if ($is_admin) {
    <section class="section" id="admin">
      <p class="muted" style="margin:0 0 0.8rem;">Administrator tools <span class="badge admin">site_admin</span></p>
% if (my $ok = flash 'admin_ok') {
      <div class="flash ok"><%= $ok %></div>
% }
% if (my $err = flash 'admin_err') {
      <div class="flash err"><%= $err %></div>
% }

      <div class="admin-tabs">
        <button type="button" data-atab="users">👥 Users</button>
        <button type="button" data-atab="quotas">📊 Quotas</button>
        <button type="button" data-atab="mail">✉️ Mail domains</button>
        <button type="button" data-atab="dovecot">📬 Dovecot</button>
      </div>

      <div class="admin-panel" data-apanel="users">
        <div class="card">
          <h2>Users <span class="hint">search to suspend / re-enable login</span></h2>
          <div class="field">
            <label>Find a user</label>
            <input type="text" id="user-mgmt-search" data-me="<%= $email %>" autocomplete="off" placeholder="type at least 3 characters of an email…">
          </div>
          <div id="user-mgmt-results"><p class="muted">Type at least 3 characters to find a user.</p></div>
        </div>
      </div>

      <div class="admin-panel" data-apanel="quotas">
        <div class="card">
          <h2>Drive quota</h2>
          <form method="post" action="/admin/drive-quota">
            <div class="field"><label>User email</label><input class="user-fill" type="email" name="user_email" required autocomplete="off" placeholder="type at least 3 characters…"></div>
            <div class="usage-note" data-usage-type="drive"></div>
            <div class="field"><label>Limit in GB (blank = reset to the 1 TB default)</label><input type="number" name="limit_gb" min="0" placeholder="1024"></div>
            <button type="submit" class="btn btn-primary">Set drive quota</button>
            <p class="muted" style="font-size:0.8rem;margin:0.5rem 0 0;">Setting a limit below what the user is already storing blocks new uploads but keeps existing files — they free space by deleting.</p>
          </form>
        </div>

        <div class="card">
          <h2>Mail quota <span class="hint">dovecot mailbox limit</span></h2>
          <form method="post" action="/admin/mail-quota">
            <div class="field"><label>User email</label><input class="user-fill" type="email" name="user_email" required autocomplete="off" placeholder="type at least 3 characters…"></div>
            <div class="usage-note" data-usage-type="mail"></div>
            <div class="field"><label>Limit in GB (blank = reset to the 1 TB default)</label><input type="number" name="limit_gb" min="0" placeholder="1024"></div>
            <button type="submit" class="btn btn-primary">Set mail quota</button>
            <p class="muted" style="font-size:0.8rem;margin:0.5rem 0 0;">Setting a limit below current mailbox usage bounces new incoming mail to senders and blocks saving to Sent until they delete mail down — existing mail is kept.</p>
          </form>
        </div>
      </div>

      <div class="admin-panel" data-apanel="mail">
        <div class="card" id="catchall-card">
          <h2>Domain catch-all routing <span class="hint">send all of a domain's mail to one mailbox</span></h2>
          <div id="ca-status" class="usage-note"></div>
          <div class="field">
            <label>Domain</label>
            <input type="text" id="ca-domain" autocomplete="off" placeholder="type at least 2 characters, e.g. test.forge.name">
          </div>
          <div id="ca-current" class="usage-note"></div>
          <div class="field">
            <label>Deliver all its mail to (a real mailbox)</label>
            <input type="email" id="ca-dest" class="user-fill" autocomplete="off" placeholder="user@base-domain">
          </div>
          <div class="btn-row">
            <button type="button" class="btn btn-primary" id="ca-set">Set catch-all</button>
            <button type="button" class="btn btn-danger" id="ca-clear">Clear</button>
          </div>
          <p class="muted" style="font-size:0.8rem;margin:0.7rem 0 0;">Point the domain's MX at this mail server first. Setting a catch-all makes the domain receive mail and forwards every address at it to the chosen mailbox.</p>

          <div style="margin-top:1.1rem;border-top:1px solid var(--border);padding-top:0.9rem;">
            <button type="button" class="btn btn-secondary" id="ca-viewall">View all domains…</button>
            <div id="ca-bulk" style="display:none;margin-top:0.8rem;">
              <p class="muted" style="font-size:0.82rem;margin:0 0 0.5rem;">Select domains, then set them all to one destination.</p>
              <div id="ca-list" style="max-height:260px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:0.4rem 0.6rem;"></div>
              <div class="field" style="margin-top:0.7rem;">
                <label>Deliver selected domains' mail to</label>
                <input type="email" id="ca-bulk-dest" class="user-fill" autocomplete="off" placeholder="user@base-domain">
              </div>
              <button type="button" class="btn btn-primary" id="ca-bulk-set">Set catch-all for selected</button>
              <div id="ca-bulk-status" class="usage-note"></div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2>Block-link footer <span class="hint">appended "manage blocked addresses" link</span></h2>
          <form method="post" action="/admin/block-link">
            <div class="field"><label>Domain</label>
              <select name="domain" required>
% for my $d (@$admin_domains) {
                <option value="<%= $d->{domain_name} %>"><%= $d->{domain_name} %></option>
% }
              </select>
            </div>
            <div class="field"><label><input type="checkbox" name="enabled" value="1"> Enabled for this domain</label></div>
            <div class="field"><label>Append mode</label>
              <select name="mode">
                <option value="header">header only (no body append)</option>
                <option value="body">append to body</option>
                <option value="both" selected>header + body append</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Save block-link settings</button>
          </form>
        </div>

        <div class="card">
          <h2>Domain email authentication</h2>
% unless (@$admin_domains) {
          <p class="muted">No managed domains yet.</p>
% }
% if (@$admin_domains) {
          <div style="margin-bottom:1rem;">
            <form method="post" action="/admin/dkim" onsubmit="return confirm('Rotate + activate a new DKIM key for this domain?')">
              <div class="field"><label>DKIM — rotate &amp; activate a fresh key</label>
                <select name="domain">
% for my $d (@$admin_domains) {
                  <option value="<%= $d->{domain_name} %>"><%= $d->{domain_name} %></option>
% }
                </select>
              </div>
              <button type="submit" class="btn btn-primary">Force-update DKIM</button>
            </form>
          </div>
          <div style="margin-bottom:1rem;">
            <form method="post" action="/admin/spf">
              <div class="field"><label>SPF domain</label>
                <select name="domain">
% for my $d (@$admin_domains) {
                  <option value="<%= $d->{domain_name} %>"><%= $d->{domain_name} %></option>
% }
                </select>
              </div>
              <div class="field"><label>SPF value</label><input type="text" name="value" value="v=spf1 mx ~all"></div>
              <button type="submit" class="btn btn-primary">Set SPF</button>
              <p class="muted" style="font-size:0.8rem;margin:0.4rem 0 0;">Replaces the domain's apex TXT records.</p>
            </form>
          </div>
          <div>
            <form method="post" action="/admin/dmarc">
              <div class="field"><label>DMARC domain</label>
                <select name="domain">
% for my $d (@$admin_domains) {
                  <option value="<%= $d->{domain_name} %>"><%= $d->{domain_name} %></option>
% }
                </select>
              </div>
              <div class="field"><label>Policy</label>
                <select name="policy"><option value="none">none (monitor)</option><option value="quarantine">quarantine</option><option value="reject">reject</option></select>
              </div>
              <div class="field"><label>Aggregate-report email (rua, optional)</label><input type="email" name="rua" placeholder="dmarc@test.mailmasker.org"></div>
              <button type="submit" class="btn btn-primary">Set DMARC</button>
            </form>
          </div>
% }
        </div>
      </div>

      <div class="admin-panel" data-apanel="dovecot">
        <div class="card">
          <h2>Mailbox server pool <span class="hint">active / passive</span></h2>
          <div id="dovecot-status"><p class="muted">Loading…</p></div>
        </div>
      </div>
    </section>
% }

  </div>
</div>
