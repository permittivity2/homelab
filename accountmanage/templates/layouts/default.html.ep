<!DOCTYPE html>
<html lang="en">
<head>
%# Shared chrome: theme.css + fonts + favicon all come from
%# static.mailmasker.org via homelab-webtheme, so a restyle needs no rebuild
%# of this package. Only the APP-SPECIFIC rules below live here.
%= include 'homelab/head'
  <title><%= title %></title>
  <style>
    /* --- Bridge from this app's original token names onto the shared theme's.
       Only the four that are still REFERENCED are kept: the inline JS below
       writes style="color:var(--danger)" into markup it builds, and the panel
       partials use --muted/--ok/--text, so renaming them would mean editing
       ~60 call sites in JavaScript strings for no gain. Everything else now
       uses the theme's own token names directly. --border is deliberately NOT
       redefined here -- the theme already owns it. --- */
    :root {
      --text:   var(--text-primary);
      --muted:  var(--text-muted);
      --danger: var(--error);
      --ok:     var(--success);
      /* Wider than the theme's 1200px default: the Administration pane holds
         fleet tables and the topology map, which were on a 1400px main before
         and get cramped at 1200. Set as a token so .container just follows. */
      --container-max-width: 1400px;
    }

    h1.page { font-size: var(--app-xl); font-weight: var(--weight-light); letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-6); }

    /* Two-pane settings layout: options on the left, selected section on
       the right. Sections are all present; JS toggles which is visible.
       A grid rather than the theme's flex .app__body because the sidenav here
       scrolls with the page content, sticky under the top bar. */
    .layout { display: grid; grid-template-columns: var(--sidenav-width) 1fr; gap: var(--space-6); align-items: start; }
    .sidenav { position: sticky; top: calc(var(--topbar-height) + var(--space-4)); border-right: none; padding: 0; }
    /* The nav buttons carry no class of their own (JS toggles .active on
       them), so the theme's .sidenav__item look is applied by element here
       instead of rewriting the markup + the toggle. */
    .sidenav button {
      display: flex; align-items: center; gap: var(--space-3);
      width: 100%; text-align: left;
      background: none; border: none; cursor: pointer;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      color: var(--text-secondary); font: inherit; font-size: var(--app-base);
      transition: background var(--transition-fast), color var(--transition-fast);
    }
    .sidenav button:hover { background: var(--surface-hover); color: var(--text-primary); }
    .sidenav button.active { background: var(--surface); color: var(--silver-bright); font-weight: var(--weight-medium); box-shadow: inset 2px 0 0 var(--silver-medium); }
    .sidenav .ico { width: 1.2rem; text-align: center; }
    .section { display: none; }
    .section.active { display: block; }

    /* Administration sub-tabs (Users / Quotas / Mail domains) inside the
       single Administration pane -- keeps the left nav short and groups the
       admin cards. A small JS block (below) toggles .admin-panel like the
       left nav toggles .section; the flash lives ABOVE the tabs so a
       post-action redirect's success/error message is visible on any tab. */
    .admin-tabs { display: flex; gap: var(--space-1); border-bottom: 1px solid var(--border); margin: 0.2rem 0 var(--space-6); flex-wrap: wrap; }
    .admin-tabs button { background: none; border: none; border-bottom: 2px solid transparent; padding: var(--space-2) var(--space-3); font: inherit; font-size: var(--app-base); color: var(--muted); cursor: pointer; }
    .admin-tabs button:hover { color: var(--text); }
    .admin-tabs button.active { color: var(--silver-bright); border-bottom-color: var(--silver-medium); font-weight: var(--weight-medium); }
    .admin-panel { display: none; }
    .admin-panel.active { display: block; }

    /* Typeahead (live user search): a results dropdown anchored under an
       input. Used for the quota-form email fields and inline in the Users
       card so we never render thousands of rows up front. */
    .ta-results {
      position: absolute; left: 0; right: 0; top: calc(100% + 2px); z-index: var(--z-dropdown);
      background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-md);
      box-shadow: var(--shadow-md); max-height: 260px; overflow-y: auto; display: none;
    }
    .ta-results.open { display: block; }
    .ta-item { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding: var(--space-2) var(--space-3); cursor: pointer; font-size: var(--app-base); }
    .ta-item:hover { background: var(--surface-hover); }
    .ta-item .st { font-size: var(--app-xs); color: var(--muted); flex: none; }
    .ta-empty { padding: var(--space-2) var(--space-3); color: var(--muted); font-size: var(--app-sm); }

    /* Live "currently using X of Y" preview under a quota form's user field,
       with a below-usage warning when the entered limit is under it. */
    .usage-note { font-size: var(--app-sm); color: var(--muted); margin: -0.4rem 0 var(--space-3); min-height: 1em; }
    .usage-note .warn-below { color: var(--danger); font-weight: var(--weight-semibold); }

    /* Forms. The theme ships .form-input etc., but this app's markup uses
       bare <input> inside .field -- styled by element so the markup stays. */
    .field { margin-bottom: var(--space-3); }
    .field label { display: block; font-size: var(--app-sm); color: var(--muted); margin-bottom: var(--space-1); }
    .field input, .field select {
      width: 100%; max-width: 360px; padding: var(--space-2) var(--space-3);
      background: var(--black-secondary); color: var(--text-primary);
      border: 1px solid var(--border-strong); border-radius: var(--radius-md); font: inherit;
    }
    .field input:hover, .field select:hover { border-color: var(--silver-dim); }

    /* Flashes. The theme's .banner is the same idea; these keep the app's
       own .flash.ok / .flash.err contract that the Perl side emits. */
    .flash { padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); font-size: var(--app-base); margin-bottom: var(--space-4); border: 1px solid; }
    .flash.ok  { background: rgba(92,158,124,0.10); color: var(--success); border-color: rgba(92,158,124,0.35); }
    .flash.err { background: rgba(216,92,92,0.10);  color: var(--error);   border-color: rgba(216,92,92,0.35); }

    /* Quota bar */
    .quota-bar { height: 8px; background: var(--surface-hover); border-radius: var(--radius-pill); overflow: hidden; margin: var(--space-1) 0 0.2rem; }
    .quota-bar > span { display: block; height: 100%; background: var(--silver-medium); border-radius: var(--radius-pill); }
    .quota-bar > span.warn { background: var(--warning); }
    .quota-bar > span.full { background: var(--danger); }

    /* Fleet topology (admin) */
    .topo-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
    .topo-controls { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
    .topo-controls select { font: inherit; font-size: var(--app-sm); padding: 0.3rem 0.4rem; border-radius: var(--radius-md); border: 1px solid var(--border-strong); background: var(--black-secondary); color: var(--text); }
    .topo-legend { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--app-xs); color: var(--muted); }
    .topo-legend .lg { width: 12px; height: 12px; border-radius: var(--radius-sm); display: inline-block; }
    .lg-up { background: var(--success); } .lg-down { background: var(--error); } .lg-unmon { background: var(--text-muted); }
    .topo-body { display: flex; gap: var(--space-3); margin-top: var(--space-3); }
    /* Inline: grow to the viewport height (was a fixed 580px) so the map has
       real room on a desktop; Fullscreen (below) gives it the whole screen. */
    #cy { flex: 1; height: calc(100vh - 320px); min-height: 540px; min-width: 0; background: var(--black-secondary); border: 1px solid var(--border); border-radius: var(--radius-md); }
    .topo-detail { width: 300px; flex: none; border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3); overflow: auto; height: calc(100vh - 320px); min-height: 540px; background: var(--surface); font-size: var(--app-base); }
    .topo-desktop-note { font-size: var(--app-xs); color: var(--muted); display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap; }
    /* Fullscreen: the topology takes over the whole viewport for the biggest,
       most-readable canvas -- it escapes the admin pane's max-width. */
    .topo-card.topo-full { position: fixed; inset: 0; z-index: var(--z-overlay); margin: 0; max-width: none; width: auto; border-radius: 0; overflow: auto; box-shadow: none; background: var(--black-primary); }
    .topo-card.topo-full #cy, .topo-card.topo-full .topo-detail { height: calc(100vh - 118px); min-height: 0; }
    .topo-card.topo-full .topo-detail { width: 340px; }
    /* A network graph is unusable on a phone -- show a clear "use a desktop"
       message instead of a cramped, unreadable canvas. */
    .topo-mobile-only { display: none; }
    .topo-detail h3 { margin: 0 0 0.2rem; font-size: var(--app-md); word-break: break-all; }
    .topo-detail dl { margin: var(--space-1) 0 0; }
    .topo-detail dt { color: var(--muted); font-size: var(--app-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); margin-top: var(--space-2); }
    .topo-detail dd { margin: 0.1rem 0 0; word-break: break-all; }
    .topo-detail .soon { margin-top: var(--space-3); padding: var(--space-2); border: 1px dashed var(--border-strong); border-radius: var(--radius-md); color: var(--muted); font-size: var(--app-sm); }
    .topo-detail .st-pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: var(--radius-pill); font-size: var(--app-xs); font-weight: var(--weight-semibold); }
    .st-pill.up { background: rgba(92,158,124,0.15); color: var(--success); }
    .st-pill.down { background: rgba(216,92,92,0.15); color: var(--error); }
    .st-pill.unmon { background: var(--surface-hover); color: var(--text-muted); }
    #topo-tooltip { position: fixed; z-index: var(--z-toast); pointer-events: none; background: var(--black-tertiary); border: 1px solid var(--border-strong); color: var(--silver-bright); padding: var(--space-2); border-radius: var(--radius-md); font-size: var(--app-xs); max-width: 300px; box-shadow: var(--shadow-md); display: none; line-height: 1.35; }

    /* Services (admin) -- a service -> hosts accordion over the fleet data */
    .svc-toolbar { display: flex; gap: var(--space-2); align-items: center; margin: 0.2rem 0 var(--space-4); flex-wrap: wrap; }
    .svc-toolbar input { flex: 1; min-width: 180px; font: inherit; font-size: var(--app-base); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--border-strong); background: var(--black-secondary); color: var(--text); }
    .svc-item { border: 1px solid var(--border); border-radius: var(--radius-md); margin-bottom: var(--space-2); overflow: hidden; }
    .svc-row { width: 100%; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); background: var(--surface); border: none; cursor: pointer; font: inherit; color: var(--text); text-align: left; }
    .svc-row:hover { background: var(--surface-hover); }
    .svc-row .svc-caret { color: var(--muted); transition: transform var(--transition-fast); flex: none; }
    .svc-row[aria-expanded="true"] .svc-caret { transform: rotate(90deg); }
    .svc-name { font-weight: var(--weight-medium); }
    .svc-badge { font-size: var(--app-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: #fff; padding: 0.05rem 0.4rem; border-radius: var(--radius-pill); flex: none; }
    .svc-meta { margin-left: auto; color: var(--muted); font-size: var(--app-sm); white-space: nowrap; }
    .svc-meta .dn { color: var(--danger); font-weight: var(--weight-semibold); }
    .svc-detail { border-top: 1px solid var(--border); padding: var(--space-1) var(--space-3) var(--space-3); background: var(--black-secondary); }
    .svc-detail table { width: 100%; }
    .svc-hdot.up { color: var(--ok); } .svc-hdot.down { color: var(--danger); } .svc-hdot.unmon { color: var(--muted); }

    /* Cards. The theme ships .panel; this app's markup is .card throughout,
       so .card is given the same look rather than rewriting every template. */
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-4) var(--space-6); margin-bottom: var(--space-4); }
    .card h2 { font-size: var(--app-md); font-weight: var(--weight-medium); margin: 0 0 var(--space-4); display: flex; align-items: center; gap: var(--space-2); }
    .card h2 .hint { font-weight: var(--weight-normal); color: var(--muted); font-size: var(--app-sm); }
    /* The theme's .kv is a narrower two-column grid; this app's labels are
       longer ("Storage used by Drive"), hence the wider first column. */
    .kv { display: grid; grid-template-columns: 170px 1fr; gap: var(--space-1) var(--space-4); font-size: var(--app-base); }
    .kv dt { color: var(--muted); }
    .kv dd { margin: 0; }
    .badge { display: inline-block; padding: 0.1rem 0.5rem; border-radius: var(--radius-pill); font-size: var(--app-xs); background: var(--surface-hover); color: var(--text-secondary); margin-right: 0.3rem; }
    .badge.admin { background: rgba(74,93,110,0.35); color: var(--silver-bright); }
    /* A capped, scrolling container for a list that has no natural upper
       bound. The blocked-addresses list is the case this was added for: it
       renders one row per address with nothing limiting it, so past roughly
       10-15 entries it pushed the rest of the Mail pane off the screen.
       max-height is in rem so it tracks the user's font size rather than
       assuming a viewport. */
    /* --- Mail setup panel. The button column and the QR column sit side
       by side on a desktop and stack on a phone, where the QR is useless
       anyway (you are already holding the device). --- */
    .devices-grid { display: flex; gap: var(--space-6); align-items: flex-start; flex-wrap: wrap; }
    .devices-grid > div:first-child { flex: 1 1 18rem; min-width: 16rem; }
    .qr-box { flex: 0 0 auto; text-align: center; }
    /* White plate behind the code: this page is dark, and a QR code without
       a light quiet zone around it scans badly or not at all. */
    .qr-box img { background: #fff; padding: var(--space-3); border-radius: var(--radius-md); display: block; }
    @media (max-width: 42rem) { .qr-box { display: none; } }

    table.settings-table { width: 100%; border-collapse: collapse; }
    table.settings-table th, table.settings-table td {
      text-align: left; padding: var(--space-2) var(--space-2);
      font-size: var(--app-sm); border-bottom: 1px solid var(--border); vertical-align: top;
    }
    table.settings-table th { color: var(--muted); font-weight: var(--weight-normal); white-space: nowrap; }
    table.settings-table td { color: var(--text); font-family: var(--font-mono, monospace); word-break: break-all; }
    table.settings-table td .note { font-family: inherit; color: var(--muted); display: block; font-size: var(--app-xs); }

    .scrollbox { max-height: 22rem; overflow-y: auto; overscroll-behavior: contain; }
    /* Only frame it once there are real rows. `:not(:empty)` does NOT work
       here -- the container always holds something (the loading text, or the
       "none blocked" message), so it would always draw and an empty list
       would look like a sunken panel. The JS sets .has-rows instead. */
    .scrollbox.has-rows { border: 1px solid var(--border); border-radius: var(--radius-md); }
    .scrollbox > p.muted { margin: 0; padding: var(--space-3); }
    /* The table inside loses its own border: the scrollbox owns the frame
       now, and two nested borders read as a mistake. */
    .scrollbox table.sessions { border: 0; }
    /* Keep the header row visible while the body scrolls. */
    /* Sortable headers. Only the ones that sort get the pointer -- the
       empty action column must not look clickable. */
    .scrollbox table.sessions thead th.ms-sort { cursor: pointer; user-select: none; }
    .scrollbox table.sessions thead th.ms-sort:hover { color: var(--silver-bright); }
    .scrollbox table.sessions thead th {
      position: sticky; top: 0; z-index: 1;
      background: var(--black-secondary);
    }

    table.sessions { width: 100%; border-collapse: collapse; font-size: var(--app-base); }
    table.sessions th, table.sessions td { text-align: left; padding: var(--space-2) var(--space-3); border-bottom: 1px solid var(--border); vertical-align: top; }
    table.sessions th { color: var(--muted); font-weight: var(--weight-semibold); }
    table.sessions tr:last-child td { border-bottom: none; }
    .this-session { color: var(--ok); font-weight: var(--weight-semibold); font-size: var(--app-xs); }
    .btn-row { margin-top: var(--space-3); display: flex; gap: var(--space-2); flex-wrap: wrap; }
    /* .btn / .btn-primary / .btn-danger come from the theme. .btn-secondary is
       this app's name for the theme's plain .btn, kept so existing markup and
       the inline JS that emits it keep working. */
    .btn-secondary { background: var(--surface-hover); color: var(--text-primary); border: 1px solid var(--border-strong); }
    .btn-secondary:hover { background: var(--black-tertiary); border-color: var(--silver-dim); }
    .muted { color: var(--muted); }
    .soon { color: var(--muted); font-size: var(--app-sm); font-style: italic; }

    /* Metrics (role-gated panel) */
    .metrics-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: var(--space-2); margin: 0.3rem 0 var(--space-4); }
    .mcard { background: var(--black-secondary); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3); text-align: center; }
    .mcard .mval { font-size: var(--app-xl); font-weight: var(--weight-light); line-height: 1.1; font-variant-numeric: tabular-nums; }
    .mcard .mlabel { font-size: var(--app-xs); color: var(--muted); margin-top: 0.2rem; text-transform: uppercase; letter-spacing: var(--tracking-wide); }
    .mcard.ok-v .mval { color: var(--success); }
    .mcard.warn .mval { color: var(--warning); }
    .mcard.crit .mval { color: var(--error); }
    .metrics-down { background: rgba(216,92,92,0.10); border: 1px solid rgba(216,92,92,0.35); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-3); font-size: var(--app-sm); }
    .metrics-hosts-wrap { overflow-x: auto; }
    .metrics-hosts { width: 100%; border-collapse: collapse; font-size: var(--app-sm); }
    .metrics-hosts th, .metrics-hosts td { text-align: left; padding: 0.3rem var(--space-2); border-bottom: 1px solid var(--border); white-space: nowrap; }
    .metrics-hosts th:not(:first-child), .metrics-hosts td:not(:first-child) { text-align: right; font-variant-numeric: tabular-nums; }
    .metrics-hosts td.warm { color: var(--warning); }
    .metrics-hosts td.hot { color: var(--error); font-weight: var(--weight-semibold); }
    /* DMARC review tables. Numeric columns are opted in with .num rather
       than "every column but the first" like .metrics-hosts, because these
       tables lead with two text columns (source IP + domain). */
    .dmarc-table { width: 100%; border-collapse: collapse; font-size: var(--app-sm); }
    .dmarc-table th, .dmarc-table td { text-align: left; padding: 0.3rem var(--space-2); border-bottom: 1px solid var(--border); white-space: nowrap; }
    .dmarc-table th.num, .dmarc-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .dmarc-table td.bad { color: var(--error); font-weight: var(--weight-semibold); }
    .dmarc-table td.ok { color: var(--ok); }
    .dmarc-table td.mono { font-family: var(--font-mono, monospace); }
    .dmarc-status { margin: 0 0 var(--space-3); font-size: var(--app-sm); }
    .dmarc-status.stale { color: var(--warning); }
    .dmarc-status.never { color: var(--error); }
    .dmarc-inline { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--app-sm); color: var(--muted); margin-bottom: var(--space-2); }
    .metrics-grafana { margin-top: var(--space-6); }
    .metrics-grafana-head { display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-1); }
    .metrics-grafana-head .hint { color: var(--muted); font-size: var(--app-xs); }
    .metrics-grafana-head a { margin-left: auto; font-size: var(--app-sm); }
    .grafana-frame { width: 100%; height: 420px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--black-secondary); }

    @media (max-width: 900px) {
      /* Desktop/laptop-only feature: hide the interactive graph + its
         controls on small screens and show the guidance message instead. */
      .topo-body, .topo-controls { display: none; }
      .topo-mobile-only { display: block; text-align: center; padding: var(--space-6) var(--space-4); border: 1px dashed var(--border-strong); border-radius: var(--radius-md); color: var(--muted); margin-top: var(--space-3); background: var(--surface); }
      .topo-mobile-only .big { font-size: 2rem; line-height: 1; margin: 0 0 var(--space-2); }
      .topo-mobile-only strong { color: var(--text); }
    }
    @media (max-width: 720px) {
      .layout { grid-template-columns: 1fr; gap: var(--space-3); }
      .sidenav { position: static; flex-direction: row; overflow-x: auto; gap: 0.3rem; padding-bottom: var(--space-1); border-bottom: 1px solid var(--border); }
      .sidenav button { white-space: nowrap; }
      .sidenav .label { font-size: var(--app-sm); }
      .btn { min-height: 40px; display: inline-flex; align-items: center; }
    }
  </style>
</head>
<body class="app">
%= include 'homelab/header'
  <main class="app__main">
    <div class="container"><%= content %></div>
  </main>
%= include 'homelab/footer'
  <script>
    /* NOTE: the account-dropdown handler that used to live here is GONE on
       purpose -- shell.js from static.mailmasker.org now drives the shared
       header's [data-menu] button (outside-click, Esc, aria-expanded). */

    // Left-nav section switching: nav buttons carry data-section; show the
    // matching .section and hide the rest. Honors a #hash on load (so a
    // post-action redirect to /#security lands on the right pane) and
    // updates the hash as you click.
    (function () {
      var navBtns = Array.prototype.slice.call(document.querySelectorAll('.sidenav button[data-section]'));
      var sections = Array.prototype.slice.call(document.querySelectorAll('.section'));
      if (!navBtns.length) return;
      function show(id) {
        var found = false;
        sections.forEach(function (s) { var on = s.id === id; s.classList.toggle('active', on); if (on) found = true; });
        navBtns.forEach(function (b) { b.classList.toggle('active', b.dataset.section === id); });
        return found;
      }
      navBtns.forEach(function (b) {
        b.addEventListener('click', function () { show(b.dataset.section); if (history.replaceState) history.replaceState(null, '', '#' + b.dataset.section); });
      });
      // Hash may carry a sub-tab as "#admin:quotas" -- the part before ':'
      // selects the left-nav section; the inner-tab block below reads the
      // part after ':'.
      var initial = (location.hash || '').replace(/^#/, '').split(':')[0];
      if (!initial || !show(initial)) show(navBtns[0].dataset.section);
    })();

    // Administration sub-tabs: toggle .admin-panel[data-apanel] from
    // .admin-tabs button[data-atab], honoring a "#admin:<tab>" hash so a
    // post-action redirect lands on the right tab. Self-contained (the
    // left-nav IIFE above only knows about .section), so it's inert when
    // the Administration pane isn't rendered (non-admin users).
    (function () {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.admin-tabs button[data-atab]'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('.admin-panel[data-apanel]'));
      if (!tabs.length) return;
      function show(tab) {
        var ok = false;
        panels.forEach(function (p) { var on = p.dataset.apanel === tab; p.classList.toggle('active', on); if (on) ok = true; });
        tabs.forEach(function (b) { b.classList.toggle('active', b.dataset.atab === tab); });
        return ok;
      }
      tabs.forEach(function (b) {
        b.addEventListener('click', function () { show(b.dataset.atab); if (history.replaceState) history.replaceState(null, '', '#admin:' + b.dataset.atab); });
      });
      var sub = ((location.hash || '').replace(/^#/, '').split(':')[1]) || '';
      if (!sub || !show(sub)) show(tabs[0].dataset.atab);
    })();

    // --- Live user search (admin) ------------------------------------
    // Shared helpers: debounce + HTML-escape + a fetch to the BFF's
    // /admin/users/search proxy (site_admin gated server-side; returns
    // [{id,email,active,roles}] for >=3-char queries, capped).
    function hlEsc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function hlDebounce(fn, ms) { var t; return function () { var a = arguments, self = this; clearTimeout(t); t = setTimeout(function () { fn.apply(self, a); }, ms); }; }
    function hlFetchUsers(q) {
      if (!q || q.length < 3) return Promise.resolve([]);
      return fetch('/admin/users/search?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : []; })
        .catch(function () { return []; });
    }

    // (a) Quota-form email typeahead: any input.user-fill gets a dropdown
    // of matching users; picking one fills the input's value.
    (function () {
      Array.prototype.forEach.call(document.querySelectorAll('input.user-fill'), function (input) {
        input.parentNode.style.position = 'relative';
        var box = document.createElement('div'); box.className = 'ta-results';
        input.parentNode.appendChild(box);
        function close() { box.classList.remove('open'); box.innerHTML = ''; }
        input.addEventListener('input', hlDebounce(function () {
          var q = input.value.trim();
          if (q.length < 3) { close(); return; }
          hlFetchUsers(q).then(function (users) {
            box.innerHTML = '';
            if (!users.length) { box.innerHTML = '<div class="ta-empty">No matching users</div>'; box.classList.add('open'); return; }
            users.forEach(function (u) {
              var it = document.createElement('div'); it.className = 'ta-item';
              it.innerHTML = '<span>' + hlEsc(u.email) + '</span><span class="st">' + (u.active ? '' : 'suspended') + '</span>';
              it.addEventListener('mousedown', function (e) { e.preventDefault(); input.value = u.email; close(); input.dispatchEvent(new Event('change')); });
              box.appendChild(it);
            });
            box.classList.add('open');
          });
        }, 200));
        input.addEventListener('blur', function () { setTimeout(close, 150); });
      });
    })();

    // (a2) Live usage preview + below-limit warning on quota forms. Any
    // [data-usage-type] element inside a quota form fetches the selected
    // user's usage (drive or mail) and shows "currently using X of Y", plus
    // a red warning when the entered GB limit is below current usage.
    function hlBytes(n) {
      if (!n || n < 0) return '0 B';
      var u = ['B', 'KB', 'MB', 'GB', 'TB'], i = 0;
      while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
      return (Math.round(n * 10) / 10) + ' ' + u[i];
    }
    (function () {
      Array.prototype.forEach.call(document.querySelectorAll('[data-usage-type]'), function (note) {
        var type = note.dataset.usageType;
        var form = note.closest('form'); if (!form) return;
        var emailInput = form.querySelector('input[name="user_email"]');
        var gbInput = form.querySelector('input[name="limit_gb"]');
        if (!emailInput) return;
        var current = null;
        function render() {
          if (!current || current.used_bytes == null) { note.innerHTML = ''; return; }
          var used = current.used_bytes, lim = current.limit_bytes || 0;
          var pct = lim > 0 ? Math.min(100, Math.round(used / lim * 100)) : 0;
          var msg = 'Currently using <strong>' + hlBytes(used) + '</strong> of ' + hlBytes(lim) + ' (' + pct + '%).';
          var gb = gbInput && gbInput.value.trim();
          if (gb && /^\d+$/.test(gb)) {
            var newLimit = parseInt(gb, 10) * 1024 * 1024 * 1024;
            if (newLimit < used) msg += ' <span class="warn-below">⚠ Below current usage — they will be over quota.</span>';
          }
          note.innerHTML = msg;
        }
        function fetchUsage() {
          var email = (emailInput.value || '').trim();
          if (email.indexOf('@') < 0) { current = null; render(); return; }
          note.innerHTML = '<span class="muted">Checking usage…</span>';
          fetch('/admin/usage?type=' + type + '&user_email=' + encodeURIComponent(email), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { current = (d && d.used_bytes != null) ? d : null; if (!current) { note.innerHTML = '<span class="muted">usage unavailable</span>'; } else { render(); } })
            .catch(function () { current = null; note.innerHTML = '<span class="muted">usage unavailable</span>'; });
        }
        emailInput.addEventListener('change', fetchUsage);
        emailInput.addEventListener('blur', fetchUsage);
        if (gbInput) gbInput.addEventListener('input', render);
      });
    })();

    // (b) Users management search: #user-mgmt-search renders matching rows
    // (with Suspend/Re-enable) into #user-mgmt-results, client-side, so the
    // whole user table is never pulled up front.
    (function () {
      var input = document.getElementById('user-mgmt-search');
      var out = document.getElementById('user-mgmt-results');
      if (!input || !out) return;
      var me = (input.dataset.me || '').toLowerCase();
      input.addEventListener('input', hlDebounce(function () {
        var q = input.value.trim();
        if (q.length < 3) { out.innerHTML = '<p class="muted">Type at least 3 characters to find a user.</p>'; return; }
        out.innerHTML = '<p class="muted">Searching…</p>';
        hlFetchUsers(q).then(function (users) {
          if (!users.length) { out.innerHTML = '<p class="muted">No matching users.</p>'; return; }
          var rows = users.map(function (u) {
            var isSelf = u.email.toLowerCase() === me;
            var roles = (u.roles && u.roles.length) ? u.roles.join(', ') : 'user';
            var action = isSelf
              ? '<span class="muted" style="font-size:0.8rem;">you</span>'
              : (u.active
                ? '<form method="post" action="/admin/users/' + u.id + '/active" onsubmit="return confirm(\'Suspend this user? They will be signed out and unable to log in or receive mail auth.\')"><input type="hidden" name="action" value="suspend"><button class="btn btn-danger">Suspend</button></form>'
                : '<form method="post" action="/admin/users/' + u.id + '/active"><input type="hidden" name="action" value="enable"><button class="btn btn-secondary">Re-enable</button></form>');
            return '<tr><td>' + hlEsc(u.email) + '</td><td>' + (u.active ? 'Active' : 'Suspended') + '</td><td class="muted">' + hlEsc(roles) + '</td><td>' + action + '</td></tr>';
          }).join('');
          out.innerHTML = '<table class="sessions"><thead><tr><th>Email</th><th>Status</th><th>Roles</th><th></th></tr></thead><tbody>' + rows + '</tbody></table>';
        });
      }, 250));
    })();

    // --- Domain catch-all routing (admin) ----------------------------
    // Domain typeahead (managed domains) -> shows the domain's current
    // catch-all; a user typeahead picks the destination mailbox; plus a
    // "view all domains" multi-select to set several to one destination.
    (function () {
      var domainInput = document.getElementById('ca-domain');
      if (!domainInput) return;
      var destInput = document.getElementById('ca-dest');
      var current = document.getElementById('ca-current');
      var status = document.getElementById('ca-status');
      var bulk = document.getElementById('ca-bulk');
      var listDiv = document.getElementById('ca-list');
      var bulkStatus = document.getElementById('ca-bulk-status');
      var sendCb = document.getElementById('ca-send');
      var sendNote = document.getElementById('ca-send-note');
      var cache = null;
      var curD = null;   // the currently-shown domain row (for the send-as note)

      function updateSendNote() {
        if (!sendNote || !sendCb) return;
        var hasDkim = !!(curD && curD.has_dkim);
        if (sendCb.checked && !hasDkim) {
          sendNote.innerHTML = '<span style="color:var(--danger)">⚠ No active DKIM for this domain — outbound mail would be unsigned and likely rejected or spam-filed. Set up DKIM for this domain first, then enable send-as.</span>';
        } else if (sendCb.checked) {
          sendNote.innerHTML = '<span class="muted">Send-as enabled: the destination mailbox may send from any address at this domain (DKIM is active).</span>';
        } else {
          sendNote.innerHTML = '<span class="muted">Receive-only: forwards inbound mail; cannot send as this domain.</span>';
        }
      }
      function renderSend(d) {
        curD = d || null;
        if (sendCb) sendCb.checked = !!(d && d.send_enabled);
        updateSendNote();
      }
      if (sendCb) sendCb.addEventListener('change', updateSendNote);

      function load() {
        return fetch('/admin/domains/catch-alls', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : []; })
          .then(function (d) { cache = Array.isArray(d) ? d : []; return cache; })
          .catch(function () { cache = []; return cache; });
      }
      function say(el, msg, ok) { el.innerHTML = msg ? '<span style="color:' + (ok ? 'var(--ok)' : 'var(--danger)') + '">' + hlEsc(msg) + '</span>' : ''; }
      function findDomain(name) { return (cache || []).filter(function (x) { return (x.domain || '').toLowerCase() === name.toLowerCase(); })[0]; }
      function form(obj) { return Object.keys(obj).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(obj[k]); }).join('&'); }
      function post(path, body) {
        return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: form(body) })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, status: r.status, body: j }; }).catch(function () { return { ok: r.ok, status: r.status, body: {} }; }); });
      }

      function showCurrent(name) {
        say(status, '');
        if (!name) { current.innerHTML = ''; return; }
        (cache ? Promise.resolve(cache) : load()).then(function () {
          var d = findDomain(name);
          if (!d) { current.innerHTML = '<span class="muted">New domain — no catch-all yet. Setting one makes it receive &amp; forward all mail.</span>'; }
          else if (d.destination) { current.innerHTML = 'Currently: <strong>all mail → ' + hlEsc(d.destination) + '</strong>' + (d.mail_enabled ? '' : ' <span style="color:var(--danger)">(inbound mail disabled)</span>') + (d.send_enabled ? ' · <span style="color:var(--ok)">send-as on</span>' : ' · <span class="muted">receive-only</span>'); if (destInput && !destInput.value) destInput.value = d.destination; }
          else { current.innerHTML = '<span class="muted">No catch-all set for this domain.</span>'; }
          renderSend(d);
        });
      }

      // domain typeahead
      domainInput.parentNode.style.position = 'relative';
      var dbox = document.createElement('div'); dbox.className = 'ta-results'; domainInput.parentNode.appendChild(dbox);
      function closeDbox() { dbox.classList.remove('open'); dbox.innerHTML = ''; }
      domainInput.addEventListener('input', hlDebounce(function () {
        var q = domainInput.value.trim().toLowerCase(); current.innerHTML = '';
        if (q.length < 2) { closeDbox(); return; }
        (cache ? Promise.resolve(cache) : load()).then(function (list) {
          var m = list.filter(function (x) { return (x.domain || '').toLowerCase().indexOf(q) >= 0; }).slice(0, 12);
          dbox.innerHTML = '';
          if (!m.length) { closeDbox(); return; }
          m.forEach(function (x) {
            var it = document.createElement('div'); it.className = 'ta-item';
            it.innerHTML = '<span>' + hlEsc(x.domain) + '</span><span class="st">' + (x.destination ? '→ ' + hlEsc(x.destination) : 'none') + '</span>';
            it.addEventListener('mousedown', function (e) { e.preventDefault(); domainInput.value = x.domain; closeDbox(); showCurrent(x.domain); });
            dbox.appendChild(it);
          });
          dbox.classList.add('open');
        });
      }, 200));
      domainInput.addEventListener('blur', function () { setTimeout(closeDbox, 150); });
      domainInput.addEventListener('change', function () { showCurrent(domainInput.value.trim()); });

      document.getElementById('ca-set').addEventListener('click', function () {
        var domain = domainInput.value.trim(), dest = destInput.value.trim();
        if (!domain || !dest) { say(status, 'Enter a domain and a destination mailbox.', false); return; }
        say(status, 'Setting…', true);
        post('/admin/domains/catch-all/set', { domain: domain, destination: dest, send_enabled: (sendCb && sendCb.checked) ? 1 : '' }).then(function (r) {
          if (r.ok) { say(status, 'All mail for ' + domain + ' now → ' + dest + ((sendCb && sendCb.checked) ? ' (send-as enabled)' : ''), true); cache = null; showCurrent(domain); }
          else { say(status, (r.body && r.body.error) || 'Failed', false); }
        });
      });
      document.getElementById('ca-clear').addEventListener('click', function () {
        var domain = domainInput.value.trim();
        if (!domain) { say(status, 'Enter a domain.', false); return; }
        if (!confirm('Remove the catch-all for ' + domain + '? Unmatched mail at this domain will no longer be forwarded.')) return;
        say(status, 'Clearing…', true);
        post('/admin/domains/catch-all/clear', { domain: domain }).then(function (r) {
          if (r.ok) { say(status, 'Catch-all cleared for ' + domain, true); cache = null; showCurrent(domain); }
          else { say(status, (r.body && r.body.error) || 'Failed', false); }
        });
      });

      // bulk multi-select
      var viewAllBtn = document.getElementById('ca-viewall');
      function renderList() {
        listDiv.innerHTML = '<p class="muted">Loading…</p>';
        load().then(function (list) {
          if (!list.length) { listDiv.innerHTML = '<p class="muted">No managed domains.</p>'; return; }
          listDiv.innerHTML = list.map(function (x) {
            var route;
            if (x.destination) {
              var sa = x.send_enabled
                ? '<span style="color:var(--ok)">send-as on</span>' + (x.has_dkim ? '' : ' <span style="color:var(--danger)">(no DKIM)</span>')
                : '<span class="muted">receive-only</span>';
              route = '→ ' + hlEsc(x.destination) + ' · ' + sa;
            } else {
              route = 'no catch-all';
            }
            return '<label style="display:flex;align-items:center;gap:0.5rem;padding:0.25rem 0;font-size:0.88rem;"><input type="checkbox" class="ca-cb" value="' + hlEsc(x.domain) + '"><span>' + hlEsc(x.domain) + '</span><span class="muted" style="margin-left:auto;font-size:0.8rem;">' + route + '</span></label>';
          }).join('');
        });
      }
      viewAllBtn.addEventListener('click', function () {
        if (bulk.style.display === 'none') { bulk.style.display = 'block'; viewAllBtn.textContent = 'Hide all domains'; renderList(); }
        else { bulk.style.display = 'none'; viewAllBtn.textContent = 'View all domains…'; }
      });
      document.getElementById('ca-bulk-set').addEventListener('click', function () {
        var dest = document.getElementById('ca-bulk-dest').value.trim();
        var sel = Array.prototype.slice.call(document.querySelectorAll('.ca-cb:checked')).map(function (cb) { return cb.value; });
        if (!sel.length) { say(bulkStatus, 'Select at least one domain.', false); return; }
        if (!dest) { say(bulkStatus, 'Enter a destination mailbox.', false); return; }
        if (!confirm('Set the catch-all for ' + sel.length + ' domain(s) to ' + dest + '?')) return;
        say(bulkStatus, 'Setting ' + sel.length + '…', true);
        post('/admin/domains/catch-all/bulk', { domains: sel.join(','), destination: dest }).then(function (r) {
          if (r.ok && r.body) {
            var n = (r.body.set || []).length, f = (r.body.failed || []);
            say(bulkStatus, 'Set ' + n + ' domain(s)' + (f.length ? ', ' + f.length + ' failed: ' + f.map(function (x) { return x.domain; }).join(', ') : ''), f.length ? false : true);
            cache = null; renderList();
          } else { say(bulkStatus, (r.body && r.body.error) || 'Failed', false); }
        });
      });
    })();

    // --- Self-service Mail settings ----------------------------------
    // Lazy-loads send-as, click-to-block, and blocked-addresses when the
    // Mail section is opened; actions post to the /mail/* BFF endpoints.
    (function () {
      var sec = document.getElementById('mailself');
      if (!sec) return;
      var loaded = false;
      function post(path, body) {
        var data = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&');
        return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: data })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); });
      }
      function reload() { loaded = false; load(); }
      function list(arr) { return (arr && arr.length) ? '<ul style="margin:0.3rem 0 0;padding-left:1.2rem;">' + arr.map(function (x) { return '<li>' + hlEsc(x) + '</li>'; }).join('') + '</ul>' : '<span class="muted">none</span>'; }
      function load() {
        if (loaded) return; loaded = true;
        fetch('/mail/self', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : {}; }).then(render).catch(function () {});
      }
      function render(d) {
        var send = (d.send_as && d.send_as.send) || { addresses: [], domains: [] };
        var recv = (d.send_as && d.send_as.receive_only) || { addresses: [], domains: [] };
        document.getElementById('ms-sendas').innerHTML =
          '<p style="margin:0 0 0.2rem;">You can <strong>send as</strong>:</p>' + list([].concat(send.addresses || [], (send.domains || []).map(function (x) { return x + ' (whole domain)'; })))
          + '<p style="margin:0.8rem 0 0.2rem;">Receive-only (cannot send as):</p>' + list([].concat(recv.addresses || [], recv.domains || []));

        var b = d.block_link || {};
        document.getElementById('ms-blocklink').innerHTML =
          '<label style="display:flex;align-items:center;gap:0.5rem;"><input type="checkbox" id="ms-bl-toggle"' + (b.enabled ? ' checked' : '') + '> Add a "block this sender" link to my inbound mail</label>'
          + '<p class="muted" style="font-size:0.8rem;margin:0.5rem 0 0;">Your home domain\'s default is ' + (b.domain_default ? 'ON' : 'OFF') + (b.mode ? ' (mode: ' + hlEsc(b.mode) + ')' : '') + '.</p>'
          + '<div id="ms-bl-status" class="usage-note"></div>';
        document.getElementById('ms-bl-toggle').addEventListener('change', function () {
          var st = document.getElementById('ms-bl-status'); st.textContent = 'Saving…';
          post('/mail/block-link', { enabled: this.checked ? '1' : '' }).then(function (r) { st.textContent = r.ok ? 'Saved.' : ('Failed: ' + ((r.body && r.body.error) || '')); });
        });

        // Normalised once here so the filter/sort/render path below never has
        // to care that the API may hand back either plain strings or full
        // rows. `created_at` is a real column on domainadmin.recipient_access
        // and /recipient-access/mine does SELECT *, so the date is already in
        // the payload -- it just was not being shown.
        var blocked = (d.blocked || []).map(function (x) {
          if (typeof x === 'string') { return { addr: x, at: '' }; }
          return { addr: x.recipient || x.address || '', at: x.created_at || '' };
        });
        var bel = document.getElementById('ms-blocked');
        var bcount = document.getElementById('ms-blocked-count');
        var bfilter = document.getElementById('ms-blocked-filter');
        // Sort state lives out here so a re-render (after an unblock, or a
        // keystroke) keeps whatever ordering the user chose.
        var bsort = { key: 'addr', dir: 1 };

        // Trim the stored timestamp to minutes rather than reformatting it.
        // The value carries its own offset ("2026-10-24 11:43:19.669515-05");
        // re-interpreting that client-side is how timezone bugs get made, and
        // nothing here needs more precision than the minute.
        function bdate(v) { return v ? String(v).slice(0, 16) : ''; }

        function renderBlocked() {
          var q = (bfilter && bfilter.value || '').trim().toLowerCase();
          // 3-character minimum: below that the filter is noise, and on a
          // 1600-row list every keystroke would rebuild the whole table.
          var rows = (q.length >= 3)
            ? blocked.filter(function (r) { return r.addr.toLowerCase().indexOf(q) !== -1; })
            : blocked.slice();
          rows.sort(function (a, b) {
            var x = (a[bsort.key] || ''), y = (b[bsort.key] || '');
            // Dates are stored "YYYY-MM-DD HH:MM:SS...", which compares
            // correctly as a string, so one comparator covers both columns.
            return x < y ? -bsort.dir : (x > y ? bsort.dir : 0);
          });

          if (bcount) {
            bcount.textContent = !blocked.length ? ''
              : (rows.length === blocked.length ? '(' + blocked.length + ')'
                                                : '(' + rows.length + ' of ' + blocked.length + ')');
          }
          bel.classList.toggle('has-rows', rows.length > 0);

          if (!blocked.length) { bel.innerHTML = '<p class="muted">You haven\'t blocked any addresses.</p>'; return; }
          if (!rows.length) { bel.innerHTML = '<p class="muted">No blocked address matches that filter.</p>'; return; }

          var arrow = function (k) { return bsort.key === k ? (bsort.dir === 1 ? ' \u25b2' : ' \u25bc') : ''; };
          bel.innerHTML = '<table class="sessions"><thead><tr>'
            + '<th class="ms-sort" data-k="addr" title="Sort by address">Address' + arrow('addr') + '</th>'
            + '<th class="ms-sort" data-k="at" title="Sort by date blocked">Blocked' + arrow('at') + '</th>'
            + '<th></th></tr></thead><tbody>'
            + rows.map(function (r) {
                return '<tr><td>' + hlEsc(r.addr) + '</td>'
                     + '<td class="muted">' + hlEsc(bdate(r.at)) + '</td>'
                     + '<td><button type="button" class="btn btn-secondary ms-unblock" data-r="' + hlEsc(r.addr) + '">Unblock</button></td></tr>';
              }).join('')
            + '</tbody></table>';

          Array.prototype.forEach.call(bel.querySelectorAll('.ms-unblock'), function (btn) {
            btn.addEventListener('click', function () { post('/mail/unblock', { recipient: btn.dataset.r }).then(reload); });
          });
          Array.prototype.forEach.call(bel.querySelectorAll('.ms-sort'), function (th) {
            th.addEventListener('click', function () {
              var k = th.dataset.k;
              // Same column toggles direction; a different column starts
              // ascending, which is what every table everywhere does.
              if (bsort.key === k) { bsort.dir = -bsort.dir; } else { bsort.key = k; bsort.dir = 1; }
              renderBlocked();
            });
          });
        }

        if (bfilter && !bfilter.dataset.wired) {
          bfilter.dataset.wired = '1';
          bfilter.addEventListener('input', renderBlocked);
        }
        renderBlocked();
      }
      var blockBtn = document.getElementById('ms-block-btn');
      if (blockBtn) blockBtn.addEventListener('click', function () {
        var inp = document.getElementById('ms-block-input'), st = document.getElementById('ms-block-status');
        var v = (inp.value || '').trim();
        if (v.indexOf('@') < 0) { st.textContent = 'Enter a valid address.'; return; }
        if (!confirm('Reject ALL future mail to ' + v + '?')) return;
        st.textContent = 'Blocking…';
        post('/mail/block', { recipient: v }).then(function (r) { if (r.ok) { inp.value = ''; st.textContent = 'Blocked.'; reload(); } else { st.textContent = 'Failed: ' + ((r.body && r.body.error) || ''); } });
      });
      var nav = document.querySelector('.sidenav button[data-section="mailself"]');
      if (nav) nav.addEventListener('click', load);
      if ((location.hash || '').indexOf('mailself') >= 0) load();
    })();

    // --- Invites (self-service) --------------------------------------
    (function () {
      var sec = document.getElementById('invites'); if (!sec) return;
      var loaded = false;
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      function reload() { loaded = false; load(); }
      function load() { if (loaded) return; loaded = true; fetch('/invites', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : {}; }).then(render).catch(function () {}); }
      function render(d) {
        var q = d.quota || {}, qel = document.getElementById('inv-quota');
        if (qel && (q.max_pending != null || q.max_per_day != null)) qel.textContent = 'Quota: up to ' + (q.max_pending != null ? q.max_pending : '—') + ' pending, ' + (q.max_per_day != null ? q.max_per_day : '—') + ' per day.';
        var invs = d.invites || [], el = document.getElementById('inv-list');
        if (!invs.length) { el.innerHTML = '<p class="muted">You haven\'t sent any invites.</p>'; return; }
        el.innerHTML = '<table class="sessions"><thead><tr><th>Recipient</th><th>Status</th><th>Sent</th><th></th></tr></thead><tbody>' + invs.map(function (x) {
          var act = (x.status === 'pending') ? '<button type="button" class="btn btn-danger inv-revoke" data-id="' + x.id + '">Revoke</button>' : '<span class="muted" style="font-size:0.8rem;">—</span>';
          return '<tr><td>' + hlEsc(x.recipient_email) + '</td><td>' + hlEsc(x.status || '') + (x.accepted_user_email ? ' → ' + hlEsc(x.accepted_user_email) : '') + '</td><td class="muted">' + hlEsc((x.created_at || '').slice(0, 10)) + '</td><td>' + act + '</td></tr>';
        }).join('') + '</tbody></table>';
        Array.prototype.forEach.call(el.querySelectorAll('.inv-revoke'), function (b) { b.addEventListener('click', function () { if (!confirm('Revoke this invite?')) return; post('/invites/revoke', { invite_id: b.dataset.id }).then(reload); }); });
      }
      var sb = document.getElementById('inv-send-btn');
      if (sb) sb.addEventListener('click', function () {
        var e = document.getElementById('inv-email'), m = document.getElementById('inv-msg'), st = document.getElementById('inv-send-status');
        var v = (e.value || '').trim(); if (v.indexOf('@') < 0) { st.textContent = 'Enter a valid email.'; return; }
        st.textContent = 'Sending…';
        post('/invites/send', { recipient_email: v, message: (m.value || '').trim() }).then(function (r) { if (r.ok) { e.value = ''; m.value = ''; st.textContent = 'Invite sent.'; reload(); } else { st.textContent = 'Failed: ' + ((r.body && r.body.error) || ''); } });
      });
      var nav = document.querySelector('.sidenav button[data-section="invites"]'); if (nav) nav.addEventListener('click', load);
      if ((location.hash || '').indexOf('invites') >= 0) load();
    })();

    // --- Account activity (self-scoped audit) ------------------------
    (function () {
      var out = document.getElementById('act-list'); if (!out) return; var loaded = false;
      function load() {
        if (loaded) return; loaded = true; out.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/activity', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : []; }).then(function (rows) {
          if (!rows.length) { out.innerHTML = '<p class="muted">No recent activity.</p>'; return; }
          out.innerHTML = '<table class="sessions"><thead><tr><th>Action</th><th>When</th><th>IP</th></tr></thead><tbody>' + rows.slice(0, 50).map(function (x) {
            return '<tr><td>' + hlEsc(x.action || '') + '</td><td class="muted">' + hlEsc(x.occurred_at || '') + '</td><td class="muted">' + hlEsc(x.ip_address || '-') + '</td></tr>';
          }).join('') + '</tbody></table>';
        }).catch(function () { out.innerHTML = '<p class="muted">Unavailable.</p>'; });
      }
      var nav = document.querySelector('.sidenav button[data-section="activity"]'); if (nav) nav.addEventListener('click', load);
      if ((location.hash || '').indexOf('activity') >= 0) load();
    })();

    // --- Send-as grants + recipient access (admin) -------------------
    (function () {
      var aliasList = document.getElementById('alias-list');
      var raccList = document.getElementById('racc-list');
      if (!aliasList && !raccList) return;
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      var loaded = false;
      function load() { if (loaded) return; loaded = true; reload(); }
      function reload() { loadAliases(); loadRacc(); }
      function loadAliases() {
        if (!aliasList) return;
        fetch('/admin/mail-aliases', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : []; }).then(function (rows) {
          if (!rows.length) { aliasList.innerHTML = '<p class="muted">No send-as grants.</p>'; return; }
          aliasList.innerHTML = '<table class="sessions"><thead><tr><th>Source</th><th>Destination</th><th>Send</th><th></th></tr></thead><tbody>' + rows.map(function (x) {
            var send = x.send_enabled ? '<span style="color:var(--ok)">on</span>' : '<span class="muted">off</span>';
            var toggle = x.send_enabled
              ? '<button type="button" class="btn btn-secondary al-send" data-s="' + hlEsc(x.source_pattern) + '" data-v="">Disable send</button>'
              : '<button type="button" class="btn btn-secondary al-send" data-s="' + hlEsc(x.source_pattern) + '" data-v="1">Enable send</button>';
            return '<tr><td>' + hlEsc(x.source_pattern) + '</td><td class="muted">' + hlEsc(x.destination) + '</td><td>' + send + '</td><td>' + toggle + ' <button type="button" class="btn btn-danger al-rm" data-s="' + hlEsc(x.source_pattern) + '">Remove</button></td></tr>';
          }).join('') + '</tbody></table>';
          Array.prototype.forEach.call(aliasList.querySelectorAll('.al-send'), function (b) { b.addEventListener('click', function () { post('/admin/mail-aliases/set-send', { source_pattern: b.dataset.s, send_enabled: b.dataset.v }).then(reload); }); });
          Array.prototype.forEach.call(aliasList.querySelectorAll('.al-rm'), function (b) { b.addEventListener('click', function () { if (!confirm('Remove grant ' + b.dataset.s + '?')) return; post('/admin/mail-aliases/remove', { source_pattern: b.dataset.s }).then(reload); }); });
        });
      }
      function loadRacc() {
        if (!raccList) return;
        fetch('/admin/recipient-access', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : []; }).then(function (rows) {
          if (!rows.length) { raccList.innerHTML = '<p class="muted">No recipient overrides.</p>'; return; }
          raccList.innerHTML = '<table class="sessions"><thead><tr><th>Recipient</th><th>Action</th><th>Reason</th><th></th></tr></thead><tbody>' + rows.map(function (x) {
            var act = x.action === 'REJECT' ? '<span style="color:var(--danger)">block</span>' : '<span style="color:var(--ok)">allow</span>';
            return '<tr><td>' + hlEsc(x.recipient) + '</td><td>' + act + '</td><td class="muted">' + hlEsc(x.reason || '') + '</td><td><button type="button" class="btn btn-secondary ra-rm" data-r="' + hlEsc(x.recipient) + '">Remove</button></td></tr>';
          }).join('') + '</tbody></table>';
          Array.prototype.forEach.call(raccList.querySelectorAll('.ra-rm'), function (b) { b.addEventListener('click', function () { post('/admin/recipient-access/remove', { recipient: b.dataset.r }).then(reload); }); });
        });
      }
      var aab = document.getElementById('alias-add-btn');
      if (aab) aab.addEventListener('click', function () {
        var s = document.getElementById('alias-src').value.trim(), d = document.getElementById('alias-dest').value.trim(), en = document.getElementById('alias-send').checked, st = document.getElementById('alias-status');
        if (s.indexOf('@') < 0 || d.indexOf('@') < 0) { st.textContent = 'Enter a source and a destination.'; return; }
        st.textContent = 'Adding…';
        post('/admin/mail-aliases/add', { source_pattern: s, destination: d, send_enabled: en ? '1' : '' }).then(function (r) { if (r.ok) { document.getElementById('alias-src').value = ''; document.getElementById('alias-dest').value = ''; st.textContent = 'Added.'; reload(); } else { st.textContent = 'Failed: ' + ((r.body && r.body.error) || ''); } });
      });
      var rab = document.getElementById('racc-add-btn');
      if (rab) rab.addEventListener('click', function () {
        var r = document.getElementById('racc-recip').value.trim(), a = document.getElementById('racc-action').value, rs = document.getElementById('racc-reason').value.trim(), st = document.getElementById('racc-status');
        if (r.indexOf('@') < 0) { st.textContent = 'Enter a recipient.'; return; }
        st.textContent = 'Applying…';
        post('/admin/recipient-access/set', { recipient: r, action: a, reason: rs }).then(function (res) { if (res.ok) { document.getElementById('racc-recip').value = ''; document.getElementById('racc-reason').value = ''; st.textContent = 'Applied.'; reload(); } else { st.textContent = 'Failed: ' + ((res.body && res.body.error) || ''); } });
      });
      var nav = document.querySelector('.admin-tabs button[data-atab="mail"]');
      if (nav) nav.addEventListener('click', load);
      if ((location.hash || '').indexOf('admin:mail') >= 0) load();
    })();

    // --- Roles & permissions (admin) ---------------------------------
    (function () {
      var rolesList = document.getElementById('roles-list');
      if (!rolesList) return;
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      var loaded = false;
      function load() { if (loaded) return; loaded = true; reload(); }
      function reload() {
        fetch('/admin/roles', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : {}; }).then(function (d) {
          var perms = d.permissions || [], roles = d.roles || [];
          rolesList.innerHTML = '<table class="sessions"><thead><tr><th>Role</th><th>Permissions</th><th></th></tr></thead><tbody>' + roles.map(function (x) {
            var granted = x.permissions || [];
            var tags = granted.map(function (p) { return '<span class="badge">' + hlEsc(p) + ' <a href="#" class="rp-rm" data-role="' + hlEsc(x.name) + '" data-perm="' + hlEsc(p) + '" style="color:var(--danger);text-decoration:none;">×</a></span>'; }).join(' ') || '<span class="muted">none</span>';
            var avail = perms.filter(function (pp) { return granted.indexOf(pp.name) < 0; });
            var addSel = avail.length ? ' <select class="rp-add" data-role="' + hlEsc(x.name) + '"><option value="">+ permission…</option>' + avail.map(function (pp) { return '<option value="' + hlEsc(pp.name) + '">' + hlEsc(pp.name) + '</option>'; }).join('') + '</select>' : '';
            var rm = x.protected ? '<span class="muted" style="font-size:0.8rem;">built-in</span>' : '<button type="button" class="btn btn-danger role-rm" data-role="' + hlEsc(x.name) + '">Delete</button>';
            return '<tr><td>' + hlEsc(x.name) + '</td><td>' + tags + addSel + '</td><td>' + rm + '</td></tr>';
          }).join('') + '</tbody></table>';
          Array.prototype.forEach.call(rolesList.querySelectorAll('.role-rm'), function (b) { b.addEventListener('click', function () { if (!confirm('Delete role ' + b.dataset.role + '?')) return; post('/admin/roles/remove', { name: b.dataset.role }).then(reload); }); });
          Array.prototype.forEach.call(rolesList.querySelectorAll('.rp-rm'), function (a) { a.addEventListener('click', function (e) { e.preventDefault(); post('/admin/roles/revoke-perm', { role: a.dataset.role, permission: a.dataset.perm }).then(reload); }); });
          Array.prototype.forEach.call(rolesList.querySelectorAll('.rp-add'), function (s) { s.addEventListener('change', function () { if (!s.value) return; post('/admin/roles/grant-perm', { role: s.dataset.role, permission: s.value }).then(reload); }); });
        });
      }
      document.getElementById('role-add-btn').addEventListener('click', function () {
        var n = document.getElementById('role-name').value.trim(), d = document.getElementById('role-desc').value.trim(), st = document.getElementById('role-status');
        if (!n) { st.textContent = 'Enter a role name.'; return; }
        st.textContent = 'Creating…';
        post('/admin/roles/add', { name: n, description: d }).then(function (r) { if (r.ok) { document.getElementById('role-name').value = ''; document.getElementById('role-desc').value = ''; st.textContent = 'Created.'; reload(); } else { st.textContent = 'Failed: ' + ((r.body && r.body.error) || ''); } });
      });
      function userRole(grant) {
        var e = document.getElementById('urole-email').value.trim(), role = document.getElementById('urole-role').value.trim(), st = document.getElementById('urole-status');
        if (e.indexOf('@') < 0 || !role) { st.textContent = 'Enter a user email and a role.'; return; }
        st.textContent = grant ? 'Granting…' : 'Revoking…';
        post(grant ? '/admin/users/grant-role' : '/admin/users/revoke-role', { user_email: e, role: role }).then(function (r) { st.textContent = r.ok ? (grant ? 'Granted.' : 'Revoked.') : ('Failed: ' + ((r.body && r.body.error) || '')); });
      }
      document.getElementById('urole-grant').addEventListener('click', function () { userRole(true); });
      document.getElementById('urole-revoke').addEventListener('click', function () { userRole(false); });
      var nav = document.querySelector('.admin-tabs button[data-atab="roles"]'); if (nav) nav.addEventListener('click', load);
      if ((location.hash || '').indexOf('admin:roles') >= 0) load();
    })();

    // --- Dovecot pool status (admin) ---------------------------------
    // Lazily loads the mailbox-serving pool (active vs standby + health)
    // when the Dovecot tab is first opened (or if it's the initial tab).
    (function () {
      var out = document.getElementById('dovecot-status');
      if (!out) return;
      var loaded = false;
      function load() {
        if (loaded) return; loaded = true;
        out.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/admin/dovecot/status', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.hosts) { out.innerHTML = '<p class="muted">Status unavailable.</p>'; return; }
            var rows = d.hosts.map(function (h) {
              var role = h.role === 'active'
                ? '<span class="badge admin">ACTIVE</span>'
                : '<span class="badge">standby</span>';
              var health = h.healthy
                ? '<span style="color:var(--ok)">● healthy</span>'
                : '<span style="color:var(--danger)">● down</span>';
              return '<tr><td>' + hlEsc(h.name) + '</td><td class="muted">' + hlEsc(h.address) + '</td><td>' + role + '</td><td>' + health + '</td></tr>';
            }).join('');
            var pathsHtml = '';
            if (d.paths && d.paths.length) {
              var prows = d.paths.map(function (p) {
                return '<tr><td>' + hlEsc(p.name) + '</td><td class="muted">' + hlEsc(p.ports) + '</td><td class="muted">' + hlEsc(p.via) + '</td></tr>';
              }).join('');
              pathsHtml = '<p class="muted" style="font-size:0.82rem;margin:1rem 0 0.3rem;">Mail paths (all pinned to the active host, fail over together)</p>'
                + '<table class="sessions"><thead><tr><th>Path</th><th>Ports</th><th>Routing</th></tr></thead><tbody>' + prows + '</tbody></table>';
            }
            out.innerHTML = '<table class="sessions"><thead><tr><th>Host</th><th>Address</th><th>Role</th><th>Health</th></tr></thead><tbody>' + rows + '</tbody></table>'
              + pathsHtml
              + (d.note ? '<p class="muted" style="font-size:0.8rem;margin:0.8rem 0 0;">' + hlEsc(d.note) + '</p>' : '');
          })
          .catch(function () { out.innerHTML = '<p class="muted">Status unavailable.</p>'; });
      }
      var tab = document.querySelector('.admin-tabs button[data-atab="dovecot"]');
      if (tab) tab.addEventListener('click', load);
      if ((location.hash || '').indexOf('dovecot') >= 0) load();
    })();

    // --- HA status (admin): PostgreSQL/Patroni + pgbouncer -----------
    (function () {
      var pg = document.getElementById('ha-postgres'), pb = document.getElementById('ha-pgbouncer');
      var dc = document.getElementById('ha-dovecot'), ed = document.getElementById('ha-edges');
      if (!pg || !pb) return;
      var loaded = false;
      function health(ok) { return ok ? '<span style="color:var(--ok)">● up</span>' : '<span style="color:var(--danger)">● down</span>'; }
      function roleBadge(role) { return role === 'leader' ? '<span class="badge admin">LEADER</span>' : '<span class="badge">' + hlEsc(role || '?') + '</span>'; }
      function renderPatroni(comp) {
        if (!comp) { pg.innerHTML = '<p class="muted">Status unavailable.</p>'; return; }
        var rows = (comp.members || []).map(function (m) {
          return '<tr><td>' + hlEsc(m.name) + '</td><td class="muted">' + hlEsc(m.address) + '</td><td>' + roleBadge(m.role)
            + '</td><td class="muted">' + hlEsc(m.state) + '</td><td class="muted">' + (m.lag == null ? '' : hlEsc(String(m.lag)))
            + '</td><td>' + health(m.healthy) + '</td></tr>';
        }).join('');
        var head = comp.vip ? '<p class="muted" style="font-size:0.82rem;margin:0 0 0.4rem;">VIP <strong>' + hlEsc(comp.vip) + '</strong>'
          + (comp.leader ? ' → leader <strong>' + hlEsc(comp.leader) + '</strong>' : ' → <span style="color:var(--danger)">no leader</span>') + '</p>' : '';
        pg.innerHTML = head
          + '<table class="sessions"><thead><tr><th>Node</th><th>Address</th><th>Role</th><th>State</th><th>Lag</th><th>Health</th></tr></thead><tbody>' + rows + '</tbody></table>'
          + (comp.note ? '<p class="muted" style="font-size:0.8rem;margin:0.8rem 0 0;">' + hlEsc(comp.note) + '</p>' : '');
      }
      function renderPgb(comp) {
        if (!comp) { pb.innerHTML = '<p class="muted">Status unavailable.</p>'; return; }
        var rows = (comp.members || []).map(function (m) {
          return '<tr><td>' + hlEsc(m.name) + '</td><td class="muted">' + hlEsc(m.address) + '</td><td class="muted">' + hlEsc(m.state) + '</td><td>' + health(m.healthy) + '</td></tr>';
        }).join('');
        pb.innerHTML = '<table class="sessions"><thead><tr><th>Node</th><th>Address</th><th>State</th><th>Health</th></tr></thead><tbody>' + rows + '</tbody></table>'
          + (comp.note ? '<p class="muted" style="font-size:0.8rem;margin:0.8rem 0 0;">' + hlEsc(comp.note) + '</p>' : '');
      }
      // Active/standby, powered-on/off: a plain state word, not a health dot,
      // because "standby" and "off" are correct states rather than faults.
      function roleTag(role) {
        if (role === 'active' || role === 'powered on') return '<span class="badge admin">' + hlEsc(role.toUpperCase()) + '</span>';
        return '<span class="badge">' + hlEsc(role || '?') + '</span>';
      }
      function renderSimple(el, comp, cols) {
        if (!el) return;
        if (!comp) { el.innerHTML = '<p class="muted">Status unavailable.</p>'; return; }
        var rows = (comp.members || []).map(function (m) {
          return '<tr><td>' + hlEsc(m.name) + '</td><td class="muted">' + hlEsc(m.address) + '</td><td>' + roleTag(m.role)
            + '</td><td class="muted">' + hlEsc(m.state || '') + '</td><td>' + health(m.healthy) + '</td></tr>';
        }).join('');
        el.innerHTML = '<table class="sessions"><thead><tr><th>Node</th><th>Address</th><th>' + cols
          + '</th><th>State</th><th>Health</th></tr></thead><tbody>' + rows + '</tbody></table>'
          + (comp.note ? '<p class="muted" style="font-size:0.8rem;margin:0.8rem 0 0;">' + hlEsc(comp.note) + '</p>' : '');
      }
      function load() {
        if (loaded) return; loaded = true;
        pg.innerHTML = '<p class="muted">Loading…</p>'; pb.innerHTML = '<p class="muted">Loading…</p>';
        if (dc) dc.innerHTML = '<p class="muted">Loading…</p>';
        if (ed) ed.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/admin/ha/status', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.components) {
              pg.innerHTML = '<p class="muted">Status unavailable.</p>'; pb.innerHTML = '<p class="muted">Status unavailable.</p>';
              if (dc) dc.innerHTML = '<p class="muted">Status unavailable.</p>';
              if (ed) ed.innerHTML = '<p class="muted">Status unavailable.</p>';
              return;
            }
            var byKind = {}; d.components.forEach(function (c) { byKind[c.kind] = c; });
            renderPatroni(byKind.patroni);
            renderPgb(byKind.pgbouncer);
            renderSimple(dc, byKind.dovecot, 'Role');
            renderSimple(ed, byKind.edges, 'Power');
          })
          .catch(function () {
            pg.innerHTML = '<p class="muted">Status unavailable.</p>'; pb.innerHTML = '<p class="muted">Status unavailable.</p>';
            if (dc) dc.innerHTML = '<p class="muted">Status unavailable.</p>';
            if (ed) ed.innerHTML = '<p class="muted">Status unavailable.</p>';
          });
      }
      var tab = document.querySelector('.admin-tabs button[data-atab="ha"]');
      if (tab) tab.addEventListener('click', load);
      if ((location.hash || '').indexOf('admin:ha') >= 0) load();
    })();

      // --- DMARC aggregate report review (admin) ----------------------
      // Four read-only fetches. Ingest freshness is rendered FIRST and
      // treated as part of the data: an empty summary because nothing has
      // fetched in days is indistinguishable from "no problems" unless the
      // page says so.
      (function () {
        var root = document.querySelector('[data-dmarc-root]');
        if (!root) return;
        var daysSel = document.getElementById('dmarc-days');
        var onlyBad = document.getElementById('dmarc-only-failing');
        var inflight = false;

        function num(n) { return (n === null || n === undefined) ? '—' : Number(n).toLocaleString(); }
        function when(ts) {
          if (!ts) return '—';
          var d = new Date(ts.replace(' ', 'T'));
          return isNaN(d) ? ts : d.toLocaleString();
        }
        function td(v, cls) { return '<td' + (cls ? ' class="' + cls + '"' : '') + '>' + v + '</td>'; }
        function row(cells) { return '<tr>' + cells.join('') + '</tr>'; }
        function empty(body, cols, msg) {
          body.innerHTML = '<tr><td colspan="' + cols + '" class="muted">' + hlEsc(msg) + '</td></tr>';
        }

        function renderStatus(d) {
          var el = document.getElementById('dmarc-status');
          var ing = (d && d.ingest) || {}, store = (d && d.store) || {};
          el.className = 'dmarc-status';
          if (!ing.last_run) {
            el.classList.add('never');
            el.innerHTML = '<strong>The report ingest has never run.</strong> ' +
              'Reports are collected by homelab-dmarc-ingest.timer on the domain-admin hosts; ' +
              'it stays idle until <code>dmarc_reports.enabled</code> is set in that package’s config.';
            return;
          }
          var age = (Date.now() - new Date(String(ing.last_run).replace(' ', 'T')).getTime()) / 3600000;
          // 25h, not 1h: the timer is hourly but receivers only send daily,
          // so "nothing new for an hour" is normal and must not look alarming.
          if (!(age < 25)) el.classList.add('stale');
          el.innerHTML = 'Last ingest ' + hlEsc(when(ing.last_run)) +
            (ing.last_host ? ' on ' + hlEsc(ing.last_host) : '') +
            (!(age < 25) ? ' — <strong>that is over a day ago</strong>' : '') +
            '. ' + num(store.reports) + ' report(s) stored' +
            (store.latest ? ', covering up to ' + hlEsc(when(store.latest)) : '') + '.' +
            (ing.last_note ? ' <span class="muted">(' + hlEsc(ing.last_note) + ')</span>' : '');
        }

        function renderSummary(d) {
          var body = document.getElementById('dmarc-summary-body');
          var rows = (d && d.domains) || [];
          if (!rows.length) return empty(body, 8, 'No reports in this window yet.');
          body.innerHTML = rows.map(function (r) {
            return row([
              td(hlEsc(r.domain || '—')),
              td(hlEsc(r.policy_p || '—')),
              td(num(r.messages), 'num'),
              td(num(r.aligned), 'num ok'),
              td(num(r.failing), 'num' + (Number(r.failing) > 0 ? ' bad' : '')),
              td(num(r.acted_on), 'num' + (Number(r.acted_on) > 0 ? ' bad' : '')),
              td(num(r.reporters), 'num'),
              td(num(r.sources), 'num')
            ]);
          }).join('');
        }

        function renderSources(d) {
          var body = document.getElementById('dmarc-sources-body');
          var rows = (d && d.sources) || [];
          if (!rows.length) {
            return empty(body, 7, onlyBad && onlyBad.checked
              ? 'No sending source failed DMARC in this window.'
              : 'No sending sources recorded in this window yet.');
          }
          body.innerHTML = rows.map(function (r) {
            return row([
              td(hlEsc(r.source_ip || '—'), 'mono'),
              td(hlEsc(r.domain || '—')),
              td(num(r.messages), 'num'),
              td(num(r.aligned), 'num ok'),
              td(num(r.failing), 'num' + (Number(r.failing) > 0 ? ' bad' : '')),
              td(num(r.reporters), 'num'),
              td(hlEsc(when(r.last_seen)))
            ]);
          }).join('');
        }

        function renderReports(d) {
          var body = document.getElementById('dmarc-reports-body');
          var rows = (d && d.reports) || [];
          if (!rows.length) return empty(body, 6, 'Nothing ingested yet.');
          body.innerHTML = rows.map(function (r) {
            return row([
              td(hlEsc(r.org_name || '—')),
              td(hlEsc(r.policy_domain || '—')),
              td(hlEsc(when(r.date_begin)) + ' → ' + hlEsc(when(r.date_end))),
              td(num(r.messages), 'num'),
              td(num(r.records), 'num'),
              td(hlEsc(when(r.ingested_at)))
            ]);
          }).join('');
        }

        function getJSON(path) {
          return fetch(path, { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .catch(function () { return null; });
        }

        function load() {
          if (inflight) return;
          inflight = true;
          var days = (daysSel && daysSel.value) || '30';
          var q = '?days=' + encodeURIComponent(days);
          var sq = q + ((onlyBad && onlyBad.checked) ? '&failing=1' : '');
          Promise.all([
            getJSON('/admin/dmarc/status').then(renderStatus),
            getJSON('/admin/dmarc/summary' + q).then(renderSummary),
            getJSON('/admin/dmarc/sources' + sq).then(renderSources),
            getJSON('/admin/dmarc/reports' + q).then(renderReports)
          ]).then(function () { inflight = false; }, function () { inflight = false; });
        }

        if (daysSel) daysSel.addEventListener('change', load);
        if (onlyBad) onlyBad.addEventListener('change', load);
        var tab = document.querySelector('.admin-tabs button[data-atab="dmarc"]');
        if (tab) tab.addEventListener('click', load);
        if ((location.hash || '').indexOf('admin:dmarc') >= 0) load();
      })();

    // --- Service accounts / invite quota / a user's sessions (admin) --
    (function () {
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      function say(el, msg, ok) { el.innerHTML = msg ? '<p style="margin:0.6rem 0 0;color:' + (ok ? 'var(--ok)' : 'var(--danger)') + '">' + hlEsc(msg) + '</p>' : ''; }

      // A5 -- create a service account
      var svc = document.getElementById('svc-acct-form');
      if (svc) svc.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = svc.email.value.trim(), pw = svc.password.value.trim(), out = document.getElementById('svc-acct-result');
        if (email.indexOf('@') < 0) { say(out, 'Enter a valid email.', false); return; }
        say(out, 'Creating…', true);
        post('/admin/users/create-service-account', pw ? { email: email, password: pw } : { email: email }).then(function (r) {
          if (!r.ok) { say(out, 'Failed: ' + ((r.body && r.body.error) || 'error'), false); return; }
          svc.reset();
          out.innerHTML = '<p style="margin:0.6rem 0 0;color:var(--ok)">Created <strong>' + hlEsc(r.body.email) + '</strong>.</p>'
            + '<p style="margin:0.3rem 0 0;">Password (shown once — copy it now):</p>'
            + '<code style="display:block;padding:0.5rem;background:var(--code-bg,rgba(127,127,127,0.12));border-radius:6px;word-break:break-all;user-select:all;">' + hlEsc(r.body.password) + '</code>';
        });
      });

      // A9 -- per-user invite quota (show current on email entry, then set)
      var iq = document.getElementById('invite-quota-form');
      if (iq) {
        var cur = document.getElementById('invite-quota-current');
        function loadCurrent() {
          var em = iq.user_email.value.trim();
          if (em.indexOf('@') < 0) { cur.textContent = ''; return; }
          fetch('/admin/invite-quota?user_email=' + encodeURIComponent(em), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
              if (!d || d.max_pending == null) { cur.textContent = 'No override — using the default quota.'; return; }
              cur.innerHTML = 'Current: <strong>' + hlEsc(d.max_pending) + '</strong> pending, <strong>' + hlEsc(d.max_per_day) + '</strong>/day.';
              if (!iq.max_pending.value) iq.max_pending.value = d.max_pending;
              if (!iq.max_per_day.value) iq.max_per_day.value = d.max_per_day;
            }).catch(function () { cur.textContent = ''; });
        }
        iq.user_email.addEventListener('change', loadCurrent);
        iq.user_email.addEventListener('blur', loadCurrent);
        iq.addEventListener('submit', function (e) {
          e.preventDefault();
          var out = document.getElementById('invite-quota-result');
          var em = iq.user_email.value.trim(), mp = iq.max_pending.value, md = iq.max_per_day.value;
          if (em.indexOf('@') < 0) { say(out, 'Enter a valid user email.', false); return; }
          say(out, 'Saving…', true);
          post('/admin/invite-quota', { user_email: em, max_pending: mp, max_per_day: md }).then(function (r) {
            say(out, r.ok ? 'Invite quota updated.' : ('Failed: ' + ((r.body && r.body.error) || 'error')), r.ok);
          });
        });
      }

      // A8 -- view/revoke a user's sessions
      var usessBtn = document.getElementById('usess-load');
      if (usessBtn) {
        var emIn = document.getElementById('usess-email'), out = document.getElementById('usess-result');
        function render(email) {
          fetch('/admin/user-sessions?user_email=' + encodeURIComponent(email), { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; }).then(function (list) {
              if (!Array.isArray(list)) { out.innerHTML = '<p class="muted">Could not load sessions.</p>'; return; }
              if (!list.length) { out.innerHTML = '<p class="muted">No active sessions for ' + hlEsc(email) + '.</p>'; return; }
              out.innerHTML = '<table class="sessions"><thead><tr><th>Started</th><th>IP</th><th>User agent</th><th></th></tr></thead><tbody>' + list.map(function (s) {
                var jti = s.jti || s.id || '';
                var started = String(s.first_seen_at || '').slice(0, 19).replace('T', ' ');
                return '<tr' + (s.current ? ' style="opacity:0.6"' : '') + '><td class="muted">' + hlEsc(started || '-') + (s.current ? ' <span class="muted">(this admin session)</span>' : '') + '</td>'
                  + '<td class="muted">' + hlEsc(s.ip_address || '-') + '</td>'
                  + '<td class="muted" style="max-width:22ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + hlEsc(s.user_agent || '') + '">' + hlEsc(s.user_agent || '-') + '</td>'
                  + '<td><button type="button" class="btn btn-danger usess-rm" data-jti="' + hlEsc(jti) + '">Revoke</button></td></tr>';
              }).join('') + '</tbody></table>';
              Array.prototype.forEach.call(out.querySelectorAll('.usess-rm'), function (b) {
                b.addEventListener('click', function () {
                  if (!confirm('Revoke this session for ' + email + '?')) return;
                  post('/admin/user-sessions/revoke', { user_email: email, jti: b.dataset.jti }).then(function () { render(email); });
                });
              });
            }).catch(function () { out.innerHTML = '<p class="muted">Could not load sessions.</p>'; });
        }
        usessBtn.addEventListener('click', function () {
          var em = emIn.value.trim();
          if (em.indexOf('@') < 0) { out.innerHTML = '<p style="color:var(--danger)">Enter a valid user email.</p>'; return; }
          out.innerHTML = '<p class="muted">Loading…</p>';
          render(em);
        });
      }
    })();

    // --- DKIM selector detail (admin) --------------------------------
    (function () {
      var sel = document.getElementById('dkim-domain');
      if (!sel) return;
      var list = document.getElementById('dkim-list'), st = document.getElementById('dkim-detail-status');
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      function say(m, ok) { st.innerHTML = m ? '<span style="color:' + (ok ? 'var(--ok)' : 'var(--danger)') + '">' + hlEsc(m) + '</span>' : ''; }
      var STATE = { active: '<span class="badge admin">ACTIVE</span>', pending: '<span class="badge">pending</span>', retiring: '<span class="badge" style="color:var(--danger)">retiring</span>', retired: '<span class="muted">retired</span>' };
      function load() {
        var domain = sel.value;
        list.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/admin/dkim/selectors?domain=' + encodeURIComponent(domain), { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; }).then(function (rows) {
            if (!Array.isArray(rows)) { list.innerHTML = '<p class="muted">Could not load selectors.</p>'; return; }
            if (!rows.length) { list.innerHTML = '<p class="muted">No selectors yet — rotate to create one.</p>'; return; }
            list.innerHTML = '<table class="sessions"><thead><tr><th>Selector</th><th>State</th><th>Bits</th><th>Created</th><th>Activated</th><th></th></tr></thead><tbody>' + rows.map(function (x) {
              var s = x.state || '', acts = [];
              if (s === 'pending') { acts.push('<button type="button" class="btn btn-primary dk-act" data-a="activate" data-s="' + hlEsc(x.selector) + '">Activate</button>'); acts.push('<button type="button" class="btn btn-danger dk-act" data-a="cancel" data-s="' + hlEsc(x.selector) + '">Cancel</button>'); }
              else if (s === 'retiring') { acts.push('<button type="button" class="btn btn-danger dk-act" data-a="retire" data-s="' + hlEsc(x.selector) + '">Retire now</button>'); }
              return '<tr><td>' + hlEsc(x.selector) + '</td><td>' + (STATE[s] || hlEsc(s)) + '</td><td class="muted">' + hlEsc(x.key_bits || '') + '</td>'
                + '<td class="muted">' + hlEsc(String(x.created_at || '').slice(0, 10)) + '</td>'
                + '<td class="muted">' + hlEsc(String(x.activated_at || '').slice(0, 10) || '-') + '</td>'
                + '<td>' + (acts.join(' ') || '<span class="muted">—</span>') + '</td></tr>';
            }).join('') + '</tbody></table>';
            Array.prototype.forEach.call(list.querySelectorAll('.dk-act'), function (b) {
              b.addEventListener('click', function () {
                var a = b.dataset.a, msg = { activate: 'Activate selector ' + b.dataset.s + ' and start signing with it?', retire: 'Retire selector ' + b.dataset.s + ' now (ends the overlap window early)?', cancel: 'Cancel (delete) pending selector ' + b.dataset.s + '?' }[a];
                if (!confirm(msg)) return;
                say('Working…', true);
                post('/admin/dkim/' + a, { domain: sel.value, selector: b.dataset.s }).then(function (r) {
                  say(r.ok ? (a.charAt(0).toUpperCase() + a.slice(1) + ' done.') : ('Failed: ' + ((r.body && r.body.error) || 'error')), r.ok);
                  load();
                });
              });
            });
          }).catch(function () { list.innerHTML = '<p class="muted">Could not load selectors.</p>'; });
      }
      document.getElementById('dkim-load-btn').addEventListener('click', load);
      sel.addEventListener('change', load);
      document.getElementById('dkim-rotate-btn').addEventListener('click', function () {
        if (!confirm('Rotate a new pending DKIM key for ' + sel.value + '? (It will not sign anything until you activate it.)')) return;
        say('Rotating…', true);
        post('/admin/dkim/rotate', { domain: sel.value }).then(function (r) { say(r.ok ? ('New pending selector ' + ((r.body && r.body.selector) || '') + ' created.') : ('Failed: ' + ((r.body && r.body.error) || 'error')), r.ok); load(); });
      });
    })();

    // --- Raw DNS records (admin) -------------------------------------
    (function () {
      var dsel = document.getElementById('dns-domain');
      if (!dsel) return;
      var list = document.getElementById('dns-list'), st = document.getElementById('dns-status');
      function post(path, body) { var d = Object.keys(body).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(body[k]); }).join('&'); return fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' }, body: d }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }).catch(function () { return { ok: r.ok, body: {} }; }); }); }
      function say(m, ok) { st.innerHTML = m ? '<span style="color:' + (ok ? 'var(--ok)' : 'var(--danger)') + '">' + hlEsc(m) + '</span>' : ''; }
      function load() {
        var domain = dsel.value;
        list.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/admin/dns/records?domain=' + encodeURIComponent(domain), { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); }).then(function (res) {
            var rows = res.body;
            if (!res.ok || !Array.isArray(rows)) { list.innerHTML = '<p class="muted">' + hlEsc((rows && rows.error) || 'Could not load records.') + '</p>'; return; }
            rows.sort(function (a, b) { return (a.name + a.type).localeCompare(b.name + b.type); });
            list.innerHTML = '<div style="overflow-x:auto"><table class="sessions"><thead><tr><th>Name</th><th>Type</th><th>TTL</th><th>Value(s)</th><th></th></tr></thead><tbody>' + rows.map(function (x) {
              var vals = (x.content || []).map(function (v) { return hlEsc(v); }).join('<br>');
              return '<tr><td style="word-break:break-all">' + hlEsc(x.name) + '</td><td>' + hlEsc(x.type) + '</td><td class="muted">' + hlEsc(x.ttl) + '</td>'
                + '<td class="muted" style="word-break:break-all">' + vals + '</td>'
                + '<td><button type="button" class="btn btn-secondary dns-edit" data-n="' + hlEsc(x.name) + '" data-t="' + hlEsc(x.type) + '" data-c="' + hlEsc((x.content || []).join('\n')) + '" data-ttl="' + hlEsc(x.ttl) + '">Edit</button> '
                + '<button type="button" class="btn btn-danger dns-del" data-n="' + hlEsc(x.name) + '" data-t="' + hlEsc(x.type) + '">Delete</button></td></tr>';
            }).join('') + '</tbody></table></div>';
            Array.prototype.forEach.call(list.querySelectorAll('.dns-del'), function (b) {
              b.addEventListener('click', function () {
                if (!confirm('Delete the entire ' + b.dataset.t + ' record set for ' + b.dataset.n + '?')) return;
                say('Deleting…', true);
                post('/admin/dns/records/delete', { domain: dsel.value, name: b.dataset.n, type: b.dataset.t }).then(function (r) { say(r.ok ? 'Deleted.' : ('Failed: ' + ((r.body && r.body.error) || 'error')), r.ok); load(); });
              });
            });
            Array.prototype.forEach.call(list.querySelectorAll('.dns-edit'), function (b) {
              b.addEventListener('click', function () {
                document.getElementById('dns-name').value = b.dataset.n;
                document.getElementById('dns-type').value = b.dataset.t;
                document.getElementById('dns-content').value = b.dataset.c;
                document.getElementById('dns-ttl').value = b.dataset.ttl;
                say('Loaded ' + b.dataset.n + ' ' + b.dataset.t + ' into the form below — edit and Save to replace it.', true);
                document.getElementById('dns-name').scrollIntoView({ behavior: 'smooth', block: 'center' });
              });
            });
          }).catch(function () { list.innerHTML = '<p class="muted">Could not load records.</p>'; });
      }
      document.getElementById('dns-load-btn').addEventListener('click', load);
      dsel.addEventListener('change', function () { list.innerHTML = '<p class="muted">Pick a zone and load its records.</p>'; });
      document.getElementById('dns-set-btn').addEventListener('click', function () {
        var name = document.getElementById('dns-name').value.trim(), type = document.getElementById('dns-type').value,
            content = document.getElementById('dns-content').value.trim(), ttl = document.getElementById('dns-ttl').value;
        if (!name || !content) { say('Enter a name and at least one value.', false); return; }
        if (!confirm('Save (replace) the ' + type + ' record set for ' + name + ' in ' + dsel.value + '?')) return;
        say('Saving…', true);
        post('/admin/dns/records', { domain: dsel.value, name: name, type: type, content: content, ttl: ttl }).then(function (r) {
          if (r.ok) { say('Saved.' + (r.body && r.body.restart_pending ? ' (new name — a DNS reload is queued)' : ''), true); load(); }
          else { say('Failed: ' + ((r.body && r.body.error) || 'error'), false); }
        });
      });
    })();

    // --- Fleet status dashboard (admin) ------------------------------
    (function () {
      var drift = document.getElementById('fleet-drift'), hosts = document.getElementById('fleet-hosts');
      if (!drift || !hosts) return;
      function truthy(v) { return v === true || v === 1 || v === 't' || v === '1'; }
      function heartbeatAge(s) {
        if (!s) return { txt: 'never', cls: 'var(--danger)' };
        var d = new Date(String(s).replace(' ', 'T'));
        if (isNaN(d.getTime())) return { txt: hlEsc(String(s).slice(0, 19)), cls: 'var(--muted)' };
        var mins = Math.round((Date.now() - d.getTime()) / 60000);
        var txt = mins < 1 ? 'just now' : mins < 60 ? (mins + ' min ago') : mins < 1440 ? (Math.round(mins / 60) + ' h ago') : (Math.round(mins / 1440) + ' d ago');
        return { txt: txt, cls: mins <= 5 ? 'var(--ok)' : mins <= 30 ? '#c90' : 'var(--danger)' };
      }
      var loaded = false;
      function load() {
        if (loaded) return; loaded = true;
        fetch('/admin/fleet/mismatches', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).then(function (rows) {
          if (!Array.isArray(rows)) { drift.innerHTML = '<p class="muted">Status unavailable.</p>'; return; }
          if (!rows.length) { drift.innerHTML = '<p style="color:var(--ok)">✓ No drift — every declared service matches what each host reports.</p>'; return; }
          drift.innerHTML = '<div style="overflow-x:auto"><table class="sessions"><thead><tr><th>Host</th><th>Service</th><th>Expected</th><th>Actual</th><th>Detail</th></tr></thead><tbody>' + rows.map(function (x) {
            var exp = truthy(x.expected), act = truthy(x.actual);
            var kind = exp && !act ? '<span style="color:var(--danger)">● missing</span>' : (!exp && act ? '<span style="color:#c90">● undeclared</span>' : '');
            return '<tr><td>' + hlEsc(x.hostname) + '</td><td>' + hlEsc(x.service_name) + ' ' + kind + '</td>'
              + '<td class="muted">' + (exp ? 'yes' : 'no') + '</td><td class="muted">' + (act ? 'yes' : 'no') + '</td>'
              + '<td class="muted">' + hlEsc(x.description || x.package_name || '') + (x.fronts ? ' <span class="muted">(' + hlEsc(x.fronts) + ')</span>' : '') + '</td></tr>';
          }).join('') + '</tbody></table></div>';
        }).catch(function () { drift.innerHTML = '<p class="muted">Status unavailable.</p>'; });
        fetch('/admin/fleet/hosts', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.ok ? r.json() : null; }).then(function (rows) {
          if (!Array.isArray(rows) || !rows.length) { hosts.innerHTML = '<p class="muted">No hosts have enrolled + heartbeated yet.</p>'; return; }
          hosts.innerHTML = '<div style="overflow-x:auto"><table class="sessions"><thead><tr><th>Host</th><th>Address</th><th>Agent</th><th>Last heartbeat</th></tr></thead><tbody>' + rows.map(function (h) {
            var age = heartbeatAge(h.last_heartbeat);
            return '<tr><td>' + hlEsc(h.hostname) + '</td><td class="muted">' + hlEsc(h.address || '') + (h.agent_port ? ':' + hlEsc(h.agent_port) : '') + '</td>'
              + '<td class="muted">' + hlEsc(h.agent_version || '-') + '</td>'
              + '<td style="color:' + age.cls + '">● ' + age.txt + '</td></tr>';
          }).join('') + '</tbody></table></div>';
        }).catch(function () { hosts.innerHTML = '<p class="muted">Status unavailable.</p>'; });
      }
      var tab = document.querySelector('.admin-tabs button[data-atab="fleet"]');
      if (tab) tab.addEventListener('click', load);
      if ((location.hash || '').indexOf('admin:fleet') >= 0) load();
    })();

    // --- Services (admin): service -> hosts, over the fleet data ------
    (function () {
      var out = document.getElementById('svc-list');
      if (!out) return;
      var CAT_FILL = { ingress: '#3562d4', app: '#48566b', mail: '#7c3aed', dns: '#0d9488', db: '#b45309', unmon: '#9aa3af' };
      function catOf(n) {
        if (n.monitored === false) return 'unmon';
        var k = (n.kind || '') + ' ' + (n.service || '');
        if (/proxy|vhost|frontend|haproxy|webproxy|dnsdist|nginx/.test(k)) return 'ingress';
        if (/imap|smtp|milter|dovecot|postfix|mailbridge|lmtp/.test(k)) return 'mail';
        if (/dns|pdns/.test(k)) return 'dns';
        if (/pgbouncer|postgres|db/.test(k)) return 'db';
        return 'app';
      }
      function hdot(h) { return '<span class="svc-hdot ' + h + '">' + (h === 'unmon' ? '○' : '●') + '</span>'; }
      var loaded = false, raw = null;
      var filterEl = document.getElementById('svc-filter');

      function render(filter) {
        if (!raw) return;
        filter = (filter || '').trim().toLowerCase();
        var byService = {};
        (raw.nodes || []).forEach(function (n) { var s = n.service || '(unknown)'; (byService[s] = byService[s] || []).push(n); });
        var services = Object.keys(byService).sort();
        var html = services.map(function (s) {
          var inst = byService[s].slice().sort(function (a, b) { return (a.host || '').localeCompare(b.host || ''); });
          if (filter && s.toLowerCase().indexOf(filter) < 0
              && !inst.some(function (x) { return ((x.host || '') + ' ' + (x.address || '')).toLowerCase().indexOf(filter) >= 0; })) return '';
          var up = inst.filter(function (x) { return x.healthy === true; }).length;
          var down = inst.filter(function (x) { return x.healthy === false; }).length;
          var unmon = inst.filter(function (x) { return x.healthy == null; }).length;
          var meta = inst.length + ' host' + (inst.length !== 1 ? 's' : '') + ' · ' + up + ' up'
            + (down ? ' · <span class="dn">' + down + ' down</span>' : '') + (unmon ? ' · ' + unmon + ' unmon' : '');
          var cat = catOf(inst[0]), pkg = inst[0].package || '';
          var rows = inst.map(function (x) {
            var h = x.healthy === true ? 'up' : x.healthy === false ? 'down' : 'unmon';
            return '<tr><td>' + hdot(h) + ' ' + hlEsc(x.host || '?') + '</td>'
              + '<td class="muted">' + hlEsc(x.address || '—') + '</td>'
              + '<td class="muted">' + hlEsc(x.package || '') + '</td>'
              + '<td class="muted" style="max-width:26ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + hlEsc(x.description || '') + '">' + hlEsc(x.description || '') + '</td></tr>';
          }).join('');
          return '<div class="svc-item"><button type="button" class="svc-row" aria-expanded="false">'
            + '<span class="svc-caret">▸</span>'
            + '<span class="svc-badge" style="background:' + (CAT_FILL[cat] || '#48566b') + '">' + hlEsc(cat) + '</span>'
            + '<span class="svc-name">' + hlEsc(s) + '</span>'
            + (pkg ? '<span class="muted" style="font-size:0.78rem">' + hlEsc(pkg) + '</span>' : '')
            + '<span class="svc-meta">' + meta + '</span></button>'
            + '<div class="svc-detail" hidden><div style="overflow-x:auto"><table class="sessions"><thead><tr><th>Host</th><th>Address</th><th>Package</th><th>Detail</th></tr></thead><tbody>' + rows + '</tbody></table></div></div></div>';
        }).join('');
        out.innerHTML = html || '<p class="muted">No services match “' + hlEsc(filter) + '”.</p>';
        Array.prototype.forEach.call(out.querySelectorAll('.svc-row'), function (b) {
          b.addEventListener('click', function () {
            var det = b.nextElementSibling, open = b.getAttribute('aria-expanded') === 'true';
            b.setAttribute('aria-expanded', open ? 'false' : 'true');
            if (open) det.setAttribute('hidden', ''); else det.removeAttribute('hidden');
            b.querySelector('.svc-caret').textContent = open ? '▸' : '▾';
          });
        });
      }
      function load(force) {
        if (loaded && !force) return;
        loaded = true;
        out.innerHTML = '<p class="muted">Loading…</p>';
        fetch('/admin/topology', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.nodes || !d.nodes.length) { out.innerHTML = '<p class="muted">No service data yet.</p>'; return; }
            raw = d; render(filterEl.value);
          })
          .catch(function () { out.innerHTML = '<p class="muted">Could not load services.</p>'; });
      }
      filterEl.addEventListener('input', hlDebounce(function () { render(filterEl.value); }, 150));
      document.getElementById('svc-reload').addEventListener('click', function () { load(true); });
      var svcTab = document.querySelector('.admin-tabs button[data-atab="services"]');
      if (svcTab) svcTab.addEventListener('click', function () { load(false); });
      if ((location.hash || '').indexOf('admin:services') >= 0) load(false);
    })();

    // --- Fleet topology graph (admin, Cytoscape.js) ------------------
    // Lazy-loads the vendored graph library only when the Topology tab is
    // first opened. Designed to grow: node/edge data already carries
    // everything a future Prometheus overlay + remote-action panel needs.
    (function () {
      var container = document.getElementById('cy');
      if (!container) return;
      var EDGE_COLOR = { proxy: '#3562d4', http: '#8a93a3', mail: '#7c3aed', dns: '#0d9488', db: '#b45309' };
      var loaded = false, cy = null, lastData = null;

      function categoryOf(n) {
        if (!n.monitored) return 'unmon';
        var k = (n.kind || '') + ' ' + (n.service || '');
        if (/proxy|vhost|frontend|haproxy|webproxy|dnsdist/.test(k)) return 'ingress';
        if (/imap|smtp|milter|dovecot|postfix|mailbridge/.test(k)) return 'mail';
        if (/dns|pdns/.test(k)) return 'dns';
        if (/pgbouncer|postgres|db/.test(k)) return 'db';
        return 'app';
      }
      var CAT_FILL = { ingress: '#3562d4', app: '#48566b', mail: '#7c3aed', dns: '#0d9488', db: '#b45309', unmon: '#9aa3af' };
      var HEALTH_BORDER = { up: '#1f9d55', down: '#d1453b', unmon: '#c2c8d0' };

      function tooltip() {
        var t = document.getElementById('topo-tooltip');
        if (!t) { t = document.createElement('div'); t.id = 'topo-tooltip'; document.body.appendChild(t); }
        return t;
      }
      function detail(n) {
        var el = document.getElementById('topo-detail');
        if (!n) { el.innerHTML = '<p class="muted">Click a node for details.<br>Drag to pan, scroll to zoom.</p>'; return; }
        var hp = n.health === 'up' ? '<span class="st-pill up">● up</span>'
               : n.health === 'down' ? '<span class="st-pill down">✗ down / stale</span>'
               : '<span class="st-pill unmon">○ unmonitored</span>';
        el.innerHTML = '<h3>' + hlEsc(n.label) + '</h3>' + hp
          + '<dl>'
          + '<dt>Host</dt><dd>' + hlEsc(n.host) + (n.addr ? ' <span class="muted">(' + hlEsc(n.addr) + ')</span>' : '') + '</dd>'
          + (n.kind ? '<dt>Kind</dt><dd>' + hlEsc(n.kind) + '</dd>' : '')
          + (n.pkg ? '<dt>Package</dt><dd>' + hlEsc(n.pkg) + '</dd>' : '')
          + (n.desc ? '<dt>Description</dt><dd>' + hlEsc(n.desc) + '</dd>' : '')
          + '</dl>'
          + '<div class="soon"><strong>Metrics</strong> — Prometheus overlay coming soon (CPU / mem / request rate on hover).<br><br><strong>Remote actions</strong> — service restart' + (n.mon ? '' : '') + ' &amp; host reboot are planned here (site_admin, audited).</div>';
      }

      function build(data) {
        lastData = data;
        var ids = {}; (data.nodes || []).forEach(function (n) { ids[n.id] = 1; });
        var els = [];
        (data.nodes || []).forEach(function (n) {
          els.push({ data: {
            id: n.id, label: n.service, host: n.host, kind: n.kind || '', pkg: n.package || '',
            desc: n.description || '', addr: n.address || '', mon: !!n.monitored,
            health: (n.healthy === true ? 'up' : (n.healthy === false ? 'down' : 'unmon')),
            cat: categoryOf(n),
          } });
        });
        (data.edges || []).forEach(function (e, i) {
          if (!ids[e.from] || !ids[e.to]) return;
          els.push({ data: { id: 'e' + i, source: e.from, target: e.to, kind: e.kind || 'http' } });
        });

        if (cy) { cy.destroy(); cy = null; }
        cy = cytoscape({
          container: container,
          elements: els,
          wheelSensitivity: 0.2,
          layout: { name: 'grid' },   // placeholder; applyLayout() runs the chosen one
          style: [
            { selector: 'node', style: {
              'label': 'data(label)', 'font-size': '10px', 'color': '#fff', 'text-wrap': 'wrap',
              'text-max-width': '96px', 'text-valign': 'center', 'text-halign': 'center',
              'background-color': function (e) { return CAT_FILL[e.data('cat')] || '#48566b'; },
              'shape': 'round-rectangle', 'width': 'label', 'height': 'label', 'padding': '7px',
              'border-width': 3, 'border-color': function (e) { return HEALTH_BORDER[e.data('health')] || '#c2c8d0'; },
              'border-style': function (e) { return e.data('health') === 'unmon' ? 'dashed' : 'solid'; },
            } },
            { selector: 'node:selected', style: { 'border-width': 5, 'border-color': '#e8e8e8' } },
            { selector: 'edge', style: {
              'width': 2, 'curve-style': 'bezier', 'target-arrow-shape': 'triangle',
              'line-color': function (e) { return EDGE_COLOR[e.data('kind')] || '#8a93a3'; },
              'target-arrow-color': function (e) { return EDGE_COLOR[e.data('kind')] || '#8a93a3'; },
              'opacity': 0.75,
            } },
            { selector: 'edge:selected', style: { 'width': 4, 'opacity': 1 } },
          ],
        });
        applyLayout();
        var tip = tooltip();
        cy.on('tap', 'node', function (evt) { detail(evt.target.data()); });
        cy.on('tap', function (evt) { if (evt.target === cy) detail(null); });
        cy.on('mouseover', 'node', function (evt) {
          var d = evt.target.data();
          tip.innerHTML = '<strong>' + hlEsc(d.label) + '</strong> @' + hlEsc(d.host) + '<br>' + (d.desc ? hlEsc(d.desc) : '');
          tip.style.display = 'block';
        });
        cy.on('mousemove', 'node', function (evt) {
          var e = evt.originalEvent; tip.style.left = (e.clientX + 12) + 'px'; tip.style.top = (e.clientY + 12) + 'px';
        });
        cy.on('mouseout', 'node', function () { tip.style.display = 'none'; });
      }

      function applyLayout() {
        if (!cy) return;
        var name = document.getElementById('topo-layout').value, opts;
        if (name === 'breadthfirst') {
          // roots() = nodes with no incoming edges (the ingress layer) as a
          // real Cytoscape collection -- avoids fragile "#id" selectors on
          // ids containing / . @ : etc.
          opts = { name: 'breadthfirst', directed: true, roots: cy.nodes().roots(), spacingFactor: 1.15, padding: 24, avoidOverlap: true };
        } else if (name === 'cose') {
          opts = { name: 'cose', animate: false, padding: 24, nodeRepulsion: 9000, idealEdgeLength: 95, nodeOverlap: 16 };
        } else {
          opts = { name: 'grid', padding: 24, avoidOverlap: true };
        }
        cy.layout(opts).run();
      }
      var relayout = applyLayout;

      function load(force) {
        if (loaded && !force) return;
        loaded = true;
        container.innerHTML = '';
        var go = function () {
          fetch('/admin/topology', { headers: { 'Accept': 'application/json' } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
              if (!d || !d.nodes || !d.nodes.length) { container.innerHTML = '<p class="muted" style="padding:1rem">No topology data yet.</p>'; return; }
              build(d);
            })
            .catch(function () { container.innerHTML = '<p class="muted" style="padding:1rem">Could not load topology.</p>'; });
        };
        if (window.cytoscape) { go(); return; }
        var s = document.createElement('script');
        s.src = '/vendor/cytoscape.min.js';
        s.onload = go;
        s.onerror = function () { container.innerHTML = '<p class="muted" style="padding:1rem">Could not load the graph library.</p>'; };
        document.head.appendChild(s);
      }

      document.getElementById('topo-layout').addEventListener('change', relayout);
      document.getElementById('topo-fit').addEventListener('click', function () { if (cy) cy.fit(null, 30); });
      document.getElementById('topo-reload').addEventListener('click', function () { load(true); });

      // Fullscreen: expand the card over the whole viewport for a big,
      // readable canvas (it escapes the admin pane's max-width). Esc exits.
      var card = document.getElementById('topo-card');
      var fullBtn = document.getElementById('topo-full');
      function setFull(on) {
        if (!card) return;
        card.classList.toggle('topo-full', on);
        if (fullBtn) fullBtn.textContent = on ? '✕  Exit fullscreen' : '⛶ Fullscreen';
        document.body.style.overflow = on ? 'hidden' : '';
        // Give the layout a tick to settle, then resize the canvas + refit.
        setTimeout(function () { if (cy) { cy.resize(); cy.fit(null, 30); } }, 90);
      }
      if (fullBtn) fullBtn.addEventListener('click', function () { setFull(!card.classList.contains('topo-full')); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && card && card.classList.contains('topo-full')) setFull(false);
      });
      var tabBtn = document.querySelector('.admin-tabs button[data-atab="topology"]');
      if (tabBtn) tabBtn.addEventListener('click', function () { load(false); setTimeout(function () { if (cy) cy.resize(); }, 60); });
      if ((location.hash || '').indexOf('admin:topology') >= 0) load(false);
    })();

    // --- Metrics tab: curated fleet-health summary from Prometheus -------
    (function () {
      if (!document.querySelector('[data-metrics-root]')) return;
      function setCard(id, text, level) {
        var el = document.getElementById(id); if (!el) return;
        el.textContent = text;
        var card = el.closest('.mcard');
        if (card) { card.classList.remove('warn', 'crit', 'ok-v'); if (level) card.classList.add(level); }
      }
      function pct(v) { return (v == null) ? '—' : Math.round(v) + '%'; }
      function lvl(v, warn, crit) { if (v == null) return null; if (v >= crit) return 'crit'; if (v >= warn) return 'warn'; return 'ok-v'; }
      function load() {
        fetch('/admin/metrics/summary', { credentials: 'same-origin' })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
          .then(function (d) {
            setCard('m-hosts', (d.hosts_up || 0) + ' / ' + (d.hosts_total || 0), (d.hosts_up < d.hosts_total) ? 'crit' : 'ok-v');
            var sUp = (d.services_total || 0) - (d.services_down || 0);
            setCard('m-services', sUp + ' / ' + (d.services_total || 0), (d.services_down > 0) ? 'crit' : 'ok-v');
            setCard('m-probes', (d.probes_up || 0) + ' / ' + (d.probes_total || 0), (d.probes_up < d.probes_total) ? 'crit' : 'ok-v');
            var cert = (d.cert_days_min == null) ? null : Math.round(d.cert_days_min);
            setCard('m-cert', cert == null ? '—' : cert + ' d', cert == null ? null : (cert < 14 ? 'crit' : cert < 30 ? 'warn' : 'ok-v'));
            setCard('m-cpu', pct(d.cpu_max), lvl(d.cpu_max, 70, 90));
            setCard('m-mem', pct(d.mem_max), lvl(d.mem_max, 80, 92));
            setCard('m-disk', pct(d.disk_max), lvl(d.disk_max, 75, 90));
            var body = document.getElementById('metrics-hosts-body');
            if (body) {
              if (!d.hosts || !d.hosts.length) { body.innerHTML = '<tr><td colspan="4" class="muted">No host data.</td></tr>'; }
              else {
                body.innerHTML = d.hosts.map(function (h) {
                  function cell(v, warn, crit) { var n = (v == null) ? null : +v; var c = (n != null && n >= crit) ? ' class="hot"' : (n != null && n >= warn) ? ' class="warm"' : ''; return '<td' + c + '>' + (n == null ? '—' : n + '%') + '</td>'; }
                  return '<tr><td>' + h.host + '</td>' + cell(h.cpu, 70, 90) + cell(h.mem, 80, 92) + cell(h.disk, 75, 90) + '</tr>';
                }).join('');
              }
            }
            var down = document.getElementById('metrics-down');
            if (down) {
              if (d.services_down_list && d.services_down_list.length) {
                down.hidden = false;
                down.innerHTML = '<strong>' + d.services_down_list.length + ' service(s) down:</strong> ' +
                  d.services_down_list.map(function (s) { return s.host + '/' + s.service; }).join(', ');
              } else { down.hidden = true; }
            }
            var up = document.getElementById('metrics-updated'); if (up) up.textContent = new Date().toLocaleTimeString();
          })
          .catch(function () {
            var body = document.getElementById('metrics-hosts-body');
            if (body) body.innerHTML = '<tr><td colspan="4" class="muted">Metrics unavailable.</td></tr>';
          });
      }
      load();
      setInterval(load, 30000);
      var rf = document.getElementById('metrics-refresh');
      if (rf) rf.addEventListener('click', function (e) { e.preventDefault(); load(); });
    })();
  </script>
</body>
</html>
