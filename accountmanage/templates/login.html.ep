<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in — My Account</title>
  <style>
    body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: #f6f7f9; color: #1a1a1a;
           display: flex; min-height: 100vh; align-items: center; justify-content: center; padding: 1rem; }
    .box { background: #fff; border: 1px solid #e3e5e9; border-radius: 12px; padding: 2rem; max-width: 380px; width: 100%; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,.06); }
    h1 { font-size: 1.2rem; margin: 0 0 0.5rem; }
    p { color: #6b7280; font-size: 0.92rem; margin: 0 0 1.25rem; }
    .err { color: #d1453b; font-size: 0.9rem; margin-bottom: 1rem; }
    .btn { display: inline-block; background: #3562d4; color: #fff; text-decoration: none; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.95rem; }
    .btn:hover { background: #2a4fb0; }
  </style>
</head>
<body>
  <div class="box">
    <h1>🔐 My Account</h1>
% if (my $error = stash 'error') {
    <div class="err"><%= $error %></div>
% }
    <p>Manage your homelab account — profile, sessions, storage, and more.</p>
    <a class="btn" href="/login">Sign in with Homelab SSO</a>
  </div>
</body>
</html>
