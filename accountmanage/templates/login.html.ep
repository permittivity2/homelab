<!DOCTYPE html>
<html lang="en">
<head>
%# Shared theme, but NOT the shared header: there is no signed-in user here,
%# so a top bar would render an empty account cluster. A centred auth card is
%# the right chrome for this one page -- the logo carries the identity.
%= include 'homelab/head'
  <title>Sign in — My Account</title>
  <style>
    body {
      margin: 0; display: flex; min-height: 100vh;
      align-items: center; justify-content: center; padding: var(--space-4);
      background: var(--black-primary);
    }
    .box {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: var(--space-8) var(--space-6);
      max-width: 380px; width: 100%; text-align: center; box-shadow: var(--shadow-lg);
    }
    .box img { height: 32px; width: auto; margin-bottom: var(--space-6); }
    .box h1 { font-size: var(--app-lg); font-weight: var(--weight-light); letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-2); }
    .box p { color: var(--text-muted); font-size: var(--app-base); margin: 0 0 var(--space-6); line-height: var(--leading-normal); }
    .err {
      color: var(--error); font-size: var(--app-base); margin-bottom: var(--space-4);
      padding: var(--space-2) var(--space-3); border-radius: var(--radius-md);
      background: rgba(216,92,92,0.10); border: 1px solid rgba(216,92,92,0.35);
    }
    .foot { margin-top: var(--space-6); font-size: var(--app-xs); color: var(--text-muted); }
    .foot a { color: var(--silver-dim); }
  </style>
</head>
<body>
  <div class="box">
    <img src="<%= theme_base %>/logo.svg" alt="Silver Linings">
    <h1>My Account</h1>
% if (my $error = stash 'error') {
    <div class="err"><%= $error %></div>
% }
    <p>Manage your account — profile, sessions, storage, and more.</p>
    <a class="btn btn-primary" href="/login">Sign in with Homelab SSO</a>
    <div class="foot">A product of <a href="https://silverlinings.llc/">Silver Linings,&nbsp;LLC</a>.</div>
  </div>
</body>
</html>
