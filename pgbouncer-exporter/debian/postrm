#!/bin/sh
set -e
case "$1" in
    purge)
        rm -f /etc/homelab/services/pgbouncer-exporter.yml
        # Leave the pgbouncer stats user + include in place (removing them
        # would need another graceful reload on the SPOF's connection layer;
        # deliberately out of scope for purge).
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear) ;;
    *) echo "postrm called with unknown argument: $1"; exit 1 ;;
esac
exit 0
