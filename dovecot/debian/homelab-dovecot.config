#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/dovecot/conf.d/91-homelab-dovecot.conf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or
# re-bootstrap a role that's already live and in use. behind_haproxy is
# the one exception, same reasoning as homelab-postfix's enable_dkim:
# an already-working host must see zero unrelated config change on a
# routine upgrade, but this specific flag needs to be re-toggleable
# later (e.g. once homelab-haproxy is actually put in front of this
# host) without a full reinstall.
if [ -f "$MARKER" ]; then
    db_input medium homelab-dovecot/behind_haproxy || true
    db_go
    exit 0
fi

db_input high homelab-dovecot/db_host || true
db_input high homelab-dovecot/pgbouncer_host || true
db_input medium homelab-dovecot/mail_domain || true
db_input high homelab-dovecot/api_base || true
# High priority -- defaults to true and has a real, breaking consequence
# if answered without actually setting up homelab-haproxy (every direct
# IMAP/IMAPS login rejected), so a plain interactive install should see
# and understand it, not just someone who thinks to go looking via
# dpkg-reconfigure.
db_input high homelab-dovecot/behind_haproxy || true
db_go

exit 0
