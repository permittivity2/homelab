# Managed by homelab-dovecot -- do not hand-edit, edit debconf answers
# instead (dpkg-reconfigure homelab-dovecot). Purely additive: never
# modifies any vendor-shipped conf.d file. See CLAUDE.md's "unified
# cross-feature identity" design -- this SQL passdb queries homelab-api's
# own api.users table via a narrow, column-scoped grant (see
# script/homelab-dovecot-bootstrap-role), so the same Argon2id password
# authenticates both HTTP (homelab-drive) and IMAP/SMTP login.
#
# Dovecot 2.4 rewrote its config language in a genuinely incompatible way
# (Debian's own dovecot-core NEWS.Debian calls this out explicitly:
# "introduces an incompatible configuration language"). Every setting
# below was verified empirically against a live 2.4.2 instance (doveconf
# -n, doveadm auth test, and a real IMAPS login/select/append/search) --
# not copied from pre-2.4 documentation, which describes a syntax this
# version no longer accepts. See README.md's Gotchas section before
# changing anything here.

# Additive to Debian's stock `plain` mechanism (confirmed via doveconf:
# this MERGES rather than replaces -- effective auth_mechanisms ends up
# `plain xoauth2 oauthbearer`, not just the two below). Enables the
# XOAUTH2/OAUTHBEARER passdb further down.
auth_mechanisms {
  xoauth2 = yes
  oauthbearer = yes
}

sql_driver = pgsql

# The connection block's positional name IS the host dovecot connects
# to -- there is no separate `host = ` field for the pgsql driver
# (unlike the classic 2.3-era dovecot-sql.conf.ext examples still
# floating around, which don't apply to 2.4's syntax at all). Runtime
# traffic goes through PgBouncer (default port 6432), never straight to
# Postgres -- see CLAUDE.md.
pgsql __DB_HOST__ {
  parameters {
    port = __DB_PORT__
    dbname = __DB_NAME__
    user = __DB_USER__
    password = __DB_PASS__
  }
}

passdb sql {
  default_password_scheme = ARGON2ID
  query = SELECT email AS user, password_hash AS password FROM api.users WHERE email = '%{user}' AND active = true

  # Without these, a WRONG plain password doesn't stop the passdb chain
  # here -- Dovecot falls through to the oauth2 passdb below next
  # (declaration order isn't what determines this; see the XOAUTH2/
  # OAUTHBEARER comment on that passdb for why oauth2 still gets a
  # chance even after this one already gave a definitive answer), which
  # then tries to verify the "password" as an OAuth *password grant*
  # (a completely different, unconfigured flow -- this package has no
  # oauth2_grant_url) and errors out with "Invalid HTTP URL: Relative
  # HTTP URL not allowed", surfacing as a generic temp_fail that MASKS
  # the correct rejection that already happened right here. Explicitly
  # terminating the chain on this passdb's own result (success or
  # failure) prevents oauth2 from ever being reached for a plain-
  # mechanism attempt at all. `doveconf -n` shows nothing wrong either
  # way; only caught by comparing `doveadm auth test`'s reported code
  # (temp_fail vs a clean failure) before and after adding the oauth2
  # passdb below.
  result_success = return-ok
  result_failure = return-fail
}

# XOAUTH2/OAUTHBEARER support (Roundcube's native OAuth login uses this
# for real IMAP auth once it holds a homelab-sso-issued access token --
# see ../roundcube/README.md and ../sso/README.md) -- alongside, not
# instead of, the sql passdb above: this is purely additive, password
# logins are completely unaffected (see that passdb's own comment for
# the one interaction that DOES exist between the two).
#
# introspection_mode's valid values (`auth`, `get`, `post`, `local`) are
# NOT documented anywhere reachable from this host -- not in
# /usr/share/dovecot/conf.d/auth-oauth2.conf.ext (which only shows `get`
# and `local` in its own commented-out examples), not in any local man
# page. Found by extracting the literal enum string `:auth:get:post:local`
# out of the `/usr/lib/dovecot/auth` binary itself, then confirming each
# candidate's ACTUAL HTTP request shape by pointing introspection_url at
# a throwaway raw-socket listener that dumps whatever request it
# receives:
#   - `get`  -- string-concatenates the raw token onto the END of
#     introspection_url with NO separator and NO Authorization header
#     (`GET /probebogus-token-abc`) -- meant for providers like Google's
#     tokeninfo endpoint where the URL is pre-built ending in
#     `?access_token=`, not for a URL meant to receive a Bearer header.
#   - `post` -- sends `POST` with `token=<token>` as an
#     application/x-www-form-urlencoded body (RFC 7662-style
#     introspection) -- also not what homelab-api's introspect expects.
#   - `auth` -- sends a plain `GET` with `Authorization: Bearer <token>`
#     and an empty body -- this is the one that actually matches
#     homelab-api's `/api/v1/auth/introspect` contract (same shape
#     Homelab::Common::AuthClient::introspect already uses). Verified
#     end-to-end with a real homelab-api-issued JWT via a real raw IMAP
#     `AUTHENTICATE OAUTHBEARER` exchange (not just doveconf -n, not
#     just doveadm auth test -- see README.md's Gotchas section for why
#     that distinction has mattered every time in this package).
#   - `local` -- deliberately not used: it validates the JWT's signature
#     locally instead of calling out to homelab-api at all, which would
#     need an RS256 public key distributed to every mail host -- this
#     ecosystem's SSO design deliberately has no signing key to manage
#     in the first place (see ../sso/README.md), so `local` doesn't fit
#     here even though it would technically parse.
#
# A bogus/expired token IS correctly rejected (confirmed with a real
# invalid-token IMAP attempt) -- but reported as a generic `temp_fail`/
# "Temporary authentication failure" rather than a clean "authentication
# failed", because Dovecot's oauth2 module doesn't distinguish "the
# introspection endpoint said this token is invalid" from "the
# introspection endpoint itself is broken" -- both surface identically.
# The security property (bad token never gets in) holds either way; this
# is just a coarser error message than sql's own password-mismatch path,
# not a bug in this config.
oauth2 {
  introspection_url = "__API_BASE__/api/v1/auth/introspect"
  introspection_mode = auth
  username_attribute = email
}

passdb oauth2 {
}

# Shared vmail system uid/gid (created by postinst before this file is
# written), Maildir++ layout keyed by domain/user.
userdb static {
  fields {
    uid = vmail
    gid = vmail
    home = /var/mail/vhosts/%{user|domain}/%{user|username}
  }
}

mail_driver = maildir
mail_path = /var/mail/vhosts/%{user|domain}/%{user|username}

# Dovecot 2.4 split INBOX's location into its own setting
# (mail_inbox_path), independent of mail_path, defaulting to the legacy
# shared-spool convention /var/mail/%{user} (owned root:mail, not
# writable by vmail) if left unset. That default breaks ONLY INBOX --
# every other mailbox (Drafts/Sent/Junk/Trash) is unaffected, since
# those use mail_path directly -- with "Failed to autocreate mailbox:
# Permission denied", even though doveconf -n reports the config as
# fully valid either way. Only caught by a real IMAP SELECT INBOX.
#
# Explicitly setting mail_inbox_path to EMPTY does NOT fall back to
# mail_path either -- empirically, that resolves INBOX to a `.INBOX`
# Maildir++ subfolder instead of the per-user maildir ROOT, a different
# (also valid, but different and not what the rest of this ecosystem
# assumes) on-disk layout. The only way to get INBOX and every other
# folder sharing the same conventional maildir root is to set
# mail_inbox_path to the exact same value as mail_path, as below.
mail_inbox_path = /var/mail/vhosts/%{user|domain}/%{user|username}

# LMTP delivery (used by homelab-postfix's virtual_transport) over TCP,
# not the vendor default unix_listener -- avoids coupling this package
# to another package's chroot/socket-directory assumptions; the two
# packages coordinate only through this fixed loopback port, nothing
# filesystem-shaped. Bound to all interfaces because Dovecot 2.4's
# inet_listener block has no working per-listener bind-address setting
# found so far (`address = ...` errors as unknown; encoding it into the
# block's positional name like the pgsql driver block silently produces
# NO listener at all, found empirically) -- acceptable here only because
# nft's default-drop INPUT policy on every host in this project already
# has no allow rule for this port, so it's unreachable from outside
# regardless. Revisit if a real bind-address setting turns up later.
service lmtp {
  inet_listener lmtp {
    port = 24
  }
}

# Debian's own dovecot-core ships a DEFAULT `auth_username_format =
# %{user | username | lower}` for the lmtp protocol specifically (visible
# in a stock `doveconf -n` even before this package touches anything) --
# the `username` filter strips everything from the first `@` onward. That
# default is a reasonable choice for single-domain/system-user setups
# where Unix usernames never contain a domain, but it's wrong here: every
# userdb/passdb lookup in this package is keyed by FULL email address.
# Left unoverridden, EVERY LMTP delivery fails with "User doesn't exist"
# for an account that logs in over IMAP just fine seconds earlier --
# because LMTP's own userdb lookup silently queries just the local part
# ("dovecot-test") while IMAP's lookup correctly uses the whole address.
# `doveconf -n` shows nothing wrong either way; only caught by an actual
# LMTP delivery attempt, not by a login test.
protocol lmtp {
  auth_username_format = %{user}
}
