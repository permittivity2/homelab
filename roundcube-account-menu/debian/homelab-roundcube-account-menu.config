#!/bin/sh
set -e

. /usr/share/debconf/confmodule

db_input high homelab-roundcube-account-menu/myaccount_url || true
# Low: the shared-asset-host default is right for every fleet host, so this
# should not interrupt a normal install -- it exists to be overridable.
db_input low homelab-roundcube-account-menu/logo_url || true
db_go

exit 0
