#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/block-link/config.yml ]; then
    exit 0
fi

db_input high homelab-block-link/db_host || true
db_input high homelab-block-link/pgbouncer_host || true
db_input high homelab-block-link/api_base || true
db_input high homelab-block-link/listen_port || true
db_input high homelab-block-link/advertise_host || true
db_input high homelab-block-link/public_base_url || true
db_input medium homelab-block-link/link_ttl_days || true
db_go

exit 0
