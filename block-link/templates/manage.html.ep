% layout 'default';
% title 'Manage blocked addresses';
%# The page a link in a delivered email opens. Opening it never changes
%# anything (see README.md, "Why GET never mutates"); only Add to Block List
%# and, signed in, a row's unblock button do.
%#   $view        Visibility::view() -- mode owner | link | several, and the
%#                addresses this visitor may block (offer) or not (main)
%#   $add         $view->{offer} minus what is already on the block list
%#   $blocked     the signed-in account's block list, sorted (owner only)
%#   $list_error  the list could not be read just now
%#   $signed_in   the address signed in here, or ''
%#   $can_sign_in sign-in is configured
%#   $manage_url  myaccount's Mail section
%#   $token       the link's own token
% my $mode   = $view->{mode};
% my $login  = '/login?next=' . Mojo::Util::url_escape("/l/$token");
% my $count  = scalar @$blocked;
% (my $countf = $count) =~ s/(\d)(?=(?:\d{3})+\z)/$1,/g;
<h1>Manage blocked addresses</h1>
<div class="form-actions page-actions">
  <a class="btn" href="<%= $manage_url %>">Manage Account</a>
</div>

%# Every address this visitor may block has a row, and the ones already blocked
%# are hidden: unblocking one of them further down brings its row back, so it
%# can be blocked again from here, as a fresh visit would offer it.
% my %todo = map { lc($_->{address}) => 1 } @$add;
% if (@{ $view->{offer} }) {
<section id="add-section"<%== @$add ? '' : ' class="hide"' %>>
<form id="blockform" class="panel" data-token="<%= $token %>">
  <div class="panel__body stack">
    <p class="text-muted">This message was sent to the address<span id="add-es"><%= @$add == 1 ? '' : 'es' %></span> below. Uncheck any you do NOT want to block.</p>
    %# .check is inline-flex, so each one gets its own line, and its words sit
    %# in ONE span: as separate flex items they split into a column on a phone.
    % for my $cand (@{ $view->{offer} }) {
    %   my $open = $todo{ lc $cand->{address} };
    <div class="cand-row<%= $open ? '' : ' hide' %>" data-addr="<%= $cand->{address} %>"><label class="check"><input type="checkbox" name="block" value="<%= $cand->{address} %>"<%== $open ? ' checked' : ' disabled' %>> <span class="cand">Block mail to <strong><%= $cand->{address} %></strong></span></label></div>
    % }
    <div class="form-actions"><button type="submit" class="btn btn-primary">Add to Block List</button></div>
  </div>
</form>
</section>
% }
% if ($mode eq 'owner' && @{ $view->{offer} } && !@$add && !$list_error) {
<p id="add-done" class="banner banner--ok"><span>Everything this message was sent to is already on your block list.</span></p>
% }

% for my $cand (@{ $view->{main} }) {
%# One span: .banner is a flex box, and loose text beside a <strong> would
%# become separate flex items and break apart on a phone.
<p class="banner banner--info"><span>This message was sent to <strong class="cand"><%= $cand->{address} %></strong>, your account's main address. It can't be blocked: that would stop all of your mail.</span></p>
% }

% if ($mode eq 'several') {
<div class="panel"><div class="panel__body stack">
  % if (length $signed_in) {
  <p>This message went to more than one account, and you're signed in as <strong class="cand"><%= $signed_in %></strong>, which isn't one of them.</p>
  % } elsif ($can_sign_in) {
  <p>This message went to more than one account, so its addresses aren't shown until you sign in. Signed in, you'll see the ones that are yours.</p>
  <div class="form-actions"><a class="btn btn-primary" href="<%= $login %>">Sign in</a></div>
  % } else {
  <p>This message went to more than one account, so its addresses aren't shown here. Your own block list is in Manage Account.</p>
  % }
</div></div>
% }

<div id="msg" role="status" aria-live="polite"></div>

<section id="blocklist-section" class="panel">
  <div class="panel__head">
    <h2 class="panel__title">Your block list</h2>
    % if ($mode eq 'owner' && !$list_error) {
    <span id="bl-count" class="text-muted bl-count"><%= $count == 1 ? '1 address' : "$countf addresses" %></span>
    % }
  </div>
  <div class="panel__body">
  % if ($mode eq 'owner' && $list_error) {
    <p class="text-muted">Your block list couldn't be loaded just now. Reload the page to try again, or use Manage Account.</p>
  % } elsif ($mode eq 'owner') {
    <div class="toolbar">
      <button type="button" id="bl-sort" class="btn btn-sm" title="Change the order">Sort: A &rarr; Z</button>
      <label class="sr-only" for="bl-filter">Filter the list</label>
      <input type="search" id="bl-filter" class="form-input" autocomplete="off" spellcheck="false"
             placeholder="Filter, e.g. ^shop" aria-describedby="bl-filter-hint">
    </div>
    <p id="bl-filter-hint" class="form-hint">A Perl-style regular expression; it starts filtering at 3 characters and ignores case.</p>
    %# The script gives each row its unblock button; data-csrf is what an
    %# unblock sends back to show it came from this page.
    <ul id="bl-list" class="blocklist" data-token="<%= $token %>" data-csrf="<%= csrf_token %>">
    % for my $addr (@$blocked) {
      <li data-addr="<%= $addr %>"><span class="bl-addr"><%= $addr %></span></li>
    % }
    </ul>
    <p id="bl-none" class="text-muted<%= @$blocked ? ' hide' : '' %>">Your block list is empty.</p>
    <p id="bl-nomatch" class="text-muted hide">No blocked address matches that filter.</p>
  % } elsif (length $signed_in) {
    <p class="text-muted">This link is for another account, so your own block list isn't shown here.</p>
  % } elsif ($can_sign_in) {
    <p class="text-muted">Sign in to see every address you've blocked, sort it and filter it.</p>
    <div class="form-actions"><a class="btn btn-primary" href="<%= $login %>">Sign in to see your block list</a></div>
  % } else {
    <p class="text-muted">Your whole block list is in Manage Account.</p>
  % }
  </div>
</section>

<div class="form-actions page-actions">
  <a class="btn" href="<%= $manage_url %>">Manage Account</a>
</div>

% if ($mode eq 'owner' && !$list_error) {
%# The question a row's unblock button asks first, in the shared theme's modal
%# (homelab-webtheme's shell.js opens it, traps focus in it and closes it on
%# Escape or a click outside). Cancel comes first, so it is what has focus.
<div class="modal" id="bl-confirm" role="dialog" aria-modal="true" aria-labelledby="bl-confirm-title">
  <div class="modal__head"><h2 id="bl-confirm-title" class="panel__title">Unblock this address?</h2></div>
  <div class="modal__body stack">
    <p><strong id="bl-confirm-addr" class="cand"></strong></p>
    <p class="text-muted">Mail sent to it will be delivered to you again.</p>
  </div>
  <div class="modal__foot">
    <button type="button" class="btn" data-modal-close>Cancel</button>
    <button type="button" class="btn btn-primary" id="bl-confirm-yes">Unblock</button>
  </div>
</div>
% }

<script>
%= include 'blocklist', format => 'js'
BlockList.wire(document);
</script>
