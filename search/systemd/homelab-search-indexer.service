[Unit]
Description=Homelab search indexer (mail + drive -> Postgres full-text index)
Documentation=file:///usr/share/doc/homelab-search/README.md
After=network-online.target srv-mail\x2dro.mount srv-drive\x2dro.mount
Wants=network-online.target

[Service]
Type=simple
# RUNS AS uid 5000 (vmail), the owner of the mail store, and this is not
# interchangeable with "a member of group 5000".
#
# The store has TWO permission modes on account directories: 21 are 0770
# vmail:vmail and 5 are 0700 vmail:vmail. Dovecot creates new maildirs 0700 by
# default, so group membership reads the older accounts and silently misses
# every newly created one -- which is how dmarc-reports, johnboy002,
# smoketest, routingprobe* and an e2e test account went unindexed while
# everything looked finished. That gap would have grown with every new
# mailbox.
#
# The NAS also has manage-gids=y, which makes the server resolve groups
# locally by uid and discard the client's supplementary group list, so a
# supplementary gid of 5000 buys nothing over NFS either. Presenting uid 5000
# is what actually works.
#
# This does NOT make the store writable: for these three hosts the export is
# `ro=` on the SERVER (see install-orchestrators/search-hosts-nfs.sh), so
# writes are refused whatever identity we present. That is exactly why the
# read-only grant was put on the server side rather than relying on a client
# mount option.
User=vmail
Group=vmail
# homelab as a supplementary group for the LOCAL config file
# (/etc/homelab/search/config.yml is root:homelab 0640, and holds the DB
# password). Supplementary groups work normally on a local filesystem; the
# manage-gids problem is specific to NFS.
SupplementaryGroups=homelab
ExecStart=/usr/bin/homelab-search-indexer
Restart=always
RestartSec=10
# Indexing must never starve dovecot or drive of NAS I/O.
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Read-only even to this process: it has no business writing either store.
ReadOnlyPaths=/srv/mail-ro /srv/drive-ro

[Install]
WantedBy=multi-user.target
