#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/search/config.yml ]; then
    exit 0
fi

db_input high homelab-search/db_host || true
db_input high homelab-search/pgbouncer_host || true
db_input high homelab-search/mail_root || true
db_input high homelab-search/drive_root || true
db_input high homelab-search/listen_port || true
db_input high homelab-search/sso_base || true
db_input high homelab-search/sso_internal_base || true
db_input high homelab-search/sso_secret || true
db_input high homelab-search/public_base_url || true
db_input high homelab-search/api_base || true
db_go

exit 0
