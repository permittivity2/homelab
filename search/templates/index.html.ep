% layout 'default';
% title 'Search';
%# Sizes and dates are formatted by the human_size/short_date HELPERS, not by
%# subs defined here: a template is compiled without the `signatures` feature,
%# so `sub ($x) {...}` in an .ep is a prototype and $x is an undeclared global.
%# The raw values still go out unformatted in the JSON that homelab-cli reads.

%# ONE question up front, everything else folded away.
%#
%# The first version put six controls and three checkboxes on the page at
%# once. On a phone that is a wall of form before you reach a single result,
%# and the honest feedback was "way too busy". A search page should ask one
%# question; the filters are for the second attempt, not the first.
%#
%# The disclosure opens automatically when a filter is actually in use, so a
%# narrowed search never hides why it is narrowed.
% my $filters_on = (length($f->{person}) || length($f->{from}) || length($f->{to})
%                || length($f->{mailbox}) || length($f->{mime})
%                || @{ $f->{type_in} // [] } || @{ $f->{type_ex} // [] }
%                || $f->{has_attachments} || $f->{in_trash} || $f->{source} ne 'both') ? 1 : 0;
<form class="searchbar" method="get" action="/">
  <div class="askrow">
    <input type="text" id="q" name="q" value="<%= $f->{q} %>" autofocus
           aria-label="Search your email and files"
           placeholder="Search your email and files">
    <button class="btn btn-primary" type="submit">Search</button>
  </div>

  <details class="filters"<%= $filters_on ? ' open' : '' %>>
    <summary>Filters<%= $filters_on ? ' (active)' : '' %></summary>
    <div class="fgrid">
      <div class="field" data-only="mail">
        <label for="person">From / to</label>
        <input type="text" id="person" name="person" value="<%= $f->{person} %>" placeholder="name or address">
      </div>
      <div class="field">
        <label for="source">Source</label>
        <select id="source" name="source">
% for my $s (['both','Mail and files'],['mail','Mail only'],['drive','Files only']) {
          <option value="<%= $s->[0] %>"<%= $f->{source} eq $s->[0] ? ' selected' : '' %>><%= $s->[1] %></option>
% }
        </select>
      </div>
      <div class="field">
        <label for="from">From date</label>
        <input type="date" id="from" name="from" value="<%= $f->{from} %>">
      </div>
      <div class="field">
        <label for="to">To date</label>
        <input type="date" id="to" name="to" value="<%= $f->{to} %>">
      </div>
      <div class="field" data-only="mail">
        <label for="mailbox">Mailbox</label>
        <select id="mailbox" name="mailbox">
          <option value="">Any mailbox</option>
% for my $mb (@$mailboxes) {
%   # Maildir++ folder names are long ('.Tax Audit.Tax Year 2020'); the full
%   # name stays the value, only the label is shortened. An option wider than
%   # the viewport is what made the page scroll sideways.
%   my $lbl = $mb->{name}; $lbl =~ s/^\.//; $lbl =~ s/\./ \/ /g;
%   $lbl = substr($lbl, 0, 22) . '…' if length($lbl) > 23;
          <option value="<%= $mb->{name} %>"<%= $f->{mailbox} eq $mb->{name} ? ' selected' : '' %>><%= $lbl %> (<%= $mb->{n} %>)</option>
% }
        </select>
      </div>
%# File type: tick what you want, leave it empty for everything.
%#
%# This started as two multi-selects, include and exclude. Both halves were
%# wrong. A <select multiple> is a power-user control -- you have to know to
%# Ctrl-click, and on a phone it is a modal list -- and "include" beside
%# "exclude" asks the reader to hold two opposite ideas at once to answer one
%# question. Checkboxes say the whole thing without a legend: what is ticked
%# is what you get, nothing ticked means no filter at all. Excluding a type
%# is still possible through the API and homelab-cli's --exclude-type, where
%# the reader is already holding a manual.
%#
%# The groups come from Homelab::Search::Mime in display order: the few
%# people actually reach for, then the rest alphabetically.
% my %tin = map { $_ => 1 } @{ $f->{type_in} // [] };
%
%# Specific types are the ones THIS account really has, grouped under the
%# same headings as the checkboxes above them, so "Pictures" and the three
%# image types it covers are visibly the same thing at two depths. Folded
%# away, because most searches never need it.
% my (%by_cat, @ungrouped);
% for my $mf (@$mime_facets) {
%   my $k = Homelab::Search::Mime::classify($mf->{mime});
%   if (defined $k) { push @{ $by_cat{$k} }, $mf } else { push @ungrouped, $mf }
% }
% my $n_specific = scalar grep { $tin{$_->{mime}} } @$mime_facets;
      <div class="field tfield">
        <span class="flabel">File type</span>
        <div class="cats">
% for my $cat (@$mime_cats) {
          <label class="chk"><input type="checkbox" name="type_in" value="cat:<%= $cat->{key} %>"
                 data-cat="<%= $cat->{key} %>"
                 data-types="<%= join(',', @{ $cat->{types} }) %>"
                 data-mimes="<%= join(',', @{ $cat->{pairs} }) %>"
                 <%= $tin{'cat:' . $cat->{key}} ? 'checked' : '' %>><span><%= $cat->{label} %></span></label>
% }
        </div>
% if (@$mime_facets) {
        <details class="specific"<%= $n_specific ? ' open' : '' %>>
          <summary>Specific types<%= $n_specific ? " ($n_specific selected)" : '' %></summary>
          <div class="leafwrap">
% for my $cat (@$mime_cats) {
%   next unless $by_cat{ $cat->{key} };
            <div class="leafgroup">
              <h5><%= $cat->{label} %></h5>
%   for my $mf (@{ $by_cat{ $cat->{key} } }) {
              <label class="chk"><input type="checkbox" name="type_in" value="<%= $mf->{mime} %>"
                     data-leaf="<%= $cat->{key} %>"<%= $tin{$mf->{mime}} ? ' checked' : '' %>><span><%= $mf->{mime} %> <em><%= $mf->{n} %></em></span></label>
%   }
            </div>
% }
% if (@ungrouped) {
            <div class="leafgroup">
              <h5>Other</h5>
% for my $mf (@ungrouped) {
              <label class="chk"><input type="checkbox" name="type_in" value="<%= $mf->{mime} %>"
                     data-leaf=""<%= $tin{$mf->{mime}} ? ' checked' : '' %>><span><%= $mf->{mime} %> <em><%= $mf->{n} %></em></span></label>
% }
            </div>
% }
          </div>
        </details>
% }
        <p class="fnote">Leave every box clear to search all types. On email, a
          type matches the message's <em>attachments</em>.</p>
      </div>
    </div>
    <div class="checks">
      <label data-only="mail"><input type="checkbox" name="has_attachments" value="1"<%= $f->{has_attachments} ? ' checked' : '' %>> Has attachments</label>
      <label data-only="drive"><input type="checkbox" name="in_trash" value="1"<%= $f->{in_trash} ? ' checked' : '' %>> Search trash instead</label>
      %# Rendered and disabled on purpose: the product has to be useful with
      %# the model switched off, so this only says the other mode is coming.
      <label class="aioff" title="Not available yet"><input type="checkbox" disabled> AI search <span class="hint">(coming)</span></label>
    </div>
  </details>
</form>

%# Grey out the filters that cannot apply to the chosen source. Mailbox,
%# sender and "has attachments" mean nothing for a file; file type and trash
%# mean nothing for a message. Leaving them live invites a search that
%# silently ignores half of what was typed.
%#
%# Presentational only -- the server already ignores a filter that does not
%# apply to the source it is querying, so a browser with JS off loses the
%# visual cue and nothing else. Drive's own search box carries a copy of
%# this; keep the two in step.
<script>
(function () {
  var src = document.getElementById('source');
  if (!src) return;
  function sync() {
    var v = src.value;
    document.querySelectorAll('[data-only]').forEach(function (el) {
      var applies = (v === 'both') || (el.getAttribute('data-only') === v);
      el.style.opacity = applies ? '' : '0.4';
      el.querySelectorAll('input, select').forEach(function (c) {
        c.disabled = !applies;
        c.title = applies ? '' : 'Not applicable when searching ' +
          (v === 'drive' ? 'files only' : 'mail only');
      });
    });
  }
  src.addEventListener('change', sync);
  sync();
})();

// Keep the category checkboxes and the specific types underneath them
// telling the same story.
//
// Both submit the same parameter, so the server sees a union either way and
// this script is a convenience, not a requirement -- with JavaScript off the
// boxes still filter exactly as they are ticked. What it adds: ticking
// "Pictures" ticks the image types it covers, so you can SEE what the group
// means, and un-ticking one of them drops the group (leaving its siblings
// ticked) rather than silently contradicting it -- the group would otherwise
// go on matching the type you just said you did not want.
(function () {
  var cats = document.querySelectorAll('input[data-cat]');
  if (!cats.length) return;

  function leavesOf(cat) {
    var types = (cat.getAttribute('data-types') || '').split(',').filter(Boolean);
    var mimes = (cat.getAttribute('data-mimes') || '').split(',').filter(Boolean);
    return Array.prototype.filter.call(
      document.querySelectorAll('input[data-leaf]'),
      function (leaf) {
        var v = leaf.value;
        if (mimes.indexOf(v) !== -1) return true;
        return types.some(function (t) { return v.indexOf(t + '/') === 0 });
      });
  }

  cats.forEach(function (cat) {
    cat.addEventListener('change', function () {
      leavesOf(cat).forEach(function (leaf) { leaf.checked = cat.checked });
      count();
    });
  });

  document.querySelectorAll('input[data-leaf]').forEach(function (leaf) {
    leaf.addEventListener('change', function () {
      if (!leaf.checked) {
        cats.forEach(function (cat) {
          if (cat.checked && leavesOf(cat).indexOf(leaf) !== -1) cat.checked = false;
        });
      }
      count();
    });
  });

  // The summary carries the count because the list is collapsed by default:
  // a filter you cannot see is a filter you forget you set.
  function count() {
    var sum = document.querySelector('details.specific > summary');
    if (!sum) return;
    var n = document.querySelectorAll('input[data-leaf]:checked').length;
    sum.textContent = 'Specific types' + (n ? ' (' + n + ' selected)' : '');
  }
})();
</script>

% if (($counts->{messages} // 0) || ($counts->{drive_items} // 0)) {
<p class="counts"><%= $counts->{messages} // 0 %> messages and <%= $counts->{drive_items} // 0 %> files indexed for you.</p>
% }

% unless ($account) {
  <p class="empty">Nothing of yours has been indexed yet. If you have just signed up, give the indexer a few minutes.</p>
% } elsif (!$searched) {
  <p class="empty">Type something above to search your mail and files together.</p>
% } else {

% if ($f->{source} ne 'drive') {
  <h2 class="sec">Email — <%= scalar @$mail %> result<%= @$mail == 1 ? '' : 's' %></h2>
  <div class="res">
% for my $m (@$mail) {
    <div class="hit">
      <div class="t">
        <span class="subj"><%= length($m->{subject} // '') ? $m->{subject} : '(no subject)' %></span>
        <span class="meta"><%= $m->{mailbox} %> · <%= short_date($m->{sent_at} // $m->{received_at}) %><%= $m->{has_attachments} ? ' · attachment' : '' %></span>
      </div>
      <div class="who"><%= $m->{from_name} || $m->{from_addr} || '(unknown sender)' %><%= $m->{from_name} && $m->{from_addr} ? " <$m->{from_addr}>" : '' %></div>
% if (length($m->{snippet} // '')) {
      <div class="snip"><%= $m->{snippet} %></div>
% }
      %# Email gets BOTH a dropdown preview and a download, per the rendering
      %# contract. The preview is server-rendered text -- a stranger's HTML is
      %# never rendered as HTML here.
      <details class="pv">
        <summary>Preview</summary>
        <iframe src="/mail/<%= $m->{message_id} %>/preview" sandbox loading="lazy" title="Message preview"></iframe>
      </details>
      <div class="acts">
        <a href="/mail/<%= $m->{message_id} %>/download">Download .eml</a>
        <span class="hint"><%= human_size($m->{size_bytes}) %></span>
      </div>
    </div>
% }
% unless (@$mail) {
    <p class="empty">No matching email.</p>
% }
  </div>
% }

% if ($f->{source} ne 'mail') {
  <h2 class="sec">Files — <%= scalar @$drive %> result<%= @$drive == 1 ? '' : 's' %></h2>
  <div class="res">
% for my $d (@$drive) {
%   my $mime = $d->{mime_type} // '';
%   # Asks the same function the server uses to decide, so the link offered
%   # and the response given can never disagree. See Homelab::Search::Serve.
%   my $viewable = viewable($mime);
    <div class="hit">
      <div class="t">
        <span class="subj"><%= $d->{file_name} %></span>
        <span class="meta"><%= $mime %> · <%= human_size($d->{size_bytes}) %> · <%= short_date($d->{content_created_at} // $d->{uploaded_at}) %></span>
      </div>
% if (length($d->{folder_path} // '')) {
      <div class="who">in <%= $d->{folder_path} %></div>
% }
% if (length($d->{snippet} // '')) {
      <div class="snip"><%= $d->{snippet} %></div>
% }
      <div class="acts">
% if ($viewable) {
        <a href="/drive/<%= $d->{drive_item_id} %>/view" target="_blank" rel="noopener noreferrer">Open</a>
% }
        <a href="/drive/<%= $d->{drive_item_id} %>/download">Download</a>
% unless ($viewable) {
        <span class="hint">download only</span>
% }
% if ($d->{deleted_at}) {
        <span class="hint">in trash</span>
% }
      </div>
    </div>
% }
% unless (@$drive) {
    <p class="empty">No matching files.</p>
% }
  </div>
% }

% }
