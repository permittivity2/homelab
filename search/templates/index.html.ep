% layout 'default';
% title 'Search';
%# Sizes and dates are formatted by the human_size/short_date HELPERS, not by
%# subs defined here: a template is compiled without the `signatures` feature,
%# so `sub ($x) {...}` in an .ep is a prototype and $x is an undeclared global.
%# The raw values still go out unformatted in the JSON that homelab-cli reads.

%# ONE question up front, everything else folded away.
%#
%# The first version put six controls and three checkboxes on the page at
%# once. On a phone that is a wall of form before you reach a single result,
%# and the honest feedback was "way too busy". A search page should ask one
%# question; the filters are for the second attempt, not the first.
%#
%# The disclosure opens automatically when a filter is actually in use, so a
%# narrowed search never hides why it is narrowed.
%#
%# $filters_on ARRIVES FROM THE CONTROLLER and is not re-derived here. The
%# near-copy that used to live on this line had different members from the
%# controller's own list, and the day they disagreed a tag link filtered
%# the page, opened the panel to show the filter, and returned nothing --
%# because the controller's copy had never heard of tags and so never ran
%# the query. One list, in App.pm, with the one deliberate difference
%# documented there.
%#
%# ...BUT ONLY AS THE OPENING GUESS. The rule above is right the first time
%# and wrong every time after, because a filter STICKS: the form re-renders
%# whatever is set, so the condition keeps firing. Untick Email once and the
%# panel reopens on every search from then until you clear it -- which reads
%# as "it always opens", because from the outside it is indistinguishable.
%#
%# It also got the opposite case wrong once the panel grew its own Search
%# buttons: searching from inside an open panel with nothing set snapped it
%# shut, since the open state was never carried across the request.
%#
%# So the state is REMEMBERED. `fopen` rides along in a hidden field the
%# toggle keeps in sync, and it wins when present. Absent -- a first visit,
%# a bookmarked url, a People link, or any browser with the script off --
%# the derived guess above still applies, so a narrowed search arriving from
%# somewhere else still shows its own reason.
% my $fopen = $c->param('fopen');
% my $panel_open = (defined $fopen && length $fopen) ? ($fopen eq '1' ? 1 : 0) : $filters_on;
% my $want_mail  = $f->{source} ne 'drive';
% my $want_drive = $f->{source} ne 'mail';
<form class="searchbar" method="get" action="/">
  <div class="askrow">
    <input type="text" id="q" name="q" value="<%= $f->{q} %>" autofocus
           aria-label="Search your email and files"
           placeholder="Search your email and files">
    <button class="btn btn-primary" type="submit">Search</button>
    %#  AI SEARCH IS A BUTTON, not a mode you leave switched on. A named
    %#  submit button sends its name only when it is the button that
    %#  submitted, so `ai=1` rides along with this one and not the other --
    %#  no script, no hidden field, and nothing to forget to untick.
    %#
    %#  Three states, because they are three different situations and one of
    %#  them is not the user's fault. The no-consent button OPENS THE NOTICE
    %#  instead of searching: consent is a decision, and a misclick is not
    %#  one. It carries no `name`, so even if the script is off it cannot
    %#  submit `ai=1` -- and the server re-checks consent regardless.
% if (!$ai_state->{available}) {
    <button class="btn btn-ai" type="button" disabled title="Not configured on this server">AI Search</button>
% } elsif (!$ai_state->{consented}) {
    <button class="btn btn-ai ai-ask" type="button">AI Search</button>
% } else {
    <button class="btn btn-ai" type="submit" name="ai" value="1">AI Search</button>
% }
  </div>

  %#  Outside the <details> on purpose: this is the panel's own state, not
  %#  one of the filters in it.
  <input type="hidden" name="fopen" id="fopen" value="<%= $panel_open %>">

  <details class="filters" id="filterPanel"<%= $panel_open ? ' open' : '' %>>
    <summary><span>Filters</span><span class="sum-active" id="sumActive"></span></summary>

    <div class="panel">

      %# SEARCH IN comes first and governs what follows, so cause and effect
      %# are adjacent. A section that cannot apply is REMOVED below, not
      %# dimmed: greying asks the reader to work out why something is grey
      %# and what would bring it back, which on the drive page meant three
      %# dead controls out of seven.
      <section class="fsec">
        <h3 class="fsec-h">Search in</h3>
        <div class="row-chk">
          <label class="box"><input type="checkbox" name="src" value="mail" id="srcMail"<%= $want_mail ? ' checked' : '' %>><span>Email</span></label>
          <label class="box"><input type="checkbox" name="src" value="drive" id="srcDrive"<%= $want_drive ? ' checked' : '' %>><span>Files</span></label>
        </div>
        <p class="note warn" id="srcNote" hidden>Neither is selected, so this searches both.</p>
      </section>

      %# Most date filtering is relative, so five presets answer it in one
      %# click. The two inputs underneath are the no-JavaScript path and the
      %# exact-dates path at once -- nothing here is script-only.
      <section class="fsec">
        <h3 class="fsec-h">Date</h3>
        <div class="chips" id="dateChips" role="group" aria-label="Date range">
% my $custom = (length($f->{from}) || length($f->{to})) ? 1 : 0;
          <label class="chip"><input type="radio" name="dpreset" value=""<%= $custom ? '' : ' checked' %>><span>Any time</span></label>
          <label class="chip"><input type="radio" name="dpreset" value="7"><span>Past week</span></label>
          <label class="chip"><input type="radio" name="dpreset" value="30"><span>Past month</span></label>
          <label class="chip"><input type="radio" name="dpreset" value="365"><span>Past year</span></label>
          <label class="chip"><input type="radio" name="dpreset" value="custom"<%= $custom ? ' checked' : '' %>><span>Exact dates</span></label>
        </div>
        <div class="daterow" id="dateRow"<%= $custom ? '' : ' hidden' %>>
          <div class="field"><label class="lab" for="from">From</label><input type="date" id="from" name="from" value="<%= $f->{from} %>"></div>
          <span class="sep">to</span>
          <div class="field"><label class="lab" for="to">To</label><input type="date" id="to" name="to" value="<%= $f->{to} %>"></div>
        </div>
      </section>

      %# PERSON, which is SHARED -- and that is not a tidy-up, it is where
      %# "photos with Jeff" went missing. One `person` parameter has always
      %# driven two different lookups: mail participants on the mail side,
      %# and an indexed join through the tagged faces of the owner's own
      %# photos on the file side. It sat in the Email-only section under the
      %# label "From or to", so the file half was both mislabelled and
      %# `hidden` the moment Email was unticked -- the one state in which a
      %# person is searching only their photos.
      %#
      %# Shared, like Type, which also means something different per source.
      <section class="fsec">
        <h3 class="fsec-h">Person</h3>
        <div class="fields">
          <div class="field">
            <label class="lab" for="person">Name or address</label>
            <input type="text" id="person" name="person" value="<%= $f->{person} %>" placeholder="e.g. Dana Whitfield">
          </div>
        </div>
        <p class="note" id="personNote"><span id="personNoteMail">On email, matches
          <em>from</em>, <em>to</em> and <em>cc</em>.</span><span id="personNoteDrive">
          On files, matches the people <em>tagged in your photos</em>.</span></p>
      </section>

      %# TYPE. Chips rather than checkboxes: fourteen 18px boxes is a lot of
      %# small targets, and a filled chip reads across the panel where a tick
      %# does not.
      %#
      %# A chip is a SELECT-ALL for the exact types it covers, and goes half
      %# selected when you untick one of them. That is not decoration: the
      %# server UNIONs these tokens, so `cat:pictures` + `image/jpeg` means
      %# all pictures, and ticking an exact type under a ticked family used
      %# to be a silent no-op -- the panel invited you to narrow and then
      %# widened. Chip and types are one control now.
% my %tin = map { $_ => 1 } @{ $f->{type_in} // [] };
      <section class="fsec">
        <h3 class="fsec-h">Type</h3>
        <div class="chips" id="catChips">
% for my $cat (@$mime_cats) {
          <label class="chip"><input type="checkbox" name="type_in" value="cat:<%= $cat->{key} %>"
                 data-cat="<%= $cat->{key} %>"
                 data-types="<%= join(',', @{ $cat->{types} }) %>"
                 data-mimes="<%= join(',', @{ $cat->{pairs} }) %>"
                 <%= $tin{'cat:' . $cat->{key}} ? 'checked' : '' %>><span><%= $cat->{label} %></span></label>
% }
        </div>

%# The exact types THIS account really has, grouped under the same headings
%# as the chips. A type appears under every family it belongs to -- text/csv
%# under Text and under Spreadsheets -- because filing it once is what hid
%# text/calendar from anyone who ticked Calendar. Only the first copy carries
%# a form name, so one type is never submitted twice.
% if (@$mime_groups) {
        <details class="specific" id="specific">
          <summary><span id="specSum">Narrow to an exact type</span></summary>
          <p class="note leadnote" id="specLead">Every exact type in your index. Tick a broad type above to narrow this list to just that family.</p>
          <div class="leafwrap">
% my %named;
% for my $g (@$mime_groups) {
            <div class="leafgroup" data-group="<%= $g->{key} %>">
              <h5><%= $g->{label} %></h5>
% for my $r (@{ $g->{rows} }) {
              <label class="leaf" title="<%= $r->{mime} %>"><input type="checkbox"<% if (!$named{$r->{mime}}++) { %> name="type_in"<% } %> value="<%= $r->{mime} %>" data-mime="<%= $r->{mime} %>"
                     data-drive="<%= $r->{drive_n} // 0 %>" data-mail="<%= $r->{mail_n} // 0 %>"<%= $tin{$r->{mime}} ? ' checked' : '' %>><span class="m"><%= $r->{label} %><% if (length $r->{ext}) { %> <em class="ext"><%= $r->{ext} %></em><% } %><% if ($r->{qualify}) { %> <em class="qual"><%= $r->{qualify} %></em><% } %></span><span class="n"><%= commify($r->{n}) %></span></label>
% }
            </div>
% }
          </div>
          <p class="note leafempty" id="specEmpty" hidden>Your index has nothing of that type yet.</p>
        </details>
% }

        <p class="note" id="typeNote">Nothing selected searches every type.
          <span id="typeNoteMail">On email, a type matches the message&rsquo;s
          <em>attachments</em>.</span></p>
      </section>

      %# Each source's own controls live with that source. "Has attachments"
      %# used to sit in a row at the bottom, three controls away from Mailbox
      %# and next to a files-only option.
      <section class="fsec" data-when="mail" id="secMail"<%= $want_mail ? '' : ' hidden' %>>
        <h3 class="fsec-h">Email only</h3>
        <div class="fields">
          <div class="field">
            <label class="lab" for="mailbox">Mailbox</label>
            <select id="mailbox" name="mailbox">
              <option value="">Any mailbox</option>
% for my $mb (@$mailboxes) {
%   # Maildir++ folder names are long ('.Tax Audit.Tax Year 2020'); the full
%   # name stays the value, only the label is shortened. An option wider than
%   # the viewport is what made the page scroll sideways.
%   my $lbl = $mb->{name}; $lbl =~ s/^\.//; $lbl =~ s/\./ \/ /g;
%   $lbl = substr($lbl, 0, 22) . '…' if length($lbl) > 23;
              <option value="<%= $mb->{name} %>"<%= $f->{mailbox} eq $mb->{name} ? ' selected' : '' %>><%= $lbl %> (<%= $mb->{n} %>)</option>
% }
            </select>
          </div>
        </div>
        <label class="box"><input type="checkbox" id="hasAtt" name="has_attachments" value="1"<%= $f->{has_attachments} ? ' checked' : '' %>><span>Only messages with an attachment</span></label>
      </section>

      <section class="fsec" data-when="drive" id="secDrive"<%= $want_drive ? '' : ' hidden' %>>
        <h3 class="fsec-h">Files only</h3>
        %#  A tag arriving from a click needs somewhere to BE. Without a
        %#  control the page filters on something invisible, with nothing to
        %#  edit and nothing to clear but "Clear all filters" -- which is the
        %#  "a narrowed search hides why it is narrowed" problem this panel
        %#  exists to avoid. Files-only because the tag tree comes from a
        %#  photo manager; the section's own script disables it when Files is
        %#  unticked, so it can never be submitted off-screen.
        <div class="fields">
          <div class="field">
            <label class="lab" for="tag">Photo tag</label>
            <input type="text" id="tag" name="tag" value="<%= $f->{tag} %>" placeholder="e.g. Utah">
          </div>
        </div>
        <p class="note">Matches that tag and everything filed under it.</p>

        %#  Files another account has shared with this one. Included by
        %#  default: they are results like any other and say whose they are.
        %#  "Only" is a question in its own right -- "what has been shared
        %#  with me" -- so it searches with an empty box, which is why
        %#  _searched in App.pm treats it as a search and 'exclude' as a
        %#  narrowing of one.
        <div class="chips" id="sharedChips" role="group" aria-label="Shared files">
% my $sh = $f->{shared} // 'include';
          <label class="chip"><input type="radio" name="shared" value="include"<%= $sh eq 'include' ? ' checked' : '' %>><span>Include shared</span></label>
          <label class="chip"><input type="radio" name="shared" value="exclude"<%= $sh eq 'exclude' ? ' checked' : '' %>><span>Mine only</span></label>
          <label class="chip"><input type="radio" name="shared" value="only"<%= $sh eq 'only' ? ' checked' : '' %>><span>Shared with me only</span></label>
        </div>
        <label class="box"><input type="checkbox" id="inTrash" name="in_trash" value="1"<%= $f->{in_trash} ? ' checked' : '' %>><span>Search the trash instead</span></label>
      </section>

      <div class="fsec-foot">
        <a class="clear" id="clearAll" href="<%= clear_href($f->{q}) %>">Clear all filters</a>
      </div>

      %#  BOTH BUTTONS AGAIN, at the bottom of the open panel. Setting a
      %#  filter is the moment you want to search, and the only buttons were
      %#  back above a panel tall enough to have scrolled them off a phone.
      %#
      %#  They are INSIDE the <details>, so "visible only while the panel is
      %#  open" is the element's own behaviour rather than a rule the script
      %#  has to maintain -- and with the script off it still holds.
      %#
      %#  Written out a second time rather than captured in a block: a
      %#  Mojolicious `<%%= %%>` escapes, so markup returned from one arrives
      %#  on the page as visible angle brackets. Duplicated markup is the
      %#  cheaper mistake.
      <div class="panel-actions">
% if (!$ai_state->{available}) {
        <button class="btn btn-primary" type="submit">Search</button>
        <button class="btn btn-ai" type="button" disabled title="Not configured on this server">AI Search</button>
% } elsif (!$ai_state->{consented}) {
        <button class="btn btn-primary" type="submit">Search</button>
        <button class="btn btn-ai ai-ask" type="button">AI Search</button>
% } else {
        <button class="btn btn-primary" type="submit">Search</button>
        <button class="btn btn-ai" type="submit" name="ai" value="1">AI Search</button>
% }
      </div>
    </div>
  </details>
</form>

%# EVERYTHING BELOW IS A CONVENIENCE. With the script off the form still
%# submits exactly what is ticked, the server still ignores filters that do
%# not apply to the chosen source, and "Clear all filters" is an ordinary
%# link. What the script adds is that the panel stops lying to you while you
%# are filling it in.
%#
%# drive/templates/index.html.ep carries a reduced copy of this. Keep the two
%# in step -- the shared half is the source sections, the date presets and
%# the chip/exact-type pairing.
<script>
%# Its own IIFE, deliberately. The big one below bails out early if the two
%# source checkboxes are missing, and the panel remembering whether it was
%# open has nothing to do with them.
(function () {
  'use strict';
  var panel = document.getElementById('filterPanel'),
      field = document.getElementById('fopen');
  if (!panel || !field) return;
  // `toggle` fires on both open and close, so this is the whole mechanism.
  panel.addEventListener('toggle', function () {
    field.value = panel.open ? '1' : '0';
  });
})();
(function () {
  'use strict';
  var $  = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

  var srcMail = $('#srcMail'), srcDrive = $('#srcDrive');
  if (!srcMail || !srcDrive) return;
  var secMail = $('#secMail'), secDrive = $('#secDrive');
  var sumActive = $('#sumActive'), srcNote = $('#srcNote');
  var dateRow = $('#dateRow'), fromEl = $('#from'), toEl = $('#to');

  // A section that cannot apply is REMOVED, and its inputs are disabled with
  // it so a filter that is off the screen can never be submitted. The values
  // survive, so re-ticking Email brings your mailbox choice back rather than
  // silently losing it.
  function showSection(sec, on) {
    if (!sec) return;
    sec.hidden = !on;
    $$('input, select', sec).forEach(function (c) { c.disabled = !on; });
  }

  function syncSource() {
    var m = srcMail.checked, d = srcDrive.checked, none = !m && !d;
    // Neither ticked means both -- the same as sending no source at all,
    // which is also what this form sends with the script off. Said out loud
    // rather than silently corrected.
    if (srcNote) srcNote.hidden = !none;
    showSection(secMail,  m || none);
    showSection(secDrive, d || none);
    // The note claimed "on email, a type matches attachments" even with
    // Email unticked, where it is simply untrue.
    var nm = $('#typeNoteMail');
    if (nm) nm.hidden = !(m || none);
    // Same rule for the Person note: each half is true of one source, so
    // each half appears only when that source is in play.
    var pm = $('#personNoteMail'), pd = $('#personNoteDrive');
    if (pm) pm.hidden = !(m || none);
    if (pd) pd.hidden = !(d || none);
    // The exact-type list is account data and depends on the sources, so
    // it has to be recomputed whenever they change.
    applyScope();
    summarize();
  }
  [srcMail, srcDrive].forEach(function (c) { c.addEventListener('change', syncSource); });

  // ---- dates ---------------------------------------------------------
  function ymd(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') +
           '-' + String(d.getDate()).padStart(2, '0');
  }
  $$('input[name=dpreset]').forEach(function (r) {
    r.addEventListener('change', function () {
      var v = r.value;
      if (dateRow) dateRow.hidden = v !== 'custom';
      if (v === '') { fromEl.value = ''; toEl.value = ''; }
      else if (v !== 'custom') {
        var start = new Date();
        start.setDate(start.getDate() - parseInt(v, 10));
        fromEl.value = ymd(start);
        toEl.value = '';
      }
      summarize();
    });
  });

  // ---- broad type <-> exact type --------------------------------------
  //
  // TRI-STATE PARENT/CHILD. A chip is a select-all for the exact types it
  // covers: ticking it ticks them, and unticking one of them leaves the chip
  // HALF selected rather than switching it off.
  //
  // That is what makes "narrow" narrow. The server UNIONs type_in tokens, so
  // cat:pictures + image/jpeg means "all pictures" -- ticking an exact type
  // under a ticked family was a silent no-op, and the panel was inviting you
  // to narrow and then widening. Chip and types are one control now.
  //
  // A type belongs to several families (text/csv is Text AND a Spreadsheet),
  // so it is listed under each. Only the first copy carries a form name; the
  // rest are kept in step here.
  var chips  = $$('input[data-cat]');
  var leaves = $$('.leaf input');
  var allMimes = [];
  leaves.forEach(function (l) { if (allMimes.indexOf(l.value) === -1) allMimes.push(l.value); });

  function matches(cat, mime) {
    var mimes = (cat.getAttribute('data-mimes') || '').split(',').filter(Boolean);
    if (mimes.indexOf(mime) !== -1) return true;
    var types = (cat.getAttribute('data-types') || '').split(',').filter(Boolean);
    return types.some(function (t) { return mime.indexOf(t + '/') === 0; });
  }
  function mimesOf(cat)  { return allMimes.filter(function (m) { return matches(cat, m); }); }
  function copiesOf(m)   { return leaves.filter(function (l) { return l.value === m; }); }
  function isOn(m)       { var c = copiesOf(m); return c.length ? c[0].checked : false; }
  function setMime(m, v) { copiesOf(m).forEach(function (l) { l.checked = v; }); }
  function labelOf(c)    { return c.nextElementSibling.textContent.trim(); }
  function activeChips() { return chips.filter(function (c) { return c.checked || c.indeterminate; }); }

  chips.forEach(function (c) {
    c.addEventListener('change', function () {
      var want = c.checked;
      mimesOf(c).forEach(function (m) { setMime(m, want); });
      // Open the drill-down when a family goes on, so the exact types it
      // covers appear at the moment they become relevant rather than sitting
      // behind a disclosure nobody knows has changed.
      if (want && $('#specific')) $('#specific').open = true;
      refreshTypes();
    });
  });
  leaves.forEach(function (l) {
    l.addEventListener('change', function () { setMime(l.value, l.checked); refreshTypes(); });
  });

  function refreshTypes() {
    chips.forEach(function (c) {
      var ms = mimesOf(c), on = ms.filter(isOn).length;
      // A family with nothing indexed yet keeps whatever you set: the token
      // still filters server-side, and recomputing it to false would make the
      // chip impossible to tick.
      c.checked       = ms.length ? (on === ms.length) : c.checked;
      c.indeterminate = on > 0 && on < ms.length;
    });
    applyScope();
    summarize();
  }

  // Can this exact type match ANYTHING, given the sources ticked?
  //
  // The exact-type list is built from what this account actually holds,
  // and a type may exist only on drive or only as a mail attachment. With
  // "Files" unticked, offering MP4 video -- a type this account has only
  // on drive -- is offering a filter that provably returns nothing, and
  // says nothing about why.
  //
  // The CHIPS above are deliberately NOT filtered this way. A chip is a
  // family in the taxonomy, not a fact about this account: a video
  // attachment could arrive tomorrow, and hiding "Videos" because none
  // has arrived yet would be wrong. The exact types ARE account facts,
  // so only they react.
  function reachable(inp) {
    var m = srcMail.checked, d = srcDrive.checked;
    if (!m && !d) return true;                       // neither ticked means both
    var inDrive = (parseInt(inp.getAttribute('data-drive'), 10) || 0) > 0;
    var inMail  = (parseInt(inp.getAttribute('data-mail'),  10) || 0) > 0;
    // A type with no counts at all predates this and is left alone.
    if (!inDrive && !inMail) return true;
    return (d && inDrive) || (m && inMail);
  }

  function applyScope() {
    if (!$('#specific')) return;
    var on = activeChips(), shown = [];
    $$('.leafgroup').forEach(function (g) {
      var any = false;
      $$('.leaf', g).forEach(function (lab) {
        var inp = lab.querySelector('input');
        // A ticked type stays visible even out of scope. Hiding a filter that
        // is still doing work is the whole bug this pass is about.
        var vis = inp.checked ||
                  (reachable(inp) && (!on.length ||
                   on.some(function (c) { return matches(c, inp.value); })));
        lab.hidden = !vis;
        if (vis) { any = true; if (shown.indexOf(inp.value) === -1) shown.push(inp.value); }
      });
      g.hidden = !any;
    });

    var n = shown.length, picked = allMimes.filter(isOn).length;
    if ($('#specLead'))  $('#specLead').hidden  = on.length > 0;
    if ($('#specEmpty')) $('#specEmpty').hidden = n > 0;
    if (!$('#specSum')) return;
    if (on.length) {
      var names = on.map(labelOf);
      var within = names.length <= 2 ? names.join(' and ')
                 : names.slice(0, 2).join(', ') + ' +' + (names.length - 2) + ' more';
      $('#specSum').textContent = 'Narrow within ' + within + ' — ' + n +
        (n === 1 ? ' exact type' : ' exact types') + (picked ? ', ' + picked + ' ticked' : '');
    } else {
      $('#specSum').textContent = 'Narrow to an exact type' +
        (picked ? ' (' + picked + ' ticked)' : '');
    }
  }

  // ---- the summary ----------------------------------------------------
  //
  // It said "Filters (active)", which tells you there is something to find
  // but not what. Naming them is the point: a narrowed search has to explain
  // itself with the panel shut.
  function summarize() {
    if (!sumActive) return;
    var bits = [];
    var m = srcMail.checked, d = srcDrive.checked;
    if (m !== d) bits.push(m ? 'email only' : 'files only');

    // A whole family reads as its own name; a part-selected one says how much
    // of it, because "pictures" and "3 of the 8 picture types" are different
    // searches and the closed panel has to tell them apart.
    var full = chips.filter(function (c) { return c.checked; }).map(labelOf);
    var part = chips.filter(function (c) { return c.indeterminate; }).map(function (c) {
      var ms = mimesOf(c);
      return labelOf(c) + ' (' + ms.filter(isOn).length + ' of ' + ms.length + ')';
    });
    var names = full.concat(part);
    if (names.length) {
      bits.push(names.length <= 2 ? names.join(' + ').toLowerCase() : names.length + ' type groups');
    } else {
      var loose = allMimes.filter(isOn).length;
      if (loose) bits.push(loose + (loose === 1 ? ' exact type' : ' exact types'));
    }

    var preset = $('input[name=dpreset]:checked');
    if (preset && preset.value && preset.value !== 'custom') {
      bits.push(preset.nextElementSibling.textContent.trim().toLowerCase());
    } else if ((fromEl && fromEl.value) || (toEl && toEl.value)) {
      bits.push(fromEl.value && toEl.value ? fromEl.value + ' to ' + toEl.value
              : fromEl.value ? 'since ' + fromEl.value : 'until ' + toEl.value);
    }

    // "to/from" was true when this box was mail-only. It now also matches
    // the faces tagged in a photo, so the summary says the plain thing.
    var p = $('#person');
    if (p && !p.disabled && p.value.trim()) bits.push('person: ' + p.value.trim());
    var tg = $('#tag');
    if (tg && !tg.disabled && tg.value.trim()) bits.push('tag: ' + tg.value.trim());
    var sh = $('input[name=shared]:checked');
    if (sh && sh.value && sh.value !== 'include') {
      bits.push(sh.nextElementSibling.textContent.trim().toLowerCase());
    }
    var mb = $('#mailbox');
    if (mb && !mb.disabled && mb.value) {
      bits.push(mb.options[mb.selectedIndex].text.replace(/\s*\(\d+\)\s*$/, ''));
    }
    var at = $('#hasAtt'), tr = $('#inTrash');
    if (at && !at.disabled && at.checked) bits.push('with attachment');
    if (tr && !tr.disabled && tr.checked) bits.push('in trash');

    sumActive.textContent = bits.join(', ');
  }

  ['#person', '#tag', '#mailbox', '#hasAtt', '#inTrash', '#from', '#to'].forEach(function (s) {
    var el = $(s); if (el) el.addEventListener('change', summarize);
  });

  refreshTypes();
  syncSource();
})();
</script>

%# ---------------------------------------------------------------- consent
%#
%# A <dialog>, shown only when AI mode is available and this person has not
%# agreed to the CURRENT wording. Rendered in the page rather than fetched,
%# so the words are in the HTML a reader can inspect.
%#
%# The hash of the notice goes back with the POST. The server compares it
%# with the notice it is serving now and refuses a mismatch, so a stale tab
%# cannot record agreement to wording we have since changed.
% if ($ai_state->{available} && !$ai_state->{consented}) {
<dialog class="consent" id="aiConsent">
  <form method="post" action="/ai/consent">
    <h2>AI search sends your data to Anthropic, a third party.</h2>
%# A stale post lands back here. The server refuses to record agreement to
%# wording it is no longer serving, and redirected with ai_notice=stale --
%# which NOTHING read, so the dialog simply reappeared and the person was
%# given no reason why their click did nothing.
% if (($c->param('ai_notice') // '') eq 'stale') {
    <p class="cstale">The wording changed while this page was open, so your
      agreement was not recorded. Please read it again below.</p>
% }
    <div class="cbody">
% for my $para (split /\n\n/, $ai_state->{notice}) {
%   next unless length $para;
%   # The FIRST paragraph is the heading above; it is not repeated here.
%   next if $para =~ /\Aai search sends your data/i;
      <p><%= $para %></p>
% }
    </div>
    <input type="hidden" name="notice_sha256" value="<%= Homelab::Search::AI::Consent::notice_sha256() %>">
    <input type="hidden" name="q" value="<%= $f->{q} %>">
    <div class="cacts">
      %# Cancel is a plain formmethod=dialog button: it closes and records
      %# nothing. Declining must never be a request.
      <button type="button" class="btn" id="aiCancel">Cancel</button>
      <button type="submit" class="btn btn-primary" name="granted" value="1">I understand — turn on AI search</button>
    </div>
  </form>
</dialog>
% }

%# ------------------------------------------------------------ the answer
%#
%# NOTHING HERE IS MODEL-AUTHORED MARKUP. `answer` and `why` are plain
%# strings escaped by Mojolicious like any other text, and every row was
%# re-resolved from its id against this account's own scope before it
%# reached this template. A model that invents an id renders nothing.
% if ($ai) {
%   my %msg = (
%     off_topic        => 'I can only search your email and files.',
%     not_consented    => 'AI search needs your agreement first.',
%     rate_limited     => 'That is a lot of questions at once — give it a minute.',
%     budget_exhausted => 'This month\'s AI budget is used up. Normal search still works.',
%     refusal          => 'The model declined to answer that one.',
%     no_tool_call     => 'I could not turn that into a search of your mail or files.',
%     timeout          => 'That took too long. Here are the keyword results instead.',
%     api_error        => 'AI search is unavailable right now. Here are the keyword results.',
%     disabled         => 'AI search is switched off on this server.',
%   );
<section class="aibox" aria-label="AI answer">
  <div class="aihead">
    <span class="aitag">AI</span>
%   if ($ai->{state} eq 'cached') {
    <span class="hint">from an earlier identical question</span>
%   }
  </div>
%   if ($ai->{state} eq 'answered' || $ai->{state} eq 'cached') {
  <p class="aians"><%= $ai->{answer} %></p>
%     if (@{ $ai->{results} }) {
  <ol class="airesults">
%       for my $r (@{ $ai->{results} }) {
    <li>
%         if ($r->{kind} eq 'mail') {
      <a href="/mail/<%= $r->{message_id} %>/download"><%= length($r->{subject} // '') ? $r->{subject} : '(no subject)' %></a>
      <span class="meta"><%= $r->{mailbox} %></span>
%         } else {
      <a href="/drive/<%= $r->{drive_item_id} %>/<% if (viewable($r->{mime_type})) { %>view" target="_blank" rel="noopener noreferrer<% } else { %>download<% } %>"><%= $r->{file_name} %></a>
      <span class="meta"><%= $r->{mime_type} %> · <%= human_size($r->{size_bytes}) %></span>
%         }
%         if (length($r->{why} // '')) {
      <span class="why"><%= $r->{why} %></span>
%         }
    </li>
%       }
  </ol>
%     }
%   } else {
  <p class="aians dim"><%= $msg{ $ai->{state} } // 'AI search did not run.' %></p>
%   }
  <form class="ainote" method="post" action="/ai/consent">
    <span>AI search on · your question and parts of your mail and files are sent to Anthropic.</span>
    <input type="hidden" name="q" value="<%= $f->{q} %>">
    <button type="submit" name="granted" value="0" class="aioffbtn">Turn off</button>
  </form>
</section>
% }

% if (($counts->{messages} // 0) || ($counts->{drive_items} // 0)) {
<p class="counts"><%= $counts->{messages} // 0 %> messages and <%= $counts->{drive_items} // 0 %> files indexed for you<%
   %><% if (($counts->{shared_items} // 0) > 0) { %>, plus <%= commify($counts->{shared_items}) %> shared with you<% } %>.</p>
% }

% unless ($account) {
  <p class="empty">Nothing of yours has been indexed yet. If you have just signed up, give the indexer a few minutes.</p>
% } elsif (!$searched) {
  <p class="empty">Type something above to search your mail and files together.</p>
% } else {

% if ($f->{source} ne 'drive') {
  <h2 class="sec">Email — <%= scalar @$mail %> result<%= @$mail == 1 ? '' : 's' %></h2>
  <div class="res">
% for my $m (@$mail) {
    <div class="hit">
      <div class="t">
        <span class="subj"><%= length($m->{subject} // '') ? $m->{subject} : '(no subject)' %></span>
        <span class="meta"><%= $m->{mailbox} %> · <%= short_date($m->{sent_at} // $m->{received_at}) %><%= $m->{has_attachments} ? ' · attachment' : '' %></span>
      </div>
      <div class="who"><%= $m->{from_name} || $m->{from_addr} || '(unknown sender)' %><%= $m->{from_name} && $m->{from_addr} ? " <$m->{from_addr}>" : '' %></div>
% if (length($m->{snippet} // '')) {
      <div class="snip"><%= $m->{snippet} %></div>
% }
      %# Email gets BOTH a dropdown preview and a download, per the rendering
      %# contract. The preview is server-rendered text -- a stranger's HTML is
      %# never rendered as HTML here.
      <details class="pv">
        <summary>Preview</summary>
        <iframe src="/mail/<%= $m->{message_id} %>/preview" sandbox loading="lazy" title="Message preview"></iframe>
      </details>
      <div class="acts">
        <a href="/mail/<%= $m->{message_id} %>/download">Download .eml</a>
        <span class="hint"><%= human_size($m->{size_bytes}) %></span>
      </div>
    </div>
% }
% unless (@$mail) {
    <p class="empty">No matching email.</p>
% }
  </div>
% }

% if ($f->{source} ne 'mail') {
  <h2 class="sec">Files — <%= scalar @$drive %> result<%= @$drive == 1 ? '' : 's' %></h2>
  <div class="res">
% for my $d (@$drive) {
%   my $mime = $d->{mime_type} // '';
%   # Asks the same function the server uses to decide, so the link offered
%   # and the response given can never disagree. See Homelab::Search::Serve.
%   my $viewable = viewable($mime);
    <div class="hit">
      <div class="t">
        %#  THE NAME IS THE LINK, which is what every file list anywhere
        %#  does and what the AI result list on this same page was already
        %#  doing -- so this half of the page was the inconsistent one.
        %#
        %#  Where it goes still follows `viewable`, the same function the
        %#  server uses to decide what it will serve inline, so the link
        %#  offered and the response given cannot disagree. A type that is
        %#  download-only -- html, svg: serving those inline from this
        %#  origin is stored XSS against the search session -- gets a name
        %#  that downloads, not one that opens.
        <span class="subj"><a class="dl" href="/drive/<%= $d->{drive_item_id} %>/download" title="Download <%= $d->{file_name} %>">Download</a><% if ($viewable) { %><a href="/drive/<%= $d->{drive_item_id} %>/view" target="_blank" rel="noopener noreferrer"><%= $d->{file_name} %></a><% } else { %><a href="/drive/<%= $d->{drive_item_id} %>/download"><%= $d->{file_name} %></a><% } %></span>
        <span class="meta"><%= $mime %> · <%= human_size($d->{size_bytes}) %> · <%= short_date($d->{content_created_at} // $d->{uploaded_at}) %></span>
      </div>
%#  WHOSE FILE THIS IS. Only present on a borrowed row, so an unlabelled
%#  result is always your own -- the absence carries meaning, which is why
%#  owned rows get no "shared by you" counterpart.
% if (length($d->{shared_by} // '')) {
      <div class="who shared"><strong>Shared by</strong> <%= $d->{shared_by} %></div>
% }
% if (length($d->{folder_path} // '')) {
      <div class="who">in <%= $d->{folder_path} %></div>
% }
% if (length($d->{snippet} // '')) {
      <div class="snip"><%= $d->{snippet} %></div>
% }
%# Per-type metadata: a camera, a duration, a page count. Shown only where
%# there is something to show, so a text file gains no empty row. GPS is
%# here because this is the owner's own page -- it is filtered out of what
%# AI mode sends to a third party, not out of what they can see themselves.
%# Who is in the photo, and the tag tree its owner filed it under. Before
%# the metadata list, because on a photo it is the most human thing there
%# is -- and because a photo matched on a name showed no reason at all once
%# people were normalized out of the metadata rows.
% if (my $ft = $drive_faces->{ $d->{drive_item_id} }) {
%   my @named = grep { length($_->{display_name} // '') } @{ $ft->{faces} || [] };
%   my $unnamed = scalar(@{ $ft->{faces} || [] }) - scalar(@named);
%   my %seen; my @who = grep { !$seen{$_}++ } map { $_->{display_name} } @named;
% if (@who || $unnamed) {
      <div class="who faces"><strong>People:</strong> <% my $first = 1; %><% for my $w (@who) { %><%= $first ? '' : ', ' %><% $first = 0; %><a href="<%= filter_href('person', $w, 'drive') %>"><%= $w %></a><% } %><% if ($unnamed) { %><%= @who ? ' · ' : '' %><em><%= $unnamed %> untagged face<%= $unnamed == 1 ? '' : 's' %></em><% } %></div>
% }
%#  The People BRANCH of the tag tree is dropped, because digiKam writes a
%#  `People|<name>` tag for every face it names -- so showing both printed
%#  the same four names twice in a row. A strict de-duplication of what is
%#  already on the line above, not an opinion about anyone's own tags.
%   my %tseen;
%   my @all = grep { !$tseen{$_}++ }
%             grep { $_ !~ m{\APeople(?:\||\z)} }
%             map  { $_->{path} } @{ $ft->{tags} || [] };
%#  AN ANCESTOR OF A PATH ALREADY HERE ADDS NOTHING, so it is dropped.
%#
%#  This is the photo's own data, not a bug in the index: digiKam writes
%#  the whole chain as separate entries, so one shot of Arches arrives
%#  carrying Utah, Utah|Moab and Utah|Moab|Arches. 456 of the 5,389 tagged
%#  photos here are like that, and they printed as three near-identical
%#  chains that read as one stuttering line.
%#
%#  Dropping the short ones loses nothing now that every SEGMENT is its own
%#  link -- "Utah" is still right there, clickable, inside the long path.
%#  Only a STRICT PREFIX goes: a branch that diverges is a different place
%#  and keeps its own line.
%#
%#  The trailing '|' in the test is the whole correctness of it. Without
%#  it, 'Places|Earth|USA|Utah' would also swallow a sibling tag named
%#  'Utah Valley', which is somewhere else entirely.
%   my @paths = grep { my $p = $_; !grep { index($_, "$p|") == 0 } @all } @all;
%#  EVERY SEGMENT IS ITS OWN FILTER, not just the leaf. The hierarchy is
%#  the whole value of these tags -- the flat Keywords field already holds
%#  the leaf, so "Moab" was findable and "Utah" was not, even though its
%#  owner filed it under Utah themselves. A tag filter matches the node AND
%#  everything under it, so clicking Utah here is "every photo from Utah".
%   if (@paths) {
      %#  One line per branch. The old run-on used '·' between paths and
      %#  '›' between segments, and at this size those are the same
      %#  squiggle -- three paths read as one chain that kept repeating
      %#  itself, which is how this got reported.
      <div class="who tags"><strong>Tags:</strong>
%     for my $path (@paths) {
        <span class="tagpath">
%       my $firstseg = 1;
%       for my $seg (split /\|/, $path) {
%         if (!$firstseg) {
        ›
%         }
%         $firstseg = 0;
        <a href="<%= filter_href('tag', $seg, 'drive') %>"><%= $seg %></a>
%       }
        </span>
%     }
      </div>
%   }
% }
% if (my $md = $drive_meta->{ $d->{drive_item_id} }) {
%   #  PAIRS THAT ARE ONE FACT. A latitude without its longitude is not a
%   #  place, and a width without a height is not a size -- so each pair
%   #  gets one chip instead of two labels and two values spending four on
%   #  one thing, which on a phone was most of the row.
%   #
%   #  Collapsed only when BOTH halves are present. A lone half falls
%   #  through to the loop below and keeps its own row rather than
%   #  disappearing, which is the failure worth guarding: the pair is an
%   #  optimistic reading of data that came out of a stranger's file.
%   my %by = map { $_->{key_name} => $_ } @$md;
%   my ($lat, $lon) = @by{'gps.latitude', 'gps.longitude'};
%   my ($w,   $h)   = @by{'media.width',  'media.height'};
%   my %hide;
%   @hide{'gps.latitude', 'gps.longitude'} = (1, 1) if $lat && $lon;
%   @hide{'media.width',  'media.height'}  = (1, 1) if $w   && $h;
%#  %hide has to apply here too: width and height are collapsed into the
%#  Dimensions chip below, and without this they also appeared under it as
%#  two more rows -- the very duplication the pair exists to remove.
%   my @spec = grep { spec_key($_->{key_name}) && !$hide{ $_->{key_name} } } @$md;
      <dl class="meta-kv">
%   if ($lat && $lon) {
%     my ($la, $lo) = (meta_value($lat), meta_value($lon));
        <dt>Lat/Long</dt>
        %#  The link is written as literal markup, NOT through <%%= %%>, which
        %#  escapes -- that silently dropped a rel= once already, and
        %#  `noreferrer` is the half that matters here: without it Google
        %#  receives this page's full url, which carries the search query
        %#  and any person filter in it. The coordinates go only because
        %#  the owner clicked.
        <dd><a href="https://www.google.com/maps/search/?api=1&amp;query=<%= $la %>,<%= $lo %>" target="_blank" rel="noopener noreferrer" title="Open in Google Maps"><%= $la %>/<%= $lo %></a></dd>
%   }
%   for my $kv (@$md) {
%     next if $hide{ $kv->{key_name} };
%     next if spec_key($kv->{key_name});
        <dt><%= $kv->{label} %></dt>
        <dd><%= meta_value($kv) %></dd>
%   }
      </dl>
%#  SPECS, FOLDED AWAY -- how the file was RECORDED, as against what it
%#  is OF. Dimensions, orientation and the camera row were a dozen chips
%#  pushing the name, the people and the place down past them. Worth
%#  having; not worth having open. The coordinates and Taken stay outside:
%#  those are what somebody is scanning the row for.
%#
%#  A <details>, so it costs no script and the open one stays open while
%#  you read it. Rendered only when the file actually carries some, so a
%#  scan or a text file gains no empty disclosure.
%   if (@spec || ($w && $h)) {
      <details class="specs">
        <summary>Specs</summary>
        <dl class="meta-kv">
%     if ($w && $h) {
          %#  &times; rather than the letter x: it is the separator every
          %#  camera and spec sheet uses, and it does not read as part of
          %#  the number next to tabular digits. "Dimensions" rather than
          %#  "Size", because the byte size is already on the headline.
          <dt>Dimensions</dt>
          <dd><%= meta_value($w) %>&times;<%= meta_value($h) %></dd>
%     }
%     for my $kv (@spec) {
          <dt><%= $kv->{label} %></dt>
          <dd><%= meta_value($kv) %></dd>
%     }
        </dl>
        <p class="rawlink"><a href="/drive/<%= $d->{drive_item_id} %>/metadata" target="_blank" rel="noopener noreferrer">All raw metadata &rarr;</a></p>
      </details>
%   }
% }
%# Both links moved onto the title line, so this row is now ONLY the
%# caveats -- and it is skipped entirely when there are none, rather than
%# leaving an empty div and its margin under every result.
% if (!$viewable || $d->{deleted_at}) {
      <div class="acts">
%   unless ($viewable) {
        <span class="hint">download only</span>
%   }
%   if ($d->{deleted_at}) {
        <span class="hint">in trash</span>
%   }
      </div>
% }
    </div>
% }
% unless (@$drive) {
    <p class="empty">No matching files.</p>
% }
  </div>
% }

% }

%# The consent dialog is opened by the AI Search button. There are two of
%# them -- one beside the search box, one at the foot of the open filter
%# panel -- so this binds a CLASS rather than an id: duplicate ids are
%# invalid, and querying all of them means adding a third button somewhere
%# needs no change here.
%#
%# Both are type=button and carry no `name`, so with JavaScript off they do
%# nothing at all. That is the correct failure: nothing is searched and no
%# consent is recorded, rather than a silent AI search nobody agreed to.
% if ($ai_state->{available} && !$ai_state->{consented}) {
<script>
(function () {
  var asks = document.querySelectorAll('.ai-ask'),
      dlg  = document.getElementById('aiConsent');
  if (!asks.length || !dlg || !dlg.showModal) return;
  Array.prototype.forEach.call(asks, function (b) {
    b.addEventListener('click', function () { dlg.showModal(); });
  });
  var cancel = document.getElementById('aiCancel');
  if (cancel) cancel.addEventListener('click', function () { dlg.close(); });
})();
</script>
% }
