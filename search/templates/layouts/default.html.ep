<!DOCTYPE html>
<html lang="en">
<head>
%# Shared chrome: theme.css, fonts and favicon come from static.mailmasker.org
%# via homelab-webtheme, so a restyle needs no rebuild of this package. Only
%# the app-specific rules below live here.
%= include 'homelab/head'
  <title><%= title %></title>
  <style>
    .wrap { max-width: 1100px; margin: 0 auto; padding: var(--space-6) var(--space-4) var(--space-10); }
    .searchbar { background: var(--surface); border: 1px solid var(--border);
                 border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-5); }
    .searchbar .row { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: flex-end; }
    .searchbar .grow { flex: 1 1 320px; min-width: 240px; }
    .field label { display: block; font-size: var(--app-xs); color: var(--text-muted);
                   margin-bottom: 4px; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
    .field input[type=text], .field input[type=date], .field select {
      width: 100%; box-sizing: border-box; background: var(--black-primary);
      color: var(--text-primary); border: 1px solid var(--border);
      border-radius: var(--radius-sm); padding: 8px 10px; font-size: var(--app-base); }
    .chips { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-3);
             font-size: var(--app-sm); color: var(--text-muted); align-items: center; }
    .chips label { display: inline-flex; gap: 6px; align-items: center; }
    .aioff { display: inline-flex; gap: 6px; align-items: center; opacity: 0.55; }
    .aioff input { cursor: not-allowed; }
    .hint { font-size: var(--app-xs); color: var(--text-muted); }
    h2.sec { font-size: var(--app-base); font-weight: var(--weight-normal); letter-spacing: var(--tracking-wide);
             text-transform: uppercase; color: var(--text-muted); margin: var(--space-6) 0 var(--space-2); }
    .res { border-top: 1px solid var(--border); }
    .hit { display: block; padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
    .hit .t { display: flex; gap: var(--space-3); align-items: baseline; justify-content: space-between; }
    .hit .subj { font-size: var(--app-base); color: var(--text-primary); }
    .hit .meta { font-size: var(--app-xs); color: var(--text-muted); white-space: nowrap; }
    .hit .who  { font-size: var(--app-sm); color: var(--silver-dim); }
    .hit .snip { font-size: var(--app-sm); color: var(--text-muted); margin-top: 4px;
                 overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .acts { margin-top: 6px; display: flex; gap: var(--space-3); font-size: var(--app-xs); }
    .acts a { color: var(--silver-dim); }
    .empty { color: var(--text-muted); padding: var(--space-6) 0; }
    .counts { font-size: var(--app-xs); color: var(--text-muted); margin-top: var(--space-2); }
    details.pv > summary { cursor: pointer; color: var(--silver-dim); font-size: var(--app-xs); }
    details.pv iframe { width: 100%; height: 420px; border: 1px solid var(--border);
                        border-radius: var(--radius-sm); margin-top: var(--space-2); background: var(--black-primary); }

    /* Single breakpoint and 44px touch targets, matching homelab-drive's
       mobile pass. The desktop row packs four fields side by side; on a
       phone that is four cramped columns, so they stack and every control
       becomes full width and thumb-sized. 16px on inputs is deliberate --
       iOS Safari zooms the whole page when a focused input is smaller. */
    @media (max-width: 720px) {
      .wrap { padding: var(--space-4) var(--space-3) var(--space-8); }
      .searchbar { padding: var(--space-3); }
      .searchbar .row { flex-direction: column; align-items: stretch; gap: var(--space-3); }
      .searchbar .row > div { flex: 1 1 auto !important; width: 100%; }
      .field input[type=text], .field input[type=date], .field select {
        font-size: 16px; min-height: 44px; }
      .searchbar .row button { width: 100%; min-height: 44px; font-size: var(--app-base); }
      /* One control per line: a label and a <select> side by side wrap
         mid-word at this width otherwise. */
      .chips { flex-direction: column; align-items: stretch; gap: var(--space-3); }
      .chips label, .chips .aioff { justify-content: space-between; min-height: 36px; }
      .chips select { flex: 0 1 60%; min-height: 40px; font-size: 16px; }
      /* Date and meta belong under the subject on a narrow screen, not
         squeezed onto the same line. */
      .hit .t { flex-direction: column; gap: 2px; }
      .hit .meta { white-space: normal; }
      details.pv iframe { height: 320px; }
      .acts { gap: var(--space-4); }
      .acts a { min-height: 32px; display: inline-flex; align-items: center; }
    }
  </style>
</head>
<body>
%= include 'homelab/header'
<div class="wrap"><%= content %></div>
%= include 'homelab/footer'
</body>
</html>
