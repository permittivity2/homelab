#!/usr/bin/env perl
# Entry point for the search web app (hypnotoad under systemd).
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Mojolicious::Commands;

$ENV{MOJO_REVERSE_PROXY} //= 1;   # always behind homelab-webproxy at the edge
Mojolicious::Commands->start_app('Homelab::Search::App');
