#!/usr/bin/make -f

# No Perl/compiled content at all (unlike every other homelab-* package)
# -- just PHP files to drop into a package-owned share directory (see
# debian/install), symlinked into roundcube-core's own real plugin
# directory by postinst at install time, not by debian/rules at build
# time -- this package can't assume where a lower/where-this-ever-gets-
# installed host's roundcube-core actually lives, and shouldn't own
# files under another package's directory anyway.
%:
	dh $@

override_dh_auto_test:

# Stamp the plugin's own version into its static info(), which is what
# Settings -> About reads. Taken from debian/changelog so it always matches
# the installed package and there is no second place to bump. The grep fails
# the build loudly if the placeholder is ever renamed or lost, rather than
# silently shipping "--" again.
override_dh_install:
	dh_install
	grep -q __PLUGIN_VERSION__ debian/homelab-roundcube-invite/usr/share/homelab-roundcube-invite/plugins/invite_sender/invite_sender.php
	sed -i "s/__PLUGIN_VERSION__/$$(dpkg-parsechangelog -S Version)/" \
		debian/homelab-roundcube-invite/usr/share/homelab-roundcube-invite/plugins/invite_sender/invite_sender.php
