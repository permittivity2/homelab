#!/bin/sh
set -e

MARKER=/etc/powerdns/pdns.d/90-homelab-dns.conf

case "$1" in
    remove)
        # Only remove the drop-in THIS package created -- never touch
        # pdns.conf, never touch the powerdns database (schema or zones).
        rm -f "$MARKER"

        # pdns.service has no reload path (see postinst) -- a restart is
        # the only way to drop our config back out.
        if command -v pdns_server >/dev/null 2>&1 && pdns_server --config=check >/dev/null 2>&1; then
            systemctl restart pdns 2>/dev/null || true
        fi
        ;;

    purge)
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
