#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/powerdns/pdns.d/90-homelab-dns.conf

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-dns/db_host || true
db_input high homelab-dns/db_port || true
db_input high homelab-dns/db_name || true
db_input high homelab-dns/db_user || true
db_input high homelab-dns/db_password || true
db_input high homelab-dns/role || true
db_go

db_get homelab-dns/role; ROLE="$RET"

if [ "$ROLE" = "master" ]; then
    db_input high homelab-dns/allow_axfr_ips || true
    db_input high homelab-dns/also_notify || true
else
    db_input medium homelab-dns/slave_cycle_interval || true
    db_input medium homelab-dns/disable_axfr || true
fi
db_go

exit 0
