#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/pgbouncer/conf.d/90-homelab-pgbouncer.ini

# Already configured (fresh reinstall/upgrade) — don't re-prompt or clobber it.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-pgbouncer/listen_addr || true
db_input high homelab-pgbouncer/listen_port || true
db_input high homelab-pgbouncer/pool_mode || true
db_input high homelab-pgbouncer/postgres_host || true
db_input high homelab-pgbouncer/postgres_port || true
db_input low homelab-pgbouncer/admin_users || true
db_go

exit 0
