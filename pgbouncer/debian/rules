#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# Nothing to compile

override_dh_auto_test:
	# No package-build-time tests

override_dh_install:
	dh_install
	install -D -m 644 backup-paths.txt \
		debian/homelab-pgbouncer/usr/share/homelab-pgbouncer/backup-paths.txt
	install -D -m 644 services/pgbouncer.yml \
		debian/homelab-pgbouncer/usr/share/homelab-pgbouncer/services/pgbouncer.yml
	install -D -m 644 config/20-homelab-restart.conf \
		debian/homelab-pgbouncer/etc/systemd/system/pgbouncer.service.d/20-homelab-restart.conf
