#!/bin/sh
set -e

SHARE_DIR=/usr/share/homelab-prometheus
HL_CONFIG_DIR=/etc/homelab/prometheus
HL_CONFIG="$HL_CONFIG_DIR/config"
PROM_DIR=/etc/prometheus/homelab
TARGETS_DIR="$PROM_DIR/targets"
PULL_CONFIG="$PROM_DIR/pull.yml"
DROPIN_DIR=/etc/systemd/system/prometheus.service.d
NFT_DROPIN=/etc/nftables.d/10-homelab-prometheus-egress.nft

case "$1" in
    configure)
        echo "homelab-prometheus post-installation setup..."

        # --- deployment parameters (overridable via $HL_CONFIG) ----------
        mkdir -p "$HL_CONFIG_DIR"
        if [ ! -f "$HL_CONFIG" ]; then
            cat > "$HL_CONFIG" <<'EOF'
# homelab-prometheus deployment parameters. Change + reinstall (or
# dpkg-reconfigure) to apply.
API_HOST="10.50.2.46"
API_PORT="3000"
FLEET_CIDR="10.50.2.0/24"
# Hosts allowed to query Prometheus (:9090) / Grafana (:3000) -- the
# accountmanage Metrics tab. Space/comma-separated.
METRICS_CONSUMERS="10.50.2.61"
EOF
            echo "  wrote $HL_CONFIG"
        fi
        # TSDB storage knobs (0.8.0). Appended to a pre-0.8.0 config with the
        # values the old drop-in hardcoded, so nothing changes until someone
        # edits them -- but they are now visible and editable where the other
        # parameters live, instead of needing a hand drop-in that sorts after
        # ours (what prod-homelabvm69 had to do on 2026-10-28).
        if ! grep -q '^TSDB_PATH=' "$HL_CONFIG"; then
            cat >> "$HL_CONFIG" <<'EOF'

# TSDB storage. Point TSDB_PATH at a mount (bind or NFS) to keep more than the
# local disk allows: the generated unit drop-in then gains RequiresMountsFor,
# so Prometheus refuses to start with the mount absent instead of writing into
# the empty directory beneath it. RETENTION_SIZE "0" = no size cap (units: B,
# KB, MB, GB, TB, PB). Change + dpkg-reconfigure homelab-prometheus to apply.
TSDB_PATH="/var/lib/prometheus/metrics2"
RETENTION_TIME="30d"
RETENTION_SIZE="0"
EOF
            echo "  added TSDB_PATH / RETENTION_TIME / RETENTION_SIZE to $HL_CONFIG (previous hardcoded values)"
        fi
        # Static scrape targets (0.9.0): hosts the fleet API does not know,
        # e.g. ns03 -- the sole resolver, not a fleet member, no agent. The
        # pull rewrites targets/<job>.json every two minutes and would erase a
        # hand entry there within one cycle, so these are rendered into a
        # sibling directory the pull never touches (see below). Appended to a
        # pre-0.9.0 config so the key is visible where the other parameters
        # live.
        if ! grep -q '^STATIC_TARGETS=' "$HL_CONFIG"; then
            cat >> "$HL_CONFIG" <<'EOF'

# Scrape targets the fleet API does not know about (no homelab-agent on them).
# Space-separated entries JOB=HOST:ADDRESS:PORT; JOB must be a scrape job in
# prometheus.yml (node, pdns-recursor, postgres, ...). Rendered on configure
# into /etc/prometheus/homelab/targets-static/<job>.json with the labels
# host=HOST and tier=legacy. Example -- ns03, the resolver (post-cutover #66):
#   STATIC_TARGETS="node=ns03:10.20.0.140:9100 pdns-recursor=ns03:10.20.0.140:8082"
# Change + dpkg-reconfigure homelab-prometheus to apply
# (install-orchestrators/metrics-static-targets.sh does both).
STATIC_TARGETS=""
EOF
            echo "  added STATIC_TARGETS to $HL_CONFIG (empty: no static targets until set)"
        fi
        API_HOST="10.50.2.46"; API_PORT="3000"; FLEET_CIDR="10.50.2.0/24"; METRICS_CONSUMERS="10.50.2.61"
        TSDB_PATH="/var/lib/prometheus/metrics2"; RETENTION_TIME="30d"; RETENTION_SIZE="0"
        STATIC_TARGETS=""
        # shellcheck disable=SC1090
        . "$HL_CONFIG" 2>/dev/null || true
        API_BASE="http://$API_HOST:$API_PORT"
        [ -n "$RETENTION_SIZE" ] || RETENTION_SIZE="0"

        # --- config tree (readable by the 'prometheus' service user) -----
        mkdir -p "$PROM_DIR" "$TARGETS_DIR"
        install -m 644 "$SHARE_DIR/config/prometheus.yml" "$PROM_DIR/prometheus.yml"
        # pull.yml is regenerated every configure (its only variable is
        # api_base, derived from $HL_CONFIG) so added scrape-job tiers flow
        # to existing installs -- it is declarative config, not hand-edited.
        sed "s#__API_BASE__#$API_BASE#g" "$SHARE_DIR/config/pull.yml.example" > "$PULL_CONFIG"
        # Alert rules are declarative and shipped, like prometheus.yml itself
        # -- replaced every configure so a new rule reaches existing installs.
        mkdir -p "$PROM_DIR/rules"
        install -m 644 "$SHARE_DIR"/config/rules/*.yml "$PROM_DIR/rules/"
        chmod 755 "$PROM_DIR" "$TARGETS_DIR" "$PROM_DIR/rules"
        chmod 644 "$PROM_DIR/prometheus.yml" "$PULL_CONFIG" "$PROM_DIR"/rules/*.yml

        # --- static targets: hosts outside the fleet API -------------------
        # Declarative: the directory is rebuilt from STATIC_TARGETS on every
        # configure, so removing an entry removes its target. One file per
        # job, same shape as the pull's files ({targets, labels.host}) plus
        # tier=legacy so dashboards and rules can tell them apart. prometheus.yml
        # lists targets-static/<job>.json beside targets/<job>.json for every
        # job; a missing file is not an error to file_sd.
        STATIC_DIR="$PROM_DIR/targets-static"
        mkdir -p "$STATIC_DIR"
        rm -f "$STATIC_DIR"/*.json
        STATIC_JOBS="$(printf '%s\n' $STATIC_TARGETS | perl -MJSON::PP -e '
            my (%by, @order);
            while (<STDIN>) {
                chomp; next unless length;
                my ($job, $rest) = split /=/, $_, 2;
                my ($host, $addr) = split /:/, ($rest // ""), 2;
                unless (length $job && length $host && defined $addr && $addr =~ /:\d+$/) {
                    print STDERR "  WARNING: STATIC_TARGETS entry \x27$_\x27 is not JOB=HOST:ADDRESS:PORT -- skipped\n";
                    next;
                }
                push @order, $job unless $by{$job};
                push @{ $by{$job} }, { targets => [$addr], labels => { host => $host, tier => "legacy" } };
            }
            for my $job (@order) {
                open my $fh, ">", "$ARGV[0]/$job.json" or die "$ARGV[0]/$job.json: $!";
                print $fh JSON::PP->new->canonical->encode($by{$job}), "\n";
                close $fh;
                print "$job\n";
            }' "$STATIC_DIR" | paste -sd' ' -)"
        chmod 755 "$STATIC_DIR"
        chmod 644 "$STATIC_DIR"/*.json 2>/dev/null || true
        for j in $STATIC_JOBS; do
            grep -q "^  - job_name: $j\$" "$PROM_DIR/prometheus.yml" \
                || echo "  WARNING: STATIC_TARGETS job '$j' has no scrape job in prometheus.yml -- written but never scraped"
        done
        if [ -n "$STATIC_JOBS" ]; then
            echo "  static targets: $STATIC_JOBS ($STATIC_DIR)"
        else
            echo "  static targets: none (STATIC_TARGETS empty)"
        fi

        # --- point prometheus.service at our config + storage -----------
        # A TSDB path of our own must exist and belong to the service user
        # (the stock package only prepares /var/lib/prometheus/metrics2).
        if [ ! -d "$TSDB_PATH" ]; then
            mkdir -p "$TSDB_PATH"
            chown prometheus:prometheus "$TSDB_PATH" 2>/dev/null || true
        fi
        mkdir -p "$DROPIN_DIR"
        MOUNT_NOTE=""
        {
            if mountpoint -q "$TSDB_PATH" 2>/dev/null; then
                MOUNT_NOTE=" (mount required)"
                printf '[Unit]\n# %s is a mount point: refuse to start without it rather than\n# write into the empty directory underneath (the data would silently split).\nRequiresMountsFor=%s\n\n' "$TSDB_PATH" "$TSDB_PATH"
            fi
            sed -e "s#__TSDB_PATH__#$TSDB_PATH#g" \
                -e "s#__RETENTION_TIME__#$RETENTION_TIME#g" \
                -e "s#__RETENTION_SIZE__#$RETENTION_SIZE#g" \
                "$SHARE_DIR/systemd/prometheus-homelab.conf.template"
        } > "$DROPIN_DIR/homelab.conf"
        chmod 644 "$DROPIN_DIR/homelab.conf"
        echo "  storage: $TSDB_PATH, retention $RETENTION_TIME / size cap $RETENTION_SIZE$MOUNT_NOTE"
        if [ -f "$DROPIN_DIR/zz-homelab-storage.conf" ]; then
            echo "  NOTE: $DROPIN_DIR/zz-homelab-storage.conf still exists and overrides the"
            echo "        values above. Move its path/retention into $HL_CONFIG, delete it,"
            echo "        then: systemctl daemon-reload && systemctl restart prometheus."
        fi

        # --- egress firewall: api + fleet exporter ports -----------------
        if [ -d /etc/nftables.d ]; then
            CONSUMER_SET="$(printf '%s' "$METRICS_CONSUMERS" | tr ', ' '\n\n' | grep -E '.' | paste -sd, -)"
            [ -n "$CONSUMER_SET" ] || CONSUMER_SET="$API_HOST"
            sed -e "s#__API_HOST__#$API_HOST#g" \
                -e "s#__API_PORT__#$API_PORT#g" \
                -e "s#__FLEET_CIDR__#$FLEET_CIDR#g" \
                -e "s#__CONSUMERS__#$CONSUMER_SET#g" \
                "$SHARE_DIR/nftables/10-homelab-prometheus-egress.nft.template" > "$NFT_DROPIN"
            # Apply live without flushing the ruleset (bad-ips-safe). The
            # drop-in now touches BOTH the output chain (egress) and the
            # input chain (consumer ingress), so clean both by comment.
            for chain in output input; do
                if nft list chain inet filter "$chain" >/dev/null 2>&1; then
                    for hh in $(nft -a list chain inet filter "$chain" 2>/dev/null \
                            | awk '/homelab-prometheus-egress/ {print $NF}'); do
                        nft delete rule inet filter "$chain" handle "$hh" 2>/dev/null || true
                    done
                fi
            done
            nft -f "$NFT_DROPIN" 2>/dev/null \
                || echo "  WARNING: could not apply $NFT_DROPIN live -- effective on next nftables reload/boot."
            echo "  firewall: egress to $API_HOST:$API_PORT + fleet exporter ports; ingress :9090/:3000 from { $CONSUMER_SET }"
        fi

        # --- fleet manifest (topology/services visibility) ---------------
        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services 2>/dev/null || true
        cp "$SHARE_DIR/services/prometheus.yml" "/etc/homelab/services/prometheus.yml"

        # --- start/refresh prometheus with our config --------------------
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable prometheus >/dev/null 2>&1 || true
        systemctl restart prometheus \
            || echo "  WARNING: prometheus failed to (re)start -- check 'journalctl -xeu prometheus'."

        # Assert the shipped rule_files glob actually matches what we just
        # installed. A glob that matches nothing is not a startup error --
        # prometheus comes up clean with zero rule groups and reports nothing --
        # so 0.7.1 shipped three alert rules that were never evaluated, because
        # prometheus.yml said /etc/prometheus/rules while the postinst wrote
        # $PROM_DIR/rules. Cheap to check, invisible when it breaks.
        RULE_GLOBS=$(sed -n '/^rule_files:/,/^[^ #-]/p' "$PROM_DIR/prometheus.yml" \
            | sed -n 's/^[[:space:]]*-[[:space:]]*//p')
        RULE_HITS=0
        for g in $RULE_GLOBS; do
            for f in $g; do [ -f "$f" ] && RULE_HITS=$((RULE_HITS+1)); done
        done
        if [ "$RULE_HITS" = 0 ]; then
            echo "  WARNING: rule_files in $PROM_DIR/prometheus.yml matches no files."
            echo "           Alert rules are installed in $PROM_DIR/rules but will NOT"
            echo "           be evaluated. This is a packaging bug -- report it."
        else
            echo "  alert rules: $RULE_HITS file(s) matched by rule_files"
        fi

        # --- first target pull (best-effort: needs an enrolled agent) ----
        if [ -f /etc/homelab/agent/credential.yml ]; then
            HOMELAB_PROMETHEUS_PULL_CONFIG="$PULL_CONFIG" homelab-prometheus-pull \
                || echo "  NOTE: initial target pull failed (agent not enrolled yet?) -- the timer will retry."
        else
            echo "  NOTE: no homelab-agent credential yet -- enroll this host's agent so"
            echo "        homelab-prometheus-pull can discover scrape targets. The timer will retry."
        fi

        # --- pull timer (keeps targets in sync with the fleet) -----------
        systemctl enable --now homelab-prometheus-pull.timer >/dev/null 2>&1 \
            || echo "  WARNING: could not enable homelab-prometheus-pull.timer -- scrape targets won't auto-refresh."

        echo "homelab-prometheus configured (Prometheus on :9090)."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
