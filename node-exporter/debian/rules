#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 644 services/node-exporter.yml \
		debian/homelab-node-exporter/usr/share/homelab-node-exporter/services/node-exporter.yml
	install -D -m 644 nftables/10-homelab-metrics.nft.template \
		debian/homelab-node-exporter/usr/share/homelab-node-exporter/nftables/10-homelab-metrics.nft.template
	install -D -m 644 config/node-exporter.example \
		debian/homelab-node-exporter/usr/share/homelab-node-exporter/config/node-exporter.example
