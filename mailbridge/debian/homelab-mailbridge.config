#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Already configured (fresh reinstall/upgrade) — don't re-prompt.
if [ -f /etc/homelab/mailbridge/config.yml ]; then
    exit 0
fi

db_input high homelab-mailbridge/db_host || true
db_input high homelab-mailbridge/pgbouncer_host || true
db_input high homelab-mailbridge/homelab_api_base_url || true
db_input high homelab-mailbridge/imap_host || true
db_input high homelab-mailbridge/imap_port || true
db_input high homelab-mailbridge/smtp_host || true
db_input high homelab-mailbridge/smtp_port || true
db_input high homelab-mailbridge/listen_port || true
db_go

exit 0
