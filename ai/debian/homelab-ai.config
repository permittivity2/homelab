#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/ai/config.yml ]; then
    exit 0
fi

db_input high homelab-ai/db_host || true
db_input high homelab-ai/pgbouncer_host || true
db_input high homelab-ai/api_base || true
db_input high homelab-ai/listen_port || true
db_input high homelab-ai/advertise_host || true
db_input high homelab-ai/api_key || true
db_go

exit 0
