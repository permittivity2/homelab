#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_install:
	dh_install
	install -D -m 644 config/ai.example.yml \
		debian/homelab-ai/usr/share/homelab-ai/config/ai.example.yml
	install -D -m 644 services/ai.yml \
		debian/homelab-ai/usr/share/homelab-ai/services/ai.yml
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-ai/usr/share/homelab-ai/{} \;
