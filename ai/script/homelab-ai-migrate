#!/usr/bin/env perl
# Applies homelab-ai's own migrations/*.sql via the migrate role.
use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Homelab::Common::Config qw(load_config);
use Homelab::Common::DB qw(migrate_dbh);
use Homelab::Common::Migrate qw(run_migrations);

my $config = load_config('HOMELAB_AI_CONFIG', '/etc/homelab/ai/config.yml');
my $dbh    = migrate_dbh(%{ $config->{database_migrate} });

my $migrations_dir = $ENV{HOMELAB_AI_MIGRATIONS_DIR} // '/usr/share/homelab-ai/migrations';
my $applied = run_migrations(dbh => $dbh, schema => 'ai', migrations_dir => $migrations_dir);

print "homelab-ai: applied $applied migration(s)\n";
