[Unit]
Description=Homelab Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_WORKER_CONFIG=/etc/homelab/worker/config.yml"
# Never fronted by homelab-webproxy and never reached by a browser
# directly -- but homelab-api's own gateway (/api/v1/jobs/*,
# Homelab::Common::Proxy::forward()) IS itself a proxy hop, and that
# forward() call now sends X-Forwarded-For/X-Real-IP for exactly this
# reason. Without trusting it here too, $c->tx->remote_address would
# resolve to homelab-api's own loopback address instead of the real
# client.
Environment="MOJO_REVERSE_PROXY=1"
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-worker
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-worker
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-worker

[Install]
WantedBy=multi-user.target
