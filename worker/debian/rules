#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 644 systemd/homelab-worker.service \
		debian/homelab-worker/etc/systemd/system/homelab-worker.service
	install -D -m 644 config/worker.example.yml \
		debian/homelab-worker/usr/share/homelab-worker/config/worker.example.yml
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-worker/usr/share/homelab-worker/{} \;
