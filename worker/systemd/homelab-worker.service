[Unit]
Description=Homelab Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_WORKER_CONFIG=/etc/homelab/worker/config.yml"
# Never fronted by homelab-webproxy and never reached by a browser --
# only homelab-api's own gateway route (and any other internal caller)
# talks to this, over plain internal HTTP (see README.md). No
# MOJO_REVERSE_PROXY needed for the same reason mailbridge/domain-admin
# don't need it: there is no proxy in front of this one.
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-worker
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-worker
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-worker

[Install]
WantedBy=multi-user.target
