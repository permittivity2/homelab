#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 644 config/vrrp.example.yml \
		debian/homelab-keepalived/usr/share/homelab-keepalived/config/vrrp.example.yml
	install -D -m 644 services/keepalived.yml \
		debian/homelab-keepalived/usr/share/homelab-keepalived/services/keepalived.yml
	install -D -m 755 script/homelab-keepalived-check \
		debian/homelab-keepalived/usr/bin/homelab-keepalived-check
	install -D -m 755 script/homelab-keepalived-notify \
		debian/homelab-keepalived/usr/bin/homelab-keepalived-notify
	install -D -m 755 script/homelab-keepalived-dhclient-script \
		debian/homelab-keepalived/usr/bin/homelab-keepalived-dhclient-script
	install -D -m 644 config/60-homelab-keepalived-arp.conf \
		debian/homelab-keepalived/etc/sysctl.d/60-homelab-keepalived-arp.conf
	install -D -m 644 config/dhclient-vip.conf \
		debian/homelab-keepalived/etc/dhcp/homelab-keepalived-vip.conf
	install -D -m 644 config/10-homelab-pubvip.network \
		debian/homelab-keepalived/etc/systemd/network/10-homelab-pubvip.network
	install -D -m 644 config/keepalived-teardown.conf \
		debian/homelab-keepalived/etc/systemd/system/keepalived.service.d/10-homelab-teardown.conf
