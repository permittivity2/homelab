#!/bin/sh
# homelab-keepalived-check -- exit 0 if this node is healthy enough to own the
# edge VIPs; non-zero lowers its effective VRRP priority (by the configured
# track_weight) so a healthier peer can take over.
#
# Two checks:
#   1. tracked edge services (track_services in vrrp.yml) must be active.
#   2. public-VIP health: if this node is CURRENTLY master (it holds the
#      keepalived-managed internal "sentinel" VIP, which only the master has),
#      then every notify-managed macvlan VIP must exist, be UP, and carry its
#      reservation MAC. This catches the silent-failure case where a node won
#      the election but homelab-keepalived-notify could not build a public VIP
#      (e.g. `ip link add` failed) -- without it the node would sit master with
#      a dead VIP and never fail over. It is gated on the sentinel so it is a
#      no-op on backups, and it checks macvlan EXISTENCE (created synchronously
#      by notify), not address presence, so the asynchronous DHCP bind window
#      never false-trips it.
#
# Reads the same files homelab-keepalived-apply wrote, so the two never drift.
set -eu

CFG=/etc/homelab/keepalived/vrrp.yml
CONF=/etc/keepalived/keepalived.conf
DVIPS=/etc/homelab/keepalived/dhcp-vips.conf
[ -f "$CFG" ] || exit 0

# --- 1. tracked services --------------------------------------------------
svcs=$(awk '
    /^track_services:[[:space:]]*$/ { inlist=1; next }
    inlist && /^[[:space:]]*-[[:space:]]*/ { line=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",line); sub(/[[:space:]]*#.*$/,"",line); gsub(/[[:space:]]/,"",line); if (line != "") print line; next }
    inlist && /^[^[:space:]-]/ { inlist=0 }
' "$CFG")

for s in $svcs; do
    systemctl is-active --quiet "$s" || exit 1
done

# --- 2. public-VIP health (master only) -----------------------------------
[ -f "$DVIPS" ] || exit 0          # no notify VIPs configured -> done

# sentinel = first keepalived-managed virtual_ipaddress in the generated conf
# (only the master holds it). If there is none, fall back to "always check".
sentinel=''
if [ -f "$CONF" ]; then
    sentinel=$(awk '
        /virtual_ipaddress[[:space:]]*\{/ { inv=1; next }
        inv && /\}/ { inv=0 }
        inv && /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/ { ip=$1; sub(/\/.*/,"",ip); print ip; exit }
    ' "$CONF" 2>/dev/null)
fi
if [ -n "$sentinel" ]; then
    # not holding the sentinel => we are a backup => nothing to assert
    ip -4 -o addr show 2>/dev/null | grep -qF " ${sentinel}/" || exit 0
fi

# we are master: every notify macvlan must exist, be UP, and carry its MAC
while read -r name parent mac mode address; do
    case "$name" in ''|\#*) continue ;; esac
    ip link show dev "$name" 2>/dev/null | grep -qw UP   || exit 1
    ip link show dev "$name" 2>/dev/null | grep -qi "$mac" || exit 1
done < "$DVIPS"

exit 0
