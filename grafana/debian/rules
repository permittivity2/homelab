#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 644 provisioning/datasources/homelab-prometheus.yaml \
		debian/homelab-grafana/etc/grafana/provisioning/datasources/homelab-prometheus.yaml
	install -D -m 644 provisioning/dashboards/homelab.yaml \
		debian/homelab-grafana/etc/grafana/provisioning/dashboards/homelab.yaml
	install -D -m 644 dashboards/fleet-host-health.json \
		debian/homelab-grafana/etc/grafana/dashboards/homelab/fleet-host-health.json
	install -D -m 644 services/grafana.yml \
		debian/homelab-grafana/usr/share/homelab-grafana/services/grafana.yml
	install -D -m 644 config/grafana.conf \
		debian/homelab-grafana/usr/share/homelab-grafana/config/grafana.conf
	install -D -m 644 systemd/grafana-server-homelab.conf.template \
		debian/homelab-grafana/usr/share/homelab-grafana/systemd/grafana-server-homelab.conf.template
