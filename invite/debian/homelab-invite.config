#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/invite/config.yml ]; then
    exit 0
fi

db_input high homelab-invite/db_host || true
db_input high homelab-invite/pgbouncer_host || true
db_input high homelab-invite/api_base || true
db_input high homelab-invite/listen_port || true
db_input high homelab-invite/advertise_host || true
db_input high homelab-invite/public_base_url || true
db_input medium homelab-invite/account_domain || true
db_input medium homelab-invite/invite_ttl_days || true
db_input medium homelab-invite/default_max_pending || true
db_input medium homelab-invite/default_max_per_day || true
db_input high homelab-invite/mailer_email || true
db_input high homelab-invite/mailer_smtp_host || true
db_input high homelab-invite/mailer_smtp_port || true
db_input high homelab-invite/mailer_smtp_password || true
db_go

exit 0
