#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

# Same --no-enable --no-start reasoning as homelab-domain-admin's own
# rules file -- postinst handles enable/start itself with its own
# sequencing; letting dh_installsystemd do it too would race it.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_install:
	dh_install
	install -D -m 644 config/invite.example.yml \
		debian/homelab-invite/usr/share/homelab-invite/config/invite.example.yml
	install -D -m 644 services/invite.yml \
		debian/homelab-invite/usr/share/homelab-invite/services/invite.yml
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-invite/usr/share/homelab-invite/{} \;
