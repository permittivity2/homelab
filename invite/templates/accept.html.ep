% layout 'invite';
% title "You're invited";
<h1>You're invited</h1>
% if (length($message // '')) {
<p class="msg">"<%= $message %>"</p>
% }
<p>Create your account. Pick a username &mdash; your login will be that name at <strong><%= $domain %></strong>.</p>
<label for="username">Username</label>
<div class="uname-row">
  <input type="text" id="username" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="yourname" autofocus>
  <span class="uname-suffix">@<%= $domain %></span>
</div>
<div id="ustatus" class="hint"></div>
<label for="pw">Password</label>
<input type="password" id="pw" placeholder="At least 8 characters" autocomplete="new-password">
<label for="pw2">Confirm password</label>
<input type="password" id="pw2" placeholder="Re-enter your password" autocomplete="new-password">
<label for="recovery">Recovery email (optional)</label>
<input type="email" id="recovery" value="<%= $recipient_email %>" autocomplete="email">
<p class="hint">If you ever forget your password, we'll email a reset link here. Pre-filled with the address your invite was sent to &mdash; edit or clear it as you like.</p>
<button id="go">Create account</button>
<p id="err" class="err"></p>
<script>
var TOKEN = <%== Mojo::JSON::to_json($token) %>;
var DOMAIN = <%== Mojo::JSON::to_json($domain) %>;
var ustatus = document.getElementById('ustatus');
var errEl = document.getElementById('err');
var unameEl = document.getElementById('username');

async function postJSON(path, data) {
    var r = await fetch(path, {
        method: 'POST', headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(data)
    });
    var j = {};
    try { j = await r.json(); } catch (e) {}
    return { ok: r.ok, status: r.status, body: j };
}

function renderSuggestions(list) {
    ustatus.innerHTML = '';
    if (!list || !list.length) return;
    var span = document.createElement('span');
    span.textContent = 'Try: ';
    ustatus.appendChild(span);
    list.forEach(function (name) {
        var chip = document.createElement('span');
        chip.className = 'chip';
        chip.textContent = name;
        chip.onclick = function () {
            unameEl.value = name;
            ustatus.innerHTML = '';
            checkUsername();
        };
        ustatus.appendChild(chip);
    });
}

async function checkUsername() {
    var u = unameEl.value.trim();
    ustatus.className = 'hint';
    ustatus.textContent = '';
    if (!u) return;
    var res = await postJSON('/invite/' + TOKEN + '/username', { username: u });
    if (!res.ok) { return; }
    var b = res.body;
    if (b.invalid) { ustatus.className = 'hint err'; ustatus.textContent = b.error || 'Invalid username.'; return; }
    if (b.available) { ustatus.className = 'hint ok'; ustatus.textContent = u.toLowerCase() + '@' + DOMAIN + ' is available.'; return; }
    ustatus.className = 'hint';
    renderSuggestions(b.suggestions);
}

unameEl.addEventListener('blur', checkUsername);

// Built in JS because the whole account-created screen is: the page is
// not re-fetched after signup, so there is no server render to put this
// in. A User-Agent sniff decides only WHICH prompt to show -- the setup
// page behind both links carries every option regardless, so being wrong
// costs a tap, never a dead end.
function addDeviceSetup(body, setupUrl) {
    var ua = navigator.userAgent || '';
    var isIOS = /\b(iPhone|iPad|iPod)\b/.test(ua);

    var wrap = document.createElement('div');
    wrap.style.cssText = 'margin: var(--space-6) 0; padding-top: var(--space-5);'
        + ' border-top: 1px solid var(--border);';

    var h2 = document.createElement('p');
    h2.style.cssText = 'margin:0 0 var(--space-2); color: var(--text-primary);';
    h2.textContent = isIOS ? 'Add it to this iPhone' : 'Get it on your phone';
    wrap.appendChild(h2);

    if (isIOS) {
        var btn = document.createElement('a');
        btn.className = 'btn btn-primary';
        btn.href = setupUrl;
        btn.textContent = 'Set up Mail';
        btn.style.cssText = 'display:block; text-align:center; margin: var(--space-3) 0;';
        wrap.appendChild(btn);
        var note = document.createElement('p');
        note.className = 'hint';
        note.textContent = 'Sets up Mail in one tap. You will be asked for the password '
            + 'you just chose; the setup file never contains it.';
        wrap.appendChild(note);
    } else {
        var note2 = document.createElement('p');
        note2.className = 'hint';
        note2.style.margin = '0 0 var(--space-3)';
        note2.textContent = 'Point your phone camera at this code.';
        wrap.appendChild(note2);

        // Derived from the setup URL rather than passed separately, so
        // the code and the link can never point at different tokens.
        var img = document.createElement('img');
        img.src = setupUrl.replace('/setup/mail?', '/setup/mail/qr.svg?');
        img.alt = 'QR code linking to the mail setup page';
        img.width = 180; img.height = 180;
        // White plate behind the code: it is drawn on a dark card, and a
        // QR without a light quiet zone around it scans badly or not at all.
        img.style.cssText = 'display:block; margin:0 auto; background:#fff;'
            + ' padding: var(--space-3); border-radius: var(--radius-md);';
        // If this host cannot render QR codes the endpoint 404s. Drop the
        // image rather than leaving a broken-image icon on the one screen
        // that is supposed to feel like everything worked.
        img.onerror = function () { img.remove(); };
        wrap.appendChild(img);

        var alt = document.createElement('p');
        alt.className = 'hint';
        alt.style.cssText = 'text-align:center; margin-top: var(--space-3);';
        var link = document.createElement('a');
        link.href = setupUrl;
        link.textContent = 'or open the setup page here';
        link.style.color = 'var(--silver-bright)';
        alt.appendChild(link);
        wrap.appendChild(alt);
    }
    body.appendChild(wrap);
}

document.getElementById('go').onclick = async function () {
    errEl.textContent = '';
    var username = unameEl.value.trim();
    var pw = document.getElementById('pw').value;
    var pw2 = document.getElementById('pw2').value;
    var recovery = document.getElementById('recovery').value.trim();
    if (!username) { errEl.textContent = 'Please choose a username.'; return; }
    if (pw.length < 8) { errEl.textContent = 'Password must be at least 8 characters.'; return; }
    if (pw !== pw2) { errEl.textContent = 'The two passwords do not match.'; return; }

    var res = await postJSON('/invite/' + TOKEN + '/accept', {
        username: username, password: pw, password_confirm: pw2, recovery_email: recovery
    });
    if (res.ok && res.body.ok) {
        // Replace only the CARD BODY. This used to overwrite document.body,
        // which threw away the page's own chrome (and now the shared logo and
        // footer with it) at the single most reassuring moment in the flow.
        var login = res.body.email || (username.toLowerCase() + '@' + DOMAIN);
        var h = document.createElement('h1');
        h.textContent = 'Account created';
        var p = document.createElement('p');
        p.appendChild(document.createTextNode('Your login is '));
        var strong = document.createElement('strong');
        strong.textContent = login;
        p.appendChild(strong);
        p.appendChild(document.createTextNode('. You can now sign in.'));
        var body = document.getElementById('card-body');
        body.innerHTML = '';
        body.appendChild(h);
        body.appendChild(p);

        // The device-setup offer, placed BEFORE the sign-in button on
        // purpose: this is the one moment the person is certain to be
        // paying attention, and getting mail onto the phone is the thing
        // that makes the account real. setup_url is null when this
        // install has no signing secret -- then this block is simply
        // absent and the screen is what it always was.
        if (res.body.setup_url) {
            addDeviceSetup(body, res.body.setup_url);
        }

        var a = document.createElement('a');
        a.className = 'btn btn-primary';
        a.href = '<%= $login_url %>';
        a.textContent = 'Sign in';
        body.appendChild(a);
        return;
    }
    if (res.body.suggestions) {
        // textContent, not innerHTML: this string used to be assigned with
        // an &mdash; entity through innerHTML, which only worked by accident.
        errEl.textContent = 'That username is no longer available — try one of these:';
        renderSuggestions(res.body.suggestions);
        return;
    }
    errEl.textContent = res.body.error || 'Something went wrong.';
};
</script>
