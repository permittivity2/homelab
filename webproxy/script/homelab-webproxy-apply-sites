#!/usr/bin/perl
# Reads /etc/homelab/webproxy/sites.yml and, for each site without an
# existing vhost, writes an HTTP-only nginx vhost, reloads nginx, then
# runs `certbot --nginx` to obtain a cert and upgrade the vhost to
# HTTPS-with-redirect. Idempotent — safe to re-run after adding a new
# site to sites.yml; existing sites (vhost file already present) are
# left completely alone, including whatever certbot has since done to
# them.
use strict;
use warnings;
use YAML::XS qw(LoadFile DumpFile);

my $SITES_CONFIG    = $ENV{HOMELAB_WEBPROXY_SITES}      // '/etc/homelab/webproxy/sites.yml';
my $VHOST_TEMPLATE  = $ENV{HOMELAB_WEBPROXY_TEMPLATE}   // '/usr/share/homelab-webproxy/config/vhost.conf.template';
my $SITES_AVAILABLE = $ENV{HOMELAB_WEBPROXY_AVAILABLE}  // '/etc/nginx/sites-available';
my $SITES_ENABLED   = $ENV{HOMELAB_WEBPROXY_ENABLED}    // '/etc/nginx/sites-enabled';
# nginx's `upstream {}` directive is only valid in the http{} context,
# not inside a server{} block -- so a load-balanced site's upstream
# group can't live in the per-domain vhost file the way a single
# proxy_pass target does. Debian/Ubuntu's stock nginx.conf already
# `include`s this directory from inside http{}, so a file dropped here
# loads automatically with no nginx.conf edit needed.
my $CONFD_DIR        = $ENV{HOMELAB_WEBPROXY_CONFD}      // '/etc/nginx/conf.d';

unless (-f $SITES_CONFIG) {
    print "homelab-webproxy: no $SITES_CONFIG yet — nothing to apply.\n";
    print "  Copy /usr/share/homelab-webproxy/config/sites.example.yml there and re-run.\n";
    exit 0;
}

my $config = LoadFile($SITES_CONFIG);
my $email  = $config->{letsencrypt_email};
my @sites  = @{ $config->{sites} // [] };
my $pool_changed = 0;    # set when a 'discover:'/upstream pool confd changes

die "sites.yml: letsencrypt_email is required\n" unless $email && $email !~ /YOUR_EMAIL_HERE/;

my $template = do {
    open(my $fh, '<', $VHOST_TEMPLATE) or die "Cannot read $VHOST_TEMPLATE: $!\n";
    local $/ = undef;
    <$fh>;
};

# Any site with `websocket: true` references $connection_upgrade in its
# vhost (see the per-site block below), which must be defined by an
# http-context `map`. Drop that map into conf.d -- Debian/Ubuntu's stock
# nginx.conf already include's this directory from inside http{}, so it
# loads with no nginx.conf edit. Written whenever at least one site needs
# it; a map{} and the vhosts that use it can appear in any order within
# http{}, so this needn't precede them textually. Only-if-changed, and
# flag a reload (via $pool_changed, below) so it takes effect even on a
# run where every vhost step is skipped (all sites already HTTPS).
my $ws_map_conf = "$CONFD_DIR/homelab-webproxy-websocket.conf";
if (grep { $_->{websocket} } @sites) {
    my $ws_map_content =
          "# Managed by homelab-webproxy's homelab-webproxy-apply-sites.\n"
        . "# Maps the request's Upgrade header so that a websocket site's\n"
        . "# `proxy_set_header Connection \$connection_upgrade` sends\n"
        . "# \"upgrade\" for a websocket request and \"close\" otherwise.\n"
        . "map \$http_upgrade \$connection_upgrade {\n"
        . "    default upgrade;\n"
        . "    ''      close;\n"
        . "}\n";
    my $existing_map = '';
    if (open(my $rf, '<', $ws_map_conf)) { local $/; $existing_map = <$rf>; close($rf); }
    if ($existing_map ne $ws_map_content) {
        open(my $wf, '>', $ws_map_conf) or die "Cannot write $ws_map_conf: $!\n";
        print $wf $ws_map_content;
        close($wf);
        $pool_changed = 1;
    }
}

my $applied = 0;
for my $site (@sites) {
    my $domain = $site->{domain} // die "sites.yml: a site is missing 'domain'\n";

    # 'upstream' (single host:port, original shape) and 'upstreams' (a
    # list, for HA/load-balanced groups) both accepted -- 'upstreams'
    # added when this first needed more than one real backend per site
    # (3x roundcube instances behind one vhost). A list gets turned into
    # a real nginx upstream{} block (see $CONFD_DIR above); proxy_pass
    # then targets that block's name instead of a literal host:port --
    # nginx doesn't support multiple proxy_pass targets any other way.
    my @upstream_targets;
    if (my $feature = $site->{discover}) {
        # PULL model (same as homelab-haproxy's 'discover:'): derive the
        # upstream list live from homelab-api's fleet view, so a new
        # instance of the fronted service is picked into the pool
        # automatically. Run on a timer (homelab-webproxy-pull.timer) to
        # stay current. $feature is a service_name (e.g. roundcube-nginx)
        # or package_name.
        require Homelab::Common::Registry;
        my $api_base = $config->{api_base}
            // die "sites.yml: site '$domain' uses 'discover' but top-level 'api_base' is unset\n";
        my $live = eval { Homelab::Common::Registry::lookup_backends($feature, api_base => $api_base) };
        if ($@) {
            warn "homelab-webproxy: discover '$feature' failed ($@); falling back to any static 'upstreams'\n";
        } else {
            @upstream_targets = sort map { "$_->{address}:$_->{port}" }
                                grep { $_->{address} && $_->{port} } @$live;
        }
        # Never emit an empty upstream (nginx -t fails): fall back to a
        # static 'upstreams' list, else skip this site this run.
        @upstream_targets = @{ $site->{upstreams} } if !@upstream_targets && ref($site->{upstreams}) eq 'ARRAY';
        if (!@upstream_targets) {
            warn "homelab-webproxy: site '$domain' discovered no upstreams and has no static fallback -- skipping\n";
            next;
        }
    } elsif (my $list = $site->{upstreams}) {
        die "sites.yml: site '$domain''s 'upstreams' must be a list\n" unless ref($list) eq 'ARRAY';
        @upstream_targets = @$list;
    } elsif (my $single = $site->{upstream}) {
        @upstream_targets = ($single);
    } else {
        die "sites.yml: site '$domain' needs 'upstream', 'upstreams', or 'discover'\n";
    }

    my $upstream;
    if (@upstream_targets > 1) {
        (my $pool_name = $domain) =~ s/[^A-Za-z0-9]/_/g;
        $pool_name = "pool_$pool_name";
        $upstream = $pool_name;
        my $pool_conf = "$CONFD_DIR/$domain-upstream.conf";
        my $pool_content = "# Managed by homelab-webproxy's homelab-webproxy-apply-sites for\n"
            . "# $domain -- do not hand-edit; edit /etc/homelab/webproxy/sites.yml\n"
            . "# and re-run homelab-webproxy-apply-sites instead. Regenerated\n"
            . "# wholesale on every run, not merged.\n"
            . "upstream $pool_name {\n";
        # 'sticky_cookie: <NAME>' (optional) -- session affinity keyed on
        # the app's own session cookie, via nginx's stock (no Plus, no
        # third-party module needed -- confirmed live 2026-09-25 with a
        # real nginx -t) ngx_http_upstream_hash_module. Needed for any
        # pooled app that keeps server-side session state per-instance
        # (Roundcube's own PHP file sessions; any homelab-* Mojolicious
        # app using $c->session for browser-based OAuth login state, e.g.
        # homelab-drive) -- a request that starts a stateful handshake on
        # one backend and lands on a DIFFERENT one for the next leg (e.g.
        # the SSO callback) finds no matching session and the flow fails.
        # Confirmed live: this broke the 3x roundcube pool's OAuth login
        # non-deterministically (~2 times out of 3) before being fixed.
        #
        # An EARLIER version of this script used ip_hash unconditionally
        # for every multi-backend pool instead -- replaced here because
        # ip_hash keys on the CLIENT'S IP, not the session, which breaks
        # the exact same way the moment a client's IP changes mid-session
        # (e.g. a phone moving between WiFi and cellular) even though the
        # cookie/session itself is still perfectly valid. Hashing the
        # session cookie survives that; only the very first request of a
        # brand new session (before the cookie exists yet) hashes an
        # empty value, which is harmless -- it just means every
        # cookie-less first-hit lands on the same one pool member until
        # that member's response sets the cookie.
        #
        # No 'sticky_cookie' at all means plain round-robin (nginx's own
        # default) -- correct for a genuinely stateless pool (e.g. a pure
        # JWT-Bearer API with no server-side session), which shouldn't
        # pay for affinity it doesn't need.
        if (my $cookie = $site->{sticky_cookie}) {
            die "sites.yml: site '$domain''s 'sticky_cookie' must be a plain cookie name (letters, digits, _, -)\n"
                unless $cookie =~ /^[A-Za-z0-9_-]+$/;
            $pool_content .= "    hash \$cookie_$cookie consistent;\n";
        }
        $pool_content .= "    server $_;\n" for @upstream_targets;
        $pool_content .= "}\n";
        # Write only if changed, and flag a reload -- a 'discover:' pool's
        # membership can change on an EXISTING (already-HTTPS) site that the
        # vhost step below skips, so the reload can't live only in that step.
        my $existing_pool = '';
        if (open(my $rf, '<', $pool_conf)) { local $/; $existing_pool = <$rf>; close($rf); }
        if ($existing_pool ne $pool_content) {
            open(my $pfh, '>', $pool_conf) or die "Cannot write $pool_conf: $!\n";
            print $pfh $pool_content;
            close($pfh);
            $pool_changed = 1;
        }
    } else {
        $upstream = $upstream_targets[0];
    }

    my $vhost_path = "$SITES_AVAILABLE/$domain";

    # A vhost that already has HTTPS (certbot's --nginx plugin adds a
    # `listen 443 ssl` line to the file on success) is genuinely done —
    # skip it. A vhost that exists but is STILL http-only means a
    # previous run's certbot step failed (e.g. port 80 wasn't reachable
    # from the internet yet) — retry the cert step for it rather than
    # silently treating "the http-only vhost file exists" as "fully
    # configured" forever. Hit this exact scenario for real on
    # test-static-internet-ip (a network-level firewall blocked the
    # ACME HTTP-01 challenge) — without this check, fixing the firewall
    # and re-running would never have picked it back up.
    if (-f $vhost_path && _vhost_has_https($vhost_path)) {
        print "homelab-webproxy: $domain already has a vhost with HTTPS configured — skipping.\n";
        next;
    }

    if (-f $vhost_path) {
        print "homelab-webproxy: $domain has an HTTP-only vhost (a previous certbot attempt likely failed) — retrying the cert...\n";
    }
    else {
        print "homelab-webproxy: configuring $domain -> $upstream...\n";

        # Per-site upload ceiling. Default 100m; a site that handles big
        # uploads (drive/api accept 4GB) sets e.g. `max_body_size: 5g`.
        # Setting it also marks the site as a large-upload site: nginx
        # then STREAMS the request body to the upstream (proxy_request_
        # buffering off) instead of first buffering the whole multi-GB
        # body to its own temp dir, and gets generous timeouts so a big
        # or slow transfer isn't cut off mid-flight.
        my $max_body = $site->{max_body_size} // '100m';
        die "sites.yml: site '$domain''s 'max_body_size' must look like e.g. 100m or 5g\n"
            unless $max_body =~ /^\d+[kKmMgG]?$/;
        my $large_directives = '';
        if (exists $site->{max_body_size}) {
            $large_directives =
                  "        proxy_request_buffering off;\n"
                . "        proxy_read_timeout 3600s;\n"
                . "        proxy_send_timeout 3600s;\n"
                . "        client_body_timeout 3600s;\n";
        }

        # 'websocket: true' -- proxy websocket Upgrade handshakes AND
        # stream (don't buffer) the response, with long timeouts. Needed
        # by any app whose live features ride a persistent websocket --
        # the motivating case is Plex (its notifications / live /
        # streaming features silently break behind a plain proxy that
        # drops the Upgrade/Connection headers). $connection_upgrade
        # comes from the http-context map this script writes to conf.d
        # whenever any site sets this (see above). proxy_read/send_timeout
        # may duplicate the large-upload block's values if both flags are
        # set on one site -- harmless (identical values, last wins).
        my $websocket_directives = '';
        if ($site->{websocket}) {
            $websocket_directives =
                  "        proxy_http_version 1.1;\n"
                . "        proxy_set_header Upgrade \$http_upgrade;\n"
                . "        proxy_set_header Connection \$connection_upgrade;\n"
                . "        proxy_buffering off;\n"
                . "        proxy_read_timeout 3600s;\n"
                . "        proxy_send_timeout 3600s;\n";
        }

        my $vhost = $template;
        $vhost =~ s/__DOMAIN__/$domain/g;
        $vhost =~ s/__UPSTREAM__/$upstream/g;
        $vhost =~ s/__MAX_BODY_SIZE__/$max_body/g;
        $vhost =~ s/__WEBSOCKET_DIRECTIVES__/$websocket_directives/g;
        $vhost =~ s/__LARGE_UPLOAD_DIRECTIVES__/$large_directives/g;

        open(my $fh, '>', $vhost_path) or die "Cannot write $vhost_path: $!\n";
        print $fh $vhost;
        close($fh);

        symlink($vhost_path, "$SITES_ENABLED/$domain") unless -e "$SITES_ENABLED/$domain";

        system('nginx', '-t') == 0 or die "nginx config test failed after adding $domain — check $vhost_path\n";
        system('systemctl', 'reload', 'nginx') == 0 or die "nginx reload failed after adding $domain\n";
    }

    # PREFER a certificate that is already on disk over asking certbot for a
    # new one. Since the fleet gained a central certificate store
    # (homelab-cert-server issues once; homelab-certsync distributes), an edge
    # node normally HAS the cert before this ever runs -- and a standby edge
    # deliberately holds no ACME account at all, so calling certbot there fails
    # by design and would leave the vhost HTTP-only. Wiring the existing files
    # is both correct and the only thing that works on a non-issuing node.
    my $live = "/etc/letsencrypt/live/$domain";
    if (-s "$live/fullchain.pem" && -s "$live/privkey.pem") {
        print "  certificate already present for $domain -- wiring it (no certbot needed)\n";
        if (_enable_tls_for($vhost_path, $domain, $live)) {
            if (system('nginx', '-t') == 0) {
                system('systemctl', 'reload', 'nginx');
                print "  $domain is live over HTTPS (existing certificate).\n";
            } else {
                warn "  WARNING: nginx -t failed after enabling TLS for $domain -- left as-is.\n";
            }
        }
        next;
    }

    print "  requesting a cert for $domain via certbot...\n";
    my $rc = system(
        'certbot', '--nginx', '-d', $domain,
        '--non-interactive', '--agree-tos', '-m', $email, '--redirect',
    );
    if ($rc != 0) {
        warn "  WARNING: certbot failed for $domain (exit $rc) — $domain is live on HTTP only for now.\n";
        warn "           Check DNS actually resolves to this host, then re-run: certbot --nginx -d $domain\n";
        warn "           (On a standby edge this is EXPECTED: only the cert server issues. Install\n";
        warn "            homelab-certsync so the certificate arrives, then re-run this.)\n";
    }
    else {
        print "  $domain is live over HTTPS.\n";
    }

    $applied++;
}

print "homelab-webproxy: $applied new site(s) configured.\n";

# An upstream pool confd changed for a site whose vhost step was skipped
# (already-HTTPS existing site -- the common case for a 'discover:' pool on
# the pull timer). Reload nginx once so the new member set takes effect.
if ($pool_changed) {
    if (system('nginx', '-t') == 0) {
        system('systemctl', 'reload', 'nginx') == 0
            or warn "homelab-webproxy: nginx reload failed after an upstream change\n";
        print "homelab-webproxy: upstream pool changed -- reloaded nginx.\n";
    } else {
        warn "homelab-webproxy: nginx config test failed after an upstream change -- NOT reloading\n";
    }
}

# Writes /etc/homelab/services/webproxy.yml, one entry per site,
# unconditionally on every run (not just newly-applied ones) --
# sites.yml is this package's own source of truth and is meant to be
# regenerated wholesale here, same reasoning as HAProxy's own
# backends.yml -> haproxy.cfg ("not merged"), so a domain removed from
# sites.yml should also disappear from the fleet status view, not just
# stop getting a new vhost written for it. homelab-agent (if installed
# on this host) picks this up and reports it to homelab-api -- no
# config needed here for that, unlike the old infrastructure_registry
# call this replaced, which needed this host's own address passed in
# explicitly; homelab-agent already knows its own identity. Best-effort:
# never lets a write failure affect the exit status of the actual
# site-apply work above.
my $manifest_dir  = $ENV{HOMELAB_SERVICES_MANIFEST_DIR} // '/etc/homelab/services';
my $manifest_file = "$manifest_dir/webproxy.yml";
if (-d $manifest_dir) {
    my @manifest = map {
        my $s = $_;
        my @t = $s->{upstreams} ? @{ $s->{upstreams} } : ($s->{upstream});
        {
            name        => "webproxy-$s->{domain}",
            package     => 'homelab-webproxy',
            kind        => 'http-proxy-vhost',
            check       => { tcp_port => 443 },
            description => "HTTPS vhost for $s->{domain}",
            fronts      => [@t],
        }
    } @sites;
    eval { DumpFile($manifest_file, \@manifest); 1 }
        or print "  WARNING: failed to write $manifest_file -- fleet status view may be stale: $@\n";
}
else {
    print "homelab-webproxy: $manifest_dir doesn't exist (homelab-agent not installed here yet)"
        . " -- skipping manifest write.\n";
}

sub _vhost_has_https {
    my ($path) = @_;
    open(my $fh, '<', $path) or return 0;
    local $/ = undef;
    my $content = <$fh>;
    close($fh);
    return $content =~ /listen\s+443\s+ssl/ ? 1 : 0;
}

# Turn an HTTP-only vhost into the same shape certbot's --nginx --redirect
# produces: a :443 TLS server plus a :80 redirect. Written by hand because the
# certificate came from the fleet store rather than from certbot on this host.
sub _enable_tls_for {
    my ($vhost_path, $domain, $live) = @_;
    open(my $in, '<', $vhost_path) or do { warn "  cannot read $vhost_path: $!\n"; return 0 };
    local $/; my $conf = <$in>; close $in;
    return 0 if $conf =~ /ssl_certificate\s/;          # already TLS

    # Add the TLS bits to the existing server block, then append a redirect
    # server for :80. Keep the original listen 80 line inside the redirect.
    my $tls = qq{\n    listen 443 ssl;\n    listen [::]:443 ssl;\n}
            . qq{    ssl_certificate $live/fullchain.pem;\n}
            . qq{    ssl_certificate_key $live/privkey.pem;\n};
    $tls .= qq{    include /etc/letsencrypt/options-ssl-nginx.conf;\n}
        if -f '/etc/letsencrypt/options-ssl-nginx.conf';
    $tls .= qq{    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;\n}
        if -f '/etc/letsencrypt/ssl-dhparams.pem';

    # drop the plain listen 80 from the main block and close it with the TLS bits
    $conf =~ s/^\s*listen\s+(\[::\]:)?80;\s*$//mg;
    $conf =~ s/\}\s*\z/$tls}\n/s;

    # Plain concatenation, NOT qq{...}: a literal '}' inside a brace-delimited
    # qq closes the quote early, which silently emitted the rest of the
    # expression into the config as text and made nginx -t fail with
    # `unknown directive "."`.
    $conf .= "\nserver {\n"
           . "    listen 80;\n"
           . "    listen [::]:80;\n"
           . "    server_name $domain;\n"
           . "    return 301 https://\$host\$request_uri;\n"
           . "}\n";

    my $tmp = "$vhost_path.tls.$$";
    open(my $out, '>', $tmp) or do { warn "  cannot write $tmp: $!\n"; return 0 };
    print $out $conf; close $out;
    rename($tmp, $vhost_path) or do { warn "  cannot install $vhost_path: $!\n"; return 0 };
    return 1;
}
