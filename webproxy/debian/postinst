#!/bin/sh
set -e

CONFIG_DIR=/etc/homelab/webproxy
SITES_FILE="$CONFIG_DIR/sites.yml"
SHARE_DIR=/usr/share/homelab-webproxy

case "$1" in
    configure)
        echo "homelab-webproxy post-installation setup..."
        mkdir -p "$CONFIG_DIR"

        if [ ! -f "$SITES_FILE" ]; then
            cp "$SHARE_DIR/config/sites.example.yml" "$SITES_FILE"
            echo "  wrote a starter $SITES_FILE — edit it (real email, your"
            echo "  domain/upstream pairs), then run: homelab-webproxy-apply-sites"
        else
            echo "  applying $SITES_FILE..."
            homelab-webproxy-apply-sites \
                || echo "  WARNING: homelab-webproxy-apply-sites reported a problem — see output above."
        fi

        echo ""
        echo "homelab-webproxy configured."
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
