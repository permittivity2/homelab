# Managed by homelab-webproxy's homelab-webproxy-apply-sites for
# __DOMAIN__ — do not hand-edit; edit /etc/homelab/webproxy/sites.yml
# and re-run homelab-webproxy-apply-sites instead. certbot rewrites this
# file to add the HTTPS server block + redirect on first run; it stays
# managed by certbot's own renewal after that.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
