# Managed by homelab-webproxy's homelab-webproxy-apply-sites for
# __DOMAIN__ — do not hand-edit; edit /etc/homelab/webproxy/sites.yml
# and re-run homelab-webproxy-apply-sites instead. certbot rewrites this
# file to add the HTTPS server block + redirect on first run; it stays
# managed by certbot's own renewal after that.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # nginx's own compiled-in default (1m) is why a real ~1.1MB
    # homelab-drive upload once failed with a slow, confusing timeout
    # instead of an immediate, clear error. Default 100m, but a site can
    # raise it via sites.yml `max_body_size:` (e.g. drive/api, which
    # accept 4GB uploads) -- see homelab-webproxy-apply-sites.
    client_max_body_size __MAX_BODY_SIZE__;

    location / {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
__LARGE_UPLOAD_DIRECTIVES__    }
}
