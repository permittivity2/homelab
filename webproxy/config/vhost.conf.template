# Managed by homelab-webproxy's homelab-webproxy-apply-sites for
# __DOMAIN__ — do not hand-edit; edit /etc/homelab/webproxy/sites.yml
# and re-run homelab-webproxy-apply-sites instead. certbot rewrites this
# file to add the HTTPS server block + redirect on first run; it stays
# managed by certbot's own renewal after that.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # nginx's own compiled-in default (1m) is why a real ~1.1MB
    # homelab-drive upload once failed with a slow, confusing timeout
    # instead of an immediate, clear error -- this is also why it sat
    # in front of homelab-roundcube's own 25m attachment limit, at the
    # OUTER proxy layer, making that inner limit unreachable for
    # anything over 1MB. One shared default here, applying to every
    # site this package manages, rather than a per-site special case --
    # nothing here currently needs a *different* limit from any other.
    client_max_body_size 100m;

    location / {
        proxy_pass http://__UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
