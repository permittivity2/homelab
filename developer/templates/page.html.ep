%# A page written in Markdown (pages/*.md): Getting started, the Claude Code
%# page, Not found. $body is its HTML; $example, when there is one, an
%# ability whose examples go in the code panel beside it.
% my $example = stash 'example';
    <article class="ref-main<%= $example ? '' : ' wide' %>">
      <div class="ref-crumb"><%= $crumb %></div>
      <h1><%= title %></h1>
<%== $body %>
    </article>
% if ($example) {
%= include 'code', ex => $example
% }
