<!DOCTYPE html>
<html lang="en">
<head>
%# developer.mailmasker.org (post-cutover item 49): the shared chrome from
%# homelab-webtheme, and three columns in the manner of Stripe's and
%# Shopify's API docs: the menu, the explanation, and a dark code panel. One
%# column on a phone. Built once into plain files; nothing here runs on a
%# server.
%= include 'homelab/head'
  <title><%= title %> · MailMasker API</title>
% if (length(stash('description') // '')) {
  <meta name="description" content="<%= stash 'description' %>">
% }
% if (my $alt = stash 'alternate') {
  <link rel="alternate" type="text/markdown" href="<%= $alt %>">
% }
  <style>
    /* Dark scrollbars and form controls, to match the black theme. */
    :root { --container-max-width: 1480px; color-scheme: dark; }
    .ref { display: grid; grid-template-columns: 15rem minmax(0, 1fr) minmax(0, 32rem); gap: var(--space-8); align-items: start; }
    .ref-main.wide { grid-column: span 2; max-width: 52rem; }

    /* The menu: areas, then abilities with their method tags. */
    .ref-nav { position: sticky; top: calc(var(--topbar-height) + var(--space-4)); max-height: calc(100vh - var(--topbar-height) - var(--space-8)); overflow-y: auto; padding-right: var(--space-2); scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
    .ref-nav .ref-filter { width: 100%; margin-bottom: var(--space-3); }
    .ref-nav h3 { font-size: var(--app-xs); font-weight: var(--weight-medium); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--text-muted); margin: var(--space-4) 0 var(--space-1); }
    .ref-nav a { display: flex; gap: var(--space-2); align-items: center; padding: 0.3rem var(--space-2); border-radius: var(--radius-sm); color: var(--text-secondary); text-decoration: none; font-size: var(--app-sm); line-height: 1.3; }
    .ref-nav a:hover { background: var(--surface-hover); color: var(--text-primary); }
    .ref-nav a.current { background: var(--surface); color: var(--silver-bright); box-shadow: inset 2px 0 0 var(--silver-medium); }
    .ref-nav .ref-version { margin-top: var(--space-6); font-size: var(--app-xs); color: var(--text-muted); line-height: 1.5; }
    .ref-jump { display: none; width: 100%; }

    /* Method tags, in the theme's colours. */
    .m { font: var(--weight-semibold) 0.68rem/1 var(--font-mono); padding: 0.22rem 0.35rem; border-radius: var(--radius-sm); flex: none; min-width: 3.2rem; text-align: center; }
    .m-GET    { color: #86c9a5; background: rgba(92, 158, 124, 0.16); }
    .m-POST   { color: #abc3d8; background: rgba(74, 93, 110, 0.45); }
    .m-PUT, .m-PATCH { color: #e7c072; background: rgba(217, 164, 65, 0.14); }
    .m-DELETE { color: #ec9090; background: rgba(216, 92, 92, 0.15); }

    /* The explanation. */
    .ref-main { min-width: 0; }
    .ref-crumb { font-size: var(--app-xs); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--text-muted); }
    .ref-main h1 { font-size: var(--app-xl); font-weight: var(--weight-light); letter-spacing: var(--tracking-tight); margin: var(--space-2) 0 var(--space-4); }
    .ref-main h2 { font-size: var(--app-md); font-weight: var(--weight-medium); margin: var(--space-8) 0 var(--space-3); }
    .ref-main p, .ref-main li { line-height: 1.6; }
    .ref-main p { margin: 0 0 var(--space-3); }
    .ref-main a { color: var(--silver-bright); text-decoration: underline; text-underline-offset: 0.15em; }
    .ref-main code { font-size: 0.85em; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.05rem 0.3rem; overflow-wrap: anywhere; }
    .ref-endpoint { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-3); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); font-family: var(--font-mono); font-size: var(--app-sm); overflow-wrap: anywhere; }
    .ref-endpoint + p { margin-top: var(--space-4); }
    .ref-who { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0; font-size: var(--app-sm); color: var(--text-secondary); }
    .ref-who strong { color: var(--text-primary); font-weight: var(--weight-medium); }
    .ref-who a { margin-left: auto; color: var(--text-muted); font-size: var(--app-xs); }
    .ref-params { width: 100%; border-collapse: collapse; font-size: var(--app-sm); }
    .ref-params th { text-align: left; font-weight: var(--weight-medium); color: var(--text-muted); font-size: var(--app-xs); text-transform: uppercase; letter-spacing: var(--tracking-wide); padding: var(--space-2); border-bottom: 1px solid var(--border-strong); }
    .ref-params td { padding: var(--space-3) var(--space-2); border-bottom: 1px solid var(--border); vertical-align: top; }
    .ref-params td.name { font-family: var(--font-mono); color: var(--silver-bright); white-space: nowrap; }
    .ref-params .req { color: var(--warning); font-size: var(--app-xs); }
    .ref-params .ex { display: block; margin-top: var(--space-1); color: var(--text-muted); font-family: var(--font-mono); font-size: var(--app-xs); overflow-wrap: anywhere; }
    .ref-notes { padding-left: 1.25rem; }
    .ref-notes li { margin-bottom: var(--space-2); }

    /* A command in the text, with its own Copy button. */
    .ref-snippet { position: relative; margin: var(--space-3) 0; }
    .ref-snippet pre { margin: 0; background: var(--surface-raised); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3) 5rem var(--space-3) var(--space-4); overflow-x: auto; font-size: 0.78rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
    .ref-snippet .copy { position: absolute; top: var(--space-2); right: var(--space-2); }

    /* The code panel: a shade lighter than the page, and in view while the
       explanation scrolls. */
    .ref-code { position: sticky; top: calc(var(--topbar-height) + var(--space-4)); display: grid; gap: var(--space-4); min-width: 0; }
    .ref-block { background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-md); overflow: hidden; }
    .ref-bar { display: flex; align-items: center; gap: var(--space-1); padding: 0 var(--space-2) 0 var(--space-3); border-bottom: 1px solid var(--border); min-height: 2.6rem; }
    .ref-bar .label { font-size: var(--app-xs); text-transform: uppercase; letter-spacing: var(--tracking-wider); color: var(--text-muted); }
    .ref-bar .spacer { flex: 1 1 auto; }
    .tab { background: none; border: none; color: var(--text-muted); padding: var(--space-3) var(--space-2); cursor: pointer; font: inherit; font-size: var(--app-sm); }
    .tab:hover { color: var(--text-primary); }
    .tab.on { color: var(--silver-bright); box-shadow: inset 0 -2px 0 var(--silver-medium); }
    /* Long lines (URLs, mostly) wrap rather than scroll, so a whole example
       is in view on a phone; Copy still copies the text exactly. */
    .ref-block pre { margin: 0; padding: var(--space-4); overflow-x: auto; font-size: 0.78rem; line-height: 1.6; color: var(--text-primary); white-space: pre-wrap; overflow-wrap: anywhere; }
    .ref-block pre.none { white-space: normal; color: var(--text-muted); font-family: var(--font-primary); }
    .ref-status { font-family: var(--font-mono); font-size: var(--app-xs); color: var(--success); }

    @media (max-width: 1180px) {
      .ref { grid-template-columns: 13rem minmax(0, 1fr); }
      .ref-code { grid-column: 2; position: static; }
      .ref-main.wide { grid-column: 2; }
    }
    @media (max-width: 760px) {
      .ref { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
      .ref-nav { display: none; }
      .ref-jump { display: block; }
      .ref-code, .ref-main.wide { grid-column: 1; }
      .ref-params td.name { white-space: normal; }
    }
  </style>
</head>
<body class="app">
%= include 'homelab/header'
<main class="app__main">
  <div class="container">
    <div class="ref">
%= include 'menu'
<%= content %>
    </div>
  </div>
</main>
%= include 'homelab/footer'
<script>
// The language switch (remembered), Copy, the menu filter and the phone's
// "Jump to" list. Everything else is plain HTML.
(function () {
  'use strict';
  var KEY = 'devref-lang';
  function setLang(lang) {
    var tabs = document.querySelectorAll('.ref-code .tab');
    if (!tabs.length) return;
    if (!document.querySelector('.ref-code .tab[data-lang="' + lang + '"]')) lang = 'curl';
    Array.prototype.forEach.call(document.querySelectorAll('.ref-code [data-lang]'), function (el) {
      var on = el.getAttribute('data-lang') === lang;
      if (el.classList.contains('tab')) { el.classList.toggle('on', on); el.setAttribute('aria-selected', on ? 'true' : 'false'); }
      else el.hidden = !on;
    });
    try { localStorage.setItem(KEY, lang); } catch (e) {}
  }
  var saved = null;
  try { saved = localStorage.getItem(KEY); } catch (e) {}
  setLang(saved || 'curl');

  function copied(btn, ok) {
    var was = btn.textContent;
    btn.textContent = ok ? 'Copied' : 'Select and copy';
    setTimeout(function () { btn.textContent = was; }, 1500);
  }
  document.addEventListener('click', function (e) {
    var tab = e.target.closest('.ref-code .tab');
    if (tab) { setLang(tab.getAttribute('data-lang')); return; }
    var btn = e.target.closest('.copy');
    if (!btn) return;
    var box = btn.closest('.ref-block, .ref-snippet');
    var pre = box && box.querySelector('pre:not([hidden])');
    if (!pre) return;
    var text = pre.textContent;
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(function () { copied(btn, true); }, function () { copied(btn, false); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text; document.body.appendChild(ta); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (err) {}
      document.body.removeChild(ta); copied(btn, ok);
    }
  });

  var filter = document.getElementById('ref-filter');
  if (filter) filter.addEventListener('input', function () {
    var q = filter.value.trim().toLowerCase();
    Array.prototype.forEach.call(document.querySelectorAll('.ref-nav [data-search]'), function (a) {
      a.hidden = q !== '' && a.getAttribute('data-search').indexOf(q) < 0;
    });
    Array.prototype.forEach.call(document.querySelectorAll('.ref-nav h3'), function (h) {
      var any = false, el = h.nextElementSibling;
      while (el && el.tagName === 'A') { if (!el.hidden) any = true; el = el.nextElementSibling; }
      h.hidden = !any;
    });
  });

  var jump = document.getElementById('ref-jump');
  if (jump) jump.addEventListener('change', function () { if (jump.value) location.href = jump.value; });
})();
</script>
</body>
</html>
