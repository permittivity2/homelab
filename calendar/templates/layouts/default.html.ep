<!DOCTYPE html>
<html lang="en">
<head>
%# Shared chrome from homelab-webtheme (theme.css, fonts, favicon from
%# static.mailmasker.org); only what this app needs is below. FullCalendar's
%# own styles are injected by its bundle; the --fc-* variables map them onto
%# the theme's colours.
%= include 'homelab/head'
<title><%= title %></title>
<style>
  :root {
    --fc-page-bg-color: var(--surface);
    --fc-neutral-bg-color: var(--surface-hover);
    --fc-neutral-text-color: var(--text-muted);
    --fc-border-color: var(--border-strong);
    --fc-button-text-color: var(--text-primary);
    --fc-button-bg-color: var(--surface-raised);
    --fc-button-border-color: var(--border-strong);
    --fc-button-hover-bg-color: var(--surface-hover);
    --fc-button-hover-border-color: var(--silver-dim);
    --fc-button-active-bg-color: var(--accent-steel);
    --fc-button-active-border-color: var(--accent-steel);
    --fc-event-bg-color: var(--info);
    --fc-event-border-color: var(--info);
    --fc-event-text-color: #fff;
    --fc-more-link-bg-color: var(--surface-raised);
    --fc-more-link-text-color: var(--text-primary);
    --fc-today-bg-color: rgba(111, 148, 184, 0.12);
    --fc-now-indicator-color: var(--error);
    --fc-highlight-color: rgba(192, 192, 192, 0.15);
    --fc-list-event-hover-bg-color: var(--surface-hover);
    --fc-small-font-size: var(--app-sm);
  }
  .app__main { padding: var(--space-4); display: flex; flex-direction: column; min-height: 0; }
  .fc { color: var(--text-primary); font-size: var(--app-base); }
  .fc a { color: inherit; text-decoration: none; }
  .fc .fc-toolbar-title { font-size: var(--app-lg); font-weight: var(--weight-medium); }
  .fc .fc-button { border-radius: var(--radius-sm); font-size: var(--app-sm); padding: var(--space-1) var(--space-3); text-transform: none; }
  .fc .fc-button:focus { box-shadow: 0 0 0 2px var(--focus-ring); }
  .fc .fc-daygrid-day-number, .fc .fc-col-header-cell-cushion { color: var(--text-secondary); }
  .fc .fc-day-today .fc-daygrid-day-number { color: var(--silver-bright); font-weight: var(--weight-semibold); }
  .fc .fc-event { border-radius: var(--radius-sm); cursor: pointer; }
  .fc .fc-event.is-busy { opacity: 0.7; }
  .fc .fc-list-day-cushion { background: var(--surface-raised); }
  .fc-theme-standard td, .fc-theme-standard th, .fc-theme-standard .fc-scrollgrid { border-color: var(--border); }
  .fc .fc-timegrid-slot-label, .fc .fc-timegrid-axis-cushion { color: var(--text-muted); font-size: var(--app-xs); }
  @media (max-width: 720px) {
    .fc .fc-toolbar { flex-wrap: wrap; gap: var(--space-2); }
    .fc .fc-toolbar-title { font-size: var(--app-md); }
    .fc .fc-toolbar-chunk:nth-child(2) { order: 3; width: 100%; text-align: center; }
  }

  /* The calendar list beside the grid: ticks with the calendar's colour. */
  .cal-side { gap: var(--space-2); }
  .cal-side .sidenav__group:first-child { margin-top: 0; }
  .cal-item { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); color: var(--text-secondary); font-size: var(--app-base); }
  .cal-item:hover { background: var(--surface-hover); color: var(--text-primary); }
  .cal-item .check { flex: 1 1 auto; min-width: 0; }
  .cal-item .cal-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cal-item .check input { accent-color: var(--cal-color, var(--info)); }

  /* 0.2.0: the peek popover on an event, the undo toast, quick add, the
     highlighted event a deep link opens on, and print. */
  .peek { position: absolute; z-index: 50; min-width: 16rem; max-width: 24rem; background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-md); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); padding: var(--space-3); }
  .peek h3 { margin: 0 0 var(--space-1); font-size: var(--app-md); }
  .peek p { margin: 0; color: var(--text-secondary); font-size: var(--app-sm); }
  .peek .form-actions { margin-top: var(--space-2); gap: var(--space-2); flex-wrap: wrap; }
  .undo-toast { position: fixed; left: 50%; bottom: 1.5rem; transform: translateX(-50%); z-index: 60; background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); display: flex; gap: var(--space-3); align-items: center; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
  .quick-add { padding: 0 var(--space-3); }
  .quick-add input { width: 100%; }
  .fc .fc-event.is-linked { box-shadow: 0 0 0 3px var(--silver-bright); }
  .search-results li { display: flex; gap: var(--space-2); align-items: center; }
  /* 0.4.0 (#87): the search form in the dialog; the related list's reasons. */
  .search-form { display: flex; gap: var(--space-2); align-items: center; }
  .search-form .form-input { flex: 1 1 auto; min-width: 0; }
  .search-results .why { color: var(--text-muted); font-size: var(--app-sm); }
  /* 0.4.0 (#88): the zone code after the view switcher is a FullCalendar
     custom button; it reads as a pill and opens the zone dialog. */
  .fc .fc-zone-button { font-family: inherit; letter-spacing: 0.04em; text-transform: none; }
  .fc .fc-zone-button.is-fixed { border-style: dashed; }
  /* 0.4.0 (#89): a pinned event shows its own zone's clock. */
  .ev-pin { display: inline-block; margin-right: 0.2em; font-size: 0.9em; line-height: 1; }
  .fc .fc-daygrid-event .ev-pin { margin-right: 0.3em; }
  /* A month cell's one-day chip clips at its own edge instead of running
     into the next day (a long time label did, live on a phone, 0.4.1). The
     multi-day bars are block events, not dot events, so they still span. */
  .fc .fc-daygrid-dot-event { overflow: hidden; }
  /* Settings, the Devices panel (#84): the name box and its button wrap on a
     phone instead of running out of the panel, and the table stays inside. */
  .devices-new { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .devices-new .form-input { flex: 1 1 12rem; min-width: 0; }
  #s-devices { width: 100%; }
  #s-devices th, #s-devices td { padding: var(--space-2); vertical-align: top; }
  #s-devices td { overflow-wrap: anywhere; }
  #s-device-secret { overflow-wrap: anywhere; display: inline-block; }
  .fc .fc-daygrid-dot-event .fc-event-time { flex-shrink: 0; }   /* the time is the point of a phone's month cell: it never shrinks; the title takes the cut (0.4.2) */
  @media print {
    .sidenav, .toolbar, .modal, .undo-toast, .peek, header, nav, .fc .fc-toolbar .fc-button-group, .fc .fc-today-button, .fc .fc-prev-button, .fc .fc-next-button { display: none !important; }
    .app__main { padding: 0; }
    body { background: #fff; color: #000; }
    .fc { font-size: 10pt; color: #000; }
    .fc .fc-event { color: #000 !important; background: #fff !important; border: 1px solid #000 !important; }
    .fc-theme-standard td, .fc-theme-standard th { border-color: #999; }
  }
  .cal-item .cal-more { flex: none; opacity: 0; width: 1.75rem; height: 1.75rem; }
  .cal-item:hover .cal-more, .cal-item:focus-within .cal-more { opacity: 1; }
  @media (pointer: coarse) { .cal-item .cal-more { opacity: 1; } }
  .swatch { display: inline-block; width: 0.75rem; height: 0.75rem; border-radius: var(--radius-sm); flex: none; }
  /* 0.3.2: phones and narrow windows (the shared theme's own 860px
     breakpoint). The theme turns every sidebar into one sideways-scrolling
     strip with its headings hidden, which suits myaccount's short tab list
     and made an unreadable row of this tool panel (a button, two text
     boxes, the tick list, settings; Gardner, 2026-11-16). Here the sidebar
     is a drawer instead, drive's folder-drawer shape: it keeps its column
     and headings, slides in over the grid, dims it, and closes on a tap
     outside, the x, or Escape. The action row above the grid carries what
     you reach for while looking at the grid. Both are display:none on a
     wide screen, so nothing is invisible-but-clickable there. */
  .cal-actions, .cal-side__head, .cal-side-backdrop { display: none; }
  body.cal-side-open { overflow: hidden; }
  @media (max-width: 860px) {
    .cal-actions { display: flex; margin-bottom: var(--space-2); }
    .cal-actions .btn { min-height: 44px; }
    .cal-actions #btn-suggestions-m { margin-left: auto; }   /* right-aligned on its own line */
    .cal-side {
      position: fixed; top: 0; left: 0; bottom: 0; width: 84vw; max-width: 320px; z-index: var(--z-overlay);
      flex-direction: column; gap: var(--space-2); overflow-y: auto; overflow-x: hidden;
      background: var(--surface); border-right: 1px solid var(--border-strong); border-bottom: 0;
      padding: var(--space-3) var(--space-2) var(--space-8);
      transform: translateX(-100%); transition: transform 0.2s ease;
    }
    .cal-side.open { transform: translateX(0); box-shadow: 2px 0 16px rgba(0, 0, 0, 0.6); }
    .cal-side .sidenav__group { display: block; }
    .cal-side .cal-side__twin { display: none; }
    .cal-side__head { display: flex; align-items: center; justify-content: space-between; padding: 0 var(--space-1) 0 var(--space-3); }
    .cal-side__title { font-size: var(--app-md); font-weight: var(--weight-semibold); }
    .cal-side__head .btn { min-width: 44px; min-height: 44px; font-size: 1.4rem; }
    .cal-side-backdrop.open { display: block; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: calc(var(--z-overlay) - 1); }
    .cal-side .btn, .cal-side .form-input { min-height: 44px; }
    .cal-item { min-height: 44px; padding: var(--space-2) var(--space-3); }
  }

  /* The editor. The modal is a flex column so a long form scrolls INSIDE
     .modal__body and the foot with Save stays on screen. The editor wraps
     head/body/foot in a <form>, so the form must be the flex column too --
     without this the form grew past the window and Save was below it
     (found by Gardner on 2026-11-14, calendar 0.1.5).
     The cap is in dvh: the height of the part of the window the phone's
     browser is NOT covering with its own bars. 100vh on Android and iOS is
     the height with every bar hidden, so a 100vh-tall dialog centred on the
     screen stuck out under Brave's bottom bars and Delete / Save / Cancel
     could not be reached (found by Gardner on 2026-11-16, calendar 0.4.3).
     The 100vh line before each dvh line is for browsers older than 2022. */
  .modal { width: min(640px, calc(100vw - var(--space-4))); max-height: calc(100vh - var(--space-8)); max-height: calc(100dvh - var(--space-8)); display: none; flex-direction: column; }
  .modal.open { display: flex; }
  .modal > form { display: flex; flex-direction: column; min-height: 0; max-height: calc(100vh - var(--space-8)); max-height: calc(100dvh - var(--space-8)); }
  .modal__head, .modal__foot { flex: 0 0 auto; }
  .modal__body { flex: 1 1 auto; min-height: 0; overflow: auto; }
  @media (max-width: 720px) {
    .modal { max-height: calc(100vh - var(--space-4)); max-height: calc(100dvh - var(--space-4)); }
    .modal > form { max-height: calc(100vh - var(--space-4)); max-height: calc(100dvh - var(--space-4)); }
    .modal__body { padding: var(--space-4); }
  }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .form-grid .span2 { grid-column: 1 / -1; }
  @media (max-width: 560px) { .form-grid { grid-template-columns: 1fr; } .form-grid .span2 { grid-column: auto; } }
  .time-row { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .time-row .form-input { width: auto; min-width: 0; flex: 1 1 8rem; }
  .chips { display: flex; gap: var(--space-1); flex-wrap: wrap; }
  .chip { border: 1px solid var(--border-strong); border-radius: var(--radius-pill); padding: 2px var(--space-3); font-size: var(--app-sm); cursor: pointer; background: none; color: var(--text-secondary); }
  .chip.is-on { background: var(--silver-bright); color: var(--black-primary); border-color: var(--silver-bright); }
  /* Invitations (#85): one chip per person asked, its answer as a colour. */
  .att-list:empty { display: none; }
  .att { display: inline-flex; align-items: center; gap: var(--space-1); border: 1px solid var(--border-strong); border-radius: var(--radius-pill); padding: 2px var(--space-2) 2px var(--space-3); font-size: var(--app-sm); color: var(--text-secondary); max-width: 100%; }
  .att__who { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 18rem; }
  .att__state { font-size: var(--app-xs); color: var(--text-muted); white-space: nowrap; }
  .att.is-accepted .att__state { color: #5c9e7c; }
  .att.is-declined .att__state { color: #d85c5c; }
  .att.is-tentative .att__state { color: #d9a441; }
  .att.is-busy { border-color: #d85c5c; }
  .att__x { border: 0; background: none; color: var(--text-muted); cursor: pointer; padding: 0 2px; font-size: var(--app-md); line-height: 1; }
  .att__x:hover { color: var(--text-primary); }
  .share-list { list-style: none; margin: 0; padding: 0; }
  .share-list li { display: flex; gap: var(--space-2); align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .share-list li:last-child { border-bottom: 0; }
  .share-who { flex: 1 1 10rem; min-width: 0; overflow-wrap: anywhere; }
  .share-url { font-family: var(--font-mono); font-size: var(--app-xs); color: var(--text-muted); overflow-wrap: anywhere; flex: 1 1 100%; }
  .modal__foot { flex-wrap: wrap; }
  .modal__foot .spacer { flex: 1 1 auto; }
  .toast { max-width: calc(100vw - 2 * var(--space-6)); overflow-wrap: anywhere; }
  .color-dots { display: flex; gap: var(--space-1); flex-wrap: wrap; align-items: center; }
  .color-dot { width: 1.5rem; height: 1.5rem; border-radius: var(--radius-pill); border: 2px solid transparent; cursor: pointer; padding: 0; }
  .color-dot.is-on { border-color: var(--silver-bright); }
  .muted-small { color: var(--text-muted); font-size: var(--app-sm); }
  .event-when { font-size: var(--app-md); }
</style>
</head>
<body class="app">
%= include 'homelab/header'
<%= content %>
%= include 'homelab/footer'
</body>
</html>
