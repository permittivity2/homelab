% layout 'default';
% title 'Settings - Calendar';
%# The app's settings page (#77): time zone and display, the mail-link switch
%# (#74 phase 3) and the AI proposal switch with its notice (phase 4). Every
%# change posts JSON with the page's CSRF token; the script is at the bottom.
<main class="app__main">
  <div class="container stack" style="max-width: 44rem">
    <h1 style="font-size: var(--app-xl)">Settings</h1>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Time zone &amp; display</h2></div>
      <div class="panel__body stack">
        <div class="form-row">
          <label class="form-label" for="s-zone">Time zone</label>
          <select class="form-select" id="s-zone">
            % for my $z (@$zones) {
            <option value="<%= $z %>"<%= $z eq $zone ? ' selected' : '' %>><%= $z =~ s/_/ /gr %></option>
            % }
          </select>
          % if ($account_zone) {
          <p class="form-hint">Your account's time zone is set in My Account; this only changes how this calendar shows times.</p>
          % } else {
          <p class="form-hint">Events are shown and entered in this zone.</p>
          % }
        </div>
        <div class="form-grid">
          <div><label class="form-label" for="s-week">Week starts on</label>
            <select class="form-select" id="s-week"><option value="0"<%= $prefs->{week_start} == 0 ? ' selected' : '' %>>Sunday</option><option value="1"<%= $prefs->{week_start} == 1 ? ' selected' : '' %>>Monday</option><option value="6"<%= $prefs->{week_start} == 6 ? ' selected' : '' %>>Saturday</option></select></div>
          <div><label class="form-label" for="s-time">Time format</label>
            <select class="form-select" id="s-time"><option value="12h"<%= $prefs->{time_format} eq '12h' ? ' selected' : '' %>>12-hour</option><option value="24h"<%= $prefs->{time_format} eq '24h' ? ' selected' : '' %>>24-hour</option></select></div>
          <div><label class="form-label" for="s-view">Opens in</label>
            <select class="form-select" id="s-view">
              % for my $v (qw(month week day agenda)) {
              <option value="<%= $v %>"<%= $prefs->{default_view} eq $v ? ' selected' : '' %>><%= ucfirst $v %></option>
              % }
            </select></div>
        </div>
        <div class="form-actions"><button type="button" class="btn btn-primary" id="s-save-display">Save</button></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Calendar links in your email</h2></div>
      <div class="panel__body stack">
        <label class="check"><input type="checkbox" id="s-maillinks"<%= $account->{mail_links_enabled} ? ' checked' : '' %>> <span>Add an "Add to calendar" link to every email I receive</span></label>
        <p class="text-muted">With this on, each inbound message to any of your addresses gets a link at the bottom that opens this calendar with an event pre-filled from the message. To make that work, the mail server keeps the message's subject, sender, date and the first part of its text for 30 days, for your account only. Nothing is sent anywhere else, and nothing is created until you press Save on the event.</p>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">AI proposals</h2></div>
      <div class="panel__body stack">
        % if (!$ai_available) {
        <p class="text-muted">Not available on this calendar.</p>
        % } else {
        <label class="check"><input type="checkbox" id="s-ai"<%= $consent->{enabled} ? ' checked' : '' %>> <span>Offer a "Propose with AI" button on events made from an email</span></label>
        % if ($consent->{sha} && !$consent->{current}) {
        <p class="banner banner--warn"><span>The notice below has changed since you agreed to it. Read it and turn the switch on again to continue.</span></p>
        % }
        <pre class="panel" style="white-space: pre-wrap; padding: var(--space-4); font-family: var(--font-primary); font-size: var(--app-sm); color: var(--text-secondary)"><%= $notice %></pre>
        % if ($account->{ai_consent_at} && $consent->{current}) {
        <p class="muted-small">You agreed to this notice on <%= substr($account->{ai_consent_at}, 0, 16) %>.</p>
        % }
        % }
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Find out more</h2></div>
      <div class="panel__body stack">
        % if (!$ai_available) {
        <p class="text-muted">Not available on this calendar.</p>
        % } else {
        <p class="text-muted">When a proposal names something a web search could add facts about (a venue, a team, a public event), a line offers to look it up. The facts come back with their sources for you to pick; nothing is written into the event until you choose.</p>
        <label class="check"><input type="checkbox" id="s-research"<%= $research->{enabled} ? ' checked' : '' %>> <span>Allow "Find out more" (web searches about the event)</span></label>
        <label class="check"><input type="checkbox" id="s-research-auto"<%= $research->{auto} ? ' checked' : '' %><%= $research->{enabled} ? '' : ' disabled' %>> <span>Research every proposal without asking</span></label>
        % if ($research->{sha} && !$research->{current}) {
        <p class="banner banner--warn"><span>The notice below has changed since you agreed to it. Read it and turn the switch on again to continue.</span></p>
        % }
        <pre class="panel" style="white-space: pre-wrap; padding: var(--space-4); font-family: var(--font-primary); font-size: var(--app-sm); color: var(--text-secondary)"><%= $research_notice %></pre>
        % if ($account->{research_consent_at} && $research->{current}) {
        <p class="muted-small">You agreed to this notice on <%= substr($account->{research_consent_at}, 0, 16) %>.</p>
        % }
        % }
      </div>
    </section>

    <p class="form-error hide" id="s-error"></p>
    <div class="form-actions"><a class="btn" href="/">Back to the calendar</a></div>
  </div>
</main>
<script>
(function () {
  var csrf = '<%= $csrf %>', noticeSha = '<%= $notice_sha %>', researchSha = '<%= $research_notice_sha %>';
  function $(id) { return document.getElementById(id); }
  function say(msg, kind) { if (window.HomelabShell) window.HomelabShell.toast(msg, kind); var e = $('s-error'); e.textContent = kind === 'error' ? msg : ''; e.classList.toggle('hide', kind !== 'error'); }
  function put(url, body) {
    return fetch(url, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || ('Request failed (' + r.status + ')')); return j; }); });
  }
  $('s-save-display').addEventListener('click', function () {
    put('/api/prefs', { timezone: $('s-zone').value, week_start: +$('s-week').value, time_format: $('s-time').value, default_view: $('s-view').value })
      .then(function () { say('Saved.', 'ok'); }).catch(function (e) { say(e.message, 'error'); });
  });
  $('s-maillinks').addEventListener('change', function () {
    var box = this;
    put('/api/account', { mail_links_enabled: box.checked }).then(function () { say(box.checked ? 'Links will be added to new email from now on.' : 'Links are off.', 'ok'); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  var rs = $('s-research'), ra = $('s-research-auto');
  if (rs) rs.addEventListener('change', function () {
    var box = this;
    put('/api/account', box.checked ? { research_enabled: true, research_consent_sha256: researchSha } : { research_enabled: false })
      .then(function () { say(box.checked ? '"Find out more" is on.' : '"Find out more" is off.', 'ok'); if (ra) { ra.disabled = !box.checked; if (!box.checked) ra.checked = false; } if (box.checked) setTimeout(function () { location.reload(); }, 600); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  if (ra) ra.addEventListener('change', function () {
    var box = this;
    put('/api/account', { research_auto: box.checked }).then(function () { say(box.checked ? 'Every proposal will be researched.' : 'Research only when you ask.', 'ok'); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  var ai = $('s-ai');
  if (ai) ai.addEventListener('change', function () {
    var box = this;
    put('/api/account', box.checked ? { ai_enabled: true, ai_consent_sha256: noticeSha } : { ai_enabled: false })
      .then(function () { say(box.checked ? 'AI proposals are on.' : 'AI proposals are off.', 'ok'); if (box.checked) setTimeout(function () { location.reload(); }, 600); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
})();
</script>
