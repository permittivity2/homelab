% layout 'default';
% title 'Settings - Calendar';
%# The app's settings page (#77): time zone and display, the mail-link switch
%# (#74 phase 3) and the AI proposal switch with its notice (phase 4). Every
%# change posts JSON with the page's CSRF token; the script is at the bottom.
<main class="app__main">
  <div class="container stack" style="max-width: 44rem">
    <h1 style="font-size: var(--app-xl)">Settings</h1>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Time zone &amp; display</h2></div>
      <div class="panel__body stack">
        <div class="form-row">
          <label class="form-label" for="s-zone">Time zone</label>
          %# 0.4.0 (#88): Local is the default. The page follows the device it is
          %# looking from; a fixed zone stays put wherever the person goes.
          % my $fixed = $prefs->{timezone};
          <select class="form-select" id="s-zone">
            <option value=""<%= $fixed ? '' : ' selected' %>>Local: this device's time zone<%= $zone && !$fixed ? " (now " . ($zone =~ s/_/ /gr) . ")" : '' %></option>
            % for my $z (@$zones) {
            <option value="<%= $z %>"<%= ($fixed // '') eq $z ? ' selected' : '' %>><%= $z =~ s/_/ /gr %></option>
            % }
          </select>
          <p class="form-hint">Local follows the device you are looking from, as its clock reports it: a phone that crosses into another zone shows its events in that zone after a refresh. Pick a zone to keep the calendar in it wherever you are. An event can also be pinned to its own zone in the editor.</p>
          % if ($account_zone) {
          <p class="form-hint">The zone in My Account is used only for mail sent before any device of yours has been seen.</p>
          % }
        </div>
        <div class="form-grid">
          <div><label class="form-label" for="s-week">Week starts on</label>
            <select class="form-select" id="s-week"><option value="0"<%= $prefs->{week_start} == 0 ? ' selected' : '' %>>Sunday</option><option value="1"<%= $prefs->{week_start} == 1 ? ' selected' : '' %>>Monday</option><option value="6"<%= $prefs->{week_start} == 6 ? ' selected' : '' %>>Saturday</option></select></div>
          <div><label class="form-label" for="s-time">Time format</label>
            <select class="form-select" id="s-time"><option value="12h"<%= $prefs->{time_format} eq '12h' ? ' selected' : '' %>>12-hour</option><option value="24h"<%= $prefs->{time_format} eq '24h' ? ' selected' : '' %>>24-hour</option></select></div>
          <div><label class="form-label" for="s-view">Opens in</label>
            <select class="form-select" id="s-view">
              % for my $v (qw(month week day agenda)) {
              <option value="<%= $v %>"<%= $prefs->{default_view} eq $v ? ' selected' : '' %>><%= ucfirst $v %></option>
              % }
            </select></div>
        </div>
        <div class="form-actions"><button type="button" class="btn btn-primary" id="s-save-display">Save</button></div>
        <p class="muted-small">Keyboard on the calendar page: n new event, t today, arrows move, d/w/m/a views, / search, Esc close.</p>
      </div>
    </section>

    %# 0.2.0: the defaults that used to be fixed.
    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Defaults for new events</h2></div>
      <div class="panel__body stack">
        <div class="form-grid">
          <div><label class="form-label" for="s-def-reminder">Reminder</label>
            <select class="form-select" id="s-def-reminder">
              % for my $o ([0, 'At the time'], [5, '5 minutes before'], [10, '10 minutes before'], [15, '15 minutes before'], [30, '30 minutes before'], [60, '1 hour before'], [120, '2 hours before'], [1440, '1 day before']) {
              <option value="<%= $o->[0] %>"<%= $prefs->{default_reminder_minutes} == $o->[0] ? ' selected' : '' %>><%= $o->[1] %></option>
              % }
            </select></div>
          <div><label class="form-label" for="s-def-hour">All-day events remind at</label>
            <select class="form-select" id="s-def-hour">
              % for my $h (0 .. 23) {
              <option value="<%= $h %>"<%= $prefs->{all_day_reminder_hour} == $h ? ' selected' : '' %>><%= ($h % 12 || 12) . ($h < 12 ? ' AM' : ' PM') %></option>
              % }
            </select></div>
          <div><label class="form-label" for="s-def-duration">Length</label>
            <select class="form-select" id="s-def-duration">
              % for my $o ([15, '15 minutes'], [30, '30 minutes'], [45, '45 minutes'], [60, '1 hour'], [90, '1.5 hours'], [120, '2 hours'], [180, '3 hours'], [240, '4 hours']) {
              <option value="<%= $o->[0] %>"<%= $prefs->{default_duration_minutes} == $o->[0] ? ' selected' : '' %>><%= $o->[1] %></option>
              % }
            </select></div>
          <div><label class="form-label" for="s-def-date">Dates written as</label>
            <select class="form-select" id="s-def-date">
              % for my $o ([mdy => 'Fri, Nov 14, 2026'], [dmy => 'Fri, 14 Nov 2026'], [ymd => 'Fri, 2026-11-14']) {
              <option value="<%= $o->[0] %>"<%= $prefs->{date_format} eq $o->[0] ? ' selected' : '' %>><%= $o->[1] %></option>
              % }
            </select></div>
        </div>
        <div class="form-actions"><button type="button" class="btn btn-primary" id="s-save-defaults">Save</button></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Calendar links in your email</h2></div>
      <div class="panel__body stack">
        <label class="check"><input type="checkbox" id="s-maillinks"<%= $account->{mail_links_enabled} ? ' checked' : '' %>> <span>Add an "Add to calendar" link to every email I receive</span></label>
        <p class="text-muted">With this on, each inbound message to any of your addresses gets a link at the bottom that opens this calendar with an event pre-filled from the message. To make that work, the mail server keeps the message's subject, sender, date and the first part of its text for 30 days, for your account only. Nothing is sent anywhere else, and nothing is created until you press Save on the event.</p>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">AI proposals</h2></div>
      <div class="panel__body stack">
        % if (!$ai_available) {
        <p class="text-muted">Not available on this calendar.</p>
        % } else {
        <label class="check"><input type="checkbox" id="s-ai"<%= $consent->{enabled} ? ' checked' : '' %>> <span>Offer a "Propose with AI" button on events made from an email</span></label>
        % if ($consent->{sha} && !$consent->{current}) {
        <p class="banner banner--warn"><span>The notice below has changed since you agreed to it. Read it and turn the switch on again to continue.</span></p>
        % }
        <pre class="panel" style="white-space: pre-wrap; padding: var(--space-4); font-family: var(--font-primary); font-size: var(--app-sm); color: var(--text-secondary)"><%= $notice %></pre>
        % if ($account->{ai_consent_at} && $consent->{current}) {
        <p class="muted-small">You agreed to this notice on <%= substr($account->{ai_consent_at}, 0, 16) %>.</p>
        % }
        % }
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Find out more</h2></div>
      <div class="panel__body stack">
        % if (!$ai_available) {
        <p class="text-muted">Not available on this calendar.</p>
        % } else {
        <p class="text-muted">When a proposal names something a web search could add facts about (a venue, a team, a public event), a line offers to look it up. The facts come back with their sources for you to pick; nothing is written into the event until you choose.</p>
        <label class="check"><input type="checkbox" id="s-research"<%= $research->{enabled} ? ' checked' : '' %>> <span>Allow "Find out more" (web searches about the event)</span></label>
        <label class="check"><input type="checkbox" id="s-research-auto"<%= $research->{auto} ? ' checked' : '' %><%= $research->{enabled} ? '' : ' disabled' %>> <span>Research every proposal without asking</span></label>
        % if ($research->{sha} && !$research->{current}) {
        <p class="banner banner--warn"><span>The notice below has changed since you agreed to it. Read it and turn the switch on again to continue.</span></p>
        % }
        <pre class="panel" style="white-space: pre-wrap; padding: var(--space-4); font-family: var(--font-primary); font-size: var(--app-sm); color: var(--text-secondary)"><%= $research_notice %></pre>
        % if ($account->{research_consent_at} && $research->{current}) {
        <p class="muted-small">You agreed to this notice on <%= substr($account->{research_consent_at}, 0, 16) %>.</p>
        % }
        % }
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Propose automatically</h2></div>
      <div class="panel__body stack">
        % if (!$ai_available) {
        <p class="text-muted">Not available on this calendar.</p>
        % } else {
        <p class="text-muted">Instead of waiting for "Propose with AI" when you open a link, have the proposal ready as the email arrives: it waits in the calendar's Suggestions and behind the email's link. Needs the email links above to be on.</p>
        <label class="check"><input type="checkbox" id="s-auto"<%= $auto->{enabled} ? ' checked' : '' %><%= $account->{mail_links_enabled} ? '' : ' disabled' %>> <span>Propose an event from each email that looks like it has one, as it arrives</span></label>
        % if (!$account->{mail_links_enabled}) {
        <p class="form-hint">Turn on "Calendar links in your email" first.</p>
        % }
        % if ($auto->{sha} && !$auto->{current}) {
        <p class="banner banner--warn"><span>The notice below has changed since you agreed to it. Read it and turn the switch on again to continue.</span></p>
        % }
        <pre class="panel" style="white-space: pre-wrap; padding: var(--space-4); font-family: var(--font-primary); font-size: var(--app-sm); color: var(--text-secondary)"><%= $auto_notice %></pre>
        % if ($account->{auto_propose_consent_at} && $auto->{current}) {
        <p class="muted-small">You agreed to this notice on <%= substr($account->{auto_propose_consent_at}, 0, 16) %>.</p>
        % }
        <h3 class="panel__title" style="font-size: var(--app-md)">Research at arrival</h3>
        % if ($auto->{research_allowed}) {
        <p class="text-muted">Your account includes this: the "Find out more" web search runs on the same emails, so the facts are waiting too. Needs "Find out more" to be on above.</p>
        <label class="check"><input type="checkbox" id="s-research-arrival"<%= $auto->{research_at_arrival} ? ' checked' : '' %><%= ($auto->{enabled} && $research->{enabled}) ? '' : ' disabled' %>> <span>Also run "Find out more" as the email arrives</span></label>
        % } else {
        <p class="text-muted">Running "Find out more" on arriving email as well is part of a paid option that is still being put together. Your own clicks on "Find out more" are not affected.</p>
        % }
        % }
      </div>
    </section>

    <section class="panel">
      <div class="panel__head"><h2 class="panel__title">Reminders</h2></div>
      <div class="panel__body stack">
        <p class="text-muted">Reminders are sent by email, minutes before an event (set on each event, up to three; new events start with the default above). They go to your account address unless you list other addresses here, one per line (up to 5).</p>
        <textarea class="form-textarea" id="s-reminder-addresses" rows="3" placeholder="<%= $me %>"><%= join "\n", @$reminder_addresses %></textarea>
        <label class="check"><input type="checkbox" id="s-remind-shared"<%= $prefs->{remind_shared} ? ' checked' : '' %>> <span>Remind me about events other people share with me</span></label>
        <div class="form-row"><label class="form-label" for="s-webhook">Webhook (optional)</label>
          <input class="form-input" id="s-webhook" type="url" placeholder="https://ntfy.example.com/my-topic" maxlength="500" value="<%= $prefs->{webhook_url} // '' %>">
          <p class="form-hint">A reminder set to "Webhook" posts JSON here (title, start, end, place, a link) instead of mailing. Without a URL it is mailed after all.</p></div>
        <div class="form-actions"><button type="button" class="btn btn-primary" id="s-save-reminders">Save</button></div>
      </div>
    </section>

    <p class="form-error hide" id="s-error"></p>
    <div class="form-actions"><a class="btn" href="/">Back to the calendar</a></div>
  </div>
</main>
<script>
(function () {
  var csrf = '<%= $csrf %>', noticeSha = '<%= $notice_sha %>', researchSha = '<%= $research_notice_sha %>', autoSha = '<%= $auto_notice_sha %>';
  function $(id) { return document.getElementById(id); }
  function say(msg, kind) { if (window.HomelabShell) window.HomelabShell.toast(msg, kind); var e = $('s-error'); e.textContent = kind === 'error' ? msg : ''; e.classList.toggle('hide', kind !== 'error'); }
  function put(url, body) {
    return fetch(url, { method: 'PUT', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || ('Request failed (' + r.status + ')')); return j; }); });
  }
  $('s-save-display').addEventListener('click', function () {
    put('/api/prefs', { timezone: $('s-zone').value, week_start: +$('s-week').value, time_format: $('s-time').value, default_view: $('s-view').value })
      .then(function () { say('Saved.', 'ok'); }).catch(function (e) { say(e.message, 'error'); });
  });
  $('s-maillinks').addEventListener('change', function () {
    var box = this;
    put('/api/account', { mail_links_enabled: box.checked }).then(function () { say(box.checked ? 'Links will be added to new email from now on.' : 'Links are off.', 'ok'); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  var rs = $('s-research'), ra = $('s-research-auto');
  if (rs) rs.addEventListener('change', function () {
    var box = this;
    put('/api/account', box.checked ? { research_enabled: true, research_consent_sha256: researchSha } : { research_enabled: false })
      .then(function () { say(box.checked ? '"Find out more" is on.' : '"Find out more" is off.', 'ok'); if (ra) { ra.disabled = !box.checked; if (!box.checked) ra.checked = false; } if (box.checked) setTimeout(function () { location.reload(); }, 600); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  if (ra) ra.addEventListener('change', function () {
    var box = this;
    put('/api/account', { research_auto: box.checked }).then(function () { say(box.checked ? 'Every proposal will be researched.' : 'Research only when you ask.', 'ok'); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  var ai = $('s-ai');
  if (ai) ai.addEventListener('change', function () {
    var box = this;
    put('/api/account', box.checked ? { ai_enabled: true, ai_consent_sha256: noticeSha } : { ai_enabled: false })
      .then(function () { say(box.checked ? 'AI proposals are on.' : 'AI proposals are off.', 'ok'); if (box.checked) setTimeout(function () { location.reload(); }, 600); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  // #80: consent #3 and the research-at-arrival switch under it.
  var au = $('s-auto'), rr = $('s-research-arrival');
  if (au) au.addEventListener('change', function () {
    var box = this;
    put('/api/account', box.checked ? { auto_propose: true, auto_propose_consent_sha256: autoSha } : { auto_propose: false })
      .then(function () { say(box.checked ? 'Proposals will be ready as email arrives.' : 'Automatic proposals are off.', 'ok'); setTimeout(function () { location.reload(); }, 600); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  if (rr) rr.addEventListener('change', function () {
    var box = this;
    put('/api/account', { research_at_arrival: box.checked }).then(function () { say(box.checked ? 'Research runs as email arrives.' : 'Research only when you ask.', 'ok'); })
      .catch(function (e) { box.checked = !box.checked; say(e.message, 'error'); });
  });
  // #79: where reminders go; 0.2.0: the shared-events switch and the webhook.
  $('s-save-reminders').addEventListener('click', function () {
    var list = $('s-reminder-addresses').value.split(/[\n,;]+/).map(function (s) { return s.trim(); }).filter(Boolean);
    put('/api/account', { reminder_addresses: list })
      .then(function (a) { $('s-reminder-addresses').value = (a.reminder_addresses || []).join('\n'); return put('/api/prefs', { remind_shared: $('s-remind-shared').checked, webhook_url: $('s-webhook').value.trim() }); })
      .then(function () { say(list.length ? 'Saved. Reminders go to ' + list.length + ' address' + (list.length === 1 ? '' : 'es') + '.' : 'Saved. Reminders go to your account address.', 'ok'); })
      .catch(function (e) { say(e.message, 'error'); });
  });
  // 0.2.0: the defaults for new events.
  $('s-save-defaults').addEventListener('click', function () {
    put('/api/prefs', { default_reminder_minutes: +$('s-def-reminder').value, all_day_reminder_hour: +$('s-def-hour').value, default_duration_minutes: +$('s-def-duration').value, date_format: $('s-def-date').value })
      .then(function () { say('Saved.', 'ok'); }).catch(function (e) { say(e.message, 'error'); });
  });
})();
</script>
