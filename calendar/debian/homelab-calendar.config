#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/calendar/config.yml ]; then
    exit 0
fi

db_input high homelab-calendar/db_host || true
db_input high homelab-calendar/pgbouncer_host || true
db_input high homelab-calendar/api_base || true
db_input high homelab-calendar/listen_port || true
db_input high homelab-calendar/advertise_host || true
db_input high homelab-calendar/public_base_url || true
db_input medium homelab-calendar/default_timezone || true
db_input high homelab-calendar/sso_base_url || true
db_input medium homelab-calendar/sso_internal_base_url || true
db_input high homelab-calendar/sso_client_secret || true
db_input medium homelab-calendar/session_secret || true
db_go

exit 0
