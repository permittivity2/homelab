#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_install:
	dh_install
	install -D -m 644 config/calendar.example.yml \
		debian/homelab-calendar/usr/share/homelab-calendar/config/calendar.example.yml
	install -D -m 644 services/calendar.yml \
		debian/homelab-calendar/usr/share/homelab-calendar/services/calendar.yml
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-calendar/usr/share/homelab-calendar/{} \;
	find templates -type f -exec install -D -m 644 {} \
		debian/homelab-calendar/usr/share/homelab-calendar/{} \;
	find public -type f -exec install -D -m 644 {} \
		debian/homelab-calendar/usr/share/homelab-calendar/{} \;
