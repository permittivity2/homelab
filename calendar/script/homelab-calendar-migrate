#!/usr/bin/env perl
# Applies homelab-calendar's own migrations/*.sql via the migrate role. Same
# template as homelab-block-link-migrate.
use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Homelab::Common::Config qw(load_config);
use Homelab::Common::DB qw(migrate_dbh);
use Homelab::Common::Migrate qw(run_migrations);

my $config = load_config('HOMELAB_CALENDAR_CONFIG', '/etc/homelab/calendar/config.yml');
my $dbh    = migrate_dbh(%{ $config->{database_migrate} });

my $migrations_dir = $ENV{HOMELAB_CALENDAR_MIGRATIONS_DIR} // '/usr/share/homelab-calendar/migrations';
my $applied = run_migrations(dbh => $dbh, schema => 'calendar', migrations_dir => $migrations_dir);

print "homelab-calendar: applied $applied migration(s)\n";
