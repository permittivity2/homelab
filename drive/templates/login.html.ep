<!DOCTYPE html>
<html lang="en">
<head>
%# Shared theme, but NOT the shared layout: there is no signed-in user here,
%# so the top bar would render an empty account cluster. The logo carries the
%# identity instead.
%= include 'homelab/head'
<title>Homelab Drive — Log in</title>
<style>
  body {
    margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
    padding: var(--space-4); background: var(--black-primary);
  }
  .card {
    width: 100%; max-width: 360px; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-md); box-shadow: var(--shadow-lg);
    padding: var(--space-8) var(--space-6); text-align: center;
  }
  .card img { height: 32px; width: auto; margin-bottom: var(--space-6); }
  h1 { font-size: var(--app-lg); font-weight: var(--weight-light); letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-6); }
  .error-banner {
    background: rgba(216,92,92,0.10); border: 1px solid rgba(216,92,92,0.35); color: var(--error);
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); margin-bottom: var(--space-4);
    font-size: var(--app-sm); text-align: left;
  }
  .foot { margin-top: var(--space-6); font-size: var(--app-xs); color: var(--text-muted); }
  .foot a { color: var(--silver-dim); }
</style>
</head>
<body>
<div class="card">
  <img src="<%= theme_base %>/logo.svg" alt="Silver Linings">
  <h1>Drive</h1>
% if ($error) {
  <div class="error-banner"><%= $error %></div>
% }
  <a class="btn btn-primary" href="/login">Log in with Homelab SSO</a>
  <div class="foot">A product of <a href="https://silverlinings.llc/">Silver Linings,&nbsp;LLC</a>.</div>
</div>
</body>
</html>
