<!DOCTYPE html>
<html>
<head><title>Homelab Drive</title></head>
<body>
<h1>Homelab Drive</h1>
<p>
  Logged in as <%= $email %> —
  <form method="post" action="/logout" style="display:inline"><button type="submit">Log out</button></form>
</p>

<form method="post" action="/upload" enctype="multipart/form-data">
  <input type="file" name="file" required>
  <button type="submit">Upload</button>
</form>

<table border="1" cellpadding="4">
  <tr><th>Name</th><th>Size</th><th>Type</th><th>Uploaded</th><th></th></tr>
% for my $f (@$files) {
  <tr>
    <td><a href="/files/<%= $f->{id} %>/download"><%= $f->{filename} %></a></td>
    <td><%= $f->{size_bytes} %> bytes</td>
    <td><%= $f->{mime_type} %></td>
    <td><%= $f->{uploaded_at} %></td>
    <td>
      <form method="post" action="/files/<%= $f->{id} %>/delete" style="display:inline"
            onsubmit="return confirm('Delete <%= $f->{filename} %>?')">
        <button type="submit">Delete</button>
      </form>
    </td>
  </tr>
% }
</table>
</body>
</html>
