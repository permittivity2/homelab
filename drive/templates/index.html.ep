<!DOCTYPE html>
<html lang="en">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homelab Drive</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0; color: #1a1a1a; background: #f5f6f8;
  }
  header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.75rem 1.25rem; background: #20232a; color: #fff;
  }
  header h1 { font-size: 1.1rem; margin: 0; font-weight: 600; }
  header .who { font-size: 0.85rem; color: #c9ccd3; display: flex; align-items: center; gap: 0.75rem; }
  header button { background: none; border: 1px solid #4b4f58; color: #fff; border-radius: 4px; padding: 0.3rem 0.7rem; cursor: pointer; }
  header button:hover { background: #2f333c; }

  .size-toggle { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.78rem; color: #c9ccd3; cursor: pointer; user-select: none; }
  .size-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
  .size-toggle .switch { position: relative; width: 32px; height: 17px; background: #4b4f58; border-radius: 999px; flex-shrink: 0; transition: background-color 0.15s; }
  .size-toggle .switch::before {
    content: ''; position: absolute; top: 2px; left: 2px; width: 13px; height: 13px;
    background: #fff; border-radius: 50%; transition: transform 0.15s;
  }
  .size-toggle input:checked + .switch { background: #3562d4; }
  .size-toggle input:checked + .switch::before { transform: translateX(15px); }
  .size-toggle input:focus-visible + .switch { outline: 2px solid #7ba0f5; outline-offset: 2px; }

  nav.breadcrumb { padding: 0.6rem 1.25rem; font-size: 0.9rem; background: #fff; border-bottom: 1px solid #e3e5e9; }
  nav.breadcrumb a { color: #3562d4; text-decoration: none; }
  nav.breadcrumb a:hover { text-decoration: underline; }
  nav.breadcrumb .sep { color: #9aa0ab; margin: 0 0.35rem; }

  /* Folder drawer toggle + backdrop -- inert on desktop (see the
     max-width media query below for the actual mobile behavior), kept
     out of layout entirely rather than just visually hidden so there's
     no chance of an invisible-but-clickable element on wide screens. */
  .sidebar-toggle { display: none; }
  #sidebar-backdrop { display: none; }

  .layout { display: flex; align-items: flex-start; gap: 1.25rem; padding: 1.25rem; }
  aside {
    width: 240px; flex-shrink: 0; background: #fff; border: 1px solid #e3e5e9;
    border-radius: 8px; padding: 1rem;
  }
  aside h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: #6b7280; margin: 0 0 0.75rem; }
  .folder-list { list-style: none; margin: 0 0 1rem; padding: 0; }
  .folder-list li {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.4rem 0.5rem; border-radius: 5px; border: 1px dashed transparent;
  }
  .folder-list li:hover { background: #f0f2f5; }
  .folder-list li.drag-over { background: #e8f0fe; border-color: #3562d4; }
  .folder-list a { color: #1a1a1a; text-decoration: none; flex: 1; display: flex; align-items: center; gap: 0.4rem; }
  .folder-list a:hover { color: #3562d4; }
  .folder-list form { margin: 0; }
  .icon-btn { background: none; border: none; cursor: pointer; color: #9aa0ab; font-size: 0.85rem; padding: 0.15rem 0.3rem; }
  .icon-btn:hover { color: #d1453b; }
  .empty-hint { color: #9aa0ab; font-size: 0.85rem; padding: 0.2rem 0.5rem; }

  form.new-folder { display: flex; gap: 0.4rem; }
  form.new-folder input[type=text] {
    flex: 1; min-width: 0; padding: 0.4rem 0.5rem; border: 1px solid #d5d8dd; border-radius: 5px; font-size: 0.85rem;
  }
  form.new-folder button {
    padding: 0.4rem 0.6rem; border: none; border-radius: 5px; background: #3562d4; color: #fff;
    cursor: pointer; font-size: 0.85rem;
  }
  form.new-folder button:hover { background: #2a4fb0; }

  main {
    flex: 1; min-width: 0; position: relative; border-radius: 8px;
    border: 2px dashed transparent; transition: background-color 0.15s, border-color 0.15s;
  }
  main.drag-over { background: #e8f0fe; border-color: #3562d4; }
  .drop-hint {
    display: none; position: sticky; top: 0; z-index: 5; text-align: center;
    padding: 0.6rem; margin-bottom: 1rem; border-radius: 6px;
    background: #3562d4; color: #fff; font-size: 0.85rem; font-weight: 600;
  }
  main.drag-over .drop-hint { display: block; }
  .upload-progress {
    display: none; align-items: center; gap: 0.5rem; background: #fff; border: 1px solid #e3e5e9;
    border-radius: 8px; padding: 0.7rem 1rem; margin-bottom: 1.25rem; font-size: 0.85rem; color: #4b5160;
  }
  .upload-progress.active { display: flex; }
  .spinner {
    width: 14px; height: 14px; border: 2px solid #d5d8dd; border-top-color: #3562d4;
    border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .error-banner {
    background: #fdeceb; border: 1px solid #f3b7b2; color: #8a2c25;
    padding: 0.6rem 0.9rem; border-radius: 6px; margin-bottom: 1rem; font-size: 0.9rem;
  }

  .upload-bar {
    display: flex; align-items: center; gap: 0.6rem; background: #fff; border: 1px solid #e3e5e9;
    border-radius: 8px; padding: 0.8rem 1rem; margin-bottom: 1.25rem;
  }
  .upload-bar button {
    padding: 0.45rem 0.9rem; border: none; border-radius: 5px; background: #1f9d55; color: #fff;
    cursor: pointer; font-size: 0.9rem;
  }
  .upload-bar button:hover { background: #187c43; }
  .upload-bar button:disabled { background: #9aa0ab; cursor: default; }
  .upload-status { font-size: 0.85rem; color: #6b7280; }
  .drop-tip { font-size: 0.8rem; color: #9aa0ab; margin-left: auto; }

  table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e3e5e9; border-radius: 8px; overflow: hidden; }
  th, td { text-align: left; padding: 0.6rem 0.9rem; font-size: 0.9rem; border-bottom: 1px solid #eef0f3; }
  th { color: #6b7280; font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; background: #fafbfc; }
  th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
  th[data-sort]:hover { color: #3562d4; }
  th[data-sort]::after { content: ''; display: inline-block; width: 0.9em; }
  th.sort-asc::after { content: '▲'; font-size: 0.7em; }
  th.sort-desc::after { content: '▼'; font-size: 0.7em; }
  tbody tr:last-child td { border-bottom: none; }
  td a { color: #1a1a1a; text-decoration: none; }
  td a:hover { color: #3562d4; text-decoration: underline; }
  .file-actions button {
    background: none; border: 1px solid #d5d8dd; border-radius: 5px; padding: 0.25rem 0.6rem;
    cursor: pointer; font-size: 0.8rem; color: #6b7280;
  }
  .file-actions button:hover { color: #d1453b; border-color: #d1453b; }
  .empty-state { padding: 2rem; text-align: center; color: #9aa0ab; font-size: 0.9rem; }

  .file-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 4px; vertical-align: middle; margin-right: 0.5rem; cursor: pointer; }

  /* ── Image lightbox / slideshow ── */
  .lightbox { position: fixed; inset: 0; z-index: 500; display: flex; align-items: center; justify-content: center; }
  .lightbox.hidden { display: none !important; }
  .lightbox-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.9); }
  .lightbox-content { position: relative; z-index: 1; max-width: 92vw; max-height: 92vh; display: flex; align-items: center; justify-content: center; }
  .lightbox-image { max-width: 92vw; max-height: 92vh; object-fit: contain; display: block; }

  .lightbox-nav {
    position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,.4); color: #fff;
    border: none; font-size: 32px; line-height: 1; width: 48px; height: 48px; border-radius: 50%;
    cursor: pointer; opacity: 0; transition: opacity 0.15s;
  }
  .lightbox-content:hover .lightbox-nav, .lightbox-content.controls-visible .lightbox-nav { opacity: 1; }
  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }
  .lightbox-nav.hidden { display: none; }
  .lightbox-nav:disabled { opacity: 0; pointer-events: none; }

  .lightbox-controls {
    position: absolute; bottom: 0; left: 0; right: 0; display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; background: linear-gradient(transparent, rgba(0,0,0,.7)); opacity: 0; transition: opacity 0.15s;
  }
  .lightbox-content:hover .lightbox-controls, .lightbox-content.controls-visible .lightbox-controls { opacity: 1; }
  .lightbox-controls button, .lightbox-btn { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; padding: 4px 6px; }
  .lightbox-controls button:hover, .lightbox-btn:hover { color: #ccc; }
  .lightbox-controls button:disabled { color: #666; cursor: default; }
  .lightbox-speed { display: flex; gap: 2px; }
  .lightbox-speed button { font-size: 12px; padding: 2px 6px; border: 1px solid rgba(255,255,255,.4); border-radius: 4px; color: #fff; }
  .lightbox-speed button.active { background: rgba(255,255,255,.25); }

  .lightbox-info {
    position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between;
    padding: 10px 14px; background: linear-gradient(rgba(0,0,0,.7), transparent); color: #fff; font-size: 13px;
    opacity: 0; transition: opacity 0.15s;
  }
  .lightbox-content:hover .lightbox-info, .lightbox-content.controls-visible .lightbox-info { opacity: 1; }

  @media (prefers-color-scheme: dark) {
    body { background: #16181d; color: #e6e8eb; }
    nav.breadcrumb, aside, .upload-bar, .upload-progress, table { background: #1e2128; border-color: #2c2f37; }
    th { background: #23262d; color: #9aa0ab; }
    th, td { border-color: #2c2f37; }
    td a, .folder-list a { color: #e6e8eb; }
    form.new-folder input[type=text] { background: #16181d; border-color: #2c2f37; color: #e6e8eb; }
    .folder-list li.drag-over, main.drag-over { background: rgba(53, 98, 212, 0.15); }
  }

  /* ── Mobile (phone/small-tablet) layout ──
     Single breakpoint, CSS-only -- no server-side device detection like
     the old homelab-drive-web-ui had (see DEVELOPMENT.md there); this
     app has no per-request UA branching at all, and a pure media query
     gets the same visual result without adding any. Three structural
     changes: the folder sidebar becomes a slide-in drawer instead of a
     permanent column (there's no room for both it and the file list
     side by side), the file table scrolls horizontally in its own
     container instead of blowing out the whole page's width (keeps
     every column, including sorting, working exactly as on desktop --
     no parallel mobile-only sort UI needed), and interactive elements
     get bumped to a real touch target size (~44px, the standard
     minimum) since a mouse-era 0.85rem icon button is genuinely hard to
     tap accurately. */
  @media (max-width: 720px) {
    header { flex-wrap: wrap; row-gap: 0.5rem; padding: 0.6rem 0.9rem; }
    header h1 { font-size: 1rem; }
    /* "Bytes"/"Human Readable" text labels are the widest thing in the
       header after the title -- the switch itself (plus its title=
       tooltip) is enough once space is tight. */
    .size-toggle span { display: none; }
    /* The email address is the second-widest header item and the least
       essential to see at a glance on a phone -- Log out stays. */
    .who-email { display: none; }

    .layout { padding: 0.75rem; gap: 0.75rem; }

    .sidebar-toggle {
      display: inline-flex; align-items: center; gap: 0.35rem; background: #fff; border: 1px solid #d5d8dd;
      border-radius: 6px; padding: 0.5rem 0.8rem; font-size: 0.85rem; color: #1a1a1a; cursor: pointer;
      min-height: 44px;
    }
    aside {
      position: fixed; top: 0; left: 0; bottom: 0; width: 82vw; max-width: 300px; z-index: 300;
      margin: 0; border-radius: 0; overflow-y: auto;
      transform: translateX(-100%); transition: transform 0.2s ease;
    }
    aside.open { transform: translateX(0); box-shadow: 2px 0 16px rgba(0,0,0,.25); }
    #sidebar-backdrop.open {
      display: block; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 290;
    }
    .folder-list li { padding: 0.6rem 0.5rem; }
    .icon-btn { min-width: 40px; min-height: 40px; font-size: 1.05rem; }
    form.new-folder { flex-wrap: wrap; }
    form.new-folder input[type=text] { flex: 1 1 100%; }
    form.new-folder button { flex: 1 1 100%; min-height: 44px; }

    .upload-bar { flex-wrap: wrap; }
    .upload-bar input[type=file] { flex: 1 1 100%; }
    .upload-bar button { min-height: 44px; }
    /* Drag-and-drop doesn't exist on touch -- the hint pointing at a
       gesture that can't happen here is just noise; the plain
       <input type=file> above it still works fine (opens the OS file
       picker/camera on tap). */
    .drop-tip { display: none; }

    /* The table itself is untouched (same markup, same sort JS) -- it
       just scrolls sideways inside this wrapper instead of forcing the
       whole page wider than the viewport. */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #files-table { min-width: 560px; }
    .file-actions button { min-height: 40px; padding: 0.4rem 0.7rem; }

    .lightbox-controls button, .lightbox-btn { font-size: 22px; padding: 8px 10px; }
    .lightbox-nav { width: 42px; height: 42px; font-size: 26px; }
  }
</style>
</head>
<body>
<header>
  <h1>Homelab Drive</h1>
  <label class="size-toggle" title="File size display, remembered for this browser session">
    <span>Bytes</span>
    <input type="checkbox" id="size-unit-toggle" checked>
    <span class="switch"></span>
    <span>Human Readable</span>
  </label>
  <div class="who">
    <span class="who-email"><%= $email %></span>
    <form method="post" action="/logout"><button type="submit">Log out</button></form>
  </div>
</header>

<nav class="breadcrumb">
  <button type="button" class="sidebar-toggle" id="sidebar-toggle">☰ Folders</button>
  <a href="/">Home</a>
% for my $crumb (@$breadcrumb) {
  <span class="sep">/</span><a href="/folders/<%= $crumb->{id} %>"><%= $crumb->{name} %></a>
% }
</nav>

<div class="layout">
  <div id="sidebar-backdrop"></div>
  <aside>
    <h2>Folders</h2>
    <ul class="folder-list" id="folder-list">
% if (!@$folders) {
      <li class="empty-hint">No folders yet</li>
% }
% for my $f (@$folders) {
      <li data-folder-id="<%= $f->{id} %>">
        <a href="/folders/<%= $f->{id} %>">📁 <%= $f->{name} %></a>
        <form method="post" action="/folders/<%= $f->{id} %>/delete"
              onsubmit="return confirm('Delete \'<%= $f->{name} %>\' and everything inside it?')">
          <button type="submit" class="icon-btn" title="Delete folder">✕</button>
        </form>
      </li>
% }
    </ul>
    <form class="new-folder" method="post" action="/folders">
      <input type="hidden" name="parent_folder_id" value="<%= $current_folder_id // '' %>">
      <input type="text" name="name" placeholder="New folder" required maxlength="255">
      <button type="submit">+</button>
    </form>
  </aside>

  <main id="drop-main" data-folder-id="<%= $current_folder_id // '' %>">
    <div class="drop-hint">Drop to upload here</div>
% if ($error) {
    <div class="error-banner"><%= $error %></div>
% }

    <div class="upload-progress" id="upload-progress">
      <span class="spinner"></span>
      <span id="upload-progress-text">Uploading…</span>
    </div>

    <form class="upload-bar" method="post" action="/upload" enctype="multipart/form-data"
          onsubmit="this.querySelector('button').disabled = true; this.querySelector('.upload-status').textContent = 'Uploading\x{2026}';">
      <input type="hidden" name="folder_id" value="<%= $current_folder_id // '' %>">
      <input type="file" name="file" required>
      <button type="submit">Upload</button>
      <span class="upload-status"></span>
      <span class="drop-tip">or drag files/folders here or onto a folder</span>
    </form>

% if (!@$files && !@$folders) {
    <div class="empty-state">This folder is empty. Upload a file or create a folder to get started.</div>
% } else {
    <div class="table-scroll">
    <table id="files-table">
      <thead>
        <tr>
          <th data-sort="name">Name</th>
          <th data-sort="size">Size</th>
          <th data-sort="type">Type</th>
          <th data-sort="date">Uploaded</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
% for my $f (@$files) {
%   my $is_image = ($f->{mime_type} // '') =~ m{^image/};
      <tr data-id="<%= $f->{id} %>" data-name="<%= lc($f->{filename}) %>" data-filename="<%= $f->{filename} %>"
          data-size="<%= $f->{size_bytes} %>" data-type="<%= lc($f->{mime_type} // '') %>" data-date="<%= $f->{uploaded_at} %>">
        <td>
% if ($is_image) {
          <img src="/files/<%= $f->{id} %>/thumbnail" class="file-thumb" loading="lazy" alt=""
               onerror="this.style.display='none'" onclick="return Lightbox.open(<%= $f->{id} %>, event)">
          <a href="/files/<%= $f->{id} %>/download" onclick="return Lightbox.open(<%= $f->{id} %>, event)"><%= $f->{filename} %></a>
% } else {
          <a href="/files/<%= $f->{id} %>/download"><%= $f->{filename} %></a>
% }
        </td>
        <td class="file-size"><%= $f->{size_bytes} %> bytes</td>
        <td><%= $f->{mime_type} %></td>
        <td><%= $f->{uploaded_at_display} %></td>
        <td class="file-actions">
          <form method="post" action="/files/<%= $f->{id} %>/delete"
                onsubmit="return confirm('Delete <%= $f->{filename} %>?')">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
% }
      </tbody>
    </table>
    </div>
% }
  </main>
</div>

<div id="lightbox" class="lightbox hidden">
  <div class="lightbox-backdrop" onclick="Lightbox.close()"></div>
  <div class="lightbox-content">
    <button class="lightbox-nav lightbox-prev" onclick="Lightbox.prev()" aria-label="Previous">‹</button>
    <img id="lightbox-image" class="lightbox-image" alt="">
    <button class="lightbox-nav lightbox-next" onclick="Lightbox.next()" aria-label="Next">›</button>

    <div class="lightbox-controls">
      <button id="lightbox-play" onclick="Lightbox.toggleSlideshow()" title="Play/Pause">⏸</button>
      <div class="lightbox-speed">
        <button data-secs="2"  onclick="Lightbox.setSlideshowInterval(2)">2s</button>
        <button data-secs="4"  onclick="Lightbox.setSlideshowInterval(4)" class="active">4s</button>
        <button data-secs="10" onclick="Lightbox.setSlideshowInterval(10)">10s</button>
      </div>
      <a id="lightbox-download" class="lightbox-btn" download title="Download">⬇</a>
      <button onclick="Lightbox.toggleFullscreen()" title="Fullscreen">⛶</button>
      <button onclick="Lightbox.close()" title="Close">✕</button>
    </div>
    <div class="lightbox-info">
      <span id="lightbox-counter"></span>
      <span id="lightbox-caption"></span>
    </div>
  </div>
</div>

<script>
// Drag-and-drop upload: drop files (or whole folders, from the OS file
// manager -- NOT a move-within-Drive feature) onto the main area to
// upload into the folder currently being viewed, or directly onto a
// folder row in the sidebar to upload into THAT folder regardless of
// which one is open. Talks to the same /api/v1/files and /api/v1/folders
// JSON API homelab-cli uses (see README.md) -- fetch()'s same-origin
// credentials carry this page's own session cookie, so _current_email()
// authenticates via its existing cookie fallback, no separate token
// needed here.
(function () {
  'use strict';

  function setupDropZone(el, getFolderId) {
    // A plain dragenter/dragleave pair flickers on any element with
    // child nodes (Chrome fires dragleave when the pointer crosses from
    // a child onto its parent, even while still inside the same drop
    // zone) -- a depth counter avoids that instead of trying to filter
    // relatedTarget, which behaves inconsistently across browsers here.
    let depth = 0;
    el.addEventListener('dragenter', function (e) {
      if (!hasFiles(e)) return;
      e.preventDefault();
      depth++;
      el.classList.add('drag-over');
    });
    el.addEventListener('dragover', function (e) {
      if (!hasFiles(e)) return;
      e.preventDefault(); // required, or the browser refuses the drop entirely
    });
    el.addEventListener('dragleave', function () {
      depth = Math.max(0, depth - 1);
      if (depth === 0) el.classList.remove('drag-over');
    });
    el.addEventListener('drop', function (e) {
      if (!hasFiles(e)) return;
      e.preventDefault();
      e.stopPropagation(); // harmless defensively even though aside/main are siblings today, not nested
      depth = 0;
      el.classList.remove('drag-over');
      handleDrop(e.dataTransfer.items, getFolderId());
    });
  }

  function hasFiles(e) {
    return e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') !== -1;
  }

  // A real user found this by actually dragging a folder-with-a-
  // subfolder (e.g. "turkeys" containing "Downloads") onto the page:
  // the subfolder came out as a SIBLING of "turkeys" under the drop
  // target instead of nested inside it. The recursive walk below
  // (processEntry) *does* correctly nest a directory's own children
  // under it -- root cause (confirmed by that same user re-testing the
  // same real drag after this landed) is that some browser/OS/file-
  // manager combination hands back a dropped folder's descendants as
  // SEPARATE top-level DataTransferItems too, alongside the folder
  // itself, bypassing that recursion entirely for the redundant copy.
  // fullPath is a real FileSystemEntry property (absolute, rooted at
  // whatever was dragged, e.g. "/turkeys" and "/turkeys/Downloads") --
  // if one top-level entry's path is a prefix of another's, the shorter
  // one is the real ancestor and the longer one is dropped here, to be
  // picked back up naturally when the ancestor is recursed into.
  // console.warn so there's still visible evidence on any future
  // recurrence, even now that the mechanism itself is confirmed.
  function dedupeNestedTopLevelEntries(entries) {
    var paths = entries.map(function (e) { return e.fullPath || null; });
    return entries.filter(function (e, i) {
      if (!e.fullPath) return true; // no fullPath (e.g. the getAsFile() fallback shape) -- nothing to compare, keep it
      for (var k = 0; k < paths.length; k++) {
        if (k !== i && paths[k] && e.fullPath.indexOf(paths[k] + '/') === 0) {
          console.warn('homelab-drive: dropping redundant top-level entry', e.fullPath, '-- nested under', paths[k]);
          return false;
        }
      }
      return true;
    });
  }

  async function handleDrop(items, targetFolderId) {
    var entries = [];
    for (var i = 0; i < items.length; i++) {
      // webkitGetAsEntry is non-standard in name only -- supported in
      // every current browser -- and is what makes recursing into a
      // dropped folder possible at all. Fall back to a flat File if
      // it's ever unavailable, so plain file drops still work.
      var entry = items[i].webkitGetAsEntry ? items[i].webkitGetAsEntry() : null;
      if (entry) {
        entries.push(entry);
      } else if (items[i].getAsFile) {
        var file = items[i].getAsFile();
        if (file) entries.push({ isFile: true, isDirectory: false, name: file.name, file: function (cb) { cb(file); } });
      }
    }
    entries = dedupeNestedTopLevelEntries(entries);
    if (!entries.length) return;

    var progress = document.getElementById('upload-progress');
    var progressText = document.getElementById('upload-progress-text');
    progress.classList.add('active');

    var counts = { uploaded: 0, failed: 0 };
    var folderCache = new Map();
    for (var j = 0; j < entries.length; j++) {
      progressText.textContent = 'Uploading… (' + counts.uploaded + ' done)';
      await processEntry(entries[j], targetFolderId, folderCache, counts, progressText);
    }

    progress.classList.remove('active');
    if (counts.failed) {
      alert(counts.failed + ' file(s) failed to upload' + (counts.uploaded ? ' (' + counts.uploaded + ' succeeded).' : '.'));
    }
    if (counts.uploaded) location.reload();
  }

  function processEntry(entry, targetFolderId, folderCache, counts, progressText) {
    if (entry.isFile) {
      return new Promise(function (resolve) {
        entry.file(async function (file) {
          var ok = await uploadFile(file, targetFolderId);
          if (ok) counts.uploaded++; else counts.failed++;
          progressText.textContent = 'Uploading… (' + counts.uploaded + ' done)';
          resolve();
        }, function () { counts.failed++; resolve(); });
      });
    }
    if (entry.isDirectory) {
      return ensureFolder(entry.name, targetFolderId, folderCache).then(function (folderId) {
        if (!folderId) { counts.failed++; return; }
        return readAllEntries(entry).then(function (children) {
          var chain = Promise.resolve();
          children.forEach(function (child) {
            chain = chain.then(function () { return processEntry(child, folderId, folderCache, counts, progressText); });
          });
          return chain;
        });
      });
    }
    return Promise.resolve();
  }

  // DirectoryReader.readEntries() only returns a batch at a time and
  // MUST be called repeatedly until it returns an empty array -- a
  // single call is not guaranteed to return every entry, even for a
  // small directory (documented browser behavior, not a defensive
  // extra here).
  function readAllEntries(dirEntry) {
    var reader = dirEntry.createReader();
    var all = [];
    return new Promise(function (resolve, reject) {
      (function readBatch() {
        reader.readEntries(function (batch) {
          if (!batch.length) { resolve(all); return; }
          all.push.apply(all, batch);
          readBatch();
        }, reject);
      })();
    });
  }

  async function ensureFolder(name, parentId, cache) {
    var key = (parentId || 'root') + '/' + name;
    if (cache.has(key)) return cache.get(key);
    var body = { name: name };
    if (parentId) body.parent_folder_id = parentId;

    var resp = await fetch('/api/v1/folders', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
    });

    var folderId = null;
    if (resp.status === 201) {
      folderId = (await resp.json()).id;
    } else if (resp.status === 409) {
      // Already exists (e.g. dragging the same folder again to add one
      // more file to it) -- reuse it instead of failing everything
      // inside it.
      var listResp = await fetch('/api/v1/folders' + (parentId ? '?parent_id=' + encodeURIComponent(parentId) : ''), { credentials: 'same-origin' });
      var list = await listResp.json();
      var existing = list.find(function (f) { return f.name === name; });
      if (existing) folderId = existing.id;
    }
    cache.set(key, folderId);
    return folderId;
  }

  async function uploadFile(file, folderId) {
    var form = new FormData();
    form.append('file', file, file.name);
    if (folderId) form.append('folder_id', folderId);
    try {
      var resp = await fetch('/api/v1/files', { method: 'POST', credentials: 'same-origin', body: form });
      return resp.ok;
    } catch (e) {
      return false;
    }
  }

  var main = document.getElementById('drop-main');
  setupDropZone(main, function () { return main.dataset.folderId || null; });
  document.querySelectorAll('#folder-list li[data-folder-id]').forEach(function (li) {
    setupDropZone(li, function () { return li.dataset.folderId; });
  });
})();
</script>

<script>
// Column sorting for the file table -- client-side, no page reload
// (all of a folder's files are already on the page at once; there's no
// pagination to fight with). size sorts numerically (raw bytes, off a
// data-size attribute -- sorting the rendered "123 bytes" text would
// put "999 bytes" before "1000000 bytes"); name/type sort
// case-insensitively (data-name/data-type are already lowercased by
// the template); date sorts on the raw, full-precision uploaded_at
// (not the seconds-trimmed display text), so ordering stays exact even
// though what's shown isn't.
(function () {
  'use strict';
  var table = document.getElementById('files-table');
  if (!table) return;
  var tbody = table.querySelector('tbody');
  var headers = Array.prototype.slice.call(table.querySelectorAll('th[data-sort]'));

  var activeKey = null;
  var activeDir = 1;

  headers.forEach(function (th) {
    th.addEventListener('click', function () {
      var key = th.dataset.sort;
      activeDir = (activeKey === key) ? -activeDir : 1;
      activeKey = key;

      headers.forEach(function (h) { h.classList.remove('sort-asc', 'sort-desc'); });
      th.classList.add(activeDir === 1 ? 'sort-asc' : 'sort-desc');

      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      rows.sort(function (rowA, rowB) {
        var a = rowA.dataset[key], b = rowB.dataset[key];
        if (key === 'size') { a = Number(a); b = Number(b); }
        if (a < b) return -activeDir;
        if (a > b) return activeDir;
        return 0;
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
    });
  });
})();
</script>

<script>
// Bytes / Human Readable size toggle, in the header so it applies
// everywhere file sizes render on this page (every folder view shares
// this one template). sessionStorage, not localStorage: the ask was
// specifically "for the duration of the session" -- survives a page
// refresh or folder navigation (same tab), but doesn't linger forever
// past that the way localStorage would. Defaults to Human Readable
// (the checkbox's own "checked" attribute in the markup matches this,
// so a no-JS or JS-not-yet-run instant shows the right initial state).
// The server always renders raw "<N> bytes" client-side reformats on
// load and on toggle off of the same data-size attribute the column
// sort already relies on -- no new data from the backend needed.
(function () {
  'use strict';
  var STORAGE_KEY = 'homelab-drive-size-unit';
  var toggle = document.getElementById('size-unit-toggle');
  if (!toggle) return;

  function formatHuman(bytes) {
    if (bytes < 1024) return bytes + ' bytes';
    var units = ['KB', 'MB', 'GB', 'TB', 'PB'];
    var value = bytes;
    var i = -1;
    do { value /= 1024; i++; } while (value >= 1024 && i < units.length - 1);
    return value.toFixed(1) + ' ' + units[i];
  }

  function applyUnit(unit) {
    document.querySelectorAll('#files-table tbody tr').forEach(function (row) {
      var cell = row.querySelector('.file-size');
      if (!cell) return;
      var bytes = Number(row.dataset.size);
      cell.textContent = unit === 'bytes' ? bytes + ' bytes' : formatHuman(bytes);
    });
  }

  // Anything other than the literal stored string 'bytes' (including
  // unset, i.e. first visit this session) resolves to the default,
  // Human Readable.
  var unit = sessionStorage.getItem(STORAGE_KEY) === 'bytes' ? 'bytes' : 'human';
  toggle.checked = (unit === 'human');
  applyUnit(unit);

  toggle.addEventListener('change', function () {
    var newUnit = toggle.checked ? 'human' : 'bytes';
    sessionStorage.setItem(STORAGE_KEY, newUnit);
    applyUnit(newUnit);
  });
})();
</script>

<script>
// Image lightbox + slideshow -- ported from the old homelab-drive-web-ui's
// DriveUI lightbox (github-repos/homelab-api's drive-web-ui/public/app.js,
// the still-running production Drive's implementation) to this app's
// simpler single-page-per-folder model. There, thumbnails/slideshow images
// were generated by a separate queue worker and served via nginx
// X-Accel-Redirect from a shared NFS mount; here generation is synchronous
// at upload time and serving is a plain Mojolicious file reply (see
// App.pm's _generate_image_derivatives/_serve_derivative and README.md) --
// but the CLIENT-side behavior (speed presets, prefetching, keyboard
// shortcuts) is deliberately the same feature, since that's what was asked
// for. Unlike the old htmx-driven app, this page does a full reload on any
// mutation (upload/delete/rename), so there's no separate "file list
// changed under me" event to listen for -- a reload naturally resets this
// module's state too.
var Lightbox = (function () {
  'use strict';

  var _images  = [];   // [{id, name}], rebuilt fresh every time the lightbox opens
  var _index   = -1;
  var _timer   = null; // slideshow setInterval handle
  var _seconds = 4;    // current interval; 0 = off

  function _currentFolderImages() {
    return Array.prototype.slice.call(document.querySelectorAll('#files-table tbody tr'))
      .filter(function (row) { return /^image\//.test(row.dataset.type || ''); })
      .map(function (row) { return { id: Number(row.dataset.id), name: row.dataset.filename || '' }; });
  }

  // Session-scoped image cache: id -> objectURL. Map insertion order
  // doubles as LRU order (re-inserting on access = MRU).
  var CACHE_MAX = 15;
  var _cache = new Map();
  var _inflight = new Map();

  function _cacheEvictOldest() {
    while (_cache.size > CACHE_MAX) {
      var oldestId = _cache.keys().next().value;
      URL.revokeObjectURL(_cache.get(oldestId));
      _cache.delete(oldestId);
    }
  }

  function _prefetch(id) {
    if (_cache.has(id) || _inflight.has(id)) return;
    var p = fetch('/files/' + id + '/slideshow-image', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r : fetch('/files/' + id + '/download', { credentials: 'same-origin' }); })
      .then(function (r) { return r.ok ? r.blob() : Promise.reject(); })
      .then(function (blob) {
        _cache.set(id, URL.createObjectURL(blob));
        _cacheEvictOldest();
      })
      .catch(function () {})
      .finally(function () { _inflight.delete(id); });
    _inflight.set(id, p);
  }

  // Forward-browsing is the common case, so prefetch further ahead (next
  // 2) than behind (previous 1).
  function _prefetchNeighbors() {
    if (_images.length <= 1) return;
    [1, 2, -1].forEach(function (offset) {
      var target = _images[(_index + offset + _images.length) % _images.length];
      if (target) _prefetch(target.id);
    });
  }

  function open(id, event) {
    if (event) { event.preventDefault(); event.stopPropagation(); }
    _images = _currentFolderImages();
    _index = _images.findIndex(function (f) { return f.id === id; });
    if (_index < 0) return false;
    _show();
    var lb = document.getElementById('lightbox');
    if (lb) lb.classList.remove('hidden');
    _start();
    return false;
  }

  function _show() {
    var img = _images[_index];
    if (!img) return;
    var slideUrl    = '/files/' + img.id + '/slideshow-image';
    var downloadUrl = '/files/' + img.id + '/download';
    var image    = document.getElementById('lightbox-image');
    var download = document.getElementById('lightbox-download');
    var caption  = document.getElementById('lightbox-caption');
    var counter  = document.getElementById('lightbox-counter');

    if (image) {
      var cached = _cache.get(img.id);
      if (cached) {
        _cache.delete(img.id);
        _cache.set(img.id, cached); // bump to most-recently-used
        image.onerror = null;
        image.src = cached;
      } else {
        // Slideshow-sized derivative first; fall back to the full-res
        // original if it's missing (generation failed, or a non-image
        // file somehow ended up in this list).
        image.onerror = function () { image.onerror = null; image.src = downloadUrl; };
        image.src = slideUrl;
        _prefetch(img.id);
      }
    }
    // Download link always hits the real endpoint, never a cached blob URL.
    if (download) { download.href = downloadUrl; download.download = img.name; }
    if (caption) caption.textContent = img.name;
    if (counter) counter.textContent = (_index + 1) + ' / ' + _images.length;

    var multi = _images.length > 1;
    document.querySelectorAll('.lightbox-nav').forEach(function (b) { b.classList.toggle('hidden', !multi); });
    var playBtn = document.getElementById('lightbox-play');
    if (playBtn) playBtn.disabled = !multi;
    document.querySelectorAll('.lightbox-speed button').forEach(function (b) { b.disabled = !multi; });

    _prefetchNeighbors();
  }

  function close() {
    _stop();
    if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
    var lb = document.getElementById('lightbox');
    if (lb) lb.classList.add('hidden');
    var image = document.getElementById('lightbox-image');
    if (image) image.src = '';
  }

  function next() {
    if (!_images.length) return;
    _index = (_index + 1) % _images.length;
    _show();
    _restartIfRunning();
  }

  function prev() {
    if (!_images.length) return;
    _index = (_index - 1 + _images.length) % _images.length;
    _show();
    _restartIfRunning();
  }

  function _updatePlayGlyph() {
    var playBtn = document.getElementById('lightbox-play');
    if (playBtn) playBtn.textContent = _timer ? '⏸' : '⏵';
  }

  function toggleSlideshow() {
    if (_timer) _stop(); else _start();
  }

  function _start() {
    if (_seconds <= 0 || _images.length <= 1) return;
    _timer = setInterval(next, _seconds * 1000);
    _updatePlayGlyph();
  }

  function _stop() {
    clearInterval(_timer);
    _timer = null;
    _updatePlayGlyph();
  }

  function _restartIfRunning() {
    if (_timer) { _stop(); _start(); }
  }

  // Quick-select buttons offer 2s/4s/10s; any digit key 1-9 sets that
  // exact number of seconds instead (0 pauses) -- see the keydown handler
  // below. Changing speed while playing restarts the timer immediately at
  // the new interval rather than waiting out the old one.
  function setSlideshowInterval(secs) {
    _seconds = secs;
    document.querySelectorAll('.lightbox-speed button').forEach(function (b) {
      b.classList.toggle('active', Number(b.dataset.secs) === secs);
    });
    if (secs === 0) _stop(); else _restartIfRunning();
  }

  function downloadCurrent() {
    var link = document.getElementById('lightbox-download');
    if (link) link.click();
  }

  function toggleFullscreen() {
    var el = document.querySelector('.lightbox-content');
    if (!el) return;
    if (!document.fullscreenElement && el.requestFullscreen) el.requestFullscreen();
    else if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
  }

  // Controls/nav/info overlays reveal on hover (see the CSS), which
  // doesn't exist on touch devices -- tapping the image itself toggles
  // them instead.
  var lbImage = document.getElementById('lightbox-image');
  if (lbImage) {
    lbImage.addEventListener('click', function (e) {
      if (!window.matchMedia('(hover: hover)').matches) {
        var content = e.currentTarget.closest('.lightbox-content');
        if (content) content.classList.toggle('controls-visible');
      }
    });
  }

  document.addEventListener('keydown', function (e) {
    var lb = document.getElementById('lightbox');
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.target.matches('input, textarea')) return;
    switch (e.key) {
      case 'Escape': close(); break;
      case ' ': case 'p': case 'P': e.preventDefault(); toggleSlideshow(); break;
      case 'd': case 'D': downloadCurrent(); break;
      case 'ArrowLeft':  prev(); break;
      case 'ArrowRight': next(); break;
      case 'Home': _index = 0; _show(); _restartIfRunning(); break;
      case 'End':  _index = _images.length - 1; _show(); _restartIfRunning(); break;
      case 'f': case 'F': toggleFullscreen(); break;
      default:
        if (e.key >= '1' && e.key <= '9') setSlideshowInterval(Number(e.key));
        else if (e.key === '0') setSlideshowInterval(0);
    }
  });

  return {
    open: open,
    close: close,
    prev: prev,
    next: next,
    toggleSlideshow: toggleSlideshow,
    setSlideshowInterval: setSlideshowInterval,
    toggleFullscreen: toggleFullscreen,
  };
})();
</script>

<script>
// Mobile folder drawer: the toggle button and backdrop are both inert
// (display:none, out of the flex layout) above the mobile breakpoint
// (see the CSS), so this wiring is harmless dead weight on desktop
// rather than something that needs its own screen-width check.
(function () {
  'use strict';
  var toggleBtn = document.getElementById('sidebar-toggle');
  var aside     = document.querySelector('aside');
  var backdrop  = document.getElementById('sidebar-backdrop');
  if (!toggleBtn || !aside || !backdrop) return;

  function openDrawer()  { aside.classList.add('open');    backdrop.classList.add('open'); }
  function closeDrawer() { aside.classList.remove('open'); backdrop.classList.remove('open'); }

  toggleBtn.addEventListener('click', function () {
    aside.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  backdrop.addEventListener('click', closeDrawer);
})();
</script>
</body>
</html>
