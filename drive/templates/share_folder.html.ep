% layout 'default';
% title ($here->{name} // $share->{folder_name} // 'Shared folder') . ' — Drive';
<div class="layout" style="justify-content:center;">
  <main style="max-width:52em;">
    <p class="muted" style="margin:0 0 var(--space-2);">
      <%= $share->{owner_email} %> shared a folder with you
    </p>

    %# Trail back to the share's root only. A visitor can climb out of a
    %# subfolder but never above the folder that was shared -- that is their
    %# whole world here.
    <nav class="breadcrumb" style="padding-left:0;padding-right:0;background:none;border:0;">
      <a href="/s/<%= $share->{token} %>">📁 <%= $share->{folder_name} %></a>
      % for my $t (@$trail) {
        <span class="sep">/</span>
        % if ($t->{id} == $here->{id}) {
          <span><%= $t->{name} %></span>
        % } else {
          <a href="/s/<%= $share->{token} %>/f/<%= $t->{id} %>"><%= $t->{name} %></a>
        % }
      % }
    </nav>

    % if (!@$subfolders && !@$files) {
      <p class="muted">This folder is empty.</p>
    % } else {
      <div class="table-scroll">
        <table>
          <thead><tr><th></th><th>Name</th><th>Size</th><th></th></tr></thead>
          <tbody>
          %# Folders first, then files -- same ordering the signed-in view uses.
          % for my $d (@$subfolders) {
            <tr>
              <td style="width:52px;">📁</td>
              <td><a href="/s/<%= $share->{token} %>/f/<%= $d->{id} %>"><%= $d->{name} %></a></td>
              <td class="muted">&mdash;</td>
              <td class="file-actions">
                <a class="btn btn-secondary" href="/s/<%= $share->{token} %>/f/<%= $d->{id} %>">Open</a>
              </td>
            </tr>
          % }
          % for my $f (@$files) {
            <tr>
              <td style="width:52px;">
                % if (($f->{mime_type} // '') =~ m{^image/}) {
                  <img class="file-thumb" src="/s/<%= $share->{token} %>/files/<%= $f->{id} %>/thumbnail"
                       alt="" onerror="this.style.display='none'">
                % }
              </td>
              <td><%= $f->{filename} %></td>
              <td class="muted"><%= $f->{size_bytes} // 0 %></td>
              <td class="file-actions">
                <a class="btn btn-secondary" href="/s/<%= $share->{token} %>/files/<%= $f->{id} %>/download">Download</a>
              </td>
            </tr>
          % }
          </tbody>
        </table>
      </div>
    % }
  </main>
</div>
