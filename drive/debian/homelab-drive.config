#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/drive/config.yml ]; then
    exit 0
fi

db_input high homelab-drive/db_host || true
db_input high homelab-drive/pgbouncer_host || true
db_input high homelab-drive/api_base || true
db_input high homelab-drive/listen_port || true
db_go

exit 0
