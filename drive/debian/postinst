#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR=/etc/homelab/drive
CONFIG_FILE="$CONFIG_DIR/config.yml"
SHARE_DIR=/usr/share/homelab-drive

case "$1" in
    configure)
        echo "homelab-drive post-installation setup..."

        adduser --system --group --home /var/lib/homelab --no-create-home \
            --shell /usr/sbin/nologin homelab 2>/dev/null || true
        # .uploads-tmp is MOJO_TMPDIR (see homelab-drive.service): large
        # upload bodies spool here, on the SAME filesystem as storage so
        # move_to is a rename. Deliberately a subdir of drive-storage,
        # never /tmp (a RAM tmpfs on this fleet -- a 4GB spill there OOMs).
        # .partials holds in-progress CHUNKED uploads (one file per
        # session; see migrations/006-upload-sessions.sql) -- same
        # real-disk, same-filesystem reasoning so finalizing is a rename.
        mkdir -p /var/lib/homelab "$CONFIG_DIR" /var/lib/homelab/drive-storage \
            /var/lib/homelab/drive-storage/.uploads-tmp /var/lib/homelab/drive-storage/.partials
        chown homelab:homelab /var/lib/homelab

        # drive-storage is GROUP vmail(5000) + setgid, and its blobs are
        # 0640 -- owner (this service) rw, group r, others nothing.
        #
        # Why group 5000 specifically, and why numeric: homelab-search
        # reads these blobs over the read-only NFS export as uid 5000, and
        # the NAS has `manage-gids=y`, so the server DISCARDS the client's
        # supplementary group list and resolves groups locally by uid. On
        # the NAS uid 5000 resolves to exactly {5000}, so 5000 is the only
        # group that can grant it read. (The group it had, 1001, is
        # `vault` on the NAS -- a group containing one human and not the
        # reader, so 0640 with that group would have locked search out of
        # every file rather than letting it in.) Numeric because this host
        # has no vmail user at all; only the number crosses NFS anyway.
        #
        # setgid is what keeps it true without privilege: the service runs
        # as homelab and is not a member of group 5000, so it cannot chgrp
        # its own uploads -- the directory assigns the group for it.
        chown homelab:5000 /var/lib/homelab/drive-storage || true
        # 2750, as ONE number, because the setgid bit above has to survive
        # the mode change: owner (this service) rwx, group (search, as uid
        # 5000) r-x, everyone else NOTHING.
        #
        # It was created 0777, and on an rw NFS client that means every
        # local uid on a drive node -- the prometheus exporter, any future
        # service, anybody with a shell -- could list all 30,512 blobs, and
        # since write permission on a DIRECTORY is what authorises unlink,
        # could delete them. No reader needs it: drive owns the directory,
        # search only ever opens a uuid a `user_email = ?` query already
        # returned and deliberately never enumerates the store (see
        # search/lib/Homelab/Search/Paths.pm), and root is unaffected either
        # way because the export is no_root_squash.
        #
        # Deliberately NOT o+x: nothing reaches a blob by a path it was
        # handed rather than by listing, and the blobs are 0640 anyway, so
        # the execute bit would buy an unprivileged uid nothing but the
        # ability to confirm a uuid exists.
        chmod 2750 /var/lib/homelab/drive-storage || true

        # The two temp directories need the SAME group and setgid, and that
        # is not belt-and-braces -- it is load-bearing. Three of the four
        # paths that put bytes into storage finish with rename(2), and
        # rename(2) PRESERVES the source file's group; a destination's
        # setgid bit only applies to files CREATED there. So temp
        # directories in group homelab silently produced blobs in group
        # homelab -- which is `vault` on the NAS, and unreadable by search
        # -- but ONLY for uploads over 256 KB, because under that size
        # Mojolicious creates the file in the storage directory itself and
        # setgid does apply.
        #
        # That is the same size-dependent split as the mode bug above, one
        # level up, and it was caught by uploading a 600 KB file and looking
        # at the result rather than by reading the code: the fix for the
        # mode set the mode explicitly on all four paths, but left the group
        # to a setgid bit that three of them bypass.
        #
        # .uploads-tmp is MOJO_TMPDIR (plain uploads, and the spool for a
        # zip/concat artifact downloaded back from homelab-worker) and also
        # holds append-job-* scratch; .partials holds chunked uploads being
        # assembled. Every one of those is renamed into storage.
        for d in .uploads-tmp .partials; do
            chown homelab:5000 "/var/lib/homelab/drive-storage/$d" || true
            chmod 2750 "/var/lib/homelab/drive-storage/$d" || true
        done

        # Reconcile blobs written before the rule existed. Mojolicious
        # hands `move_to` either a Mojo::Asset::Memory (spurts a fresh
        # file under our umask -> 0644) or, once the body passes
        # max_memory_size, a File::Temp already on disk (move_to is a
        # rename, which PRESERVES File::Temp's 0600) -- so a blob's mode
        # used to depend on whether it crossed 256 KB. It is not a
        # migration artifact: every one of the 109 live 0600 files was
        # over that threshold and all 30,403 under it were 0644. The
        # 0600 ones were unreadable by search, which could only report
        # them as missing. The test skips files already correct, so this
        # is a cheap stat sweep on every upgrade after the first.
        find /var/lib/homelab/drive-storage -maxdepth 1 -type f \
             \( ! -group 5000 -o ! -perm 640 \) \
             -exec chgrp 5000 {} + -exec chmod 0640 {} + 2>/dev/null || true

        # Shared manifest dir -- may not exist yet if homelab-agent isn't
        # installed on this host first (install order isn't guaranteed
        # either way); ensure it, then drop this package's own
        # declarative entry into it unconditionally (static metadata,
        # not user config -- always refresh, unlike $CONFIG_FILE below).
        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services
        cp "$SHARE_DIR/services/drive.yml" "/etc/homelab/services/drive.yml"

        if [ ! -f "$CONFIG_FILE" ]; then
            db_get homelab-drive/db_host || true;        DB_HOST="${RET:-localhost}"
            db_get homelab-drive/pgbouncer_host || true;  PGBOUNCER_HOST="${RET:-localhost}"
            db_get homelab-drive/api_base || true;        API_BASE="${RET:-http://localhost:3000}"
            db_get homelab-drive/listen_port || true;     LISTEN_PORT="${RET:-2501}"
            db_get homelab-drive/advertise_host || true;  ADVERTISE_HOST="${RET:-127.0.0.1}"
            db_get homelab-drive/sso_base_url || true;      SSO_BASE_URL="${RET:-http://127.0.0.1:2502}"
            db_get homelab-drive/sso_internal_base_url || true; SSO_INTERNAL_BASE_URL="${RET:-$SSO_BASE_URL}"
            db_get homelab-drive/sso_redirect_uri || true;  SSO_REDIRECT_URI="${RET:-https://drive.test.mailmasker.org/oauth/callback}"
            db_get homelab-drive/sso_client_secret || true; SSO_CLIENT_SECRET="$RET"

            if [ -z "$SSO_CLIENT_SECRET" ]; then
                echo "  WARNING: no sso_client_secret was provided -- homelab-drive will not"
                echo "  be able to complete SSO logins until you set sso.client_secret in"
                echo "  $CONFIG_FILE by hand (or dpkg-reconfigure homelab-drive) to match"
                echo "  what homelab-sso's own install printed for the 'drive' client."
                SSO_CLIENT_SECRET="YOUR_SSO_CLIENT_SECRET_HERE"
            fi

            echo "  bootstrapping Postgres roles for 'homelab_drive' on $DB_HOST..."
            BOOTSTRAP_OUT="$(homelab-bootstrap-app-role --feature homelab_drive --schema drive --db-host "$DB_HOST")"

            RUNTIME_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_ROLE=//p')"
            RUNTIME_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_PASSWORD=//p')"
            RUNTIME_SCRAM_SECRET="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_SCRAM_SECRET=//p')"
            MIGRATE_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_ROLE=//p')"
            MIGRATE_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_PASSWORD=//p')"
            BOOTSTRAP_MANUAL="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^BOOTSTRAP_MANUAL=//p')"

            if [ -z "$RUNTIME_ROLE" ] || [ -z "$MIGRATE_ROLE" ]; then
                echo "ERROR: homelab-bootstrap-app-role did not report success — see output above."
                echo "       Not writing $CONFIG_FILE; re-run 'dpkg-reconfigure homelab-drive' once fixed."
                db_stop
                exit 0
            fi

            SESSION_SECRET="$(openssl rand -base64 32)"

            sed \
                -e "s#https://login.test.mailmasker.org#$API_BASE#g" \
                -e "s#YOUR_PGBOUNCER_HOST#$PGBOUNCER_HOST#g" \
                -e "s#YOUR_RUNTIME_PASSWORD_HERE#$RUNTIME_PASSWORD#g" \
                -e "s#homelab_drive_runtime#$RUNTIME_ROLE#g" \
                -e "s#YOUR_POSTGRES_HOST#$DB_HOST#g" \
                -e "s#YOUR_MIGRATE_PASSWORD_HERE#$MIGRATE_PASSWORD#g" \
                -e "s#homelab_drive_migrate#$MIGRATE_ROLE#g" \
                -e "s#CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS#$SESSION_SECRET#g" \
                -e "s#0\.0\.0\.0:2501#0.0.0.0:$LISTEN_PORT#g" \
                -e "s#host: 127\.0\.0\.1#host: $ADVERTISE_HOST#g" \
                -e "s#port: 2501#port: $LISTEN_PORT#g" \
                -e "s#YOUR_SSO_BASE_URL_HERE#$SSO_BASE_URL#g" \
                -e "s#YOUR_SSO_INTERNAL_BASE_URL_HERE#$SSO_INTERNAL_BASE_URL#g" \
                -e "s#https://drive.test.mailmasker.org/oauth/callback#$SSO_REDIRECT_URI#g" \
                -e "s#YOUR_SSO_CLIENT_SECRET_HERE#$SSO_CLIENT_SECRET#g" \
                "$SHARE_DIR/config/drive.example.yml" > "$CONFIG_FILE"
            chown root:homelab "$CONFIG_FILE"
            chmod 640 "$CONFIG_FILE"
            echo "  wrote $CONFIG_FILE"

            # Manual (multi-host, no-SSH-to-DB) bootstrap: config is fully
            # written above, but the DB role + pgbouncer entry must be done
            # by hand (runbook already printed by homelab-bootstrap-app-role).
            # Skip pgbouncer-register (SCRAM is empty here) and migrate (role
            # doesn't exist yet); the operator finishes via dpkg-reconfigure
            # after the DB-side steps.
            if [ "$BOOTSTRAP_MANUAL" = "1" ]; then
                echo ""
                echo "  ================================================================"
                echo "  CONFIG WRITTEN -- but DB-side steps remain (runbook printed above):"
                echo "    1) run the role SQL on the DB primary"
                echo "    2) register '$RUNTIME_ROLE' in pgbouncer on each pooler"
                echo "  Then finish this host (applies migrations + starts the service):"
                echo "      sudo dpkg-reconfigure homelab-drive"
                echo "  ================================================================"
                echo ""
                db_stop
                exit 0
            fi

            echo "  registering '$RUNTIME_ROLE' with pgbouncer on $PGBOUNCER_HOST..."
            homelab-bootstrap-pgbouncer-entry --role "$RUNTIME_ROLE" \
                --scram-secret "$RUNTIME_SCRAM_SECRET" --pgbouncer-host "$PGBOUNCER_HOST" \
                || echo "  WARNING: pgbouncer registration failed — see output above; register '$RUNTIME_ROLE' by hand."
        fi

        # RUNTIME_ROLE is only set above on a fresh install -- on an
        # upgrade, derive it from the config already on disk.
        if [ -z "$RUNTIME_ROLE" ]; then
            RUNTIME_ROLE="$(sed -n '/^database:/,/^database_migrate:/{s/^[[:space:]]*user: //p}' "$CONFIG_FILE" | head -1)"
        fi
        if [ -n "$RUNTIME_ROLE" ]; then
            echo "  granting '$RUNTIME_ROLE' INSERT access on audit.queue (for the file/folder delete and upload audit trail)..."
            DB_HOST_FOR_GRANT="${DB_HOST:-$(sed -n '/^database_migrate:/,/^database:/{s/^[[:space:]]*host: //p}' "$CONFIG_FILE" | head -1)}"
            homelab-audit-grant-queue-insert --role "$RUNTIME_ROLE" --db-host "${DB_HOST_FOR_GRANT:-localhost}" \
                || echo "  WARNING: could not grant audit.queue access -- if homelab-audit isn't installed/migrated yet, install it and re-run this grant by hand (see homelab-audit/README.md); audited actions (file/folder delete, upload) will fail closed until this grant exists."
        fi

        echo "  applying migrations..."
        HOMELAB_DRIVE_MIGRATIONS_DIR="$SHARE_DIR/migrations" \
            HOMELAB_DRIVE_CONFIG="$CONFIG_FILE" \
            sudo -u homelab homelab-drive-migrate

        systemctl enable homelab-drive >/dev/null 2>&1 || true
        if systemctl is-active --quiet homelab-drive; then
            systemctl restart homelab-drive || echo "WARNING: homelab-drive restart failed -- check 'systemctl status homelab-drive' by hand."
        else
            systemctl start homelab-drive || echo "WARNING: homelab-drive failed to start -- check 'systemctl status homelab-drive' by hand."
        fi

        db_stop

        echo ""
        echo "homelab-drive configured."
        echo "config: $CONFIG_FILE"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
