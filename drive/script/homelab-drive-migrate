#!/usr/bin/env perl
# Applies homelab-drive's own migrations/*.sql via the migrate role.
# Same template as homelab-api-migrate — see that file's comment.
use strict;
use warnings;

use FindBin;
use lib "$FindBin::Bin/../lib";

use Homelab::Common::Config qw(load_config);
use Homelab::Common::DB qw(migrate_dbh);
use Homelab::Common::Migrate qw(run_migrations);

my $config = load_config('HOMELAB_DRIVE_CONFIG', '/etc/homelab/drive/config.yml');
my $dbh    = migrate_dbh(%{ $config->{database_migrate} });

my $migrations_dir = $ENV{HOMELAB_DRIVE_MIGRATIONS_DIR} // '/usr/share/homelab-drive/migrations';
my $applied = run_migrations(dbh => $dbh, schema => 'drive', migrations_dir => $migrations_dir);

print "homelab-drive: applied $applied migration(s)\n";
