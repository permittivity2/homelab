[Unit]
Description=Homelab Drive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_DRIVE_CONFIG=/etc/homelab/drive/config.yml"
Environment="HOMELAB_DRIVE_HOME=/usr/share/homelab-drive"
# Request-size ceiling. Mojolicious defaults to 16MB; this must be
# raised in lockstep with the nginx client_max_body_size in front of
# this on EVERY hop -- for the browser that's homelab-webproxy's own
# drive.<domain> vhost, and for CLI/API traffic it's ALSO homelab-api's
# gateway (/api/v1/drive/*) + its api.<domain> vhost (each with its own
# MOJO_MAX_MESSAGE_SIZE + client_max_body_size) -- whichever hop is
# lowest silently wins. 5GB (not exactly 4) leaves headroom for a full
# 4GB file plus multipart/form-data framing overhead.
Environment="MOJO_MAX_MESSAGE_SIZE=5368709120"
# Where Mojo spools an upload body too big for memory (anything over
# MOJO_MAX_MEMORY_SIZE, default 256KB). MUST NOT be the default /tmp,
# which on this fleet is a RAM-backed tmpfs -- a 4GB upload there would
# be buffered entirely in RAM and OOM the box. Pointed at a dir on the
# SAME filesystem as storage.path so the spill lands on real disk AND
# $upload->move_to into storage is a cheap rename, not a 4GB copy. The
# postinst creates this dir (owned by the homelab user).
Environment="MOJO_TMPDIR=/var/lib/homelab/drive-storage/.uploads-tmp"
# Reached two ways, both needing this: directly, fronted by homelab-
# webproxy for browser traffic (drive.test.mailmasker.org), AND via
# homelab-api's own gateway (/api/v1/drive/*, Homelab::Common::Proxy::
# forward()) for CLI/API traffic -- both hops now send X-Forwarded-For/
# X-Real-IP (webproxy always did; the gateway hop was a real, separate
# bug, fixed alongside this). Without this, $c->tx->remote_address
# resolves to whichever of those two ever connected most recently,
# never the real client -- audit-log entries for gateway-mediated
# drive actions (deletes, uploads) were recording homelab-api's own
# loopback address before this fix.
Environment="MOJO_REVERSE_PROXY=1"
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-drive
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-drive
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-drive

[Install]
WantedBy=multi-user.target
