#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

override_dh_install:
	dh_install
	install -D -m 755 script/homelab-cert-issue        debian/homelab-cert-server/usr/bin/homelab-cert-issue
	install -D -m 755 script/homelab-cert-publish      debian/homelab-cert-server/usr/bin/homelab-cert-publish
	install -D -m 755 script/homelab-cert-dns-auth     debian/homelab-cert-server/usr/bin/homelab-cert-dns-auth
	install -D -m 755 script/homelab-cert-dns-cleanup  debian/homelab-cert-server/usr/bin/homelab-cert-dns-cleanup
	install -D -m 644 lib/Homelab/CertServer/Util.pm   debian/homelab-cert-server/usr/share/homelab-cert-server/lib/Homelab/CertServer/Util.pm
	install -D -m 644 config/cert-server.example.yml   debian/homelab-cert-server/usr/share/homelab-cert-server/config/cert-server.example.yml
	install -D -m 644 services/cert-server.yml         debian/homelab-cert-server/usr/share/homelab-cert-server/services/cert-server.yml
	install -D -m 644 systemd/homelab-cert-server.service debian/homelab-cert-server/lib/systemd/system/homelab-cert-server.service
	install -D -m 644 systemd/homelab-cert-server.timer   debian/homelab-cert-server/lib/systemd/system/homelab-cert-server.timer

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
