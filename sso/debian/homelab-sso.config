#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Already configured (fresh reinstall/upgrade) — don't re-prompt.
if [ -f /etc/homelab/sso/config.yml ]; then
    exit 0
fi

db_input high homelab-sso/db_host || true
db_input high homelab-sso/pgbouncer_host || true
db_input high homelab-sso/homelab_api_base_url || true
db_input high homelab-sso/listen_port || true
db_input high homelab-sso/drive_redirect_uri || true
db_input high homelab-sso/drive_client_secret || true
db_input high homelab-sso/roundcube_redirect_uri || true
db_input high homelab-sso/roundcube_client_secret || true
db_go

exit 0
