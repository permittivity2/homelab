#!/bin/sh
set -e

case "$1" in
    remove)
        # Stop the service; never touch the homelab_sso_runtime/_migrate
        # Postgres roles, their grants, the "sso" schema/data, or the
        # pgbouncer userlist entry -- those are out of scope for this
        # package on removal, same precedent as every other package here.
        systemctl stop homelab-sso 2>/dev/null || true
        ;;

    purge)
        rm -rf /etc/homelab/sso
        if [ -f /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
