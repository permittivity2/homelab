#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

# Unit file used to be hand-copied into /etc/systemd/system/ in
# override_dh_install below, invisible to dh_installsystemd -- this
# package shipped with no prerm/postrm at all as a result, so `apt
# purge` never stopped the running service (found live via
# ../drive/debian/rules's identical bug -- see that file's own
# comment for the full incident). --no-enable --no-start: postinst
# already handles enable/start itself with its own sequencing.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start


override_dh_install:
	dh_install
	install -D -m 644 config/sso.example.yml \
		debian/homelab-sso/usr/share/homelab-sso/config/sso.example.yml
	install -D -m 644 services/sso.yml \
		debian/homelab-sso/usr/share/homelab-sso/services/sso.yml
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-sso/usr/share/homelab-sso/{} \;
	find templates -type f -exec install -D -m 644 {} \
		debian/homelab-sso/usr/share/homelab-sso/{} \;
