<!DOCTYPE html>
<html lang="en">
<head>
%# Shared chrome from homelab-webtheme: theme.css / fonts / favicon come from
%# static.mailmasker.org, so SSO restyles with the rest of the fleet and needs
%# no rebuild for a colour change.
%#
%# This layout uses the shared THEME but not the shared HEADER: nobody is
%# signed in on an auth page, so a top bar would render an empty account
%# cluster. The logo carries the identity instead -- the same treatment
%# drive's and myaccount's login pages get.
%= include 'homelab/head'
<title><%= title %></title>
<style>
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: var(--space-6);
    padding: var(--space-4); background: var(--black-primary);
  }
  .card {
    width: 100%; max-width: 380px; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg); padding: var(--space-8) var(--space-6);
  }
  .brand { text-align: center; margin-bottom: var(--space-6); }
  .brand img { height: 30px; width: auto; }
  .brand p {
    font-size: var(--app-xs); color: var(--text-muted); margin: var(--space-3) 0 0;
    text-transform: uppercase; letter-spacing: var(--tracking-wider);
  }
  h2 { font-size: var(--app-lg); font-weight: var(--weight-light); letter-spacing: var(--tracking-tight); margin: 0 0 var(--space-2); }
  p { font-size: var(--app-base); color: var(--text-secondary); line-height: var(--leading-normal); }

  .error-banner, .ok-banner {
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-md);
    margin-bottom: var(--space-4); font-size: var(--app-sm); border: 1px solid;
  }
  .error-banner { background: rgba(216,92,92,0.10); color: var(--error);   border-color: rgba(216,92,92,0.35); }
  .ok-banner    { background: rgba(92,158,124,0.10); color: var(--success); border-color: rgba(92,158,124,0.35); }

  label {
    display: block; font-size: var(--app-sm); font-weight: var(--weight-medium);
    color: var(--text-secondary); margin: var(--space-4) 0 var(--space-1);
  }
  label:first-of-type { margin-top: 0; }
  input[type=email], input[type=password], input[type=text] {
    width: 100%; padding: var(--space-2) var(--space-3);
    background: var(--black-secondary); color: var(--text-primary);
    border: 1px solid var(--border-strong); border-radius: var(--radius-md);
    font-size: var(--app-base); font-family: inherit;
  }
  input::placeholder { color: var(--text-muted); }
  input:hover { border-color: var(--silver-dim); }
  /* The theme's global :focus-visible ring covers keyboard focus; this adds
     the same ring on POINTER focus too, which is what you want in a login
     form -- you should always be able to see which field you are typing in. */
  input:focus { outline: 2px solid var(--focus-ring); outline-offset: 2px; border-color: var(--silver-medium); }

  button[type=submit] {
    width: 100%; margin-top: var(--space-6); padding: var(--space-3);
    border: 1px solid var(--silver-bright); border-radius: var(--radius-md);
    background: var(--silver-bright); color: var(--black-primary);
    font: inherit; font-size: var(--app-base); font-weight: var(--weight-medium); cursor: pointer;
    transition: background var(--transition-fast);
  }
  button[type=submit]:hover { background: #ffffff; }

  .links, .forgot { margin-top: var(--space-4); text-align: center; font-size: var(--app-sm); }
  a { color: var(--text-secondary); }
  a:hover { color: var(--silver-bright); }

  /* The shared footer is a full-width bar in the apps; centred under the card
     is the right shape for a standalone auth page. */
  .appfoot { border: 0; padding: 0; text-align: center; }
</style>
</head>
<body>
<div class="card">
  <div class="brand">
    <img src="<%= theme_base %>/logo.svg" alt="Silver Linings">
    <p><%= stash('brand_sub') // 'Sign in' %></p>
  </div>
  <%= content %>
</div>
%= include 'homelab/footer'
</body>
</html>
