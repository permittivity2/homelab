#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if [ -f /etc/homelab/notes/config.yml ]; then
    exit 0
fi

db_input high homelab-notes/db_host || true
db_input high homelab-notes/pgbouncer_host || true
db_input high homelab-notes/api_base || true
db_input high homelab-notes/listen_port || true
db_input high homelab-notes/advertise_host || true
db_input high homelab-notes/public_base_url || true
db_input high homelab-notes/sso_base_url || true
db_input medium homelab-notes/sso_internal_base_url || true
db_input high homelab-notes/sso_client_secret || true
db_input medium homelab-notes/session_secret || true
db_go

exit 0
