#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR=/etc/homelab/audit
CONFIG_FILE="$CONFIG_DIR/config.yml"
SHARE_DIR=/usr/share/homelab-audit

case "$1" in
    configure)
        echo "homelab-audit post-installation setup..."

        adduser --system --group --home /var/lib/homelab --no-create-home \
            --shell /usr/sbin/nologin homelab 2>/dev/null || true
        mkdir -p /var/lib/homelab "$CONFIG_DIR"
        chown homelab:homelab /var/lib/homelab

        # Shared manifest dir -- may not exist yet if homelab-agent
        # isn't installed on this host first (install order isn't
        # guaranteed either way); ensure it, then drop this package's
        # own declarative entry into it unconditionally (static
        # metadata, not user config -- always refresh, unlike
        # $CONFIG_FILE below).
        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services
        cp "$SHARE_DIR/services/audit.yml" "/etc/homelab/services/audit.yml"

        if [ ! -f "$CONFIG_FILE" ]; then
            db_get homelab-audit/db_host || true;        DB_HOST="${RET:-localhost}"
            db_get homelab-audit/pgbouncer_host || true; PGBOUNCER_HOST="${RET:-localhost}"
            db_get homelab-audit/api_base || true;       API_BASE="${RET:-http://localhost:3000}"
            db_get homelab-audit/listen_port || true;    LISTEN_PORT="${RET:-2513}"
            db_get homelab-audit/advertise_host || true; ADVERTISE_HOST="${RET:-127.0.0.1}"

            echo "  bootstrapping Postgres roles for 'homelab_audit' on $DB_HOST..."
            BOOTSTRAP_OUT="$(homelab-bootstrap-app-role --feature homelab_audit --schema audit --db-host "$DB_HOST")"

            RUNTIME_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_ROLE=//p')"
            RUNTIME_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_PASSWORD=//p')"
            RUNTIME_SCRAM_SECRET="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_SCRAM_SECRET=//p')"
            MIGRATE_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_ROLE=//p')"
            MIGRATE_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_PASSWORD=//p')"
            BOOTSTRAP_MANUAL="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^BOOTSTRAP_MANUAL=//p')"

            if [ -z "$RUNTIME_ROLE" ] || [ -z "$MIGRATE_ROLE" ]; then
                echo "ERROR: homelab-bootstrap-app-role did not report success — see output above."
                echo "       Not writing $CONFIG_FILE; re-run 'dpkg-reconfigure homelab-audit' once fixed."
                db_stop
                exit 0
            fi

            # Write config from the generated passwords FIRST -- complete even in
            # the manual (multi-host, no-SSH) case, where the DB role + pgbouncer
            # entry are done by hand afterward. Bound to 0.0.0.0 (not 127.0.0.1):
            # reachable from homelab-api's gateway forward; firewall is the boundary.
            sed \
                -e "s#https://api\.test\.mailmasker\.org#$API_BASE#g" \
                -e "s#YOUR_PGBOUNCER_HOST#$PGBOUNCER_HOST#g" \
                -e "s#YOUR_RUNTIME_PASSWORD_HERE#$RUNTIME_PASSWORD#g" \
                -e "s#homelab_audit_runtime#$RUNTIME_ROLE#g" \
                -e "s#YOUR_POSTGRES_HOST#$DB_HOST#g" \
                -e "s#YOUR_MIGRATE_PASSWORD_HERE#$MIGRATE_PASSWORD#g" \
                -e "s#homelab_audit_migrate#$MIGRATE_ROLE#g" \
                -e "s#\"http://127\.0\.0\.1:2513\"#\"http://0.0.0.0:$LISTEN_PORT\"#g" \
                -e "s#  port: 2513#  port: $LISTEN_PORT#g" \
                -e "s#  host: 127\.0\.0\.1#  host: $ADVERTISE_HOST#g" \
                "$SHARE_DIR/config/audit.example.yml" > "$CONFIG_FILE"
            chown root:homelab "$CONFIG_FILE"
            chmod 640 "$CONFIG_FILE"
            echo "  wrote $CONFIG_FILE"

            if [ "$BOOTSTRAP_MANUAL" = "1" ]; then
                echo ""
                echo "  ================================================================"
                echo "  CONFIG WRITTEN -- but DB-side steps remain (runbook printed above):"
                echo "    1) run the role SQL on the DB primary"
                echo "    2) register '$RUNTIME_ROLE' in pgbouncer on each pooler"
                echo "  Then finish this host (applies migrations + starts the service):"
                echo "      sudo dpkg-reconfigure homelab-audit"
                echo "  ================================================================"
                echo ""
                db_stop
                exit 0
            fi

            echo "  registering '$RUNTIME_ROLE' with pgbouncer on $PGBOUNCER_HOST..."
            homelab-bootstrap-pgbouncer-entry --role "$RUNTIME_ROLE" \
                --scram-secret "$RUNTIME_SCRAM_SECRET" --pgbouncer-host "$PGBOUNCER_HOST" \
                || echo "  WARNING: pgbouncer registration failed — see output above; register '$RUNTIME_ROLE' by hand."
        else
            echo "  $CONFIG_FILE already exists -- leaving it untouched"
            echo "  (dpkg-reconfigure homelab-audit to redo the prompts)"
        fi

        echo "  applying migrations..."
        HOMELAB_AUDIT_MIGRATIONS_DIR="$SHARE_DIR/migrations" \
            HOMELAB_AUDIT_CONFIG="$CONFIG_FILE" \
            sudo -u homelab homelab-audit-migrate

        systemctl enable homelab-audit >/dev/null 2>&1 || true
        if systemctl is-active --quiet homelab-audit; then
            systemctl restart homelab-audit || echo "WARNING: homelab-audit restart failed -- check 'systemctl status homelab-audit' by hand."
        else
            systemctl start homelab-audit || echo "WARNING: homelab-audit failed to start -- check 'systemctl status homelab-audit' by hand."
        fi

        db_stop

        echo ""
        echo "homelab-audit configured."
        echo "config: $CONFIG_FILE"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
