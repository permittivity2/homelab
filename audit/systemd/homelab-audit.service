[Unit]
Description=Homelab Audit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_AUDIT_CONFIG=/etc/homelab/audit/config.yml"
# Never fronted by homelab-webproxy and never reached by a browser --
# only homelab-api's own gateway route talks to this, over plain
# internal HTTP (see README.md). No MOJO_REVERSE_PROXY needed for the
# same reason homelab-worker/mailbridge/domain-admin don't need it:
# there is no proxy in front of this one.
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-audit
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-audit
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-audit

[Install]
WantedBy=multi-user.target
