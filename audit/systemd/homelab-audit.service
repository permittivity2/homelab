[Unit]
Description=Homelab Audit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_AUDIT_CONFIG=/etc/homelab/audit/config.yml"
# Never fronted by homelab-webproxy and never reached by a browser --
# only homelab-api's own gateway route talks to this, over plain
# internal HTTP (see README.md). No MOJO_REVERSE_PROXY needed for the
# same reason homelab-worker/mailbridge/domain-admin don't need it:
# there is no proxy in front of this one.
# Post-cutover #41 J: the hypnotoad pid file lives in /run, emptied at every
# boot (homelab-common >= 0.1.38 points pid_file at RUNTIME_DIRECTORY), so a
# pid left on disk by a power cut can never make hypnotoad signal a stranger.
# The ExecStartPre clears the old on-disk pid for one release.
RuntimeDirectory=homelab-audit
RuntimeDirectoryMode=0750
ExecStartPre=-/bin/rm -f /var/lib/homelab/audit-hypnotoad.pid
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-audit
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-audit
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-audit

[Install]
WantedBy=multi-user.target
