#!/usr/bin/make -f

%:
	dh $@ --buildsystem=perl_makemaker

override_dh_auto_test:

# Unit file used to be hand-copied into /etc/systemd/system/ in
# override_dh_install below, invisible to dh_installsystemd -- this
# package shipped with no prerm/postrm at all as a result, so `apt
# purge` never stopped the running service (found live via
# ../drive/debian/rules's identical bug -- see that file's own
# comment for the full incident). --no-enable --no-start: postinst
# already handles enable/start itself with its own sequencing.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
#	A SECOND call is required for the DMARC ingest units. A bare
#	dh_installsystemd only installs debian/<package>.service -- the
#	debian/<package>.<unitname>.{service,timer} files are invisible to it
#	without --name, so the timer shipped as "not-found" on the first
#	deploy despite the files existing in debian/. Same family of mistake
#	as the hand-copied unit this override was added for in the first
#	place (see the comment above).
	dh_installsystemd --no-enable --no-start --name=homelab-dmarc-ingest


override_dh_install:
	dh_install
	install -D -m 644 config/domain-admin.example.yml \
		debian/homelab-domain-admin/usr/share/homelab-domain-admin/config/domain-admin.example.yml
	install -D -m 644 services/domain-admin.yml \
		debian/homelab-domain-admin/usr/share/homelab-domain-admin/services/domain-admin.yml
	install -D -m 644 pdns.d/95-homelab-domain-admin-api.conf.template \
		debian/homelab-domain-admin/usr/share/homelab-domain-admin/pdns.d/95-homelab-domain-admin-api.conf.template
	find migrations -type f -exec install -D -m 644 {} \
		debian/homelab-domain-admin/usr/share/homelab-domain-admin/{} \;
