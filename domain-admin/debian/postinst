#!/bin/sh
set -e

. /usr/share/debconf/confmodule

CONFIG_DIR=/etc/homelab/domain-admin
CONFIG_FILE="$CONFIG_DIR/config.yml"
SHARE_DIR=/usr/share/homelab-domain-admin
PDNS_D=/etc/powerdns/pdns.d
PDNS_MARKER="$PDNS_D/95-homelab-domain-admin-api.conf"
SUDOERS_FILE=/etc/sudoers.d/homelab-domain-admin

case "$1" in
    configure)
        echo "homelab-domain-admin post-installation setup..."

        adduser --system --group --home /var/lib/homelab --no-create-home \
            --shell /usr/sbin/nologin homelab 2>/dev/null || true
        mkdir -p /var/lib/homelab "$CONFIG_DIR"
        chown homelab:homelab /var/lib/homelab

        # Shared manifest dir -- may not exist yet if homelab-agent
        # isn't installed on this host first (install order isn't
        # guaranteed either way); ensure it, then drop this package's
        # own declarative entry into it unconditionally (static
        # metadata, not user config -- always refresh, unlike
        # $CONFIG_FILE below).
        mkdir -p /etc/homelab/services
        chgrp homelab /etc/homelab/services 2>/dev/null || true
        chmod 775 /etc/homelab/services
        cp "$SHARE_DIR/services/domain-admin.yml" "/etc/homelab/services/domain-admin.yml"

        if [ ! -f "$CONFIG_FILE" ]; then
            db_get homelab-domain-admin/db_host || true;        DB_HOST="${RET:-localhost}"
            db_get homelab-domain-admin/pgbouncer_host || true; PGBOUNCER_HOST="${RET:-localhost}"
            db_get homelab-domain-admin/api_base || true;       API_BASE="${RET:-http://localhost:3000}"
            db_get homelab-domain-admin/listen_port || true;    LISTEN_PORT="${RET:-2511}"
            db_get homelab-domain-admin/advertise_host || true; ADVERTISE_HOST="${RET:-127.0.0.1}"
            db_get homelab-domain-admin/pdns_api_host || true;  PDNS_API_HOST="${RET:-127.0.0.1}"
            db_get homelab-domain-admin/pdns_api_port || true;  PDNS_API_PORT="${RET:-8081}"
            db_get homelab-domain-admin/pdns_api_key || true;   PDNS_API_KEY_ANSWER="$RET"
            db_get homelab-domain-admin/haproxy_vip || true;    HAPROXY_VIP="${RET:-10.50.2.44}"
            db_get homelab-domain-admin/key_encryption_key || true; KEK_ANSWER="$RET"

            echo "  bootstrapping Postgres roles for 'homelab_domain_admin' on $DB_HOST..."
            # || true: a failed/skipped bootstrap (e.g. an ADDITIONAL signer
            # with no DB-admin access, whose role already exists) must NOT
            # abort the postinst under set -e -- it falls through to the
            # preseeded-pool-credentials reuse path below.
            BOOTSTRAP_OUT="$(homelab-bootstrap-app-role --feature homelab_domain_admin --schema domainadmin --db-host "$DB_HOST" </dev/null || true)"

            RUNTIME_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_ROLE=//p')"
            RUNTIME_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_PASSWORD=//p')"
            RUNTIME_SCRAM_SECRET="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^RUNTIME_SCRAM_SECRET=//p')"
            MIGRATE_ROLE="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_ROLE=//p')"
            MIGRATE_PASSWORD="$(echo "$BOOTSTRAP_OUT" | sed -n 's/^MIGRATE_PASSWORD=//p')"

            if [ -z "$RUNTIME_ROLE" ] || [ -z "$MIGRATE_ROLE" ]; then
                # bootstrap couldn't create/return the role -- the common
                # case for an ADDITIONAL signer whose role already exists in
                # the shared DB, on a fleet with no DB-admin access from
                # here. Reuse the pool credentials supplied via debconf (the
                # runtime/migrate role+password are identical on every
                # signer). The pgbouncer userlist entry already exists from
                # the first signer, so no scram/registration is needed.
                echo "  bootstrap returned no credentials; using preseeded pool credentials (additional-signer path)..."
                db_get homelab-domain-admin/runtime_role || true;     RUNTIME_ROLE="${RUNTIME_ROLE:-$RET}"
                db_get homelab-domain-admin/runtime_password || true; RUNTIME_PASSWORD="${RUNTIME_PASSWORD:-$RET}"
                db_get homelab-domain-admin/migrate_role || true;     MIGRATE_ROLE="${MIGRATE_ROLE:-$RET}"
                db_get homelab-domain-admin/migrate_password || true; MIGRATE_PASSWORD="${MIGRATE_PASSWORD:-$RET}"
                RUNTIME_SCRAM_SECRET=""
            fi

            if [ -z "$RUNTIME_ROLE" ] || [ -z "$RUNTIME_PASSWORD" ] || [ -z "$MIGRATE_ROLE" ]; then
                echo "ERROR: no usable DB credentials — bootstrap did not succeed and no pool"
                echo "       credentials were preseeded (homelab-domain-admin/runtime_role etc.)."
                echo "       Not writing $CONFIG_FILE; preseed the pool creds or fix DB access, then"
                echo "       re-run 'dpkg-reconfigure homelab-domain-admin'."
                db_stop
                exit 0
            fi

            # Register in pgbouncer only when WE bootstrapped the role (have
            # its scram); an additional signer reuses the entry the first
            # one already added.
            if [ -n "$RUNTIME_SCRAM_SECRET" ]; then
                echo "  registering '$RUNTIME_ROLE' with pgbouncer on $PGBOUNCER_HOST..."
                homelab-bootstrap-pgbouncer-entry --role "$RUNTIME_ROLE" \
                    --scram-secret "$RUNTIME_SCRAM_SECRET" --pgbouncer-host "$PGBOUNCER_HOST" \
                    || echo "  WARNING: pgbouncer registration failed — see output above; register '$RUNTIME_ROLE' by hand."
            fi

            # Explicit answer wins (matches a pre-existing REMOTE
            # PowerDNS's already-configured key, see this template's own
            # description); blank means the usual co-located case, where
            # a fresh random key gets written into PowerDNS's own config
            # too, further down, only when pdns_server is found locally.
            PDNS_API_KEY="${PDNS_API_KEY_ANSWER:-$(openssl rand -base64 32)}"

            # DKIM key-encryption-key: explicit answer wins; blank auto-
            # generates one and prints it LOUDLY so it can be reused on the
            # other signers -- it MUST be identical fleet-wide or their
            # DB-distributed keys won't decrypt (see KeyVault + README).
            KEK="${KEK_ANSWER:-$(openssl rand -base64 32)}"
            if [ -z "$KEK_ANSWER" ]; then
                echo ""
                echo "  ============================================================"
                echo "  Generated a NEW DKIM key-encryption-key (KEK) for this pool."
                echo "  Set this EXACT value as homelab-domain-admin/key_encryption_key"
                echo "  on every OTHER signer host (or their keys won't decrypt):"
                echo ""
                echo "      $KEK"
                echo ""
                echo "  Keep it OUT of the database and back it up separately."
                echo "  ============================================================"
                echo ""
            fi

            # Two related distributed-deployment bugs, both found via a
            # real remote gateway-forward attempt (not assumed): the
            # example config's own HTTP listener was bound to 127.0.0.1
            # (only the port was ever substituted, never the host) --
            # unreachable from any other host including homelab-api's own
            # gateway, which got a bare connection-refused. Bound to
            # 0.0.0.0 now, same "bind broadly, firewall is the boundary"
            # posture already used elsewhere in this project (dovecot's
            # LMTP/auth listeners, etc) -- matches what homelab-sso and
            # homelab-drive's own example configs already did correctly.
            # Separately, config.yml's registry.host (what homelab-api
            # actually dials when forwarding to this service) is set to the
            # HAProxy VIP, not this host's own address -- the "always behind
            # HAProxy" convention, so the gateway dials the VIP and this
            # host is just one backend server behind it (see haproxy_vip +
            # the self-registration below). ADVERTISE_HOST is the real
            # backend-server address HAProxy forwards to.
            sed \
                -e "s#https://api\.test\.mailmasker\.org#$API_BASE#g" \
                -e "s#YOUR_PGBOUNCER_HOST#$PGBOUNCER_HOST#g" \
                -e "s#YOUR_RUNTIME_PASSWORD_HERE#$RUNTIME_PASSWORD#g" \
                -e "s#homelab_domain_admin_runtime#$RUNTIME_ROLE#g" \
                -e "s#YOUR_POSTGRES_HOST#$DB_HOST#g" \
                -e "s#YOUR_MIGRATE_PASSWORD_HERE#$MIGRATE_PASSWORD#g" \
                -e "s#homelab_domain_admin_migrate#$MIGRATE_ROLE#g" \
                -e "s#http://127\.0\.0\.1:8081#http://$PDNS_API_HOST:$PDNS_API_PORT#g" \
                -e "s#YOUR_PDNS_API_KEY_HERE#$PDNS_API_KEY#g" \
                -e "s#\"http://127\.0\.0\.1:2511\"#\"http://0.0.0.0:$LISTEN_PORT\"#g" \
                -e "s#  port: 2511#  port: $LISTEN_PORT#g" \
                -e "s#  host: 127\.0\.0\.1#  host: $HAPROXY_VIP#g" \
                -e "s#YOUR_BASE64_KEK_HERE#$KEK#g" \
                "$SHARE_DIR/config/domain-admin.example.yml" > "$CONFIG_FILE"
            chown root:homelab "$CONFIG_FILE"
            chmod 640 "$CONFIG_FILE"
            echo "  wrote $CONFIG_FILE"
        else
            echo "  $CONFIG_FILE already exists -- leaving it untouched"
            echo "  (dpkg-reconfigure homelab-domain-admin to redo the prompts)"
        fi

        # === Always-behind-HAProxy HA wiring (runs on EVERY configure,
        # idempotently, NOT just first install -- a host's firewall and its
        # HAProxy/PowerDNS registration should be ensured on upgrade/
        # reconfigure too, and it must work for an additional signer whose
        # config was written by the reuse path above). All values are read
        # from the config just written/present, so this is independent of
        # how the config was produced. ===
        HA_LISTEN_PORT="$(sed -n 's#^  listen: .*://[^:]*:\([0-9][0-9]*\).*#\1#p' "$CONFIG_FILE" | head -1)"
        HA_LISTEN_PORT="${HA_LISTEN_PORT:-2511}"
        HA_VIP="$(sed -n '/^registry:/,/^[^ ]/{s/^  host: //p}' "$CONFIG_FILE" | head -1)"
        HA_PDNS_URL="$(sed -n 's#^  api_base_url: ##p' "$CONFIG_FILE" | head -1)"
        HA_PDNS_HOST="$(printf '%s' "$HA_PDNS_URL" | sed -n 's#^https\?://\([^:/]*\).*#\1#p')"
        HA_PDNS_PORT="$(printf '%s' "$HA_PDNS_URL" | sed -n 's#^https\?://[^:/]*:\([0-9][0-9]*\).*#\1#p')"
        HA_PDNS_PORT="${HA_PDNS_PORT:-8081}"
        # This host's own data-plane (10.50.0.0/22) address -- the backend
        # server address HAProxy forwards to.
        HA_SELF_IP="$(ip -o -4 addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -E '^10\.50\.' | head -1)"

        # --- Firewall drop-in: open exactly the signer's ports ($LISTEN_PORT
        # inbound from the plane; $PDNS_PORT egress to a REMOTE PowerDNS).
        # ADDS rules into the base 'inet filter' chains -- requires the host's
        # /etc/nftables.conf to declare that table and include
        # /etc/nftables.d/* (see README). Idempotent: reload rebuilds from
        # all files, so re-running never duplicates rules.
        NFT_DROPIN=/etc/nftables.d/50-homelab-domain-admin.conf
        if grep -qE 'include "/etc/nftables\.d/\*"' /etc/nftables.conf 2>/dev/null \
           && nft list table inet filter >/dev/null 2>&1; then
            {
                echo '#!/usr/sbin/nft -f'
                echo '# Managed by homelab-domain-admin -- do not edit by hand.'
                echo "add rule inet filter input tcp dport $HA_LISTEN_PORT ip saddr 10.50.0.0/22 accept comment \"homelab-domain-admin: admin API / signer inbound\""
                case "$HA_PDNS_HOST" in
                    ''|127.0.0.1|localhost|::1) : ;;
                    *) echo "add rule inet filter output tcp dport $HA_PDNS_PORT ip daddr $HA_PDNS_HOST accept comment \"homelab-domain-admin: PowerDNS API egress\"" ;;
                esac
            } > "$NFT_DROPIN"
            chmod 0644 "$NFT_DROPIN"
            if nft -c -f /etc/nftables.conf >/dev/null 2>&1; then
                if systemctl is-active --quiet nftables 2>/dev/null || systemctl is-enabled --quiet nftables 2>/dev/null; then
                    systemctl reload nftables 2>/dev/null \
                        || echo "  WARNING: 'systemctl reload nftables' failed -- apply $NFT_DROPIN by hand."
                fi
                echo "  applied firewall drop-in $NFT_DROPIN"
            else
                echo "  WARNING: nft check failed after writing $NFT_DROPIN -- removing it, firewall left unchanged."
                rm -f "$NFT_DROPIN"
            fi
        else
            echo "  NOTE: /etc/nftables.conf has no /etc/nftables.d/* include or no 'inet filter' table --"
            echo "        skipping the firewall drop-in; open $HA_LISTEN_PORT (from 10.50.0.0/22) +"
            echo "        egress to ${HA_PDNS_HOST:-PowerDNS}:$HA_PDNS_PORT by hand."
        fi

        # --- HAProxy backend + PowerDNS allowlist registration is now PULL,
        # not push: once this host's homelab-agent heartbeats, homelab-api's
        # fleet view lists it, and ct00's homelab-haproxy-pull.timer +
        # ct18's homelab-dns-pull.timer pick it into the HAProxy 'domain-admin'
        # backend and the PowerDNS webserver-allow-from automatically (within
        # a couple of minutes) -- no install-time cross-host push, no SSH.
        # (The homelab-bootstrap-haproxy-backend / -pdns-api-client helpers
        # remain in homelab-common for an operator to run by hand if a pull
        # consumer isn't deployed.)
        echo "  HAProxy backend + PowerDNS allowlist are pull-managed (ct00/ct18 timers) -- nothing to push."

        # RUNTIME_ROLE is only set above on a fresh install -- on an
        # upgrade, derive it from the config already on disk.
        if [ -z "$RUNTIME_ROLE" ]; then
            RUNTIME_ROLE="$(sed -n '/^database:/,/^database_migrate:/{s/^[[:space:]]*user: //p}' "$CONFIG_FILE" | head -1)"
        fi
        if [ -n "$RUNTIME_ROLE" ]; then
            echo "  granting '$RUNTIME_ROLE' INSERT access on audit.queue (for the domain/DNS/DKIM/recipient-access audit trail)..."
            DB_HOST_FOR_GRANT="${DB_HOST:-$(sed -n '/^database_migrate:/,/^database:/{s/^[[:space:]]*host: //p}' "$CONFIG_FILE" | head -1)}"
            homelab-audit-grant-queue-insert --role "$RUNTIME_ROLE" --db-host "${DB_HOST_FOR_GRANT:-localhost}" </dev/null \
                || echo "  WARNING: could not grant audit.queue access -- if homelab-audit isn't installed/migrated yet, install it and re-run this grant by hand (see homelab-audit/README.md); audited actions will fail closed until this grant exists."
        fi

        echo "  applying migrations..."
        HOMELAB_DOMAIN_ADMIN_MIGRATIONS_DIR="$SHARE_DIR/migrations" \
            HOMELAB_DOMAIN_ADMIN_CONFIG="$CONFIG_FILE" \
            sudo -u homelab homelab-domain-admin-migrate

        # Narrow, explicit sudoers grant -- lets the unprivileged `homelab`
        # user restart pdns after a DNS write PowerDNS won't otherwise
        # serve until restarted (see README.md), and manage opendkim (used
        # starting in a later phase -- granted now since this is one
        # static file, not something worth a second sudoers rewrite when
        # that phase lands). Nothing else. Validated with visudo before
        # being activated -- prefer leaving the OLD file (or none) in
        # place over activating a broken one.
        TMP_SUDOERS="$(mktemp)"
        cat > "$TMP_SUDOERS" <<'SUDOERS'
# Managed by homelab-domain-admin's postinst -- do not hand-edit.
homelab ALL=(root) NOPASSWD: /usr/bin/systemctl restart pdns, /usr/bin/systemctl reload opendkim, /usr/bin/systemctl restart opendkim
SUDOERS
        if visudo -c -f "$TMP_SUDOERS" >/dev/null 2>&1; then
            install -m 0440 "$TMP_SUDOERS" "$SUDOERS_FILE"
            echo "  wrote $SUDOERS_FILE"
        else
            echo "  WARNING: generated sudoers file failed validation -- NOT installing it."
            echo "           pdns restarts after a DNS write will need to be done by hand."
        fi
        rm -f "$TMP_SUDOERS"

        # Enable PowerDNS's HTTP API, but only if PowerDNS is actually
        # installed on this host (Recommends, not Depends -- a domain
        # can have dns_managed=false, and this package can be installed
        # before homelab-dns is). Same validate-then-restart idiom as
        # homelab-dns's own postinst -- pdns.service has no reload path
        # at all, so a genuine config change unavoidably needs a restart.
        if command -v pdns_server >/dev/null 2>&1; then
            mkdir -p "$PDNS_D"
            sed -e "s#__PDNS_API_KEY__#${PDNS_API_KEY:-$(grep -A2 '^powerdns:' "$CONFIG_FILE" | sed -n 's/^  api_key: //p')}#g" \
                "$SHARE_DIR/pdns.d/95-homelab-domain-admin-api.conf.template" > "$PDNS_MARKER"
            chmod 640 "$PDNS_MARKER"
            chgrp pdns "$PDNS_MARKER" 2>/dev/null || true
            echo "  wrote $PDNS_MARKER"

            if pdns_server --config=check >/dev/null 2>&1; then
                if systemctl is-active --quiet pdns; then
                    systemctl restart pdns || echo "WARNING: pdns restart failed -- check 'systemctl status pdns' by hand."
                else
                    systemctl start pdns || echo "WARNING: pdns failed to start -- check 'systemctl status pdns' by hand."
                fi
            else
                echo "  WARNING: PowerDNS config check failed -- NOT touching pdns."
                echo "           Run 'pdns_server --config=check' by hand to see the error;"
                echo "           the previous running config (if any) is untouched."
            fi
        else
            echo "  PowerDNS is not installed on this host -- skipping API enablement"
            echo "  (install homelab-dns first, then 'dpkg-reconfigure homelab-domain-admin')."
        fi

        systemctl enable homelab-domain-admin >/dev/null 2>&1 || true
        if systemctl is-active --quiet homelab-domain-admin; then
            systemctl restart homelab-domain-admin || echo "WARNING: homelab-domain-admin restart failed -- check 'systemctl status homelab-domain-admin' by hand."
        else
            systemctl start homelab-domain-admin || echo "WARNING: homelab-domain-admin failed to start -- check 'systemctl status homelab-domain-admin' by hand."
        fi

        db_stop

        echo ""
        echo "homelab-domain-admin configured."
        echo "config: $CONFIG_FILE"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument: $1"
        exit 1
        ;;
esac

exit 0
