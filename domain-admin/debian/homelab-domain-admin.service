[Unit]
Description=Homelab Domain Admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homelab
Group=homelab
WorkingDirectory=/var/lib/homelab
Environment="HOMELAB_DOMAIN_ADMIN_CONFIG=/etc/homelab/domain-admin/config.yml"
# Never fronted by homelab-webproxy and never reached by a browser
# directly -- but homelab-api's own gateway (/api/v1/domains/*,
# Homelab::Common::Proxy::forward()) IS itself a proxy hop, and that
# forward() call now sends X-Forwarded-For/X-Real-IP for exactly this
# reason. Without trusting it here too, $c->tx->remote_address would
# resolve to homelab-api's own loopback address instead of the real
# client -- caught while wiring up the audit trail, where every
# gateway-mediated domain/DNS/DKIM/recipient-access/mail-alias entry
# was recording the wrong IP.
Environment="MOJO_REVERSE_PROXY=1"
ExecStart=/usr/bin/hypnotoad -f /usr/bin/homelab-domain-admin
ExecStop=/usr/bin/hypnotoad -s /usr/bin/homelab-domain-admin
TimeoutStopSec=10
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homelab-domain-admin

[Install]
WantedBy=multi-user.target
