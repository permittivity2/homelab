#!/bin/sh
set -e

. /usr/share/debconf/confmodule

MARKER=/etc/roundcube/config.inc.php.bootstrapped

# Already configured (fresh reinstall/upgrade) — don't re-prompt or
# re-bootstrap a role that's already live and in use.
if [ -f "$MARKER" ]; then
    exit 0
fi

db_input high homelab-roundcube/db_host || true
db_input high homelab-roundcube/pgbouncer_host || true
db_input high homelab-roundcube/internal_port || true
db_input medium homelab-roundcube/product_name || true
db_input high homelab-roundcube/sso_base_url || true
db_input high homelab-roundcube/sso_client_secret || true
db_input high homelab-roundcube/api_base_url || true
db_go

exit 0
