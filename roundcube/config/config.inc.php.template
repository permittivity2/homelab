<?php
// Managed by homelab-roundcube -- do not hand-edit, edit debconf answers
// instead (dpkg-reconfigure homelab-roundcube). This REPLACES Debian's
// own /etc/roundcube/config.inc.php entirely -- dbconfig-common was
// declined at install time (roundcube-core/dbconfig-install=false) in
// favor of the standard homelab-* split runtime/migrate role pattern
// (see CLAUDE.md), so this file owns db_dsnw directly rather than
// including Debian's own debian-db-roundcube.php.
//
// Runtime traffic goes through PgBouncer (default port 6432), never
// straight to Postgres -- see CLAUDE.md's split-role design. This is
// the "unified cross-feature identity" design in action from the
// browser's side: whatever email/password a user types here is the
// SAME Argon2id-hashed api.users row homelab-dovecot's IMAP passdb (and
// homelab-drive's HTTP login) validate against -- Roundcube itself
// never touches api.users at all; it authenticates purely by
// attempting a real IMAP LOGIN against homelab-dovecot with whatever
// the user typed, exactly like any other IMAP client would.
$config = [];

$config['db_dsnw'] = 'pgsql://__DB_USER__:__DB_PASS__@__DB_HOST__:__DB_PORT__/__DB_NAME__';

// IMAP host chosen to perform the log-in -- homelab-dovecot, same host
// (loopback), plain (non-TLS) connection: Dovecot allows plaintext AUTH
// on loopback even with disable_plaintext_auth at its Debian default,
// and TLS between two processes on the same host via 127.0.0.1 adds
// packaging complexity (cert trust) without a real security benefit
// here. Revisit if Roundcube and Dovecot are ever split across hosts.
$config['imap_host'] = ['localhost:143'];

// SMTP server (submission, not the inbound MX port) -- homelab-postfix,
// same host. %u/%p: whatever the user just authenticated to IMAP with
// is reused for SMTP AUTH too, so there's still only ever one password
// prompt.
$config['smtp_host'] = 'localhost:587';
$config['smtp_user'] = '%u';
$config['smtp_pass'] = '%p';

$config['support_url'] = '';
$config['product_name'] = '__PRODUCT_NAME__';

// Without this, Roundcube generates http:// (not https://) redirect_uri
// values -- the internal nginx vhost (config/nginx-internal.conf.template)
// hands off to PHP-FPM over plain loopback HTTP with no
// X-Forwarded-Proto translation into the HTTPS server var, so PHP has no
// other way to know the real, public-facing request was HTTPS. Without
// this, homelab-sso's exact-match redirect_uri check on /oauth/token
// rejects the callback. (Root-caused once already in this project's
// prior private repo's own SSO rollout -- see script/
// homelab-roundcube-patch-oauth-sso's header for the sibling PATH_INFO
// bug found the same way.)
$config['use_https'] = true;

// Login is delegated entirely to homelab-sso -- an OAuth2-style
// authorization-code flow, natively supported by Roundcube
// (program/include/rcmail_oauth.php), no plugin needed. Two small core
// patches are required to make it actually work here (see
// script/homelab-roundcube-patch-oauth-sso's header for why); postinst
// runs that patch unconditionally on every install/upgrade, same as the
// PHP 8.5 compat patch. oauth_logout_uri is NOT a stock Roundcube config
// key -- it's read by that same patch, to redirect a Roundcube-initiated
// logout through homelab-sso's own /logout (single logout -- see
// ../sso/README.md) instead of only clearing Roundcube's own session.
$config['oauth_provider']      = 'homelab-sso';
$config['oauth_provider_name'] = 'Homelab SSO';
$config['oauth_client_id']     = 'roundcube';
$config['oauth_client_secret'] = '__SSO_CLIENT_SECRET__';
$config['oauth_auth_uri']      = '__SSO_BASE_URL__/oauth/authorize';
$config['oauth_token_uri']     = '__SSO_BASE_URL__/oauth/token';
$config['oauth_identity_uri']  = '__SSO_BASE_URL__/oauth/userinfo';
$config['oauth_logout_uri']    = '__SSO_BASE_URL__/logout';
$config['oauth_scope']         = 'openid';
// Silent full-page auto-redirect through homelab-sso on any
// unauthenticated visit -- this is what actually delivers "login once,
// login everywhere": without it, a live Drive session does NOT carry
// over automatically when visiting Roundcube fresh, because Roundcube
// still shows its own login page (with a manual "Login with Homelab
// SSO" link/button) instead of silently checking homelab-sso's IdP
// session on your behalf. Started as `false` (a deliberately cautious
// default for the first rollout, matching this project's prior private
// repo's own SSO work, which only flipped the equivalent of this after
// proving the flow correct in production) and was flipped to `true`
// once a real user confirmed the flow itself was solid but the missing
// auto-redirect made "login once, login everywhere" not actually feel
// that way in a real browser.
$config['oauth_login_redirect'] = true;

// Must stay aligned with homelab-api's jwt.expiry_seconds (config/
// api.example.yml; currently 1800s = 30 minutes) by hand -- there is no
// automatic sync between the two. A shorter local session than the JWT
// means Roundcube's own PHP session dies first, which the OAuth plugin's
// unauthenticated-redirect only fires on an actually-clean state (no
// local session error present, to avoid a redirect loop) -- so a
// prematurely-dead local session here surfaces Roundcube's raw "session
// invalid or expired" page instead of silently bouncing through SSO.
// Same gotcha already hit once in this project's prior private repo.
$config['session_lifetime'] = 30;

// AES-256-CBC, not the default DES-EDE3-CBC (kept in Debian's own
// shipped defaults.inc.php only for backward compatibility -- its own
// comment recommends AES-256-CBC as "a better choice", so use it
// outright rather than inheriting a weaker legacy default). Needs a
// real 32-byte key, generated fresh per install by postinst -- never
// the sample value from Debian's own default config.inc.php, which
// would mean every homelab-roundcube install encrypting session IMAP
// passwords with the SAME publicly-known key.
$config['cipher_method'] = 'AES-256-CBC';
$config['des_key'] = '__CIPHER_KEY__';

// Deliberately minimal for the first pass, matching every other
// homelab-* feature's own "prove the core path first" precedent (see
// e.g. homelab-drive's README) -- no plugins enabled yet. archive/
// managesieve/zipdownload etc. are straightforward to add later once
// login + read + send is proven end-to-end.
$config['plugins'] = [];

$config['skin'] = 'elastic';
$config['enable_spellcheck'] = false;
