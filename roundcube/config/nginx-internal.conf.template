# Managed by homelab-roundcube -- do not hand-edit, edit debconf answers
# instead (dpkg-reconfigure homelab-roundcube). This is a SEPARATE,
# internal-only nginx vhost, distinct from homelab-webproxy's own
# managed sites -- it exists purely to bridge Roundcube's PHP-FPM
# backend to plain HTTP, so homelab-webproxy's existing
# `upstream: host:PORT` reverse-proxy model (designed around
# already-HTTP-speaking backends like homelab-drive's hypnotoad) works
# for a PHP application too without needing homelab-webproxy itself to
# learn a second, fastcgi-flavored upstream type.
#
# Bound to all interfaces, not loopback only: homelab-webproxy and
# homelab-roundcube are routinely on separate hosts (this project's own
# test topology included), and a loopback-only bind would make this
# totally unreachable from a remote webproxy -- same "bind broadly, the
# firewall is the boundary" posture used elsewhere in this project, not
# "trust the network" (nftables scopes inbound access on this port to
# webproxy's own address specifically, tighter than the broad
# internal-supernet scoping used for the pure backend services, since
# this one serves the actual webmail UI rather than an internal API).
server {
    listen __INTERNAL_PORT__;
    server_name _;
    root /var/lib/roundcube/public_html;
    index index.php;

    client_max_body_size 25m;

    # The real visitor, not the edge. The edge (homelab-webproxy) appends
    # the visitor's address to X-Forwarded-For; it is believed ONLY from
    # the edge nodes themselves (prod-homelab00/01/02 and their shared
    # service address .140). With this, this vhost's access log and PHP's
    # REMOTE_ADDR (what Roundcube itself logs) name the visitor; without
    # it every webmail request looked like it came from the edge.
    # Roundcube's ip_check is off (its default), so a visitor whose
    # address changes mid-session (a phone) is not logged out by this.
    set_real_ip_from 10.50.2.140;
    set_real_ip_from 10.50.2.144;
    set_real_ip_from 10.50.2.145;
    set_real_ip_from 10.50.2.146;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php__PHP_VERSION__-fpm.sock;

        # Without these, PHP's own $_SERVER['SERVER_PORT'] reflects THIS
        # vhost's own loopback listen port (__INTERNAL_PORT__), not the
        # real public-facing port homelab-webproxy terminated TLS on --
        # this vhost has no visibility into that at all otherwise. Found
        # via a real, live OAuth round trip: Roundcube's
        # rcmail_oauth::get_redirect_uri() (see
        # ../script/homelab-roundcube-patch-oauth-sso) built
        # "https://mail.test.mailmasker.org:__INTERNAL_PORT__/..." --
        # the leaked internal port made homelab-sso's exact-match
        # redirect_uri check fail every time. Always 443 here: this
        # vhost is only ever reached via homelab-webproxy, which always
        # terminates TLS on 443 -- same fixed assumption
        # $config['use_https'] already makes in config.inc.php.template.
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
    }

    # Never serve Roundcube's own config/logs/temp/.git etc.
    location ~ /\.(?!well-known) {
        deny all;
    }
}
