#!/bin/sh
set -e
case "$1" in
    purge)
        rm -f /etc/homelab/services/dovecot-metrics.yml
        if [ -f /etc/dovecot/conf.d/99-homelab-metrics.conf ]; then
            rm -f /etc/dovecot/conf.d/99-homelab-metrics.conf
            doveconf >/dev/null 2>&1 && systemctl reload dovecot 2>/dev/null || true
        fi
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear) ;;
    *) echo "postrm called with unknown argument: $1"; exit 1 ;;
esac
exit 0
